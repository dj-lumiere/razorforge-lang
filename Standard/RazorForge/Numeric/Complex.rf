module Numerics

### Represents an arbitrary-precision complex number with decimal real and imaginary components.
### `Complex` is built on top of {Real}, so both components retain decimal precision semantics.
### Use it for analysis routines that need complex arithmetic without collapsing to machine precision.
### :see: {Real}, {Numeric-Types}
record Complex obeys Numeric, Equatable, Hashable, Assignable, Copyable
  ### Stores the real component.
  secret real: Real
  ### Stores the imaginary component.
  secret imag: Real

# Default decimal precision (significant digits) for Complex transcendentals.
# 100 digits — comfortably above Decimal's fixed 70.
preset DECIMAL_DEFAULT_PRECISION: S32 = 100

# Complex constants. These are RECORD constructions over `Real` (an arbitrary-precision decimal record),
# NOT compile-time scalar constants, so they are `common routine` factories — the same idiom as
# `Real.zero()`/`Real.one()` — NOT `preset`s. (A `preset` inlines its value expression at every use;
# inlining a `Real.zero()` construction leaves the call unresolved at codegen, since a preset value is not
# re-analyzed at the inline site.)

### The complex zero value (0 + 0i).
### :returns: The resulting `Complex` value.
common routine Complex.zero() -> Complex
  return Complex(real: Real.zero(), imag: Real.zero())

### The complex unit value (1 + 0i).
### :returns: The resulting `Complex` value.
common routine Complex.one() -> Complex
  return Complex(real: Real.one(), imag: Real.zero())

### The imaginary unit (0 + 1i).
### :returns: The resulting `Complex` value.
common routine Complex.i() -> Complex
  return Complex(real: Real.zero(), imag: Real.one())

# ============================================================================
# Creators
# ============================================================================

### Creates the complex zero value.
### :returns: The resulting `Complex` value.
routine Complex() -> Complex
  return Complex.zero()

### Creates a purely real complex value.
### The imaginary component is initialized to zero.
### :param real: The real component.
### :returns: The resulting `Complex` value.
routine Complex(real: Real) -> Complex
  return Complex(real: real, imag: Real.zero())

### Creates a complex value from explicit real and imaginary components.
### :param real: The real component.
### :param imag: The imaginary component.
### :returns: The resulting `Complex` value.
routine Complex(real: Real, imag: Real) -> Complex
  return Complex(real: real, imag: imag)

### Creates a purely real complex value from a signed 64-bit integer (imaginary part zero).
### Uses the `from:` label (not `real:`) so the call routes to `create`, not a record literal.
### :param from: The real-axis integer value.
### :returns: The resulting `Complex` value.
routine Complex(from: S64) -> Complex
  return Complex(real: Real(value: from), imag: Real.zero())

### Creates a purely real complex value from an `F64` (imaginary part zero).
### :param from: The real-axis double value.
### :returns: The resulting `Complex` value.
routine Complex(from: F64) -> Complex
  return Complex(real: Real(value: from), imag: Real.zero())

### Creates a complex value from polar coordinates.
### `r` is the radius and `theta` is the angle in radians.
### :param r: The radius value.
### :param theta: The angle in radians.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
common routine Complex.from_polar(r: Real, theta: Real, precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Complex
  return Complex(real: r * theta.cos(precision), imag: r * theta.sin(precision))

# ============================================================================
# Arithmetic Operations
# ============================================================================

### Adds `you` to this complex value component-wise.
### :param you: The value to add.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.add(you: Complex) -> Complex
  return Complex(real: me.real + you.real, imag: me.imag + you.imag)

### Subtracts `you` from this complex value component-wise.
### :param you: The value to subtract.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.sub(you: Complex) -> Complex
  return Complex(real: me.real - you.real, imag: me.imag - you.imag)

### Multiplies this value by `you` using the standard complex product rule.
### :param you: The value to multiply by.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.mul(you: Complex) -> Complex
  return Complex(real: me.real * you.real - me.imag * you.imag, imag: me.real * you.imag + me.imag * you.real)

### Divides this value by `you`.
### :param you: The non-zero divisor.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.truediv(you: Complex) -> Complex
  var d = you.real * you.real + you.imag * you.imag
  return Complex(
    real: (me.real * you.real + me.imag * you.imag) / d,
    imag: (me.imag * you.real - me.real * you.imag) / d
  )

### Returns the additive inverse of this complex value.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.neg() -> Complex
  return Complex(real: -me.real, imag: -me.imag)

### Returns `true` when both the real and imaginary components are equal.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
@readonly
routine Complex.eq(you: Complex) -> Bool
  return me.real == you.real and me.imag == you.imag

# ============================================================================
# Hashing
# ============================================================================

### Returns a SipHash-2-4 keyed hash of this value.
### Hashes the canonical fixed-precision representation under the supplied key pair.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: The 64-bit keyed hash.
@readonly
routine Complex.hash(k0: U64, k1: U64) -> U64
  return me.represent_with_places(decimal_places: 10_s32).hash(k0: k0, k1: k1)

# ============================================================================
# Components and Properties
# ============================================================================

### Returns the real component.
### :returns: The resulting `Real` value.
@readonly
routine Complex.real_part() -> Real
  return me.real

### Returns the imaginary component.
### :returns: The resulting `Real` value.
@readonly
routine Complex.imag_part() -> Real
  return me.imag

### Returns the magnitude of this value.
### This is equivalent to `sqrt(real^2 + imag^2)`.
### :returns: The resulting `Real` value.
@readonly
routine Complex.abs() -> Real
  return (me.real * me.real + me.imag * me.imag).sqrt()

### Returns the squared magnitude of this value.
### Use `norm` when the caller needs relative magnitude without paying for a
### square root.
### :returns: The resulting `Real` value.
@readonly
routine Complex.norm() -> Real
  return me.real * me.real + me.imag * me.imag

### Returns the complex conjugate of this value.
### The real component is preserved and the imaginary component changes sign.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.conjugate() -> Complex
  return Complex(real: me.real, imag: -me.imag)

### Returns the phase angle of this complex value in radians.
### :param precision: The decimal precision to use.
### :returns: The resulting `Real` value.
@readonly
routine Complex.arg(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Real
  return me.imag.atan2(x: me.real, precision: precision)

### Computes the principal complex square root.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.sqrt(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Complex
  var r = me.abs()
  if r.is_zero()
    return Complex.zero()

  var two = Real(value: 2_s64)
  var rp = (r + me.real).divide(you: two, precision: precision).sqrt(precision)
  var ip = (r - me.real).divide(you: two, precision: precision).sqrt(precision)
  if me.imag.is_negative()
    ip = -ip
  return Complex(real: rp, imag: ip)

### Computes the complex exponential `e^z`.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.exp(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Complex
  var ea = me.real.exp(precision)
  return Complex(real: ea * me.imag.cos(precision), imag: ea * me.imag.sin(precision))

### Computes the principal natural logarithm of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.log(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Complex
  return Complex(real: me.abs().log(precision), imag: me.arg(precision))

### Raises this value to a complex exponent.
### :param exp: The exponent value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.pow(exp: Complex, precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Complex
  return (exp * me.log(precision)).exp(precision)

### Raises this value to a complex exponent using the default precision.
### :param exp: The exponent value.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.pow!(exp: Complex) -> Complex
  return (exp * me.log()).exp()

### Computes the complex sine of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.sin(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Complex
  return Complex(
    real: me.real.sin(precision) * me.imag.cosh(precision),
    imag: me.real.cos(precision) * me.imag.sinh(precision)
  )

### Computes the complex cosine of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.cos(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Complex
  return Complex(
    real: me.real.cos(precision) * me.imag.cosh(precision),
    imag: -(me.real.sin(precision) * me.imag.sinh(precision))
  )

### Computes the complex tangent of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.tan(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Complex
  var a2 = me.real + me.real
  var b2 = me.imag + me.imag
  var d = a2.cos(precision) + b2.cosh(precision)
  return Complex(real: a2.sin(precision).divide(you: d, precision: precision), imag: b2.sinh(precision).divide(you: d, precision: precision))

### Computes the principal inverse sine of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.asin(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Complex
  var iz = Complex(real: -me.imag, imag: me.real)
  var w = iz + (Complex.one() - me * me).sqrt(precision)
  var v = w.log(precision)
  return Complex(real: v.imag_part(), imag: -v.real_part())

### Computes the principal inverse cosine of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.acos(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Complex
  var s = (Complex.one() - me * me).sqrt(precision)
  var w = me + Complex(real: -s.imag_part(), imag: s.real_part())
  var v = w.log(precision)
  return Complex(real: v.imag_part(), imag: -v.real_part())

### Computes the principal inverse tangent of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.atan(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Complex
  var one = Real.one()
  var two = Real(value: 2_s64)
  var num = Complex(real: me.real, imag: me.imag + one)
  var den = Complex(real: -me.real, imag: one - me.imag)
  var v = (num / den).log(precision)
  return Complex(real: -v.imag_part().divide(you: two, precision: precision), imag: v.real_part().divide(you: two, precision: precision))

### Computes the complex hyperbolic sine of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.sinh(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Complex
  return Complex(
    real: me.real.sinh(precision) * me.imag.cos(precision),
    imag: me.real.cosh(precision) * me.imag.sin(precision)
  )

### Computes the complex hyperbolic cosine of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.cosh(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Complex
  return Complex(
    real: me.real.cosh(precision) * me.imag.cos(precision),
    imag: me.real.sinh(precision) * me.imag.sin(precision)
  )

### Computes the complex hyperbolic tangent of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.tanh(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Complex
  var a2 = me.real + me.real
  var b2 = me.imag + me.imag
  var d = a2.cosh(precision) + b2.cos(precision)
  return Complex(real: a2.sinh(precision).divide(you: d, precision: precision), imag: b2.sin(precision).divide(you: d, precision: precision))

### Computes the principal inverse hyperbolic sine of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.asinh(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Complex
  return (me + (me * me + Complex.one()).sqrt(precision)).log(precision)

### Computes the principal inverse hyperbolic cosine of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.acosh(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Complex
  return (me + (me * me - Complex.one()).sqrt(precision)).log(precision)

### Computes the principal inverse hyperbolic tangent of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.atanh(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Complex
  var two = Real(value: 2_s64)
  var v = ((Complex.one() + me) / (Complex.one() - me)).log(precision)
  return Complex(real: v.real_part().divide(you: two, precision: precision), imag: v.imag_part().divide(you: two, precision: precision))

### Computes the principal base-10 logarithm of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.log10(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Complex
  var v = me.log(precision)
  var ln10 = Real(value: 10_s64).log(precision)
  return Complex(real: v.real_part().divide(you: ln10, precision: precision), imag: v.imag_part().divide(you: ln10, precision: precision))

### Computes the principal base-2 logarithm of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.log2(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Complex
  var v = me.log(precision)
  var ln2 = Real(value: 2_s64).log(precision)
  return Complex(real: v.real_part().divide(you: ln2, precision: precision), imag: v.imag_part().divide(you: ln2, precision: precision))

### Returns the multiplicative inverse `1/me` (conjugate divided by the squared magnitude).
### :param precision: The decimal precision to use.
### :returns: The resulting `Complex` value.
@readonly
routine Complex.reciprocal(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Complex
  var d = me.norm()
  return Complex(real: me.real.divide(you: d, precision: precision), imag: (-me.imag).divide(you: d, precision: precision))

### Returns the polar form of this value as `(radius, angle-in-radians)` — the inverse of
### `from_polar`.
### :param precision: The decimal precision to use for the angle.
### :returns: A tuple `(magnitude, argument)`.
@readonly
routine Complex.to_polar(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> (Real, Real)
  return (me.abs(), me.arg(precision))

# ============================================================================
# Query Routines
# ============================================================================

### Returns `true` when both components are zero.
### :returns: The resulting `Bool` value.
@readonly
routine Complex.is_zero() -> Bool
  return me.real.is_zero() and me.imag.is_zero()

### Returns `true` when the imaginary component is zero.
### :returns: The resulting `Bool` value.
@readonly
routine Complex.is_real() -> Bool
  return me.imag.is_zero()

### Returns `true` when the real component is zero.
### :returns: The resulting `Bool` value.
@readonly
routine Complex.is_imaginary() -> Bool
  return me.real.is_zero()

# ============================================================================
# Text Representation
# ============================================================================

### Formats this value compactly as `a+bj` / `a-bj`, with each component in its canonical decimal
### form (full precision, no trailing zeros — e.g. `1+1j`, not `1.0000000000 + 1.0000000000j`).
### The `j` spelling matches the imaginary literal suffixes (`2j`, `1.5jn`), so output is valid
### literal syntax. Standard `represent` shape (no args) for f-string dispatch.
### :returns: The resulting `Text` value.
@[readonly, override]
routine Complex.represent() -> Text
  var real_text = me.real.represent()
  var imag_abs = me.imag.abs().represent()
  if me.imag.is_negative()
    return real_text + "-" + imag_abs + "j"
  return real_text + "+" + imag_abs + "j"

### Formats this value as `a +/- bj` with the requested precision.
### :param decimal_places: The number of decimal places to render.
### :returns: The resulting `Text` value.
@readonly
routine Complex.represent_with_places(decimal_places: S32) -> Text
  var real_text = me.real.represent_with_places(decimal_places: decimal_places)
  var imag_abs = me.imag.abs().represent_with_places(decimal_places: decimal_places)
  if me.imag.is_negative()
    return real_text + " - " + imag_abs + "j"
  return real_text + " + " + imag_abs + "j"

### Returns a diagnostic string that includes the type name wrapper.
### Standard `diagnose` shape (no args) for f-string dispatch.
### :returns: The resulting `Text` value.
@[readonly, override]
routine Complex.diagnose() -> Text
  return me.diagnose_with_places(decimal_places: 10_s32)

### Returns a diagnostic string with the requested precision.
### :param decimal_places: The number of decimal places to render.
### :returns: The resulting `Text` value.
@readonly
routine Complex.diagnose_with_places(decimal_places: S32) -> Text
  return "Complex(" + me.represent_with_places(decimal_places: decimal_places) + ")"
