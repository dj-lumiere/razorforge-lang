module Numerics

### Arbitrary-precision binary floating-point real, backed by the libbf runtime.
###
### `Real` is a value record that mirrors {Integer}: it carries an atomically
### refcounted libbf handle. Copying bumps the underlying refcount (no number data
### is copied); the last drop frees the handle. Addition, subtraction and
### multiplication are EXACT (the precision grows as needed); division, `sqrt` and
### the transcendentals round to a generous default working precision under
### round-to-nearest-ties-to-even.
### :see: {Integer}, {Decimal}
record Real obeys Assignable, Copyable, Equatable, Comparable, Negatable, Addable, Subtractable, Multiplicable, Divisible, Exponentiable, Hashable
  ### The native libbf handle managed by the runtime.
  secret handle: CPtr
  ### Atomic strong-count cell (or null) governing the shared handle lifetime.
  secret ctrl: Hijacked[FrozenController]

# ============================================================================
# Construction
# ============================================================================

### Constructs the real value zero.
### :returns: The resulting `Real` value.
routine Real() -> Real
  return Real(handle: rf_real_new(), ctrl: FrozenController().hijack())

### Constructs a `Real` from a signed 64-bit integer (exact).
### :param value: The initial signed value.
### :returns: The resulting `Real` value.
routine Real(value: S64) -> Real
  var r = Real(handle: rf_real_new(), ctrl: FrozenController().hijack())
  rf_real_set_i64(handle: r.handle, value: value)
  return r

### Constructs a `Real` from an F64 (exact — the double is widened, not re-rounded).
### :param value: The initial double value.
### :returns: The resulting `Real` value.
routine Real(value: F64) -> Real
  var r = Real(handle: rf_real_new(), ctrl: FrozenController().hijack())
  rf_real_set_f64(handle: r.handle, value: value)
  return r

### Returns the real value zero.
### :returns: The resulting `Real` value.
common routine Real.zero() -> Real
  return Real()

### Returns the real value one.
### :returns: The resulting `Real` value.
common routine Real.one() -> Real
  return Real(value: 1_s64)

### Constructs a `Real` from a decimal string.
### :param text: The textual real representation.
### :param radix: The numeric base to use.
### :returns: The resulting `Real` value.
### :throws: {ValueError} if `text` is not a valid real in `radix`.
routine Real!(text: Text, radix: S32 = 10) -> Real
  var r = Real(handle: rf_real_new(), ctrl: FrozenController().hijack())
  var status = rf_real_set_str(handle: r.handle, str: text.to_cstr(), radix: radix)
  if status != 0_s32
    throw InvalidValueError(input: text, target: "Real")
  return r

### Materializes a `Real` from a tokenizer-validated decimal string (literal lowering).
### :param text: The decimal string (no suffix, no separators).
### :returns: The resulting `Real` value.
common routine Real.from_literal(text: Text) -> Real
  var r = Real(handle: rf_real_new(), ctrl: FrozenController().hijack())
  discard rf_real_set_str(handle: r.handle, str: text.to_cstr(), radix: 10_s32)
  return r

# ============================================================================
# Lifetime (atomic refcount over the shared handle)
# ============================================================================

### Returns a copy with the underlying refcount bumped; the handle is shared.
### :returns: The resulting `Real` value.
@[readonly, inline]
routine Real.assign() -> Real
  danger
    if not me.ctrl.is_none()
      me.ctrl.as_entity().hold()
  return Real(handle: me.handle, ctrl: me.ctrl)

### Releases this reference; frees the handle when this was the last live ref.
@override
dangerous routine Real.destroy()
  if me.ctrl.is_none()
    return
  var prev = me.ctrl.as_entity().unhold()
  if prev <= 1_u64
    rf_real_clear(handle: me.handle)
    me.ctrl.invalidate()
  return

# ============================================================================
# Arithmetic (+, -, * exact; / rounded to the working precision)
# ============================================================================

### Adds `other` to this value (exact).
### :param you: The value to add.
### :returns: The resulting `Real` value.
@readonly
routine Real.add(you: Real) -> Real
  var result = Real(handle: rf_real_new(), ctrl: FrozenController().hijack())
  rf_real_add(result: result.handle, a: me.handle, b: you.handle)
  return result

### Subtracts `other` from this value (exact).
### :param you: The value to subtract.
### :returns: The resulting `Real` value.
@readonly
routine Real.sub(you: Real) -> Real
  var result = Real(handle: rf_real_new(), ctrl: FrozenController().hijack())
  rf_real_sub(result: result.handle, a: me.handle, b: you.handle)
  return result

### Multiplies this value by `other` (exact).
### :param you: The value to multiply by.
### :returns: The resulting `Real` value.
@readonly
routine Real.mul(you: Real) -> Real
  var result = Real(handle: rf_real_new(), ctrl: FrozenController().hijack())
  rf_real_mul(result: result.handle, a: me.handle, b: you.handle)
  return result

### Divides this value by `other`, rounded to the working precision.
### :param you: The divisor.
### :returns: The resulting `Real` value.
@readonly
routine Real.truediv(you: Real) -> Real
  var result = Real(handle: rf_real_new(), ctrl: FrozenController().hijack())
  rf_real_div(result: result.handle, a: me.handle, b: you.handle)
  return result

### Returns the additive inverse of this value.
### :returns: The resulting `Real` value.
@readonly
routine Real.neg() -> Real
  var result = Real(handle: rf_real_new(), ctrl: FrozenController().hijack())
  rf_real_neg(result: result.handle, a: me.handle)
  return result

### Returns `true` when this value is strictly less than zero.
### :returns: The resulting `Bool` value.
@readonly
routine Real.is_negative() -> Bool
  return rf_real_cmp(a: me.handle, b: Real().handle) < 0_s32

### Returns `true` when this value is exactly zero.
### :returns: The resulting `Bool` value.
@readonly
routine Real.is_zero() -> Bool
  return rf_real_cmp(a: me.handle, b: Real().handle) == 0_s32

### Returns the absolute value of this real number.
### :returns: The resulting `Real` value.
@readonly
routine Real.abs() -> Real
  if me.is_negative()
    return me.neg()
  return me.assign()

# ============================================================================
# Comparison
# ============================================================================

### Returns `true` when both values represent the same real number.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
@readonly
routine Real.eq(you: Real) -> Bool
  return rf_real_cmp(a: me.handle, b: you.handle) == 0_s32

### Compares this value with `you` under numeric ordering.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
@readonly
routine Real.cmp(you: Real) -> ComparisonSign
  var c = rf_real_cmp(a: me.handle, b: you.handle)
  if c < 0_s32
    return ME_SMALL
  elseif c > 0_s32
    return ME_LARGE
  return SAME

