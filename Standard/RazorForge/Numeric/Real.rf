# --- Precision-aware variants (precision = decimal significant digits) ---

### Divides this value by `other`, rounding to `precision` decimal digits.
@readonly
routine Real.divide(you: Real, precision: S32) -> Real
  var result = Real(handle: rf_real_new(), ctrl: FrozenController().hijack())
  rf_real_div_p(result: result.handle, a: me.handle, b: you.handle, prec: precision)
  return result

