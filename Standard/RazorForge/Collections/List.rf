module Core

import BuilderQuery

### A growable, contiguous sequence of elements with amortized O(1) append.
###
### `List[T]` stores elements in a single resizable heap buffer. Random access
### by index is O(1). Appending to the back is O(1) amortized because the buffer grows
### geometrically when capacity runs out (see `next_grow_capacity`: it doubles while small,
### then grows by 1.5x once large to bound memory waste). Inserting or removing near the
### front is O(n) due to element shifting.
###
### **When to use**
### - You need fast indexed access (`list[i]`).
### - You mainly add elements to the back.
### - You need to sort or reverse a sequence in place.
### - Use {CircularList[T]} instead when you frequently add or remove from both ends.
### - Use {SortedList[T]} instead when elements must stay in sorted order.
###
### **Complexity**
### | Operation | Time |
### |---|---|
### | `add_last` | O(1) amortized |
### | `remove_last!` | O(1) |
### | `add_first` / `add_at!` | O(n) |
### | `remove_first!` / `remove_at!` | O(n) |
### | `getitem!` / `setitem!` | O(1) |
### | `contains` | O(n) |
### | `sort` | O(n log n) |
### | `reverse` | O(n) |
### | Iteration | O(n) |
###
### :typeparam T: The element type stored in the list.
### :see: {CircularList[T]} for efficient double-ended insertion and removal.
### :see: {SortedList[T]} for a list that maintains ascending order automatically.
entity List[AnyType T] obeys Iterable[T], MutableIndexable[T], Sized, Container, Equatable, Copyable onlyif T obeys Copyable, ListLiteral[T]
relates ListEmittable[T] as Iter
  ### Stores the backing buffer.
  secret data: Hijacked[T]
  ### Stores the number of initialized elements.
  secret count: U64
  ### Stores the total number of elements that fit without reallocating.
  secret capacity: U64

# Creators

routine List[T]() -> List[T]
  return List[T](
    data: hijacked_none[T](),
    count: 0u64,
    capacity: 0u64
  )

### Creates an empty list with storage reserved for at least `capacity` elements.
### No elements are initialized, but the backing allocation is made immediately to
### avoid the first few growth steps.
### :param capacity: The initial capacity to reserve.
routine List[T](capacity: U64) -> List[T]
  var byte_size = T.data_size() * capacity
  danger
    var ptr = rf_allocate_dynamic_uninit(byte_size)
    return List[T](
      data: hijacked_from[T](ptr),
      count: 0u64,
      capacity: capacity
    )

### Creates a list of `count` copies of `fill_value`. The backing buffer is sized
### exactly to `count` and every slot is initialized with an independent copy of
### `fill_value`. Equivalent to {List[T].create()} when `count == 0`.
### :param count: The number of elements to produce.
### :param fill_value: The value to copy into each slot.
### :returns: A list containing `count` copies of `fill_value`.
routine List[T](count: U64, fill_value: T) -> List[T]
needs T obeys Copyable
  if count == 0u64
    return List[T]()

  var byte_size = T.data_size() * count
  var t_size = T.data_size()
  danger
    var ptr = rf_allocate_dynamic_uninit(byte_size)
    var data = hijacked_from[T](ptr)
    var i = 0u64
    while i < count
      data.offset(t_size *% i).poke(fill_value)
      i = i +% 1u64
    return List[T](
      data: data,
      count: count,
      capacity: count
    )

### Builds a list containing exactly the given `elements`, in order. This static routine is the mechanism
### behind the `[a, b, c]` list-literal syntax (the `ListLiteral` opt-in): the compiler lowers a list
### literal to `List[T].from_literal(...)`, packing the elements into a fixed `Array[T, K]` and
### monomorphizing one body per element count `K`. A distinct name (not the `List(...)` constructor) so it
### never collides with the fixed-arity constructors (`List(capacity)` etc.).
### :param elements: The elements to populate the list with, in order.
### :returns: A list of the given elements.
common routine List[T].from_literal(elements...: T) -> List[T]
  var result = List[T]()
  var i = 0u64
  while i < elements.count()
    result.add_last(elements[i])
    i = i +% 1u64
  return result

# Core operations

### Returns the number of elements currently stored in the list.
### :returns: The live element count.
@readonly
routine List[T].count() -> U64
  return me.count

### Returns the number of elements that fit in the current allocation without reallocating.
### :returns: The current backing-buffer slot count.
@readonly
routine List[T].capacity() -> U64
  return me.capacity

### Returns true if the list contains no elements.
### :returns: `true` when `count()` is zero.
@readonly
routine List[T].is_empty() -> Bool
  return me.count == 0u64

### Appends `value` at the back of the list.
### The buffer grows automatically when the current capacity is exhausted, following the
### shared `next_grow_capacity` policy (double while small, 1.5x once large).
### :param value: The value to append.
@reshaping
routine List[T].add_last(value: T)
  if me.count >= me.capacity
    me.reserve(next_grow_capacity(current: me.capacity, min_needed: me.count +% 1u64, element_size: T.data_size().byte_size()))

  var byte_offset = T.data_size() * me.count
  danger
    me.data.offset(byte_offset).poke(value)
  me.count = me.count +% 1u64
  return

### Appends every element of `other` to the back of this list, in order.
### Reserves capacity once up front when the source has a known size, avoiding the
### per-element growth that a naive `for x in other; me.add_last(value: x)` loop
### incurs. Equivalent to `extend` in Python or `addAll` in Java/Kotlin.
###
### :param you: The sequence to append. Any `Iterable[T]` is accepted; pass a
###               `List[T]`, `Bytes` (for `List[Byte]`), a generator, an IterTools
###               chain, etc.
### :note: Common fast-output idiom: accumulate digit bytes into a `List[Byte]`
###        via `buf.add_range(you: x.to_digit_bytes())`, then flush once.
### :see: {List[T].add_last}, {T.to_digit_bytes}
###
### NOTE: Stub signature — implementation pending. Tracking:
###       memory/bytes_io_api_plan.md (v0.1.0 first additions).
@reshaping
routine List[T].add_range(you: Accessing[Iterable[T]])
  # TODO(fast-io): hoist capacity-reserve when `you` exposes a known count.
  # For now, fall back to per-element append so the routine type-checks while the
  # optimized path is being designed.
  each value in you
    me.add_last(value: value)
  return

### Removes and returns the last element, reducing the count by one.
### Capacity is not reduced.
### :returns: The element that was at the back.
### :absent: The list is empty.
@reshaping
routine List[T].remove_last!() -> T
  if me.is_empty()
    absent

  me.count = me.count - 1u64
  var byte_offset = T.data_size() * me.count
  danger
    return me.data.offset(byte_offset).peek()

### Inserts `value` at the front of the list.
### All existing elements are shifted one position toward the back. This is O(n).
### :param value: The value to insert.
@reshaping
routine List[T].add_first(value: T)
  me.add_at(index: 0u64, value: value)
  return

### Inserts `value` at `index`, shifting later elements right by one position.
### Use `add_last` for back insertion to avoid the O(n) shift cost.
### :param index: The zero-based insertion position.
### :param value: The value to insert.
### :throws: {IndexOutOfBoundsError} if `index` is greater than `count()`.
@reshaping
routine List[T].add_at!(index: U64, value: T)
  if index > me.count
    throw IndexOutOfBoundsError(index: index.U64(), count: me.count.U64())

  if me.count >= me.capacity
    me.reserve(next_grow_capacity(current: me.capacity, min_needed: me.count +% 1u64, element_size: T.data_size().byte_size()))

  # Shift elements right via memmove
  if index < me.count
    danger
      var elem_size = T.data_size()
      var src_ptr:Hijacked[T] = me.data.offset(elem_size * index)
      var dst_ptr:Hijacked[T] = me.data.offset(elem_size * (index + 1u64))
      rf_copy_bytes_at(dest: dst_ptr.get_address(), src: src_ptr.get_address(), size: elem_size * (me.count - index))

  danger
    me.data.offset(T.data_size() * index).poke(value)
  me.count = me.count + 1u64
  return

### Removes and returns the first element, shifting the remaining elements left by one position.
### :returns: The element that was at the front.
### :absent: The list is empty.
@reshaping
routine List[T].remove_first!() -> T
  if me.is_empty()
    absent
  return me.remove_at(0u64)

### Removes and returns the element at `index`, shifting later elements left by one position.
### :param index: The zero-based position to remove.
### :returns: The element that was at `index`.
### :throws: {IndexOutOfBoundsError} if `index` is out of range.
@reshaping
routine List[T].remove_at!(index: U64) -> T
  if index >= me.count
    throw IndexOutOfBoundsError(index: index.U64(), count: me.count.U64())

  var byte_offset = T.data_size() * index
  danger
    var value = me.data.offset(byte_offset).peek()

    # Shift elements left via memmove
    if index < me.count - 1u64
      var elem_size = T.data_size()
      var src_ptr = me.data.offset(elem_size * (index + 1u64))
      var dst_ptr = me.data.offset(elem_size * index)
      rf_copy_bytes_at(dest: dst_ptr.get_address(), src: src_ptr.get_address(), size: elem_size * (me.count - 1u64 - index))

    me.count = me.count - 1u64
    return value

### Returns the first element without removing it.
### :returns: The current first element.
### :absent: The list is empty.
@readonly
routine List[T].first!() -> T
  if me.is_empty()
    absent
  danger
    return me.data.peek()

### Returns the last element without removing it.
### :returns: The current last element.
### :absent: The list is empty.
@readonly
routine List[T].last!() -> T
  if me.is_empty()
    absent
  var byte_offset = T.data_size() * (me.count - 1u64)
  danger
    return me.data.offset(byte_offset).peek()

# ============================================================================
# Indexing with Integral (forward index)
# ============================================================================

### Returns the element at `index`.
### :param index: The zero-based position to read.
### :returns: The element at that position.
### :throws: {IndexOutOfBoundsError} if `index >= count()`.
@readonly
routine List[T].getitem!(index: U64) -> T
  if index >= me.count
    throw IndexOutOfBoundsError(index: index, count: me.count)
  var byte_offset = T.data_size() * index
  danger
    return me.data.offset(byte_offset).peek()

### Replaces the element at `index` with `value`.
### :param index: The zero-based position to update.
### :param value: The replacement value.
### :throws: {IndexOutOfBoundsError} if `index >= count()`.
routine List[T].setitem!(index: U64, value: T)
  if index >= me.count
    throw IndexOutOfBoundsError(index: index, count: me.count)
  var byte_offset = T.data_size() * index
  danger
    me.data.offset(byte_offset).poke(value)
  return

### Returns a NEW list holding independent copies of the elements in `range` — the slice form of
### indexing (`list[a til b]`). A half-open `a til b` yields `[a, b)`; an inclusive `a to b` yields
### `[a, b]`; a descending range reverses the segment. Positions at or past `count` are skipped, so
### `list[a til ^0]` slices cleanly to the end. Each element is copied through `copy` (managed leaves
### like `Text` bump their refcount), so the result shares no structure with the original and mutating
### one does not affect the other — the value-semantics counterpart to `Text`/`Bytes` slicing.
### :param range: The index range to extract.
### :returns: A new `List[T]` owning copies of the selected elements.
@readonly
routine List[T].getitem(range: Range[U64]) -> List[T]
needs T obeys Copyable
  var result = List[T]()
  each i in range
    if i < me.count
      result.add_last(value: me.get_raw(index: i).duplicate())
  return steal result

# ============================================================================
# Unchecked internal access — no bounds check, for stdlib use only
# ============================================================================

### Returns the element at `index` without bounds checking.
### Only call this when the index is already proven to be in range.
@readonly
@inline
routine List[T].get_raw(index: U64) -> T
  danger
    return me.data.offset(T.data_size() * index).peek()

### Writes `value` at `index` without bounds checking.
### Only call this when the index is already proven to be in range.
@inline
routine List[T].set_raw(index: U64, value: T)
  danger
    me.data.offset(T.data_size() * index).poke(value)
  return

### Ensures the backing allocation holds at least `new_capacity` elements.
### Does nothing if the current capacity already meets or exceeds `new_capacity`.
### :param new_capacity: The minimum slot count to guarantee.
@reshaping
routine List[T].reserve(new_capacity: U64)
  if new_capacity > me.capacity
    var new_byte_size = T.data_size() * new_capacity

    danger
      if me.data.is_none()
        var ptr = rf_allocate_dynamic_uninit(new_byte_size)
        me.data = hijacked_from[T](ptr)
      else
        var ptr = rf_reallocate_dynamic(ptr: LLVM::pointer_to_int[T, Address](me.data), size: new_byte_size)
        me.data = hijacked_from[T](ptr)

    me.capacity = new_capacity
  return

### Discards all elements while preserving the current allocation.
### Use this to reuse a list without paying reallocation costs.
@reshaping
routine List[T].clear()
  me.count = 0u64
  return

# ============================================================================
# Iterable protocol support
# ============================================================================

### Walks the elements of a `List[T]` from front to back.
### The iterator captures a raw pointer and element count at creation so it does
### not hold a live reference to the list; mutations during iteration are unsafe.
### :typeparam T: The element type produced by the iterator.
entity ListEmittable[AnyType T] obeys Emittable[T]
  ### Stores a pointer into the source list buffer.
  secret data: Hijacked[T]
  ### Stores the element count captured at iterator creation.
  secret count: U64
  ### Stores the current iteration position.
  secret index: U64

@readonly
routine List[T].iter() -> ListEmittable[T]
  danger
    return ListEmittable[T](data: me.data, count: me.count(), index: 0u64)

routine ListEmittable[T].emit!() -> T
  if me.index >= me.count
    absent
  danger
    var _result = me.data.offset(T.data_size() * me.index).peek()
    me.index = me.index + 1u64
    return _result

### Returns true if both lists contain the same elements in the same order.
### :param you: The other list to compare against.
### :returns: `true` if both have equal count and all corresponding elements are equal.
@readonly
routine List[T].eq(you: Accessing[List[T]]) -> Bool
needs T obeys Equatable
  if me.count() != you.count()
    return false
  var i = 0u64
  while i < me.count()
    if me[i] != you[i]
      return false
    i = i +% 1u64
  return true

### Returns true if any element in the list equals `value`.
### Uses the element type's equality operator and scans from front to back.
### :param value: The value to search for.
### :returns: `true` if `value` is found; `false` if no element matches.
@readonly
routine List[T].contains(value: Accessing[T]) -> Bool
needs T obeys Equatable
  var i = 0u64
  while i < me.count()
    if me[i] == value
      return true
    i = i +% 1u64
  return false

@[readonly, override]
routine List[T].represent() -> Text
  var result = "["
  var i = 0u64
  each v in me
    if i > 0u64
      result = result + ", "
    result = result + nested_repr(v)
    i = i +% 1u64
  result = result + "]"
  return result

@[readonly, override]
routine List[T].diagnose() -> Text
  var result = me.full_type_name() + "(count: " + me.count().represent() + ", ["
  var i = 0u64
  each v in me
    if i > 0u64
      result = result + ", "
    result = result + nested_repr(v)
    i = i +% 1u64
  result = result + "])"
  return result

### Appends `count` elements from `source` beginning at `from` into this list.
### Elements are copied as a single contiguous range using a memcopy.
### :param source: The source list to copy from.
### :param from: The zero-based start index within `source`.
### :param count: The number of elements to copy.
### :throws: {IndexOutOfBoundsError} if `from + count` exceeds `source.count()`.
@reshaping
routine List[T].add_range!(source: Accessing[List[T]], from: U64, count: U64)
needs T obeys Copyable
  if count == 0u64
    return
  if from + count > source.count()
    throw IndexOutOfBoundsError(index: from + count, count: source.count())

  var new_count = me.count + count
  if new_count > me.capacity
    me.reserve(next_grow_capacity(current: me.capacity, min_needed: new_count, element_size: T.data_size().byte_size()))

  # Clone each element through the read-only borrow. `clone` is elided for trivially-copyable T
  # (no symbol) and delegates to the retain-aware `store` for RC records like Text, so appended
  # elements are owned independently. The prior bitwise copy aliased buffer pointers (double-free).
  var i = 0u64
  while i < count
    me.add_last(value: source[from + i].duplicate())
    i = i + 1u64
  return

### Returns a deep, independent copy of this list. Each element is copied through `copy`,
### so the result shares no heap storage with the original (managed leaves like `Text` bump
### their refcount; aggregate elements are duplicated recursively). This is the deep-copy point
### the compiler inserts when a `List[T]` is an owned arm of a value being copied.
### :returns: A new `List[T]` owning independent copies of every element.
routine List[T].duplicate() -> List[T]
needs T obeys Copyable
  var result = List[T](capacity: me.count)
  var i = 0u64
  while i < me.count
    result.add_last(value: me[i].duplicate())
    i = i +% 1u64
  return steal result

### Serializes this list to a `SerialValue.List`, serializing each element in order. Overrides the
### default field-walk so a `List[T]` renders as a sequence of serialized elements, not its internal
### buffer/count layout.
### :returns: The `SerialValue.List` holding each element's serialized form.
@[readonly, override]
routine List[T].serialize() -> SerialValue
  var result = List[SerialValue]()
  var i = 0u64
  while i < me.count
    result.add_last(value: me[i].serialize())
    i = i +% 1u64
  return SerialValue(steal result)

### Shortens the list to `new_count` elements by discarding elements past the new boundary.
### The backing allocation is not changed.
### :param new_count: The new element count; must be no greater than `count()`.
### :throws: {IndexOutOfBoundsError} if `new_count > count()`.
@reshaping
routine List[T].truncate!(new_count: U64)
  if new_count > me.count
    throw IndexOutOfBoundsError(index: new_count, count: me.count)
  me.count = new_count
  return

# ============================================================================
# Sorting — iterative merge sort with insertion sort for small runs
# ============================================================================

### The maximum run length sorted with insertion sort before the merge phase begins.
secret preset SORT_MIN_RUN: U64 = 32u64

### Sorts the list in ascending order in place using the element's natural `<` ordering.
### Uses a stable, iterative bottom-up merge sort with insertion sort for small runs.
### Equal elements preserve their relative order.
routine List[T].sort()
needs T obeys Comparable
  if me.count <= 1u64
    return

  # Insertion sort small lists directly
  if me.count <= SORT_MIN_RUN
    me.insertion_sort(start: 0u64, end: me.count)
    return

  # Phase 1: insertion sort each chunk of SORT_MIN_RUN
  var i = 0u64
  loop
    if i >= me.count
      break
    var end = i + SORT_MIN_RUN
    if end > me.count
      end = me.count
    me.insertion_sort(start: i, end: end)
    i = i + SORT_MIN_RUN

  # Phase 2: iterative bottom-up merge, doubling width each pass
  var buffer = List[T](capacity: me.count)
  buffer.count = me.count

  var width = SORT_MIN_RUN
  loop
    if width >= me.count
      break

    var left = 0u64
    loop
      if left >= me.count
        break

      var mid = left + width
      if mid > me.count
        mid = me.count
      var right = left + width *% 2u64
      if right > me.count
        right = me.count

      if mid < right
        me.merge_into(left: left, mid: mid, right: right, buffer: buffer)

      left = left + width *% 2u64

    width = width *% 2u64
  return

### Sorts the list in place using a caller-supplied comparator.
### The comparator must return `true` when `a` should appear before `b`.
### Uses the same stable, iterative merge sort as `sort()`.
### :param compare: A two-argument routine that returns `true` when its first argument precedes its second.
routine List[T].sort_by(compare: Routine[(T, T), Bool])
  if me.count <= 1u64
    return

  if me.count <= SORT_MIN_RUN
    me.insertion_sort_by(start: 0u64, end: me.count, compare: compare)
    return

  var i = 0u64
  loop
    if i >= me.count
      break
    var end = i + SORT_MIN_RUN
    if end > me.count
      end = me.count
    me.insertion_sort_by(start: i, end: end, compare: compare)
    i = i + SORT_MIN_RUN

  var buffer = List[T](capacity: me.count)
  buffer.count = me.count

  var width = SORT_MIN_RUN
  loop
    if width >= me.count
      break

    var left = 0u64
    loop
      if left >= me.count
        break

      var mid = left + width
      if mid > me.count
        mid = me.count
      var right = left + width *% 2u64
      if right > me.count
        right = me.count

      if mid < right
        me.merge_into_by(left: left, mid: mid, right: right, buffer: buffer, compare: compare)

      left = left + width *% 2u64

    width = width *% 2u64
  return

### Returns a new list with the same elements sorted in ascending order.
### The original list is left unchanged.
### :returns: A new `List[T]` whose elements are in ascending order.
@readonly
routine List[T].sorted() -> List[T]
needs T obeys Comparable
  var copy = List[T](capacity: me.count)
  copy.add_range(source: me, from: 0u64, count: me.count)
  copy.sort()
  return steal copy

### Returns a new list with the same elements sorted using `compare`.
### The original list is left unchanged.
### :param compare: A two-argument routine that returns `true` when its first argument precedes its second.
### :returns: A new `List[T]` whose elements are ordered according to `compare`.
@readonly
routine List[T].sorted_by(compare: Routine[(T, T), Bool]) -> List[T]
  var copy = List[T](capacity: me.count)
  copy.add_range(source: me, from: 0u64, count: me.count)
  copy.sort_by(compare)
  return steal copy

### Reverses the order of all elements in place.
### The first element becomes last, the last becomes first, and element count is unchanged.
routine List[T].reverse_in_place()
  if me.count <= 1u64
    return

  var lo = 0u64
  var hi = me.count - 1u64
  loop
    if lo >= hi
      break
    var temp = me.get_raw(lo)
    me.set_raw(index: lo, value: me.get_raw(hi))
    me.set_raw(index: hi, value: temp)
    lo = lo + 1u64
    hi = hi - 1u64
  return

# ============================================================================
# Sorting — internal helpers (secret)
# ============================================================================

### Sorts the sub-range [start, end) in place using insertion sort.
### Used by `sort` and `sort_by` for small runs where merge sort has too much overhead.
### :param start: The inclusive starting index of the range.
### :param end: The exclusive ending index of the range.
routine List[T].insertion_sort(start: U64, end: U64)
needs T obeys Comparable
  var i = start + 1u64
  loop
    if i >= end
      break
    var key = me.get_raw(i)
    var j = i
    loop
      if j <= start
        break
      var prev = me.get_raw(j - 1u64)
      if not (key < prev)
        break
      me.set_raw(index: j, value: prev)
      j = j - 1u64
    me.set_raw(index: j, value: key)
    i = i + 1u64
  return

### Sorts the sub-range [start, end) in place using insertion sort with a custom comparator.
### :param start: The inclusive starting index of the range.
### :param end: The exclusive ending index of the range.
### :param compare: A routine that returns `true` when its first argument should precede its second.
routine List[T].insertion_sort_by(start: U64, end: U64, compare: Routine[(T, T), Bool])
  var i = start + 1u64
  loop
    if i >= end
      break
    var key = me.get_raw(i)
    var j = i
    loop
      if j <= start
        break
      var prev = me.get_raw(j - 1u64)
      if not compare(key, prev)
        break
      me.set_raw(index: j, value: prev)
      j = j - 1u64
    me.set_raw(index: j, value: key)
    i = i + 1u64
  return

### Merges two adjacent sorted runs `[left, mid)` and `[mid, right)` in place.
### Uses `buffer` as scratch space; `buffer` must be at least `count()` elements long.
### This merge is stable: equal elements from the left run always precede those from the right.
### :param left: Start index of the first sorted run.
### :param mid: Start index of the second sorted run (and exclusive end of the first).
### :param right: Exclusive end index of the second sorted run.
### :param buffer: A pre-allocated list used as temporary storage during the merge.
routine List[T].merge_into(left: U64, mid: U64, right: U64, buffer: Controlling[List[T]])
needs T obeys Comparable
  # Copy [left, right) into the buffer
  var i = left
  loop
    if i >= right
      break
    buffer.set_raw(index: i, value: me.get_raw(i))
    i = i + 1u64

  var a = left
  var b = mid
  var out = left

  loop
    if a >= mid or b >= right
      break
    var va = buffer.get_raw(a)
    var vb = buffer.get_raw(b)
    if vb < va
      me.set_raw(index: out, value: vb)
      b = b + 1u64
    else
      me.set_raw(index: out, value: va)
      a = a + 1u64
    out = out + 1u64

  # Copy remaining elements from left run
  loop
    if a >= mid
      break
    me.set_raw(index: out, value: buffer.get_raw(a))
    a = a + 1u64
    out = out + 1u64

  # Copy remaining elements from right run
  loop
    if b >= right
      break
    me.set_raw(index: out, value: buffer.get_raw(b))
    b = b + 1u64
    out = out + 1u64
  return

### Merges two adjacent sorted runs `[left, mid)` and `[mid, right)` using a custom comparator.
### Uses `buffer` as scratch space. Stable: equal elements from the left run are output first.
### :param left: Start index of the first sorted run.
### :param mid: Start index of the second sorted run (and exclusive end of the first).
### :param right: Exclusive end index of the second sorted run.
### :param buffer: A pre-allocated list used as temporary storage during the merge.
### :param compare: A routine that returns `true` when its first argument should precede its second.
routine List[T].merge_into_by(left: U64, mid: U64, right: U64, buffer: Controlling[List[T]], compare: Routine[(T, T), Bool])
  var i = left
  loop
    if i >= right
      break
    buffer.set_raw(index: i, value: me.get_raw(i))
    i = i + 1u64

  var a = left
  var b = mid
  var out = left

  loop
    if a >= mid or b >= right
      break
    var va = buffer.get_raw(a)
    var vb = buffer.get_raw(b)
    if compare(vb, va)
      me.set_raw(index: out, value: vb)
      b = b + 1u64
    else
      me.set_raw(index: out, value: va)
      a = a + 1u64
    out = out + 1u64

  loop
    if a >= mid
      break
    me.set_raw(index: out, value: buffer.get_raw(a))
    a = a + 1u64
    out = out + 1u64

  loop
    if b >= right
      break
    me.set_raw(index: out, value: buffer.get_raw(b))
    b = b + 1u64
    out = out + 1u64
  return

### Destroys each live element (no-op for value-typed `T`), then frees the backing buffer.
@override
dangerous routine List[T].destroy()
  var elem_size = T.data_size()
  each i in 0 til me.count()
    me.data.offset(elem_size * i).peek().destroy()
  me.data.invalidate()
  me.hijack().invalidate()
  return

### Cycle-collector TRACE: report every live element to the collector (a `Roamed` element reports its
### controller, a value element is a no-op) via the backing buffer. Overrides the universal member-walk —
### a raw `Hijacked` buffer cannot self-trace (it does not know its own length), so the list supplies it.
@override
dangerous routine List[T].roam_trace()
  me.data.cyclic_trace_buffer(count: me.count)
  return

### Cycle-collector FREE: free the backing buffer and this list's own box, but do NOT tear down the
### elements — the collector frees the whole white cycle directly, so destroying a `Roamed` element here
### would double-free a sibling reaped in the same batch. (Contrast `destroy`, which DOES destroy each
### element for a normal, non-cycle teardown.)
@override
dangerous routine List[T].roam_free()
  me.data.invalidate()
  me.hijack().invalidate()
  return
