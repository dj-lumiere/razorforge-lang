module Core

import BuilderQuery
import Core.SecureHashKey

secret preset DICT_INITIAL_CAPACITY: U64 = 16u64
secret preset DICT_INITIAL_ENTRIES: U64 = 16u64
secret preset CTRL_EMPTY: U8 = 128_u8
secret preset CTRL_TOMBSTONED: U8 = 254_u8
secret preset CTRL_H2_MASK: U8 = 127_u8
secret preset ENTRY_DEAD: U8 = 0_u8
secret preset ENTRY_LIVE: U8 = 1_u8

### A hash-flooding-resistant insertion-ordered key-value dictionary.
###
### `Dict[K, V]` works like {Dict[K, V]} (insertion-ordered iteration, O(1) average
### operations) but uses SipHash-2-4 keyed with a per-instance secret to make the probe
### sequence unpredictable to external attackers. Iteration order follows insertion order;
### the secure key only affects the probe-array layout, not the entries array.
###
### **When to use**
### - You are storing data derived from untrusted input (e.g. HTTP headers, user IDs, file names).
### - You need the same insert/lookup/remove interface as {Dict[K, V]} with a security guarantee.
###
### **Complexity**
### | Operation | Average | Worst case |
### |---|---|---|
### | `add` | O(1) | O(n) (rehash) |
### | `remove` | O(1) | O(n) |
### | `contains` / `get_or_default` | O(1) | O(n) |
### | Iteration | O(n + tombstones) | O(n + tombstones) |
###
### :typeparam K: The key type. Must obey {Hashable} and {Equatable}.
### :typeparam V: The value type associated with each key.
### :see: {Set[T]} for the set counterpart.
entity Dict[K, V] obeys Iterable[DictEntry[K, V]], KeyFindable, Container, Copyable onlyif (K obeys Copyable, V obeys Copyable), DictLiteral[K, V]
needs K obeys Hashable, Equatable
relates DictEmittable[K, V] as Iter
relates K as Key
relates V as Value
  secret ctrl: Hijacked[U8]
  secret indices: Hijacked[U64]
  secret keys: Hijacked[K]
  secret vals: Hijacked[V]
  secret entry_live: Hijacked[U8]
  secret count: U64
  secret deleted: U64
  secret entries_used: U64
  secret capacity: U64
  secret entries_cap: U64
  secret k0: U64
  secret k1: U64

# ============================================================================
# Creators
# ============================================================================

### Creates a dict containing the given key-value `pairs`. Variadic constructor behind the `{k: v, …}`
### dict-literal syntax (the `DictLiteral` opt-in): the compiler packs the pairs into a fixed
### `Array[DictEntry[K, V], N]` and monomorphizes one body per pair count. A later duplicate key overwrites.
### :param pairs: The key-value pairs as `DictEntry[K, V]` values.
### :returns: A dict of the given pairs.
common routine Dict[K, V].from_literal(pairs...: DictEntry[K, V]) -> Dict[K, V]
needs K obeys Hashable, Equatable
  var result = Dict[K, V]()
  var i = 0u64
  while i < pairs.count()
    discard result.add(key: pairs[i].key, value: pairs[i].value)
    i = i +% 1u64
  return result

routine Dict[K, V]() -> Dict[K, V]
  return Dict[K, V](key: SecureHashKey.random())

routine Dict[K, V](key: SecureHashKey) -> Dict[K, V]
  var cap = DICT_INITIAL_CAPACITY
  var ecap = DICT_INITIAL_ENTRIES
  var dict = Dict[K, V](
    ctrl: hijacked_none[U8](),
    indices: hijacked_none[U64](),
    keys: hijacked_none[K](),
    vals: hijacked_none[V](),
    entry_live: hijacked_none[U8](),
    count: 0u64,
    deleted: 0u64,
    entries_used: 0u64,
    capacity: cap,
    entries_cap: ecap,
    k0: key.k0,
    k1: key.k1
  )
  danger
    dict.ctrl = Hijacked[U8](C::rf_allocate_dynamic_uninit(cap))
    C::rf_set_bytes_at(dest: LLVM::pointer_to_int[U8, Address](dict.ctrl), value: CTRL_EMPTY, size: cap)
    dict.indices = Hijacked[U64](rf_allocate_dynamic_uninit(U64.data_size() * cap))
    dict.keys = hijacked_from[K](rf_allocate_dynamic_uninit(K.data_size() * ecap))
    dict.vals = hijacked_from[V](rf_allocate_dynamic_uninit(V.data_size() * ecap))
    dict.entry_live = Hijacked[U8](C::rf_allocate_dynamic_uninit(ecap))
  return steal dict

routine Dict[K, V](key: SecureHashKey, capacity: U64) -> Dict[K, V]
  var cap = DICT_INITIAL_CAPACITY
  while cap < capacity
    cap = cap *% 2u64
  var ecap = DICT_INITIAL_ENTRIES
  while ecap < capacity
    ecap = ecap *% 2u64
  var dict = Dict[K, V](
    ctrl: hijacked_none[U8](),
    indices: hijacked_none[U64](),
    keys: hijacked_none[K](),
    vals: hijacked_none[V](),
    entry_live: hijacked_none[U8](),
    count: 0u64,
    deleted: 0u64,
    entries_used: 0u64,
    capacity: cap,
    entries_cap: ecap,
    k0: key.k0,
    k1: key.k1
  )
  danger
    dict.ctrl = Hijacked[U8](C::rf_allocate_dynamic_uninit(cap))
    C::rf_set_bytes_at(dest: LLVM::pointer_to_int[U8, Address](dict.ctrl), value: CTRL_EMPTY, size: cap)
    dict.indices = Hijacked[U64](rf_allocate_dynamic_uninit(U64.data_size() * cap))
    dict.keys = hijacked_from[K](rf_allocate_dynamic_uninit(K.data_size() * ecap))
    dict.vals = hijacked_from[V](rf_allocate_dynamic_uninit(V.data_size() * ecap))
    dict.entry_live = Hijacked[U8](C::rf_allocate_dynamic_uninit(ecap))
  return steal dict

### Frees the heap buffers owned by this dictionary. The element/key/value contents are
### not recursed into — only the backing arrays are released.
@override
dangerous routine Dict[K, V].destroy()
  # Tear down each live key and value before freeing the buffers (mirrors the live-entry scan
  # in DictEmittable.emit!). No-op for value types; frees owned entity keys/values.
  var p = 0u64
  while p < me.entries_used
    if me.entry_live.offset(ByteSize(bytes: p)).peek() == ENTRY_LIVE
      me.keys.offset(K.data_size() * p).peek().destroy()
      me.vals.offset(V.data_size() * p).peek().destroy()
    p = p + 1u64
  me.ctrl.invalidate()
  me.indices.invalidate()
  me.keys.invalidate()
  me.vals.invalidate()
  me.entry_live.invalidate()
  me.hijack().invalidate()
  return

# ============================================================================
# Internal Helpers
# ============================================================================

@readonly
routine Dict[K, V].h2(hash: U64) -> U8
  return U8(hash & U64(CTRL_H2_MASK))

@readonly
routine Dict[K, V].h1(hash: U64) -> U64
  return hash >> 7u32

@readonly
routine Dict[K, V].read_index(slot: U64) -> U64
  danger
    return me.indices.offset(U64.data_size() * slot).peek()

@readonly
routine Dict[K, V].read_key_at(ei: U64) -> K
  danger
    return me.keys.offset(K.data_size() * ei).peek()

@readonly
routine Dict[K, V].read_val_at(ei: U64) -> V
  danger
    return me.vals.offset(V.data_size() * ei).peek()

routine Dict[K, V].write_val_at(ei: U64, val: V)
  danger
    me.vals.offset(V.data_size() * ei).poke(val)
  return

@readonly
routine Dict[K, V].find_slot(key: K) -> U64
  var h = key.hash(k0: me.k0, k1: me.k1)
  var target = me.h2(h)
  var mask = me.capacity -% 1u64
  var i = me.h1(h) & mask
  danger
    loop
      var c = me.ctrl.offset(ByteSize(bytes: i)).peek()
      if c == CTRL_EMPTY
        return me.capacity
      if c == target
        var ei = me.indices.offset(U64.data_size() * i).peek()
        if me.keys.offset(K.data_size() * ei).peek() == key
          return i
      i = (i +% 1u64) & mask
  return me.capacity

routine Dict[K, V].insert_index_raw(h: U64, entry_index: U64)
  var h2_val = me.h2(h)
  var mask = me.capacity -% 1u64
  var i = me.h1(h) & mask
  danger
    loop
      var c = me.ctrl.offset(ByteSize(bytes: i)).peek()
      if c == CTRL_EMPTY
        me.ctrl.offset(ByteSize(bytes: i)).poke(h2_val)
        me.indices.offset(U64.data_size() * i).poke(entry_index)
        return
      if c == CTRL_TOMBSTONED
        me.ctrl.offset(ByteSize(bytes: i)).poke(h2_val)
        me.indices.offset(U64.data_size() * i).poke(entry_index)
        me.deleted = me.deleted -% 1u64
        return
      i = (i +% 1u64) & mask
  return

@readonly
routine Dict[K, V].should_rehash() -> Bool
  if (me.count +% me.deleted) *% 8u64 >= me.capacity *% 7u64
    return true
  if me.entries_used >= me.entries_cap
    return true
  return false

@reshaping
routine Dict[K, V].rehash()
  var old_cap = me.capacity
  var old_ecap = me.entries_cap
  var old_ctrl = me.ctrl
  var old_indices = me.indices
  var old_keys = me.keys
  var old_vals = me.vals
  var old_entry_live = me.entry_live
  var old_entries_used = me.entries_used

  var table_pressured = (me.count +% me.deleted) *% 8u64 >= old_cap *% 7u64
  var new_cap = old_cap
  if table_pressured
    new_cap = old_cap *% 2u64

  var new_ecap = old_ecap
  if me.count *% 2u64 >= old_ecap
    new_ecap = old_ecap *% 2u64

  danger
    me.ctrl = Hijacked[U8](C::rf_allocate_dynamic_uninit(new_cap))
    C::rf_set_bytes_at(dest: LLVM::pointer_to_int[U8, Address](me.ctrl), value: CTRL_EMPTY, size: new_cap)
    me.indices = Hijacked[U64](rf_allocate_dynamic_uninit(U64.data_size() * new_cap))
    me.keys = hijacked_from[K](rf_allocate_dynamic_uninit(K.data_size() * new_ecap))
    me.vals = hijacked_from[V](rf_allocate_dynamic_uninit(V.data_size() * new_ecap))
    me.entry_live = Hijacked[U8](C::rf_allocate_dynamic_uninit(new_ecap))
  me.capacity = new_cap
  me.entries_cap = new_ecap
  me.count = 0u64
  me.deleted = 0u64
  me.entries_used = 0u64

  var i = 0u64
  while i < old_entries_used
    danger
      var live = old_entry_live.offset(ByteSize(bytes: i)).peek()
      if live == ENTRY_LIVE
        var k = old_keys.offset(K.data_size() * i).peek()
        var v = old_vals.offset(V.data_size() * i).peek()
        var new_ei = me.entries_used
        me.keys.offset(K.data_size() * new_ei).poke(k)
        me.vals.offset(V.data_size() * new_ei).poke(v)
        me.entry_live.offset(ByteSize(bytes: new_ei)).poke(ENTRY_LIVE)
        me.entries_used = me.entries_used +% 1u64
        me.insert_index_raw(h: k.hash(k0: me.k0, k1: me.k1), entry_index: new_ei)
        me.count = me.count +% 1u64
    i = i +% 1u64

  danger
    if not old_ctrl.is_none()
      C::rf_invalidate(LLVM::pointer_to_int[U8, Address](old_ctrl))
    if not old_indices.is_none()
      C::rf_invalidate(LLVM::pointer_to_int[U64, Address](old_indices))
    if not old_keys.is_none()
      C::rf_invalidate(LLVM::pointer_to_int[K, Address](old_keys))
    if not old_vals.is_none()
      C::rf_invalidate(LLVM::pointer_to_int[V, Address](old_vals))
    if not old_entry_live.is_none()
      C::rf_invalidate(LLVM::pointer_to_int[U8, Address](old_entry_live))
  return

# ============================================================================
# Core Operations
# ============================================================================

@readonly
routine Dict[K, V].count() -> U64
  return me.count

@readonly
routine Dict[K, V].is_empty() -> Bool
  return me.count == 0u64

routine Dict[K, V].clear()
  danger
    C::rf_set_bytes_at(dest: LLVM::pointer_to_int[U8, Address](me.ctrl), value: CTRL_EMPTY, size: me.capacity)
  me.count = 0u64
  me.deleted = 0u64
  me.entries_used = 0u64
  return

@readonly
routine Dict[K, V].contains(key: K) -> Bool
  return me.find_slot(key) < me.capacity

routine Dict[K, V].add(key: K, value: V) -> Bool
  if me.should_rehash()
    me.rehash()
  var slot = me.find_slot(key)
  if slot < me.capacity
    var existing_ei = me.read_index(slot)
    me.write_val_at(ei: existing_ei, val: value)
    return false
  var ei = me.entries_used
  danger
    me.keys.offset(K.data_size() * ei).poke(key)
    me.vals.offset(V.data_size() * ei).poke(value)
    me.entry_live.offset(ByteSize(bytes: ei)).poke(ENTRY_LIVE)
  me.entries_used = me.entries_used +% 1u64
  me.insert_index_raw(h: key.hash(k0: me.k0, k1: me.k1), entry_index: ei)
  me.count = me.count +% 1u64
  return true

routine Dict[K, V].remove(key: K) -> Bool
  var slot = me.find_slot(key)
  if slot >= me.capacity
    return false
  var ei = me.read_index(slot)
  danger
    me.ctrl.offset(ByteSize(bytes: slot)).poke(CTRL_TOMBSTONED)
    me.entry_live.offset(ByteSize(bytes: ei)).poke(ENTRY_DEAD)
  me.count = me.count -% 1u64
  me.deleted = me.deleted +% 1u64
  return true

@readonly
routine Dict[K, V].get_or_default(key: K, default_value: V) -> V
  var slot = me.find_slot(key)
  if slot >= me.capacity
    return default_value
  return me.read_val_at(me.read_index(slot))

# ============================================================================
# Indexing
# ============================================================================

@readonly
routine Dict[K, V].getitem!(key: Accessing[K]) -> V
  var slot = me.find_slot(key)
  if slot >= me.capacity
    absent
  return me.read_val_at(me.read_index(slot))

routine Dict[K, V].setitem!(key: Accessing[K], value: V)
  if key notin me
    absent
  var slot = me.find_slot(key)
  me.write_val_at(ei: me.read_index(slot), val: value)
  return

# ============================================================================
# Keys / Values / Entries
# ============================================================================

### Returns all live keys in insertion order.
### :returns: A {List[K]} of every key; order matches the sequence in which the keys were first added.
@readonly
routine Dict[K, V].keys() -> List[K]
  var result = List[K](me.count)
  var i = 0u64
  while i < me.entries_used
    danger
      if me.entry_live.offset(ByteSize(bytes: i)).peek() == ENTRY_LIVE
        result.add_last(me.keys.offset(K.data_size() * i).peek())
    i = i +% 1u64
  return steal result

### Returns all live values in insertion order.
### :returns: A {List[V]} of every value; order matches the corresponding `keys()` call.
@readonly
routine Dict[K, V].values() -> List[V]
  var result = List[V](me.count)
  var i = 0u64
  while i < me.entries_used
    danger
      if me.entry_live.offset(ByteSize(bytes: i)).peek() == ENTRY_LIVE
        result.add_last(me.vals.offset(V.data_size() * i).peek())
    i = i +% 1u64
  return steal result

### Returns all live entries in insertion order.
### :returns: A {List[DictEntry[K, V]]} of every key-value pair; order matches the sequence in which the keys were first added.
@readonly
routine Dict[K, V].entries() -> List[DictEntry[K, V]]
  var result = List[DictEntry[K, V]](me.count)
  var i = 0u64
  while i < me.entries_used
    danger
      if me.entry_live.offset(ByteSize(bytes: i)).peek() == ENTRY_LIVE
        var k = me.keys.offset(K.data_size() * i).peek()
        var v = me.vals.offset(V.data_size() * i).peek()
        result.add_last(DictEntry[K, V](key: k, value: v))
    i = i +% 1u64
  return steal result

# ============================================================================
# Iteration
# ============================================================================

@readonly
routine Dict[K, V].iter() -> DictEmittable[K, V]
  danger
    return DictEmittable[K, V](
      keys: me.keys,
      vals: me.vals,
      entry_live: me.entry_live,
      entries_used: me.entries_used,
      pos: 0u64
    )

### Emittable that walks the dense entries array of a {Dict[K, V]} in insertion order.
entity DictEmittable[K, V] obeys Emittable[DictEntry[K, V]]
  secret keys: Hijacked[K]
  secret vals: Hijacked[V]
  secret entry_live: Hijacked[U8]
  secret entries_used: U64
  secret pos: U64

routine DictEmittable[K, V].emit!() -> DictEntry[K, V]
  danger
    while me.pos < me.entries_used
      var p = me.pos
      me.pos = me.pos + 1u64
      if me.entry_live.offset(ByteSize(bytes: p)).peek() == ENTRY_LIVE
        var k = me.keys.offset(K.data_size() * p).peek()
        var v = me.vals.offset(V.data_size() * p).peek()
        return DictEntry[K, V](key: k, value: v)
  absent

# ============================================================================
# Copy
# ============================================================================

### Returns a deep, independent copy of this dictionary. Every key and value is copied through
### `copy`, so the result shares no heap storage with the original (managed leaves like `Text`
### bump their refcount; aggregate values are duplicated recursively). This is the deep-copy point
### the compiler inserts when a `Dict[K, V]` is an owned arm of a value being copied.
### :returns: A new `Dict[K, V]` owning independent copies of every entry.
routine Dict[K, V].duplicate() -> Dict[K, V]
needs K obeys Copyable
needs V obeys Copyable
  var result = Dict[K, V]()
  each entry in me
    discard result.add(key: entry.key.duplicate(), value: entry.value.duplicate())
  return steal result

# ============================================================================
# Display
# ============================================================================

@[readonly, override]
routine Dict[K, V].represent() -> Text
  if me.is_empty()
    return "{:}"
  var result = "{"
  var first = true
  each entry in me
    if not first
      result = result + ", "
    result = result + nested_repr(entry.key) + ": " + nested_repr(entry.value)
    first = false
  result = result + "}"
  return steal result

@[readonly, override]
routine Dict[K, V].diagnose() -> Text
  var result = me.full_type_name() + "(count: " + me.count().represent() + ", {"
  var first = true
  each entry in me
    if not first
      result = result + ", "
    result = result + nested_repr(entry.key) + ": " + nested_repr(entry.value)
    first = false
  result = result + "})"
  return steal result

# ============================================================================
# Comparison
# ============================================================================

@readonly
routine Dict[K, V].eq(you: Accessing[Dict[K, V]]) -> Bool
needs V obeys Equatable
  if me.count != you.count
    return false
  var i = 0u64
  while i < me.entries_used
    danger
      if me.entry_live.offset(ByteSize(bytes: i)).peek() == ENTRY_LIVE
        var k = me.keys.offset(K.data_size() * i).peek()
        var v = me.vals.offset(V.data_size() * i).peek()
        var slot = you.find_slot(k)
        if slot >= you.capacity
          return false
        var other_ei = you.indices.offset(U64.data_size() * slot).peek()
        var other_v = you.vals.offset(V.data_size() * other_ei).peek()
        if v != other_v
          return false
    i = i +% 1u64
  return true

### Serializes this dictionary to a `SerialValue.Dict`; keys render via `represent`, values serialize.
### :returns: The `SerialValue.Dict` mapping each key's text to its value's serialized form.
@[readonly, override]
routine Dict[K, V].serialize() -> SerialValue
  var __sv = Dict[Text, SerialValue]()
  each __e in me
    discard __sv.add(key: __e.key.represent(), value: __e.value.serialize())
  return SerialValue(steal __sv)
