module Collections

import BuilderQuery

secret preset B_DICT: U64 = 64u64
secret preset MIN_KEYS_DICT: U64 = 31u64

### Internal B-tree node for {SortedDict[K, V]}.
### Stores up to 63 ordered key-value pairs, up to 64 child pointers, and a cached subtree element count.
### :typeparam K: The key type.
### :typeparam V: The value type.
entity BTreeDictNode[AnyType K, AnyType V]
needs K obeys Comparable
  entry_keys: Array[K, 63]
  entry_values: Array[V, 63]
  children: Array[Hijacked[BTreeDictNode[K, V]], 64]
  key_count: U64
  child_count: U64
  subtree_size: U64
  is_leaf: Bool

### A sorted dictionary that maintains keys in ascending order, backed by a B-tree.
###
### `SortedDict[K, V]` maps comparable keys to values and always keeps those keys sorted.
### Unlike {Dict[K, V]}, which uses hashing and has no defined order, `SortedDict` lets
### you iterate in key order, efficiently find the minimum or maximum entry, and retrieve
### entries by sorted rank. Each key is unique — inserting an existing key overwrites its value.
###
### **When to use**
### - You need to iterate over entries in key order.
### - You need `min!` / `max!` or want the smallest/largest key at any time.
### - You need range queries over the key space.
### - You need rank-based access: the N-th smallest entry.
###
### **Complexity**
### | Operation | Time |
### |---|---|
### | `add` | O(log n) |
### | `remove` | O(log n) |
### | `contains` / `get!` / `get_or` | O(log n) |
### | `[]` rank-based access | O(log n) |
### | `min!` / `max!` | O(log n) |
### | `keys()` / `values()` | O(n) |
### | Iteration | O(n) |
###
### :typeparam K: The key type. Must obey {Comparable}.
### :typeparam V: The value type.
### :see: {Dict[K, V]} for an unordered dictionary with O(1) average lookup.
### :see: {SortedList[T]} for a sorted sequence that allows duplicates.
entity SortedDict[AnyType K, AnyType V] obeys Iterable[DictEntry[K, V]], KeyFindable, DictLiteral[K, V]
needs K obeys Comparable
relates SortedDictEmittable[K, V] as Iter
relates K as Key
relates V as Value
  secret root: Hijacked[BTreeDictNode[K, V]]?
  secret count: U64

# ============================================================================
# Node buffer helpers
# ============================================================================

### Returns the number of entries currently stored in this node.
### :returns: The key count.
@readonly
routine BTreeDictNode[K, V].keys_count() -> U64
  return me.key_count

### Returns the number of child pointers currently stored in this node.
### :returns: The child count.
@readonly
routine BTreeDictNode[K, V].children_count() -> U64
  return me.child_count

### Returns a raw pointer to the start of the keys buffer.
### :returns: A {Hijacked[K]} pointing to the first key slot.
@readonly
routine BTreeDictNode[K, V].keys_base() -> Hijacked[K]
  return me.hijack().recast_as[K]()

### Returns a raw pointer to the start of the values buffer, offset past the keys region.
### :returns: A {Hijacked[V]} pointing to the first value slot.
@readonly
routine BTreeDictNode[K, V].values_base() -> Hijacked[V]
  return me.hijack().recast_as[K]().stride(count: 63_s64).recast_as[V]()

### Returns a raw pointer to the start of the children buffer, offset past the keys and values regions.
### The buffer holds child-node POINTERS (the tree is a manual `Hijacked` graph — a node does not own
### its children inline), so the base is a pointer-to-pointer.
### :returns: A {Hijacked[Hijacked[BTreeDictNode[K, V]]]} pointing to the first child-pointer slot.
@readonly
routine BTreeDictNode[K, V].children_base() -> Hijacked[Hijacked[BTreeDictNode[K, V]]]
  return me.hijack().recast_as[K]().stride(count: 63_s64).recast_as[V]().stride(count: 63_s64).recast_as[Hijacked[BTreeDictNode[K, V]]]()

### Returns the key at slot `i`.
### :param i: Zero-based entry index.
### :returns: The key at position `i`.
@readonly
routine BTreeDictNode[K, V].key_get(i: U64) -> K
  danger
    return me.keys_base().stride(count: i.S64()).peek()

### Returns the value at slot `i`.
### :param i: Zero-based entry index.
### :returns: The value at position `i`.
@readonly
routine BTreeDictNode[K, V].value_get(i: U64) -> V
  danger
    return me.values_base().stride(count: i.S64()).peek()

### Builds a {DictEntry[K, V]} from the entry at slot `i`, taking OWNED copies of the key and value.
### The key/value are bound to locals first so the copy pass injects a retaining `store` (a bare
### `key_get(i)` call-result argument would NOT be copied, leaving the entry aliasing the buffer's
### refcounted controller — a double-free when the entry is torn down). Mirrors Dict's iterator.
### :param i: Zero-based entry index.
### :returns: An owning {DictEntry[K, V]} copy of the entry at position `i`.
@readonly
routine BTreeDictNode[K, V].entry_get(i: U64) -> DictEntry[K, V]
  var k = me.key_get(i)
  var v = me.value_get(i)
  return DictEntry[K, V](key: k, value: v)

### Writes `value` to the key slot at position `i`.
### :param i: Zero-based entry index.
### :param value: The key to store.
routine BTreeDictNode[K, V].key_set(i: U64, value: K)
  danger
    me.keys_base().stride(count: i.S64()).poke(value: value)
  return

### Writes `value` to the value slot at position `i`.
### :param i: Zero-based entry index.
### :param value: The value to store.
routine BTreeDictNode[K, V].value_set(i: U64, value: V)
  danger
    me.values_base().stride(count: i.S64()).poke(value: value)
  return

### Returns a non-owning pointer to the child node at slot `i`.
### The tree owns its children; this LENDS the pointer (no ownership transfer). Callers `.as_entity()`
### it to read the node. Returning a bare `?BTreeDictNode` would make `var c = node.children_get(i)` a
### second owner and double-free the tree-owned node at scope exit (containment = ownership).
### :param i: Zero-based child index.
### :returns: The `?Hijacked[BTreeDictNode[K, V]]` child-node pointer stored in slot `i`.
@readonly
dangerous routine BTreeDictNode[K, V].children_get(i: U64) -> Hijacked[BTreeDictNode[K, V]]
  return me.children_base().stride(count: i.S64()).peek()

### Recursively frees this node's subtree (post-order): destroys each child node, tears down each
### stored key and value, then frees this node's own allocation. Visited inline (never bound to a
### `var`) so scope-exit teardown doesn't double-free.
@override
dangerous routine BTreeDictNode[K, V].destroy()
  if not me.is_leaf
    var ci = 0u64
    while ci < me.child_count
      me.children_get(ci).as_entity().destroy()
      ci = ci + 1u64
  var ki = 0u64
  while ki < me.key_count
    me.key_get(ki).destroy()
    me.value_get(ki).destroy()
    ki = ki + 1u64
  me.hijack().invalidate()
  return

### Cycle-collector TRACE: recurse into every child node, then report each stored key AND value to the
### collector. Overrides the universal member-walk (keys/values live in fixed inline arrays the generic
### walk cannot iterate).
@override
dangerous routine BTreeDictNode[K, V].roam_trace()
  if not me.is_leaf
    var ci = 0u64
    while ci < me.child_count
      me.children_get(ci).as_entity().roam_trace()
      ci = ci + 1u64
  var ki = 0u64
  while ki < me.key_count
    me.key_get(ki).cyclic_visit()
    me.value_get(ki).cyclic_visit()
    ki = ki + 1u64
  return

### Cycle-collector FREE: recurse into every child node freeing the subtree, then free this node's own
### box — but NOT the stored keys/values (the collector frees the whole white cycle directly).
@override
dangerous routine BTreeDictNode[K, V].roam_free()
  if not me.is_leaf
    var ci = 0u64
    while ci < me.child_count
      me.children_get(ci).as_entity().roam_free()
      ci = ci + 1u64
  me.hijack().invalidate()
  return

### Frees the entire backing B-tree — every node, key, and value — at scope exit.
@override
dangerous routine SortedDict[K, V].destroy()
  if me.root is None
    me.hijack().invalidate()
    return
  me.root!!.as_entity().destroy()
  me.hijack().invalidate()
  return

### Cycle-collector TRACE: delegate to the root node's recursive trace (reports every key/value).
@override
dangerous routine SortedDict[K, V].roam_trace()
  if me.root is None
    return
  me.root!!.as_entity().roam_trace()
  return

### Cycle-collector FREE: free the whole B-tree via the root's recursive free, then free this dict's own
### box — but NOT the stored keys/values (the collector frees the whole white cycle directly).
@override
dangerous routine SortedDict[K, V].roam_free()
  if me.root is None
    me.hijack().invalidate()
    return
  me.root!!.as_entity().roam_free()
  me.hijack().invalidate()
  return

### Writes `value` to the child slot at position `i`.
### :param i: Zero-based child index.
### :param value: The child-node pointer to store.
routine BTreeDictNode[K, V].children_set(i: U64, value: Hijacked[BTreeDictNode[K, V]])
  danger
    me.children_base().stride(count: i.S64()).poke(value: value)
  return

### Appends a key-value pair after the last entry and increments the entry count.
### :param k: The key to append.
### :param v: The value to append.
routine BTreeDictNode[K, V].entries_add_last(k: K, v: V)
  danger
    me.keys_base().stride(count: me.key_count.S64()).poke(value: k)
    me.values_base().stride(count: me.key_count.S64()).poke(value: v)
  me.key_count = me.key_count +% 1u64
  return

### Appends `value` after the last child pointer and increments the child count.
### :param value: The child-node pointer to append.
routine BTreeDictNode[K, V].children_add_last(value: Hijacked[BTreeDictNode[K, V]])
  danger
    me.children_base().stride(count: me.child_count.S64()).poke(value: value)
  me.child_count = me.child_count +% 1u64
  return

### Inserts a key-value pair at position `i`, shifting later entries right by one.
### :param i: Zero-based insertion index.
### :param k: The key to insert.
### :param v: The value to insert.
routine BTreeDictNode[K, V].entries_add_at(i: U64, k: K, v: V)
  danger
    var kbase = me.keys_base()
    var vbase = me.values_base()
    if i < me.key_count
      var k_elem_size = K.data_size()
      var v_elem_size = V.data_size()
      var shift_count = me.key_count -% i
      var ksrc_addr = kbase.stride(count: i.S64()).get_address()
      var kdst_addr = kbase.stride(count: (i +% 1u64).S64()).get_address()
      var vsrc_addr = vbase.stride(count: i.S64()).get_address()
      var vdst_addr = vbase.stride(count: (i +% 1u64).S64()).get_address()
      rf_copy_bytes_at(dest: kdst_addr, src: ksrc_addr, size: k_elem_size * shift_count)
      rf_copy_bytes_at(dest: vdst_addr, src: vsrc_addr, size: v_elem_size * shift_count)
    kbase.stride(count: i.S64()).poke(value: k)
    vbase.stride(count: i.S64()).poke(value: v)
  me.key_count = me.key_count +% 1u64
  return

### Inserts `value` at position `i` in the children buffer, shifting later pointers right by one.
### :param i: Zero-based insertion index.
### :param value: The child-node pointer to insert.
routine BTreeDictNode[K, V].children_add_at(i: U64, value: Hijacked[BTreeDictNode[K, V]])
  danger
    var base = me.children_base()
    if i < me.child_count
      var elem_size = Address.data_size()
      var shift_count = me.child_count -% i
      var src_addr = base.stride(count: i.S64()).get_address()
      var dst_addr = base.stride(count: (i +% 1u64).S64()).get_address()
      rf_copy_bytes_at(dest: dst_addr, src: src_addr, size: elem_size * shift_count)
    base.stride(count: i.S64()).poke(value: value)
  me.child_count = me.child_count +% 1u64
  return

### Removes the entry at position `i`, shifting later entries left by one.
### :param i: Zero-based index of the entry to remove.
routine BTreeDictNode[K, V].entries_remove_at(i: U64)
  danger
    if i +% 1u64 < me.key_count
      var kbase = me.keys_base()
      var vbase = me.values_base()
      var k_elem_size = K.data_size()
      var v_elem_size = V.data_size()
      var shift_count = me.key_count -% i -% 1u64
      var ksrc_addr = kbase.stride(count: (i +% 1u64).S64()).get_address()
      var kdst_addr = kbase.stride(count: i.S64()).get_address()
      var vsrc_addr = vbase.stride(count: (i +% 1u64).S64()).get_address()
      var vdst_addr = vbase.stride(count: i.S64()).get_address()
      rf_copy_bytes_at(dest: kdst_addr, src: ksrc_addr, size: k_elem_size * shift_count)
      rf_copy_bytes_at(dest: vdst_addr, src: vsrc_addr, size: v_elem_size * shift_count)
  me.key_count = me.key_count -% 1u64
  return

### Removes the child pointer at position `i`, shifting later pointers left by one.
### :param i: Zero-based index of the child to remove.
routine BTreeDictNode[K, V].children_remove_at(i: U64)
  danger
    if i +% 1u64 < me.child_count
      var base = me.children_base()
      var elem_size = Address.data_size()
      var shift_count = me.child_count -% i -% 1u64
      var src_addr = base.stride(count: (i +% 1u64).S64()).get_address()
      var dst_addr = base.stride(count: i.S64()).get_address()
      rf_copy_bytes_at(dest: dst_addr, src: src_addr, size: elem_size * shift_count)
  me.child_count = me.child_count -% 1u64
  return

### Decrements the entry count, logically removing the last entry without zeroing memory.
routine BTreeDictNode[K, V].entries_remove_last()
  me.key_count = me.key_count -% 1u64
  return

### Decrements the child count, logically removing the last child pointer without zeroing memory.
routine BTreeDictNode[K, V].children_remove_last()
  me.child_count = me.child_count -% 1u64
  return

### Sets the entry count to `n`, discarding all entries at or after index `n`.
### :param n: The new entry count.
routine BTreeDictNode[K, V].entries_truncate(n: U64)
  me.key_count = n
  return

### Sets the child count to `n`, discarding all children at or after index `n`.
### :param n: The new child count.
routine BTreeDictNode[K, V].children_truncate(n: U64)
  me.child_count = n
  return

### Bulk-copies `count` entries from `other` starting at `start` into this node's entry buffers.
### :param other: The source node to copy from.
### :param start: Zero-based start index in `other`.
### :param count: Number of entries to copy.
routine BTreeDictNode[K, V].entries_add_range_from(other: Accessing[BTreeDictNode[K, V]], start: U64, count: U64)
  if count > 0u64
    danger
      var k_elem_size = K.data_size()
      var v_elem_size = V.data_size()
      var ksrc_addr = other.keys_base().stride(count: start.S64()).get_address()
      var kdst_addr = me.keys_base().stride(count: me.key_count.S64()).get_address()
      var vsrc_addr = other.values_base().stride(count: start.S64()).get_address()
      var vdst_addr = me.values_base().stride(count: me.key_count.S64()).get_address()
      rf_copy_bytes_at(dest: kdst_addr, src: ksrc_addr, size: k_elem_size * count)
      rf_copy_bytes_at(dest: vdst_addr, src: vsrc_addr, size: v_elem_size * count)
  me.key_count = me.key_count +% count
  return

### Bulk-copies `count` child pointers from `other` starting at `start` into this node's children buffer.
### :param other: The source node to copy from.
### :param start: Zero-based start index in `other`.
### :param count: Number of child pointers to copy.
routine BTreeDictNode[K, V].children_add_range_from(other: Accessing[BTreeDictNode[K, V]], start: U64, count: U64)
  if count > 0u64
    danger
      var elem_size = Address.data_size()
      var src_addr = other.children_base().stride(count: start.S64()).get_address()
      var dst_addr = me.children_base().stride(count: me.child_count.S64()).get_address()
      rf_copy_bytes_at(dest: dst_addr, src: src_addr, size: elem_size * count)
  me.child_count = me.child_count +% count
  return

# ============================================================================
# Creators
# ============================================================================

routine BTreeDictNode[K, V](is_leaf: Bool) -> BTreeDictNode[K, V]
  return BTreeDictNode[K, V](
    entry_keys: LLVM::zero_value[Array[K, 63]](),
    entry_values: LLVM::zero_value[Array[V, 63]](),
    children: LLVM::zero_value[Array[BTreeDictNode[K, V], 64]](),
    key_count: 0u64,
    child_count: 0u64,
    subtree_size: 0u64,
    is_leaf: is_leaf
  )

routine SortedDict[K, V]() -> SortedDict[K, V]
  return SortedDict[K, V](
    root: none,
    count: 0u64
  )

### Creates a sorted dict containing the given key-value `pairs` (stored in sorted key order). Variadic
### constructor behind the `{k: v, …}` dict-literal syntax (the `DictLiteral` opt-in).
### :param pairs: The key-value pairs as `DictEntry[K, V]` values; a later duplicate key overwrites.
### :returns: A sorted dict of the given pairs.
common routine SortedDict[K, V].from_literal(pairs...: DictEntry[K, V]) -> SortedDict[K, V]
needs K obeys Comparable
  var result = SortedDict[K, V]()
  var i = 0u64
  while i < pairs.count()
    discard result.add(key: pairs[i].key, value: pairs[i].value)
    i = i +% 1u64
  return result


# ============================================================================
# Core
# ============================================================================

### Returns the number of key-value pairs in this dictionary.
### :returns: The entry count.
@readonly
routine SortedDict[K, V].count() -> U64
  return me.count

### Returns true if this dictionary contains no entries.
### :returns: `true` when `count()` is zero.
@readonly
routine SortedDict[K, V].is_empty() -> Bool
  return me.count == 0u64

### Removes all entries, resetting the dictionary to an empty state.
routine SortedDict[K, V].clear()
  me.root = none
  me.count = 0u64
  return

# ============================================================================
# Binary search
# ============================================================================

### Binary search: returns the leftmost index where `node.keys[i] >= key`.
### :param node: The node whose keys are searched.
### :param key: The target key.
### :returns: Smallest index `i` where `node.keys[i] >= key`, or `keys_count()` if all keys are smaller.
@readonly
@inline
routine SortedDict[K, V].lower_bound(node: Accessing[BTreeDictNode[K, V]], key: K) -> U64
  var lo = 0u64
  var hi = node.keys_count()
  while lo < hi
    var mid = lo +% LLVM::unsigned_div(hi -% lo, 2u64)
    if node.key_get(mid) < key
      lo = mid +% 1u64
    else
      hi = mid
  return lo

# ============================================================================
# Search
# ============================================================================

### Returns true if `key` exists in this dictionary.
### :param key: The key to look up.
### :returns: `true` if the key is present.
@readonly
routine SortedDict[K, V].contains(key: K) -> Bool
  if me.root is None
    return false
  danger
    var root_ref = me.root!!.as_entity()
    return me.search_node(node: root_ref, key: key)

### Descends the subtree rooted at `node` to find `key`.
### :param node: The subtree root to search.
### :param key: The key to find.
### :returns: `true` if found anywhere in the subtree.
@readonly
@inline
routine SortedDict[K, V].search_node(node: Accessing[BTreeDictNode[K, V]], key: K) -> Bool
  danger
    var i = me.lower_bound(node: node, key: key)
    if i < node.keys_count() and key == node.key_get(i)
      return true
    if node.is_leaf
      return false
    return me.search_node(node: node.children_get(i).as_entity(), key: key)

### Returns the value associated with `key`.
### :param key: The key to look up.
### :returns: The value mapped to `key`.
### :throws: `KeyNotFoundError` if `key` is not present.
@readonly
routine SortedDict[K, V].getitem!(key: Accessing[K]) -> V
  if me.root is None
    throw KeyNotFoundError(key: key.represent())
  danger
    var root_ref = me.root!!.as_entity()
    return me.get_from_node(node: root_ref, key: key)

### Descends `node` to retrieve the value for `key`, throwing if not found.
### :param node: The subtree root to search.
### :param key: The key to look up.
### :returns: The value mapped to `key`.
### :throws: `KeyNotFoundError` if `key` is not present.
@readonly
routine SortedDict[K, V].get_from_node!(node: Accessing[BTreeDictNode[K, V]], key: K) -> V
  danger
    var i = me.lower_bound(node: node, key: key)
    if i < node.keys_count() and key == node.key_get(i)
      return node.value_get(i)
    if node.is_leaf
      throw KeyNotFoundError(key: key.represent())
    return me.get_from_node(node: node.children_get(i).as_entity(), key: key)

### Updates the value associated with `key`.
### :param key: The key to update.
### :param value: The replacement value.
### :absent: The key is not present in the dictionary.
routine SortedDict[K, V].setitem!(key: Accessing[K], value: V)
  if key notin me
    absent
  discard me.add(key: key, value: value)
  return

# ============================================================================
# Insert
# ============================================================================

### Inserts or updates the entry for `key`.
### If `key` already exists, its value is replaced with `value`.
### :param key: The key to insert or update.
### :param value: The value to associate with `key`.
### :returns: `true` if a new key was inserted; `false` if an existing key was updated.
routine SortedDict[K, V].add(key: K, value: V) -> Bool
  if me.root is None
    danger
      me.root = BTreeDictNode[K, V](is_leaf: true).hijack()
      me.root!!.as_entity().entries_add_last(k: key, v: value)
      me.root!!.as_entity().subtree_size = 1u64
    me.count = 1u64
    return true

  var root_full = false
  danger
    root_full = me.root!!.as_entity().keys_count() >= B_DICT -% 1u64
  if root_full
    danger
      var old_root = me.root!!
      me.root = BTreeDictNode[K, V](is_leaf: false).hijack()
      var new_root = me.root!!.as_entity()
      new_root.children_add_last(value: old_root)
      me.split_child(parent_node: new_root, child_idx: 0u64)
      new_root.subtree_size = new_root.children_get(0u64).as_entity().subtree_size +% new_root.children_get(1u64).as_entity().subtree_size +% 1u64

  var inserted = false
  danger
    var root_ref = me.root!!.as_entity()
    inserted = me.insert_non_full(node: root_ref, key: key, value: value)
  if inserted
    me.count = me.count +% 1u64
  return inserted

### Inserts or updates `key` in `node`, which must have at least one free entry slot.
### :param node: A non-full node to insert into.
### :param key: The key to insert or update.
### :param value: The value to associate with `key`.
### :returns: `true` if a new entry was inserted; `false` if an existing key was updated.
@inline
routine SortedDict[K, V].insert_non_full(node: Controlling[BTreeDictNode[K, V]], key: K, value: V) -> Bool
  danger
    var i = me.lower_bound(node: node, key: key)

    if i < node.keys_count() and node.key_get(i) == key
      node.value_set(i: i, value: value)
      return false

    if node.is_leaf
      node.entries_add_at(i: i, k: key, v: value)
      node.subtree_size = node.subtree_size +% 1u64
      return true
    else
      if node.children_get(i).as_entity().keys_count() >= B_DICT -% 1u64
        me.split_child(parent_node: node, child_idx: i)
        if key == node.key_get(i)
          node.value_set(i: i, value: value)
          return false
        if key > node.key_get(i)
          i = i +% 1u64

      var inserted = me.insert_non_full(node: node.children_get(i).as_entity(), key: key, value: value)
      if inserted
        node.subtree_size = node.subtree_size +% 1u64
      return inserted

### Splits the full child at index `child_idx`, promoting its median entry up to `parent_node`.
### :param parent_node: The parent node that owns the full child.
### :param child_idx: Index of the full child within `parent_node`'s children buffer.
@inline
routine SortedDict[K, V].split_child(parent_node: Controlling[BTreeDictNode[K, V]], child_idx: U64)
  danger
    var child = parent_node.children_get(child_idx).as_entity()
    var mid = LLVM::unsigned_div(B_DICT -% 1u64, 2u64)

    var new_node_ptr = BTreeDictNode[K, V](is_leaf: child.is_leaf).hijack()
    var new_node = new_node_ptr.as_entity()
    new_node.entries_add_range_from(other: child, start: mid +% 1u64, count: child.keys_count() -% mid -% 1u64)

    if not child.is_leaf
      new_node.children_add_range_from(other: child, start: mid +% 1u64, count: child.children_count() -% mid -% 1u64)

    var mid_key = child.key_get(mid)
    var mid_value = child.value_get(mid)

    child.entries_truncate(mid)
    if not child.is_leaf
      child.children_truncate(mid +% 1u64)

    if child.is_leaf
      child.subtree_size = child.keys_count()
      new_node.subtree_size = new_node.keys_count()
    else
      var left_size = child.keys_count()
      var i = 0u64
      while i < child.children_count()
        left_size = left_size +% child.children_get(i).as_entity().subtree_size
        i = i +% 1u64
      child.subtree_size = left_size
      var right_size = new_node.keys_count()
      i = 0u64
      while i < new_node.children_count()
        right_size = right_size +% new_node.children_get(i).as_entity().subtree_size
        i = i +% 1u64
      new_node.subtree_size = right_size

    parent_node.entries_add_at(i: child_idx, k: mid_key, v: mid_value)
    parent_node.children_add_at(i: child_idx +% 1u64, value: new_node_ptr)
    return

# ============================================================================
# Remove
# ============================================================================

### Removes the entry for `key` from the dictionary.
### :param key: The key to remove.
### :returns: `true` if the key was found and removed; `false` if not present.
routine SortedDict[K, V].remove(key: K) -> Bool
  if me.root is None
    return false

  var removed = false
  danger
    var root_ref = me.root!!.as_entity()
    removed = me.remove_from_node(node: root_ref, key: key)
  if removed
    me.count = me.count -% 1u64
    danger
      if me.root!!.as_entity().keys_count() == 0u64 and not me.root!!.as_entity().is_leaf
        me.root = me.root!!.as_entity().children_get(0u64)
      if me.root!!.as_entity().keys_count() == 0u64
        me.root = none
  return removed

### Descends `node` to delete the entry for `key`, rebalancing on the way back up.
### :param node: The subtree root to search and remove from.
### :param key: The key to remove.
### :returns: `true` if the key was found and removed.
@inline
routine SortedDict[K, V].remove_from_node(node: Controlling[BTreeDictNode[K, V]], key: K) -> Bool
  danger
    var i = me.lower_bound(node: node, key: key)

    if i < node.keys_count() and key == node.key_get(i)
      if node.is_leaf
        node.entries_remove_at(i)
        node.subtree_size = node.subtree_size -% 1u64
        return true
      else
        var left = node.children_get(i).as_entity()
        var right = node.children_get(i +% 1u64).as_entity()
        if left.keys_count() > MIN_KEYS_DICT
          var pred = me.get_predecessor(node: node, idx: i)
          node.key_set(i: i, value: pred.key)
          node.value_set(i: i, value: pred.value)
          discard me.remove_from_node(node: left, key: pred.key)
          node.subtree_size = node.subtree_size -% 1u64
          return true
        elseif right.keys_count() > MIN_KEYS_DICT
          var succ = me.get_successor(node: node, idx: i)
          node.key_set(i: i, value: succ.key)
          node.value_set(i: i, value: succ.value)
          discard me.remove_from_node(node: right, key: succ.key)
          node.subtree_size = node.subtree_size -% 1u64
          return true
        else
          me.merge_children_at(node: node, i: i)
          var removed = me.remove_from_node(node: node.children_get(i).as_entity(), key: key)
          if removed
            node.subtree_size = node.subtree_size -% 1u64
          return removed
    else
      if node.is_leaf
        return false
      i = me.fix_child(node: node, i: i)
      var removed = me.remove_from_node(node: node.children_get(i).as_entity(), key: key)
      if removed
        node.subtree_size = node.subtree_size -% 1u64
      return removed

### Returns the largest entry in the left subtree of `node.children[idx]`.
### :param node: The parent node.
### :param idx: Index of the separator entry whose left child to descend.
### :returns: The in-order predecessor entry.
@inline
routine SortedDict[K, V].get_predecessor(node: Accessing[BTreeDictNode[K, V]], idx: U64) -> DictEntry[K, V]
  danger
    var current = node.children_get(idx).as_entity()
    while not current.is_leaf
      current = current.children_get(current.children_count() -% 1u64).as_entity()
    var last = current.keys_count() -% 1u64
    return current.entry_get(last)

### Returns the smallest entry in the right subtree of `node.children[idx + 1]`.
### :param node: The parent node.
### :param idx: Index of the separator entry whose right child to descend.
### :returns: The in-order successor entry.
@inline
routine SortedDict[K, V].get_successor(node: Accessing[BTreeDictNode[K, V]], idx: U64) -> DictEntry[K, V]
  danger
    var current = node.children_get(idx +% 1u64).as_entity()
    while not current.is_leaf
      current = current.children_get(0u64).as_entity()
    return current.entry_get(0u64)

### Merges `node.children[i + 1]` into `node.children[i]`, pulling down the separator entry at `node.keys[i]`.
### :param node: The parent node whose two adjacent children are merged.
### :param i: Index of the separator entry and the left child that absorbs the right.
@inline
routine SortedDict[K, V].merge_children_at(node: Controlling[BTreeDictNode[K, V]], i: U64)
  danger
    var left = node.children_get(i).as_entity()
    var right = node.children_get(i +% 1u64).as_entity()

    left.entries_add_last(k: node.key_get(i), v: node.value_get(i))
    left.entries_add_range_from(other: right, start: 0u64, count: right.keys_count())

    if not right.is_leaf
      left.children_add_range_from(other: right, start: 0u64, count: right.children_count())

    left.subtree_size = left.subtree_size +% right.subtree_size +% 1u64

    node.entries_remove_at(i)
    node.children_remove_at(i +% 1u64)
    return

### Ensures `node.children[i]` has enough keys for safe descent; rotates or merges siblings as needed.
### :param node: The parent node whose child needs fixing.
### :param i: The child index that is about to be descended into.
### :returns: The adjusted child index after any rotation or merge.
@inline
routine SortedDict[K, V].fix_child(node: Controlling[BTreeDictNode[K, V]], i: U64) -> U64
  danger
    if node.children_get(i).as_entity().keys_count() > MIN_KEYS_DICT
      return i
    if i > 0u64 and node.children_get(i -% 1u64).as_entity().keys_count() > MIN_KEYS_DICT
      me.rotate_right_at(node: node, i: i)
      return i
    if i +% 1u64 < node.children_count() and node.children_get(i +% 1u64).as_entity().keys_count() > MIN_KEYS_DICT
      me.rotate_left_at(node: node, i: i)
      return i
    if i > 0u64
      me.merge_children_at(node: node, i: i -% 1u64)
      return i -% 1u64
    me.merge_children_at(node: node, i: i)
    return i

### Borrows the last entry from the left sibling of `node.children[i]` through the parent separator.
### :param node: The parent node.
### :param i: Index of the child that receives the borrowed entry.
@inline
routine SortedDict[K, V].rotate_right_at(node: Controlling[BTreeDictNode[K, V]], i: U64)
  danger
    var left = node.children_get(i -% 1u64).as_entity()
    var child = node.children_get(i).as_entity()

    child.entries_add_at(i: 0u64, k: node.key_get(i -% 1u64), v: node.value_get(i -% 1u64))

    if not child.is_leaf
      child.children_add_at(i: 0u64, value: left.children_get(left.children_count() -% 1u64).as_entity().hijack())
      left.children_remove_last()

    var last = left.keys_count() -% 1u64
    node.key_set(i: i -% 1u64, value: left.key_get(last))
    node.value_set(i: i -% 1u64, value: left.value_get(last))
    left.entries_remove_last()

    me.update_subtree_size(left)
    me.update_subtree_size(child)
    return

### Borrows the first entry from the right sibling of `node.children[i]` through the parent separator.
### :param node: The parent node.
### :param i: Index of the child that receives the borrowed entry.
@inline
routine SortedDict[K, V].rotate_left_at(node: Controlling[BTreeDictNode[K, V]], i: U64)
  danger
    var right = node.children_get(i +% 1u64).as_entity()
    var child = node.children_get(i).as_entity()

    child.entries_add_last(k: node.key_get(i), v: node.value_get(i))

    if not child.is_leaf
      child.children_add_last(right.children_get(0u64).as_entity().hijack())
      right.children_remove_at(0u64)

    node.key_set(i: i, value: right.key_get(0u64))
    node.value_set(i: i, value: right.value_get(0u64))
    right.entries_remove_at(0u64)

    me.update_subtree_size(right)
    me.update_subtree_size(child)
    return

### Recomputes `node.subtree_size` from its entries and children.
### :param node: The node whose subtree size is to be refreshed.
@inline
routine SortedDict[K, V].update_subtree_size(node: Controlling[BTreeDictNode[K, V]])
  danger
    if node.is_leaf
      node.subtree_size = node.keys_count()
    else
      var size = node.keys_count()
      var i = 0u64
      while i < node.children_count()
        size = size +% node.children_get(i).as_entity().subtree_size
        i = i +% 1u64
      node.subtree_size = size
    return

# ============================================================================
# Get helpers
# ============================================================================

### Returns the entry at the given zero-based sorted rank.
### Rank 0 is the entry with the smallest key; rank `count()-1` is the largest.
### :param i: The zero-based sorted rank to read.
### :returns: The {DictEntry[K, V]} at that sorted position.
### :throws: {IndexOutOfBoundsError} if `i >= count()`.
@readonly
routine SortedDict[K, V].get_by_rank!(i: U64) -> DictEntry[K, V]
  if i >= me.count
    throw IndexOutOfBoundsError(index: i, count: me.count)
  danger
    var root_ref = me.root!!.as_entity()
    return me.get_by_rank_node(node: root_ref, rank: i)

### Returns the entry at zero-based sorted rank `rank` within `node`'s subtree.
### :param node: The subtree root to search.
### :param rank: Zero-based position in the in-order traversal of this subtree.
### :returns: The {DictEntry[K, V]} at that rank.
@readonly
routine SortedDict[K, V].get_by_rank_node(node: Accessing[BTreeDictNode[K, V]], rank: U64) -> DictEntry[K, V]
  danger
    if node.is_leaf
      return node.entry_get(rank)

    var remaining = rank
    var i = 0u64
    while i < node.children_count()
      var child_size = node.children_get(i).as_entity().subtree_size
      if remaining < child_size
        return me.get_by_rank_node(node: node.children_get(i).as_entity(), rank: remaining)
      remaining = remaining -% child_size
      if i < node.keys_count()
        if remaining == 0u64
          return node.entry_get(i)
        remaining = remaining -% 1u64
      i = i +% 1u64
    return node.entry_get(0u64)

### Returns the value for `key`, or `default` if the key is not present.
### :param key: The key to look up.
### :param default: The fallback value returned when `key` is absent.
### :returns: The mapped value if found, otherwise `default`.
@readonly
routine SortedDict[K, V].get_or(key: K, default: V) -> V
  if me.root is None
    return default
  danger
    var root_ref = me.root!!.as_entity()
    return me.get_or_from_node(node: root_ref, key: key, default: default)

### Descends `node` to retrieve the value for `key`, returning `default` if not found.
### :param node: The subtree root to search.
### :param key: The key to look up.
### :param default: The fallback value returned when `key` is absent.
### :returns: The mapped value if found, otherwise `default`.
@readonly
routine SortedDict[K, V].get_or_from_node(node: Accessing[BTreeDictNode[K, V]], key: K, default: V) -> V
  danger
    var i = me.lower_bound(node: node, key: key)
    if i < node.keys_count() and key == node.key_get(i)
      return node.value_get(i)
    if node.is_leaf
      return default
    return me.get_or_from_node(node: node.children_get(i).as_entity(), key: key, default: default)

# ============================================================================
# Min/Max
# ============================================================================

### Returns the entry with the smallest key.
### :returns: A {DictEntry[K, V]} with the minimum key and its associated value.
### :absent: The dictionary is empty.
@readonly
routine SortedDict[K, V].min!() -> DictEntry[K, V]
  if me.is_empty()
    absent
  danger
    var node = me.root!!.as_entity()
    while not node.is_leaf
      node = node.children_get(0u64).as_entity()
    return node.entry_get(0u64)

### Returns the entry with the largest key.
### :returns: A {DictEntry[K, V]} with the maximum key and its associated value.
### :absent: The dictionary is empty.
@readonly
routine SortedDict[K, V].max!() -> DictEntry[K, V]
  if me.is_empty()
    absent
  danger
    var node = me.root!!.as_entity()
    while not node.is_leaf
      node = node.children_get(node.children_count() -% 1u64).as_entity()
    var last = node.keys_count() -% 1u64
    return node.entry_get(last)

### Returns the entry with the smallest key. Alias for {SortedDict[K, V].min()}.
### :returns: The first (minimum-key) entry.
### :absent: The dictionary is empty.
@readonly
routine SortedDict[K, V].first!() -> DictEntry[K, V]
  return me.min()

### Returns the entry with the largest key. Alias for {SortedDict[K, V].max()}.
### :returns: The last (maximum-key) entry.
### :absent: The dictionary is empty.
@readonly
routine SortedDict[K, V].last!() -> DictEntry[K, V]
  return me.max()

# ============================================================================
# Keys / Values
# ============================================================================

### Returns all keys in ascending order.
### :returns: A {List[K]} of every key, sorted from smallest to largest.
@readonly
routine SortedDict[K, V].keys() -> List[K]
  var result = List[K](me.count)
  if me.root is None
    pass
  else
    danger
      var root_ref = me.root!!.as_entity()
      me.collect_keys(node: root_ref, result: result)
  return steal result

### Appends all keys from `node`'s subtree into `result` via in-order traversal.
### :param node: The subtree root to traverse.
### :param result: The list to append keys into.
@readonly
routine SortedDict[K, V].collect_keys(node: Accessing[BTreeDictNode[K, V]], result: Controlling[List[K]])
  danger
    var i = 0u64
    while i < node.keys_count()
      if not node.is_leaf
        me.collect_keys(node: node.children_get(i).as_entity(), result: result)
      result.add_last(node.key_get(i))
      i = i +% 1u64
    if not node.is_leaf
      me.collect_keys(node: node.children_get(node.children_count() -% 1u64).as_entity(), result: result)
    return

### Returns all values in key-ascending order.
### :returns: A {List[V]} of every value, ordered by their corresponding keys.
@readonly
routine SortedDict[K, V].values() -> List[V]
  var result = List[V](me.count)
  if me.root is None
    pass
  else
    danger
      var root_ref = me.root!!.as_entity()
      me.collect_values(node: root_ref, result: result)
  return steal result

### Appends all values from `node`'s subtree into `result` via in-order traversal.
### :param node: The subtree root to traverse.
### :param result: The list to append values into.
@readonly
routine SortedDict[K, V].collect_values(node: Accessing[BTreeDictNode[K, V]], result: Controlling[List[V]])
  danger
    var i = 0u64
    while i < node.keys_count()
      if not node.is_leaf
        me.collect_values(node: node.children_get(i).as_entity(), result: result)
      result.add_last(node.value_get(i))
      i = i +% 1u64
    if not node.is_leaf
      me.collect_values(node: node.children_get(node.children_count() -% 1u64).as_entity(), result: result)
    return

# ============================================================================
# Rank-based access
# ============================================================================

### Returns the entry at zero-based sorted rank `rank` within `node`'s subtree.
### :param node: The subtree root to search.
### :param rank: Zero-based position in the in-order traversal of this subtree.
### :returns: The entry at that rank.
@readonly
routine SortedDict[K, V].get_by_rank(node: Accessing[BTreeDictNode[K, V]], rank: U64) -> DictEntry[K, V]
  danger
    if node.is_leaf
      return node.entry_get(rank)

    var remaining = rank
    var i = 0u64
    while i < node.children_count()
      var child_size = node.children_get(i).as_entity().subtree_size
      if remaining < child_size
        return me.get_by_rank(node: node.children_get(i).as_entity(), rank: remaining)
      remaining = remaining -% child_size
      if i < node.keys_count()
        if remaining == 0u64
          return node.entry_get(i)
        remaining = remaining -% 1u64
      i = i +% 1u64
    return node.entry_get(0u64)

# ============================================================================
# Iteration
# ============================================================================

@readonly
routine SortedDict[K, V].iter() -> SortedDictEmittable[K, V]
  danger
    return SortedDictEmittable[K, V](dict: me.hijack(), index: 0u64)

### Creates a {List[DictEntry[K, V]]} from all entries of `from` in ascending key order.
### :param from: The sorted dictionary to convert.
### :returns: A new list of all entries in key-ascending order.
routine List[DictEntry[K, V]](from: SortedDict[K, V]) -> List[DictEntry[K, V]]
  var result = List[DictEntry[K, V]](from.count)
  if from.root is None
    pass
  else
    danger
      var root_ref = from.root!!.as_entity()
      from.collect_inorder(node: root_ref, result: result)
  return steal result

### Appends all entries from `node`'s subtree into `result` via in-order traversal.
### :param node: The subtree root to traverse.
### :param result: The list to append entries into.
@readonly
routine SortedDict[K, V].collect_inorder(node: Accessing[BTreeDictNode[K, V]], result: Controlling[List[DictEntry[K, V]]])
  danger
    var i = 0u64
    while i < node.keys_count()
      if not node.is_leaf
        me.collect_inorder(node: node.children_get(i).as_entity(), result: result)
      result.add_last(node.entry_get(i))
      i = i +% 1u64
    if not node.is_leaf
      me.collect_inorder(node: node.children_get(node.children_count() -% 1u64).as_entity(), result: result)
    return

### Emittable that yields entries of a {SortedDict[K, V]} in ascending key order.
### Holds a NON-OWNING `Hijacked` pointer to the dict — a cursor borrows its container, it does not
### own it. An owning `dict: SortedDict` field would make the iterator's teardown free the whole tree,
### double-freeing it against the real owner's scope-exit `destroy` (containment = ownership).
### :typeparam K: The key type.
### :typeparam V: The value type.
entity SortedDictEmittable[AnyType K, AnyType V] obeys Emittable[DictEntry[K, V]]
  dict: Hijacked[SortedDict[K, V]]
  index: U64

routine SortedDictEmittable[K, V].emit!() -> DictEntry[K, V]
  danger
    if me.index >= me.dict.as_entity().count()
      absent
    var root_ref = me.dict.as_entity().root!!.as_entity()
    var entry = me.dict.as_entity().get_by_rank(node: root_ref, rank: me.index)
    me.index = me.index + 1u64
    return entry

# ============================================================================
# Display
# ============================================================================

@[readonly, override]
routine SortedDict[K, V].represent() -> Text
  var result = me.type_name() + "({"
  var i = 0u64
  each entry in me
    if i > 0u64
      result = result + ", "
    result = result + nested_repr(entry.key) + ": " + nested_repr(entry.value)
    i = i +% 1u64
  result = result + "})"
  return steal result

@[readonly, override]
routine SortedDict[K, V].diagnose() -> Text
  var result = me.full_type_name() + "(count: " + me.count().represent() + ", {"
  var i = 0u64
  each entry in me
    if i > 0u64
      result = result + ", "
    result = result + nested_repr(entry.key) + ": " + nested_repr(entry.value)
    i = i +% 1u64
  result = result + "})"
  return steal result

### Serializes this dictionary to a `SerialValue.Dict`; keys render via `represent`, values serialize.
### :returns: The `SerialValue.Dict` mapping each key's text to its value's serialized form.
@[readonly, override]
routine SortedDict[K, V].serialize() -> SerialValue
  var __sv = Dict[Text, SerialValue]()
  each __e in me
    discard __sv.add(key: __e.key.represent(), value: __e.value.serialize())
  return SerialValue(steal __sv)
