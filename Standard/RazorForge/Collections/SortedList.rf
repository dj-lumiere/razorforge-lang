module Collections

import BuilderQuery

secret preset B_LIST: U64 = 64u64
secret preset MIN_KEYS_LIST: U64 = 31u64

### Internal B-tree node for {SortedList[T]}.
### Stores up to 63 ordered keys, up to 64 child pointers, and a cached subtree element count.
### :typeparam T: The stored element type.
entity BTreeListNode[AnyType T]
needs T obeys Comparable
  keys: Array[T, 63]
  children: Array[Hijacked[BTreeListNode[T]], 64]
  key_count: U64
  child_count: U64
  subtree_size: U64
  is_leaf: Bool

### A sorted list that preserves duplicate elements, backed by a B-tree.
###
### `SortedList[T]` automatically maintains elements in ascending order on every insert and
### remove. Unlike {List[T]}, you cannot append at an arbitrary position — elements always
### land in their sorted slot. Unlike {SortedSet[T]}, duplicate values are allowed and each
### copy is stored independently.
###
### **When to use**
### - You need a sorted sequence that allows duplicates.
### - You need O(log n) rank-based indexed access (`list[3]` gives the 4th smallest element).
### - You need efficient range queries: all elements between two bounds.
### - You need `count_of` to count how many times a value appears.
###
### **Complexity**
### | Operation | Time |
### |---|---|
### | `add` | O(log n) |
### | `remove` / `remove_all` | O(log n) per removal |
### | `contains` | O(log n) |
### | `count_of` | O(k + log n), k = occurrences |
### | `[]` indexed access | O(log n) |
### | `range` | O(k + log n), k = results |
### | `min!` / `max!` | O(log n) |
### | Iteration | O(n) |
###
### :typeparam T: The stored element type. Must obey {Comparable}.
### :see: {SortedSet[T]} for a duplicate-free sorted collection.
### :see: {SortedDict[K, V]} for sorted key-value storage.
entity SortedList[AnyType T] obeys Iterable[T], Container, ListLiteral[T]
needs T obeys Comparable
relates SortedListEmittable[T] as Iter
  secret root: Hijacked[BTreeListNode[T]]?
  secret count: U64

# ============================================================================
# Node buffer helpers
# ============================================================================

### Returns the number of keys currently stored in this node.
### :returns: The key count.
@readonly
routine BTreeListNode[T].keys_count() -> U64
  return me.key_count

### Returns the number of child pointers currently stored in this node.
### :returns: The child count.
@readonly
routine BTreeListNode[T].children_count() -> U64
  return me.child_count

### Returns a raw pointer to the start of the keys buffer.
### :returns: A {Hijacked[T]} pointing to the first key slot.
@readonly
routine BTreeListNode[T].keys_base() -> Hijacked[T]
  return me.hijack().recast_as[T]()

### Returns a raw pointer to the start of the children buffer, offset past the keys region.
### :returns: A {Hijacked[BTreeListNode[T]]} pointing to the first child slot.
@readonly
routine BTreeListNode[T].children_base() -> Hijacked[Hijacked[BTreeListNode[T]]]
  return me.hijack().recast_as[T]().stride(count: 63_s64).recast_as[Hijacked[BTreeListNode[T]]]()

### Returns the key at slot `i`.
### :param i: Zero-based key index.
### :returns: The key value at position `i`.
@readonly
routine BTreeListNode[T].keys_get(i: U64) -> T
  danger
    return me.keys_base().stride(count: i.S64()).peek()

### Writes `value` to the key slot at position `i`.
### :param i: Zero-based key index.
### :param value: The key value to store.
routine BTreeListNode[T].keys_set(i: U64, value: T)
  danger
    me.keys_base().stride(count: i.S64()).poke(value: value)
  return

### Returns the child node at slot `i`.
### :param i: Zero-based child index.
### :returns: The child node at position `i`.
@readonly
routine BTreeListNode[T].children_get(i: U64) -> Hijacked[BTreeListNode[T]]
  danger
    return me.children_base().stride(count: i.S64()).peek()

### Writes `value` to the child slot at position `i`.
### :param i: Zero-based child index.
### :param value: The child node to store.
routine BTreeListNode[T].children_set(i: U64, value: Hijacked[BTreeListNode[T]])
  danger
    me.children_base().stride(count: i.S64()).poke(value: value)
  return

### Appends `value` after the last key and increments the key count.
### :param value: The key to append.
routine BTreeListNode[T].keys_add_last(value: T)
  danger
    me.keys_base().stride(count: me.key_count.S64()).poke(value: value)
  me.key_count = me.key_count +% 1u64
  return

### Appends `value` after the last child pointer and increments the child count.
### :param value: The child node to append.
routine BTreeListNode[T].children_add_last(value: Hijacked[BTreeListNode[T]])
  danger
    me.children_base().stride(count: me.child_count.S64()).poke(value: value)
  me.child_count = me.child_count +% 1u64
  return

### Recursively frees this node's subtree (post-order): destroys each child node, tears down each
### stored key, then frees this node's own allocation. Children/keys are visited inline (never bound
### to a `var`) so scope-exit teardown doesn't double-free them.
@override
dangerous routine BTreeListNode[T].destroy()
  if not me.is_leaf
    var ci = 0u64
    while ci < me.child_count
      me.children_get(ci).as_entity().destroy()
      ci = ci + 1u64
  var ki = 0u64
  while ki < me.key_count
    me.keys_get(ki).destroy()
    ki = ki + 1u64
  me.hijack().invalidate()
  return

### Cycle-collector TRACE: recurse into every child node, then report each stored key to the collector
### (a `Roamed` key reports its controller; a value key is a no-op). Overrides the universal member-walk
### (the keys live in a fixed inline array the generic walk cannot iterate).
@override
dangerous routine BTreeListNode[T].roam_trace()
  if not me.is_leaf
    var ci = 0u64
    while ci < me.child_count
      me.children_get(ci).as_entity().roam_trace()
      ci = ci + 1u64
  var ki = 0u64
  while ki < me.key_count
    me.keys_get(ki).cyclic_visit()
    ki = ki + 1u64
  return

### Cycle-collector FREE: recurse into every child node freeing the subtree, then free this node's own
### box — but NOT the stored keys (the collector frees the whole white cycle directly).
@override
dangerous routine BTreeListNode[T].roam_free()
  if not me.is_leaf
    var ci = 0u64
    while ci < me.child_count
      me.children_get(ci).as_entity().roam_free()
      ci = ci + 1u64
  me.hijack().invalidate()
  return

### Inserts `value` at position `i` in the keys buffer, shifting later keys right by one.
### :param i: Zero-based insertion index.
### :param value: The key to insert.
routine BTreeListNode[T].keys_add_at(i: U64, value: T)
  danger
    var base = me.keys_base()
    if i < me.key_count
      var elem_size = T.data_size()
      var shift_count = me.key_count -% i
      var src_addr = base.stride(count: i.S64()).get_address()
      var dst_addr = base.stride(count: (i +% 1u64).S64()).get_address()
      rf_copy_bytes_at(dest: dst_addr, src: src_addr, size: elem_size * shift_count)
    base.stride(count: i.S64()).poke(value: value)
  me.key_count = me.key_count +% 1u64
  return

### Inserts `value` at position `i` in the children buffer, shifting later pointers right by one.
### :param i: Zero-based insertion index.
### :param value: The child node to insert.
routine BTreeListNode[T].children_add_at(i: U64, value: Hijacked[BTreeListNode[T]])
  danger
    var base = me.children_base()
    if i < me.child_count
      var elem_size = Address.data_size()
      var shift_count = me.child_count -% i
      var src_addr = base.stride(count: i.S64()).get_address()
      var dst_addr = base.stride(count: (i +% 1u64).S64()).get_address()
      rf_copy_bytes_at(dest: dst_addr, src: src_addr, size: elem_size * shift_count)
    base.stride(count: i.S64()).poke(value: value)
  me.child_count = me.child_count +% 1u64
  return

### Removes the key at position `i`, shifting later keys left by one.
### :param i: Zero-based index of the key to remove.
routine BTreeListNode[T].keys_remove_at(i: U64)
  danger
    if i +% 1u64 < me.key_count
      var base = me.keys_base()
      var elem_size = T.data_size()
      var shift_count = me.key_count -% i -% 1u64
      var src_addr = base.stride(count: (i +% 1u64).S64()).get_address()
      var dst_addr = base.stride(count: i.S64()).get_address()
      rf_copy_bytes_at(dest: dst_addr, src: src_addr, size: elem_size * shift_count)
  me.key_count = me.key_count -% 1u64
  return

### Removes the child pointer at position `i`, shifting later pointers left by one.
### :param i: Zero-based index of the child to remove.
routine BTreeListNode[T].children_remove_at(i: U64)
  danger
    if i +% 1u64 < me.child_count
      var base = me.children_base()
      var elem_size = Address.data_size()
      var shift_count = me.child_count -% i -% 1u64
      var src_addr = base.stride(count: (i +% 1u64).S64()).get_address()
      var dst_addr = base.stride(count: i.S64()).get_address()
      rf_copy_bytes_at(dest: dst_addr, src: src_addr, size: elem_size * shift_count)
  me.child_count = me.child_count -% 1u64
  return

### Decrements the key count, logically removing the last key without zeroing memory.
routine BTreeListNode[T].keys_remove_last()
  me.key_count = me.key_count -% 1u64
  return

### Decrements the child count, logically removing the last child pointer without zeroing memory.
routine BTreeListNode[T].children_remove_last()
  me.child_count = me.child_count -% 1u64
  return

### Sets the key count to `n`, discarding all keys at or after index `n`.
### :param n: The new key count.
routine BTreeListNode[T].keys_truncate(n: U64)
  me.key_count = n
  return

### Sets the child count to `n`, discarding all children at or after index `n`.
### :param n: The new child count.
routine BTreeListNode[T].children_truncate(n: U64)
  me.child_count = n
  return

### Bulk-copies `count` keys from `other` starting at `start` into this node's keys buffer.
### :param you: The source node to copy from.
### :param start: Zero-based start index in `other`.
### :param count: Number of keys to copy.
routine BTreeListNode[T].keys_add_range_from(you: Accessing[BTreeListNode[T]], start: U64, count: U64)
  if count > 0u64
    danger
      var elem_size = T.data_size()
      var src_addr = you.keys_base().stride(count: start.S64()).get_address()
      var dst_addr = me.keys_base().stride(count: me.key_count.S64()).get_address()
      rf_copy_bytes_at(dest: dst_addr, src: src_addr, size: elem_size * count)
  me.key_count = me.key_count +% count
  return

### Bulk-copies `count` child pointers from `other` starting at `start` into this node's children buffer.
### :param you: The source node to copy from.
### :param start: Zero-based start index in `other`.
### :param count: Number of child pointers to copy.
routine BTreeListNode[T].children_add_range_from(you: Accessing[BTreeListNode[T]], start: U64, count: U64)
  if count > 0u64
    danger
      var elem_size = Address.data_size()
      var src_addr = you.children_base().stride(count: start.S64()).get_address()
      var dst_addr = me.children_base().stride(count: me.child_count.S64()).get_address()
      rf_copy_bytes_at(dest: dst_addr, src: src_addr, size: elem_size * count)
  me.child_count = me.child_count +% count
  return

# ============================================================================
# Creators
# ============================================================================

routine BTreeListNode[T](is_leaf: Bool) -> BTreeListNode[T]
  return BTreeListNode[T](
    keys: LLVM::zero_value[Array[T, 63]](),
    children: LLVM::zero_value[Array[Hijacked[BTreeListNode[T]], 64]](),
    key_count: 0u64,
    child_count: 0u64,
    subtree_size: 0u64,
    is_leaf: is_leaf
  )

routine SortedList[T]() -> SortedList[T]
  return SortedList[T](
    root: none,
    count: 0u64
  )

### Creates a sorted list containing the given `elements` (inserted in sorted order). Variadic
### constructor behind the `[a, b, c]` list-literal syntax (the `ListLiteral` opt-in).
### :param elements: The elements to insert; final order is sorted, not argument order.
### :returns: A sorted list of the given elements.
common routine SortedList[T].from_literal(elements...: T) -> SortedList[T]
needs T obeys Comparable
  var result = SortedList[T]()
  var i = 0u64
  while i < elements.count()
    result.add(value: elements[i])
    i = i +% 1u64
  return result


# ============================================================================
# Core
# ============================================================================

### Returns the total number of elements in this list, counting duplicates separately.
### :returns: The element count.
@readonly
routine SortedList[T].count() -> U64
  return me.count

### Returns true if this list contains no elements.
### :returns: `true` when `count()` is zero.
@readonly
routine SortedList[T].is_empty() -> Bool
  return me.count == 0u64

### Removes all elements, resetting the list to an empty state.
routine SortedList[T].clear()
  me.root = none
  me.count = 0u64
  return

### Frees the entire backing B-tree — every node and each stored element — when the list goes out
### of scope. The root node is visited inline (never bound to a `var`) so scope-exit teardown
### doesn't double-free it.
@override
dangerous routine SortedList[T].destroy()
  if me.root is None
    me.hijack().invalidate()
    return
  me.root!!.as_entity().destroy()
  me.hijack().invalidate()
  return

### Cycle-collector TRACE: delegate to the root node's recursive trace (reports every key in the tree).
@override
dangerous routine SortedList[T].roam_trace()
  if me.root is None
    return
  me.root!!.as_entity().roam_trace()
  return

### Cycle-collector FREE: free the whole B-tree (every node) via the root's recursive free, then free
### this list's own box — but NOT the stored keys (the collector frees the whole white cycle directly).
@override
dangerous routine SortedList[T].roam_free()
  if me.root is None
    me.hijack().invalidate()
    return
  me.root!!.as_entity().roam_free()
  me.hijack().invalidate()
  return

# ============================================================================
# Search
# ============================================================================

### Returns true if `value` appears at least once in this list.
### :param value: The value to search for.
### :returns: `true` if the value is present.
@readonly
routine SortedList[T].contains(value: T) -> Bool
  if me.root is None
    return false
  danger
    var root_ref = me.root!!.as_entity()
    return me.search_node(node: root_ref, value: value)

### Descends the subtree rooted at `node` to find `value`.
### :param node: The subtree root to search.
### :param value: The value to find.
### :returns: `true` if found anywhere in the subtree.
@readonly
@inline
routine SortedList[T].search_node(node: Accessing[BTreeListNode[T]], value: T) -> Bool
  danger
    var i = me.lower_bound(node: node, value: value)
    if i < node.keys_count() and value == node.keys_get(i)
      return true
    if node.is_leaf
      return false
    return me.search_node(node: node.children_get(i).as_entity(), value: value)

### Returns the number of times `value` appears in this list.
### :param value: The value to count.
### :returns: The occurrence count; zero if the value is not present.
@readonly
routine SortedList[T].count_of(value: T) -> U64
  if me.root is None
    return 0u64
  danger
    var root_ref = me.root!!.as_entity()
    return me.count_in_node(node: root_ref, value: value)

### Counts occurrences of `value` in the subtree rooted at `node`.
### :param node: The subtree root to search.
### :param value: The value to count.
### :returns: Number of occurrences found in the subtree.
@readonly
routine SortedList[T].count_in_node(node: Accessing[BTreeListNode[T]], value: T) -> U64
  danger
    var count = 0u64
    var i = 0u64
    while i < node.keys_count()
      if not node.is_leaf
        count = count +% me.count_in_node(node: node.children_get(i).as_entity(), value: value)
      if node.keys_get(i) == value
        count = count +% 1u64
      i = i +% 1u64
    if not node.is_leaf
      count = count +% me.count_in_node(node: node.children_get(node.children_count() -% 1u64).as_entity(), value: value)
    return count

### Binary search: returns the leftmost index where `node.keys[i] >= value`.
### :param node: The node whose keys are searched.
### :param value: The target value.
### :returns: Smallest index `i` where `node.keys[i] >= value`, or `keys_count()` if all keys are smaller.
@readonly
@inline
routine SortedList[T].lower_bound(node: Accessing[BTreeListNode[T]], value: T) -> U64
  var lo = 0u64
  var hi = node.keys_count()
  while lo < hi
    var mid = lo +% LLVM::unsigned_div(hi -% lo, 2u64)
    if node.keys_get(mid) < value
      lo = mid +% 1u64
    else
      hi = mid
  return lo

### Binary search: returns the leftmost index where `node.keys[i] > value`.
### :param node: The node whose keys are searched.
### :param value: The target value.
### :returns: Smallest index `i` where `node.keys[i] > value`, or `keys_count()` if all keys are `<= value`.
@readonly
@inline
routine SortedList[T].upper_bound(node: Accessing[BTreeListNode[T]], value: T) -> U64
  var lo = 0u64
  var hi = node.keys_count()
  while lo < hi
    var mid = lo +% LLVM::unsigned_div(hi -% lo, 2u64)
    if node.keys_get(mid) <= value
      lo = mid +% 1u64
    else
      hi = mid
  return lo

# ============================================================================
# Insert
# ============================================================================

### Inserts `value` into the list in sorted order, allowing duplicates.
### :param value: The element to insert.
routine SortedList[T].add(value: T)
  if me.root is None
    danger
      me.root = BTreeListNode[T](is_leaf: true).hijack()
      me.root!!.as_entity().keys_add_last(value)
      me.root!!.as_entity().subtree_size = 1u64
    me.count = 1u64
    return

  var root_full = false
  danger
    root_full = me.root!!.as_entity().keys_count() >= B_LIST -% 1u64
  if root_full
    danger
      var old_root = me.root!!
      me.root = BTreeListNode[T](is_leaf: false).hijack()
      var new_root = me.root!!.as_entity()
      new_root.children_add_last(value: old_root)
      me.split_child(parent_node: new_root, child_idx: 0u64)
      new_root.subtree_size = new_root.children_get(0u64).as_entity().subtree_size +% new_root.children_get(1u64).as_entity().subtree_size +% 1u64

  danger
    var root_ref = me.root!!.as_entity()
    me.insert_non_full(node: root_ref, value: value)
  me.count = me.count +% 1u64
  return

### Inserts `value` into `node`, which must have at least one free key slot.
### :param node: A non-full node to insert into.
### :param value: The element to insert.
@inline
routine SortedList[T].insert_non_full(node: Controlling[BTreeListNode[T]], value: T)
  danger
    if node.is_leaf
      var i = me.upper_bound(node: node, value: value)
      node.keys_add_at(i: i, value: value)
      node.subtree_size = node.subtree_size +% 1u64
    else
      var i = me.upper_bound(node: node, value: value)
      if node.children_get(i).as_entity().keys_count() >= B_LIST -% 1u64
        me.split_child(parent_node: node, child_idx: i)
        if value > node.keys_get(i)
          i = i +% 1u64
      me.insert_non_full(node: node.children_get(i).as_entity(), value: value)
      node.subtree_size = node.subtree_size +% 1u64
    return

### Splits the full child at index `child_idx`, promoting its median key up to `parent_node`.
### :param parent_node: The parent node that owns the full child.
### :param child_idx: Index of the full child within `parent_node`'s children buffer.
@inline
routine SortedList[T].split_child(parent_node: Controlling[BTreeListNode[T]], child_idx: U64)
  danger
    var child = parent_node.children_get(child_idx).as_entity()
    var mid = LLVM::unsigned_div(B_LIST -% 1u64, 2u64)

    var new_node_ptr = BTreeListNode[T](is_leaf: child.is_leaf).hijack()
    var new_node = new_node_ptr.as_entity()
    new_node.keys_add_range_from(you: child, start: mid +% 1u64, count: child.keys_count() -% mid -% 1u64)

    if not child.is_leaf
      new_node.children_add_range_from(you: child, start: mid +% 1u64, count: child.children_count() -% mid -% 1u64)

    var mid_key = child.keys_get(mid)
    child.keys_truncate(mid)
    if not child.is_leaf
      child.children_truncate(mid +% 1u64)

    if child.is_leaf
      child.subtree_size = child.keys_count()
      new_node.subtree_size = new_node.keys_count()
    else
      var left_size = child.keys_count()
      var i = 0u64
      while i < child.children_count()
        left_size = left_size +% child.children_get(i).as_entity().subtree_size
        i = i +% 1u64
      child.subtree_size = left_size
      var right_size = new_node.keys_count()
      i = 0u64
      while i < new_node.children_count()
        right_size = right_size +% new_node.children_get(i).as_entity().subtree_size
        i = i +% 1u64
      new_node.subtree_size = right_size

    parent_node.keys_add_at(i: child_idx, value: mid_key)
    parent_node.children_add_at(i: child_idx +% 1u64, value: new_node_ptr)
    return

# ============================================================================
# Remove
# ============================================================================

### Removes one occurrence of `value` from the list.
### If the value appears multiple times, only one copy is removed.
### :param value: The value to remove.
### :returns: `true` if a matching element was found and removed; `false` if not present.
routine SortedList[T].remove(value: T) -> Bool
  if me.root is None
    return false

  var removed = false
  danger
    var root_ref = me.root!!.as_entity()
    removed = me.remove_from_node(node: root_ref, value: value)
  if removed
    me.count = me.count -% 1u64
    danger
      if me.root!!.as_entity().keys_count() == 0u64 and not me.root!!.as_entity().is_leaf
        me.root = me.root!!.as_entity().children_get(0u64)
      if me.root!!.as_entity().keys_count() == 0u64
        me.root = none
  return removed

### Descends `node` to delete one occurrence of `value`, rebalancing on the way back up.
### :param node: The subtree root to search and remove from.
### :param value: The value to remove.
### :returns: `true` if a matching element was found and removed.
@inline
routine SortedList[T].remove_from_node(node: Controlling[BTreeListNode[T]], value: T) -> Bool
  danger
    var i = me.lower_bound(node: node, value: value)

    if i < node.keys_count() and value == node.keys_get(i)
      if node.is_leaf
        node.keys_remove_at(i)
        node.subtree_size = node.subtree_size -% 1u64
        return true
      else
        var left = node.children_get(i).as_entity()
        var right = node.children_get(i +% 1u64).as_entity()
        if left.keys_count() > MIN_KEYS_LIST
          var pred = me.get_predecessor(node: node, idx: i)
          node.keys_set(i: i, value: pred)
          me.remove_from_node(node: left, value: pred)
          node.subtree_size = node.subtree_size -% 1u64
          return true
        elseif right.keys_count() > MIN_KEYS_LIST
          var succ = me.get_successor(node: node, idx: i)
          node.keys_set(i: i, value: succ)
          me.remove_from_node(node: right, value: succ)
          node.subtree_size = node.subtree_size -% 1u64
          return true
        else
          me.merge_children_at(node: node, i: i)
          var removed = me.remove_from_node(node: node.children_get(i).as_entity(), value: value)
          if removed
            node.subtree_size = node.subtree_size -% 1u64
          return removed
    else
      if node.is_leaf
        return false
      i = me.fix_child(node: node, i: i)
      var removed = me.remove_from_node(node: node.children_get(i).as_entity(), value: value)
      if removed
        node.subtree_size = node.subtree_size -% 1u64
      return removed

### Returns the largest key in the left subtree of `node.children[idx]`.
### :param node: The parent node.
### :param idx: Index of the separator key whose left child to descend.
### :returns: The in-order predecessor key.
@inline
routine SortedList[T].get_predecessor(node: Accessing[BTreeListNode[T]], idx: U64) -> T
  danger
    var current = node.children_get(idx).as_entity()
    while not current.is_leaf
      current = current.children_get(current.children_count() -% 1u64).as_entity()
    return current.keys_get(current.keys_count() -% 1u64)

### Returns the smallest key in the right subtree of `node.children[idx + 1]`.
### :param node: The parent node.
### :param idx: Index of the separator key whose right child to descend.
### :returns: The in-order successor key.
@inline
routine SortedList[T].get_successor(node: Accessing[BTreeListNode[T]], idx: U64) -> T
  danger
    var current = node.children_get(idx +% 1u64).as_entity()
    while not current.is_leaf
      current = current.children_get(0u64).as_entity()
    return current.keys_get(0u64)

### Merges `node.children[i + 1]` into `node.children[i]`, pulling down the separator key at `node.keys[i]`.
### :param node: The parent node whose two adjacent children are merged.
### :param i: Index of the separator key and the left child that absorbs the right.
@inline
routine SortedList[T].merge_children_at(node: Controlling[BTreeListNode[T]], i: U64)
  danger
    var left = node.children_get(i).as_entity()
    var right = node.children_get(i +% 1u64).as_entity()

    left.keys_add_last(node.keys_get(i))
    left.keys_add_range_from(you: right, start: 0u64, count: right.keys_count())
    if not right.is_leaf
      left.children_add_range_from(you: right, start: 0u64, count: right.children_count())
    left.subtree_size = left.subtree_size +% right.subtree_size +% 1u64

    node.keys_remove_at(i)
    node.children_remove_at(i +% 1u64)
    return

### Ensures `node.children[i]` has enough keys for safe descent; rotates or merges siblings as needed.
### :param node: The parent node whose child needs fixing.
### :param i: The child index that is about to be descended into.
### :returns: The adjusted child index after any rotation or merge.
@inline
routine SortedList[T].fix_child(node: Controlling[BTreeListNode[T]], i: U64) -> U64
  danger
    if node.children_get(i).as_entity().keys_count() > MIN_KEYS_LIST
      return i
    if i > 0u64 and node.children_get(i -% 1u64).as_entity().keys_count() > MIN_KEYS_LIST
      me.rotate_right_at(node: node, i: i)
      return i
    if i +% 1u64 < node.children_count() and node.children_get(i +% 1u64).as_entity().keys_count() > MIN_KEYS_LIST
      me.rotate_left_at(node: node, i: i)
      return i
    if i > 0u64
      me.merge_children_at(node: node, i: i -% 1u64)
      return i -% 1u64
    me.merge_children_at(node: node, i: i)
    return i

### Borrows the last key from the left sibling of `node.children[i]` through the parent separator.
### :param node: The parent node.
### :param i: Index of the child that receives the borrowed key.
@inline
routine SortedList[T].rotate_right_at(node: Controlling[BTreeListNode[T]], i: U64)
  danger
    var left = node.children_get(i -% 1u64).as_entity()
    var child = node.children_get(i).as_entity()

    child.keys_add_at(i: 0u64, value: node.keys_get(i -% 1u64))
    if not child.is_leaf
      child.children_add_at(i: 0u64, value: left.children_get(left.children_count() -% 1u64).as_entity().hijack())
      left.children_remove_last()
    node.keys_set(i: i -% 1u64, value: left.keys_get(left.keys_count() -% 1u64))
    left.keys_remove_last()
    me.update_subtree_size(left)
    me.update_subtree_size(child)
    return

### Borrows the first key from the right sibling of `node.children[i]` through the parent separator.
### :param node: The parent node.
### :param i: Index of the child that receives the borrowed key.
@inline
routine SortedList[T].rotate_left_at(node: Controlling[BTreeListNode[T]], i: U64)
  danger
    var right = node.children_get(i +% 1u64).as_entity()
    var child = node.children_get(i).as_entity()

    child.keys_add_last(node.keys_get(i))
    if not child.is_leaf
      child.children_add_last(right.children_get(0u64).as_entity().hijack())
      right.children_remove_at(0u64)
    node.keys_set(i: i, value: right.keys_get(0u64))
    right.keys_remove_at(0u64)
    me.update_subtree_size(right)
    me.update_subtree_size(child)
    return

### Recomputes `node.subtree_size` from its keys and children.
### :param node: The node whose subtree size is to be refreshed.
@inline
routine SortedList[T].update_subtree_size(node: Controlling[BTreeListNode[T]])
  danger
    if node.is_leaf
      node.subtree_size = node.keys_count()
    else
      var size = node.keys_count()
      var i = 0u64
      while i < node.children_count()
        size = size +% node.children_get(i).as_entity().subtree_size
        i = i +% 1u64
      node.subtree_size = size
    return

### Removes every occurrence of `value` from the list.
### :param value: The value whose every copy is removed.
### :returns: The number of elements that were removed.
routine SortedList[T].remove_all(value: T) -> U64
  var removed = 0u64
  while me.remove(value)
    removed = removed +% 1u64
  return removed

# ============================================================================
# Rank-based access (replaces [] indexing — cost is O(log n))
# ============================================================================

### Returns the element at zero-based sorted rank `rank`.
### Unlike List's O(1) `[]`, this is O(log n) because the tree must be descended.
### :param rank: Zero-based position in sorted order.
### :returns: The element at that rank.
### :throws: {IndexOutOfBoundsError} if `rank >= count()`.
@readonly
routine SortedList[T].get_by_rank!(rank: U64) -> T
  if rank >= me.count
    throw IndexOutOfBoundsError(index: rank, count: me.count)
  danger
    var root_ref = me.root!!.as_entity()
    return me.get_at_subtree_rank(node: root_ref, rank: rank)

### Returns the element at zero-based sorted rank `rank` within `node`'s subtree.
### :param node: The subtree root to search.
### :param rank: Zero-based position in the in-order traversal of this subtree.
### :returns: The element at that rank.
@readonly
routine SortedList[T].get_at_subtree_rank(node: Accessing[BTreeListNode[T]], rank: U64) -> T
  danger
    if node.is_leaf
      return node.keys_get(rank)

    var remaining = rank
    var i = 0u64
    while i < node.children_count()
      var child_size = node.children_get(i).as_entity().subtree_size
      if remaining < child_size
        return me.get_at_subtree_rank(node: node.children_get(i).as_entity(), rank: remaining)
      remaining = remaining -% child_size
      if i < node.keys_count()
        if remaining == 0u64
          return node.keys_get(i)
        remaining = remaining -% 1u64
      i = i +% 1u64
    return node.keys_get(0u64)

# ============================================================================
# Range
# ============================================================================

### Returns all elements in the closed interval `[min_val, max_val]`, in ascending order.
### Both bounds are inclusive. If no elements fall in the range, an empty list is returned.
### :param min_val: Inclusive lower bound.
### :param max_val: Inclusive upper bound.
### :returns: A {List[T]} of all matching elements in sorted order.
@readonly
routine SortedList[T].range(min_val: T, max_val: T) -> List[T]
  var result = List[T]()
  if me.root is None
    pass
  else
    danger
      var root_ref = me.root!!.as_entity()
      me.range_collect(node: root_ref, min_val: min_val, max_val: max_val, result: result)
  return steal result

### Appends elements in `[min_val, max_val]` from `node`'s subtree into `result`.
### :param node: The subtree root to traverse.
### :param min_val: Inclusive lower bound.
### :param max_val: Inclusive upper bound.
### :param result: The list to append matching elements into.
@readonly
routine SortedList[T].range_collect(node: Accessing[BTreeListNode[T]], min_val: T, max_val: T, result: Controlling[List[T]])
  danger
    var i = 0u64
    while i < node.keys_count()
      if not node.is_leaf and (i == 0u64 or node.keys_get(i -% 1u64) >= min_val)
        me.range_collect(node: node.children_get(i).as_entity(), min_val: min_val, max_val: max_val, result: result)
      var key = node.keys_get(i)
      if key >= min_val and key <= max_val
        result.add_last(key)
      i = i +% 1u64
    if not node.is_leaf
      me.range_collect(node: node.children_get(node.children_count() -% 1u64).as_entity(), min_val: min_val, max_val: max_val, result: result)
    return

# ============================================================================
# Min/Max
# ============================================================================

### Returns the smallest element in the list.
### :returns: The minimum element.
### :absent: The list is empty.
@readonly
routine SortedList[T].min!() -> T
  if me.is_empty()
    absent
  danger
    var node = me.root!!.as_entity()
    while not node.is_leaf
      node = node.children_get(0u64).as_entity()
    return node.keys_get(0u64)

### Returns the largest element in the list.
### :returns: The maximum element.
### :absent: The list is empty.
@readonly
routine SortedList[T].max!() -> T
  if me.is_empty()
    absent
  danger
    var node = me.root!!.as_entity()
    while not node.is_leaf
      node = node.children_get(node.children_count() -% 1u64).as_entity()
    return node.keys_get(node.keys_count() -% 1u64)

### Returns the smallest element. Alias for {SortedList[T].min()}.
### :returns: The first (minimum) element.
### :absent: The list is empty.
@readonly
routine SortedList[T].first!() -> T
  return me.min()

### Returns the largest element. Alias for {SortedList[T].max()}.
### :returns: The last (maximum) element.
### :absent: The list is empty.
@readonly
routine SortedList[T].last!() -> T
  return me.max()

# ============================================================================
# Iteration
# ============================================================================

@readonly
routine SortedList[T].iter() -> SortedListEmittable[T]
  danger
    return SortedListEmittable[T](list: me.hijack(), index: 0u64)

### Creates a {List[T]} from all elements of `from` in ascending sorted order.
### :param from: The sorted list to convert.
### :returns: A new {List[T]} containing all elements in ascending order.
routine List[T](from: SortedList[T]) -> List[T]
  var result = List[T](capacity: from.count)
  if from.root is None
    pass
  else
    danger
      var root_ref = from.root!!.as_entity()
      from.collect_inorder(node: root_ref, result: result)
  return steal result

### Appends all keys from `node`'s subtree into `result` via in-order traversal.
### :param node: The subtree root to traverse.
### :param result: The list to append elements into.
@readonly
routine SortedList[T].collect_inorder(node: Accessing[BTreeListNode[T]], result: Controlling[List[T]])
  danger
    var i = 0u64
    while i < node.keys_count()
      if not node.is_leaf
        me.collect_inorder(node: node.children_get(i).as_entity(), result: result)
      result.add_last(node.keys_get(i))
      i = i +% 1u64
    if not node.is_leaf
      me.collect_inorder(node: node.children_get(node.children_count() -% 1u64).as_entity(), result: result)
    return

### Emittable that yields elements of a {SortedList[T]} in ascending order.
### :typeparam T: The stored element type.
entity SortedListEmittable[AnyType T] obeys Emittable[T]
  list: Hijacked[SortedList[T]]
  index: U64

routine SortedListEmittable[T].emit!() -> T
  danger
    if me.index >= me.list.as_entity().count()
      absent
    var _result = me.list.as_entity().get_by_rank(rank: me.index)
    me.index = me.index + 1u64
    return _result

# ============================================================================
# Display / Equality
# ============================================================================

@[readonly, override]
routine SortedList[T].represent() -> Text
  var result = me.type_name() + "(["
  var i = 0u64
  each v in me
    if i > 0u64
      result = result + ", "
    result = result + nested_repr(v)
    i = i +% 1u64
  result = result + "])"
  return steal result

@[readonly, override]
routine SortedList[T].diagnose() -> Text
  var result = me.full_type_name() + "(count: " + me.count().represent() + ", ["
  var i = 0u64
  each v in me
    if i > 0u64
      result = result + ", "
    result = result + nested_repr(v)
    i = i +% 1u64
  result = result + "])"
  return steal result

### Returns true if both lists contain exactly the same elements in the same order.
### :param you: The list to compare against.
### :returns: `true` if element-wise equal.
@readonly
routine SortedList[T].eq(you: Accessing[SortedList[T]]) -> Bool
  if me.count != you.count
    return false
  var i = 0u64
  while i < me.count
    if me.try_get_by_rank(rank: i)!! != you.try_get_by_rank(rank: i)!!
      return false
    i = i +% 1u64
  return true

### Serializes this collection to a `SerialValue.List`, serializing each element.
### :returns: The `SerialValue.List` of each element's serialized form.
@[readonly, override]
routine SortedList[T].serialize() -> SerialValue
  var __sv = List[SerialValue]()
  each __x in me
    __sv.add_last(value: __x.serialize())
  return SerialValue(steal __sv)
