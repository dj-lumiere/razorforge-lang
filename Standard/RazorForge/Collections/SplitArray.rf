module Collections

import BuilderQuery
import BuilderExpansion

### A fixed-size, struct-of-arrays (SoA) array of `N` records with value semantics.
###
### `SplitArray[T, N]` is the SoA counterpart of {Array[T, N]}: instead of storing `N` whole `T`
### values inline (array-of-structs), it stores each FIELD of the element record `T` in its own
### inline `Array[fieldType, N]` column. Indexing copies a whole `T` out — gathering one value from
### each column — so the surface matches `Array[T, N]`'s value-out `getitem`; the payoff is
### cache-friendly per-field scans and per-field bulk work.
###
### Like `Array`, it never heap-allocates: every column is packed directly into the record's own
### footprint, copying the `SplitArray` copies all `N` elements, and the size can never change after
### construction. The element type must be `Splittable` (trivially destructible — its footprint
### reduces to `@llvm` primitives with no custom store/destroy), so each column is a flat blittable
### `Array`.
###
### Storage is realized by a decl-position `expand m in allmemvarof(T)`: one `Array[$typeof(m), N]`
### column per field of `T`, materialized per concrete instantiation.
###
### **When to use**
### - The element count is a compile-time constant AND you scan/update fields in bulk (SoA wins on cache).
### - Use {Array[T, N]} for the array-of-structs layout (whole-element locality).
### - Use {SplitList[T]} when the count is only known at runtime.
###
### **Complexity**
### | Operation | Time |
### |---|---|
### | `getitem!` / `setitem!` | O(fields) |
### | `contains` / `index_of!` | O(N) |
### | Iteration | O(N) |
###
### :typeparam T: The record element type (must be `Splittable`).
### :typeparam N: The compile-time element count, supplied as a `U64` literal.
### :see: {Array[T, N]} for the array-of-structs counterpart.
### :see: {SplitList[T]} for the growable, heap-backed SoA sequence.
record SplitArray[AnyType T, U64 N] obeys Comparable, Iterable[T], MutableIndexable[T], Sized, Container
needs T obeys Splittable
relates SplitArrayEmittable[T, N] as Iter
  expand m in allmemvarof(T)
    ### One inline column holding this field across every element.
    secret $nameof(m): Array[$typeof(m), N]

# ============================================================================
# Indexing
# ============================================================================

### Returns the element at `index`, gathering one value from each column. Enables `array[i]`.
### :param index: The zero-based position to read.
### :returns: The reconstructed element.
### :throws: {IndexOutOfBoundsError} if `index >= N`.
@readonly
routine SplitArray[T, N].getitem!(index: U64) -> T
  if index >= N
    throw IndexOutOfBoundsError(index: index, count: N)
  var result = T.blank()
  expand m in allmemvarof(T)
    danger
      result.$nameof(m) = me.$nameof(m)[index]
  return result

### Overwrites the element at `index`, scattering each field into its column. Enables `array[i] = value`.
### `me` is received by reference (struct-record `setitem!`), so the per-column writes reach the
### caller's storage directly — no whole-array copy.
### :param index: The zero-based position to update.
### :param value: The replacement element.
### :throws: {IndexOutOfBoundsError} if `index >= N`.
routine SplitArray[T, N].setitem!(index: U64, value: T)
  if index >= N
    throw IndexOutOfBoundsError(index: index, count: N)
  expand m in allmemvarof(T)
    danger
      me.$nameof(m)[index] = value.$nameof(m)
  return

# ============================================================================
# Query Operations
# ============================================================================

### Returns the fixed number of elements, always equal to the compile-time parameter `N`.
### :returns: The element count `N`.
@readonly
routine SplitArray[T, N].count() -> U64
  return N

### Returns true when the compile-time size is zero.
### :returns: `true` if `N == 0`.
@readonly
routine SplitArray[T, N].is_empty() -> Bool
  return N == 0u64

### Returns the first element of the array.
### :returns: The element at index `0`.
### :absent: The array has zero elements (`N == 0`).
@readonly
routine SplitArray[T, N].first!() -> T
  if N == 0u64
    absent
  return me[0u64]

### Returns the last element of the array.
### :returns: The element at index `N - 1`.
### :absent: The array has zero elements (`N == 0`).
@readonly
routine SplitArray[T, N].last!() -> T
  if N == 0u64
    absent
  return me[N - 1u64]

### Returns true if any element equals `value`. O(N): reconstructs each element from the columns
### and compares by value.
### :param value: The value to search for.
### :returns: `true` if a matching element is present.
@readonly
routine SplitArray[T, N].contains(value: T) -> Bool
needs T obeys Equatable
  each i in 0u64 til N
    if me[i] == value
      return true
  return false

### Returns the index of the first element equal to `value`.
### :param value: The value to search for.
### :returns: The zero-based index of the first match.
### :absent: No element equals `value`.
@readonly
routine SplitArray[T, N].index_of!(value: T) -> U64
needs T obeys Equatable
  each i in 0u64 til N
    if me[i] == value
      return i
  absent

# ============================================================================
# Iteration Support
# ============================================================================

### Walks the elements of a fixed-size `SplitArray[T, N]` from index 0 to N - 1, reconstructing each
### `T` from the columns in order. Because `SplitArray` is a record type, the iterator holds its own
### copy of the column data.
### :typeparam T: The element type yielded by the iterator.
### :typeparam N: The compile-time element count.
entity SplitArrayEmittable[AnyType T, U64 N] obeys Emittable[T]
needs T obeys Splittable
  ### Stores the split array being iterated.
  source: SplitArray[T, N]
  ### Stores the next logical index to read.
  index: U64

@readonly
routine SplitArray[T, N].iter() -> SplitArrayEmittable[T, N]
  return SplitArrayEmittable[T, N](source: me, index: 0u64)

### Produces the next element and advances, or `absent`s when the sequence is exhausted.
### :returns: The element at the current index.
### :absent: All `N` elements have been yielded.
routine SplitArrayEmittable[T, N].emit!() -> T
  if me.index >= N
    absent
  var value = me.source[me.index]
  me.index = me.index + 1u64
  return value

# ============================================================================
# Display
# ============================================================================

@[readonly, override]
routine SplitArray[T, N].represent() -> Text
  var result = "SplitArray(["
  each i in 0u64 til N
    if i > 0u64
      result = result + ", "
    result = result + nested_repr(me[i])
  result = result + "])"
  return result

@[readonly, override]
routine SplitArray[T, N].diagnose() -> Text
  var result = me.full_type_name() + "(["
  each i in 0u64 til N
    if i > 0u64
      result = result + ", "
    result = result + nested_repr(me[i])
  result = result + "])"
  return result

# ============================================================================
# Comparison
# ============================================================================

### Returns true when both arrays contain equal elements in the same order.
### :param you: The other array to compare against.
### :returns: `true` if every corresponding pair of elements is equal.
### :note: Requires `T` to obey `Equatable`.
@readonly
routine SplitArray[T, N].eq(you: SplitArray[T, N]) -> Bool
needs T obeys Equatable
  each i in 0u64 til N
    if me[i] != you[i]
      return false
  return true

### Lexicographic comparison of two arrays of equal length. Compares element by element from index 0
### using `T.cmp`; returns at the first non-equal pair, or `SAME` when every pair is equal.
### :param you: The other array to compare against.
### :returns: `ME_SMALL`, `SAME`, or `ME_LARGE`.
### :note: Requires `T` to obey `Comparable`.
@readonly
routine SplitArray[T, N].cmp(you: SplitArray[T, N]) -> ComparisonSign
needs T obeys Comparable
  each i in 0u64 til N
    var sign = me[i].cmp(you[i])
    if sign isnot SAME
      return sign
  return SAME