module Core

### Platform-neutral basic API for {CWChar}. The width-specific representation and the `U32` widen/narrow
### conversions live in the `@target`-gated `CWChar_windows` / `CWChar_unix` siblings; these members build on
### the widen conversion (total on both widths), so they are shared and load on every target.

### Returns this wide character as an unsigned numeric code-unit value.
### :returns: The resulting `U32` value.
@readonly
routine CWChar.codepoint() -> U32
  return U32(from: me)

### Returns whether both values are equal.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
@readonly
routine CWChar.eq(you: CWChar) -> Bool
  return U32(from: me) == U32(from: you)

### Compares this value with the other value.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
@readonly
routine CWChar.cmp(you: CWChar) -> ComparisonSign
  return U32(from: me) <=> U32(from: you)

### Returns the display form of this C `wchar_t`, rendered as its decimal code-unit value.
### :returns: The resulting `Text` value.
@[readonly, override]
routine CWChar.represent() -> Text
  return U32(from: me).represent()

### Returns the diagnostic form of this C `wchar_t`.
### :returns: The resulting `Text` value.
@[readonly, override]
routine CWChar.diagnose() -> Text
  return "CWChar(" + U32(from: me).represent() + ")"

### Returns a keyed hash of this value using SipHash-2-4.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: The resulting `U64` value.
@readonly
routine CWChar.hash(k0: U64, k1: U64) -> U64
  return U32(from: me).hash(k0: k0, k1: k1)
