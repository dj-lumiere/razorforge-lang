module Core

import BuilderQuery

### Represents temporary read-only access to an entity.
### `Viewing[T]` is the non-Assignable access token produced by `.view()` for single-threaded observation.
### :typeparam T: The entity type being viewed.
### :see: {Modifying[T]}, {Amending[T]}, {Consulting[T]}, {Access-Types}
@llvm("ptr")
record Viewing[AnyType T] obeys Accessing[T], Enterable
  pass

### Produces a temporary read-only view of `me`.
### :returns: The resulting `Viewing[T]` value.
### :note: Entity-only. Records are value-typed — scoped access to record-typed values is
###        not supported in v0.0.1a. Use `entity` if you need a viewable reference.
routine T.view() -> Viewing[T]
needs EntityType T
  danger
    return Viewing[T](me.hijack())

# NOTE: No creators, no manual methods - all operations handled by compiler
# The address member variable is managed internally by the `.view()` implementation
# Users should NEVER create Viewing[T] values directly

# ============================================================================
# Resource management — enables `using entity.view() as v`
# ============================================================================

### Called on entry to a `using` block; passes the view through as the bound value (access is
### already established by `.view()`).
### :returns: This view as `Viewing[T]`.
routine Viewing[T].enter() -> Viewing[T]
  return me

### Called on exit from a `using` block; no-op for a view (the compiler handles scope cleanup).
routine Viewing[T].exit()
  return

# ============================================================================
# Marker-protocol coercion (access) — yields the inner entity as T
# ============================================================================

### Yields the inner entity as an in-flight `T` reference for read-only access.
### Inserted implicitly at call sites whose parameter is `Accessing[T]`.
### :returns: The inner entity as `T`.
@[readonly, inline]
routine Viewing[T].access() -> T
  danger
    return Hijacked[T](me).as_entity()

# ============================================================================
# Display (transparent - delegates to inner value)
# ============================================================================

### Returns the display form of the viewed entity.
### :returns: The resulting `Text` value.
@[readonly, override]
routine Viewing[T].represent() -> Text
  danger
    var hijacked = Hijacked[T](me)
    return hijacked.as_entity().represent()

### Returns the diagnostic form of the viewed entity.
### :returns: The resulting `Text` value.
@[readonly, override]
routine Viewing[T].diagnose() -> Text
  danger
    var hijacked = Hijacked[T](me)
    return me.type_name() + "(" + hijacked.as_entity().diagnose() + ")"

@override
dangerous routine Viewing[T].destroy()
  return
