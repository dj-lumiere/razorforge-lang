module Core

import BuilderQuery

### Represents temporary thread-safe read-only access to data guarded by a {Guarded[T, P]}.
### `Consulting[T]` is the non-Assignable token produced by `Guarded.consult()` for shared (multi-reader)
### observation. It holds the shared {GuardController[T, P]} pointer; entering its `using` scope
### (`enter`) acquires the reader hold on the controller's access-discipline lock and exiting
### (`exit`) releases it, so the lock spans exactly the `using` block. Many consultants may coexist;
### the readers-XOR-writer access discipline forbids a consultant from coexisting with a {Amending[T]}.
### Must be opened with `using` — a bare/inline `consult()` would never acquire the lock.
### :typeparam T: The entity type being consulted.
### :typeparam P: The access-discipline lock policy of the originating `Guarded`.
### :see: {Amending[T]}, {Viewing[T]}, {Guarded[T, P]}, {Access-Types}
@llvm("ptr")
record Consulting[AnyType T, AnyType P] obeys Accessing[T], Enterable
needs EntityType T, P obeys LockPolicy
  pass

# NOTE: No creators, no manual methods — the token is produced only by `Guarded.consult()`, which
# acquires the reader hold and constructs it from the controller pointer. Users never create one.

# ============================================================================
# Resource management — enables `using shared.consult() as v`
# ============================================================================

### Called on entry to the `using` block: acquires the shared reader hold on the controller's
### access-discipline lock, then passes the token through as the bound value. Pairs with `exit`,
### so the lock spans exactly the `using` scope.
### :returns: This token as `Consulting[T, P]`.
routine Consulting[T, P].enter() -> Consulting[T, P]
  danger
    var ctrl = Hijacked[GuardController[T, P]](me).as_entity()
    ctrl.add_inspector()
  return me

### Called on entry to a *fallible* `using ... fallback` block: attempts the shared reader hold once,
### without blocking. Returns `true` if the hold was acquired (the `using` body runs and `exit` will
### release it) or `false` on contention (the `fallback` branch runs; nothing is held).
### :returns: `true` if the reader hold was acquired, `false` otherwise.
routine Consulting[T, P].try_enter() -> Bool
  danger
    var ctrl = Hijacked[GuardController[T, P]](me).as_entity()
    return ctrl.try_add_inspector()

### Called on exit from the `using` block (and on every escape): releases the reader hold.
routine Consulting[T, P].exit()
  danger
    var ctrl = Hijacked[GuardController[T, P]](me).as_entity()
    ctrl.remove_inspector()
  return

# ============================================================================
# Marker-protocol coercion (access) — yields the guarded entity as T
# ============================================================================

### Yields the guarded entity as an in-flight `T` reference for read-only access.
### Inserted implicitly at call sites whose parameter is `Accessing[T]`. Projects through the
### controller to reach the managed entity.
### :returns: The guarded entity as `T`.
@[readonly, inline]
routine Consulting[T, P].access() -> T
  danger
    var ctrl = Hijacked[GuardController[T, P]](me).as_entity()
    return ctrl.raw_data().as_entity()

# ============================================================================
# Display (transparent — delegates to the guarded entity through the controller)
# ============================================================================

### Returns the display form of the consulted entity.
### :returns: The resulting `Text` value.
@[readonly, override]
routine Consulting[T, P].represent() -> Text
  danger
    var ctrl = Hijacked[GuardController[T, P]](me).as_entity()
    return ctrl.raw_data().as_entity().represent()

### Returns the diagnostic form of the consulted entity.
### :returns: The resulting `Text` value.
@[readonly, override]
routine Consulting[T, P].diagnose() -> Text
  danger
    var ctrl = Hijacked[GuardController[T, P]](me).as_entity()
    return me.type_name() + "(" + ctrl.raw_data().as_entity().diagnose() + ")"

### No-op: the token owns no heap (it only aliases the controller), and the reader hold is
### released by `exit`. Releasing here too would double-release the lock.
@override
dangerous routine Consulting[T, P].destroy()
  return
