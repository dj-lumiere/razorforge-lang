module Core

import BuilderQuery

### Single-threaded strong reference. Thin pointer to {RetainController[T]}.
### Equivalent to `Rc[T]` in Rust. Copying bumps the strong count; dropping decrements it.
### :typeparam T: The exclusively owned entity type.
@llvm("ptr")
record Retained[EntityType T] obeys Controlling[T]
  pass

# ============================================================================
# Construction
# ============================================================================

### Constructor form: wraps `from` in a reference-counted {Retained[T]}. `Retained[T](from: n)` routes
### here (bare `Type(...)` → user `create`). Ownership of the entity moves into the RC system.
routine Retained[T].create(from: T) -> Retained[T]
needs EntityType T
  danger
    var ctrl = RetainController[T](data: from.hijack()).hijack()
    return Retained[T](ctrl)

# ============================================================================
# Reference counting
# ============================================================================

### Returns a new strong reference to the same entity, incrementing the strong count.
### :returns: A new strong handle sharing the same underlying entity.
routine Retained[T].share() -> Retained[T]
  danger
    var ctrl = Hijacked[RetainController[T]](me).as_entity()
    ctrl.hold()
  return me

### Creates a weak reference to the same entity.
### :returns: A new weak handle to the same entity's controller.
routine Retained[T].observe() -> Tracked[T]
  danger
    var ctrl = Hijacked[RetainController[T]](me).as_entity()
    ctrl.observe()
    return Tracked[T](me)

# ============================================================================
# Inspection
# ============================================================================

### Returns the current strong reference count.
### :returns: The number of live strong handles to this entity.
routine Retained[T].strong_count() -> U32
  danger
    var ctrl = Hijacked[RetainController[T]](me).as_entity()
    return ctrl.strong_count()

### Returns the current weak reference count.
### :returns: The number of live weak handles to this entity's controller.
routine Retained[T].weak_count() -> U32
  danger
    var ctrl = Hijacked[RetainController[T]](me).as_entity()
    return ctrl.weak_count()

# ============================================================================
# Marker-protocol coercion (access/control) — yields the inner entity as T
# ============================================================================

### Yields the inner entity as an in-flight `T` reference for read-only access.
### Inserted implicitly at call sites whose parameter is `Accessing[T]`.
### :returns: The inner entity as `T`.
@[readonly, inline]
routine Retained[T].access() -> T
  danger
    var ctrl = Hijacked[RetainController[T]](me).as_entity()
    return ctrl.raw_data().as_entity()

### Yields the inner entity as an in-flight `T` reference for read/write access.
### Inserted implicitly at call sites whose parameter is `Controlling[T]`.
### :returns: The inner entity as `T`.
@inline
routine Retained[T].control() -> T
  danger
    var ctrl = Hijacked[RetainController[T]](me).as_entity()
    return ctrl.raw_data().as_entity()

# ============================================================================
# Display (transparent — delegates to inner value)
# ============================================================================

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
@[readonly, override]
routine Retained[T].represent() -> Text
  danger
    var ctrl = Hijacked[RetainController[T]](me).as_entity()
    return ctrl.raw_data().as_entity().represent()

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
@[readonly, override]
routine Retained[T].diagnose() -> Text
  danger
    var ctrl = Hijacked[RetainController[T]](me).as_entity()
    var rc = ctrl.strong_count()
    var weak = ctrl.weak_count()
    var addr = ctrl.raw_data().get_address()
    return me.type_name() + "(holding: " + rc.represent() + ", observing: " + weak.represent() + ", addr: " + addr.represent() + ", " + ctrl.raw_data().as_entity().diagnose() + ")"

### Decrements the strong count, tearing down the entity at zero (and the controller when both counts
### reach zero). This IS the decrement — there is no separate `release` verb; `destroy` is the teardown.
@override
dangerous routine Retained[T].destroy()
  var ctrl = Hijacked[RetainController[T]](me).as_entity()
  ctrl.unhold()
  return
