module Core

import BuilderQuery

### Represents an unmanaged typed raw pointer.
### `Hijacked[T]` is the low-level pointer wrapper for memory that is outside RazorForge's ownership and access rules.
### Use it for FFI, allocators, explicit memory layout work, and runtime plumbing where safety is intentionally bypassed.
### Unlike `steal`, `hijack` does NOT transfer ownership: the original owner keeps its binding, its
### lifetime, and its `destroy`. A `Hijacked[T]` is an unsanctioned *alias* into memory you do not
### own (hence `danger`) — the owner and the alias can both touch it — not a takeover of it.
### :typeparam T: The pointee type.
### :see: {Address}, {Modifying[T]}, {Viewing[T]}, {Memory-Types}
@llvm("ptr")
record Hijacked[AnyType T] obeys Assignable, Copyable
  pass

### Returns the raw address carried by this pointer.
### :returns: The raw address stored in this pointer.
@readonly
routine Hijacked[T].get_address() -> Address
  return LLVM::pointer_to_int[T, Address](me)

### Returns a bitwise duplicate of this raw pointer.
### `Hijacked[T]` is `@llvm("ptr")` so it does not auto-derive `Assignable`; this
### trivial opt-in body lets `=` and `with` work, with aliasing left to the user
### just like every other operation on this type.
### :returns: A bitwise duplicate of this pointer.
@readonly
routine Hijacked[T].assign() -> Hijacked[T]
  return me

### Returns a bitwise duplicate of this raw pointer (Copyable). A raw pointer is a trivially-copyable
### value, so `copy` is the same bitwise duplicate as `assign`; the `@llvm("ptr")` type auto-derives
### neither, so both are trivial opt-in bodies. Aliasing is left to the user, like every `Hijacked` op.
### :returns: A bitwise duplicate of this pointer.
@readonly
routine Hijacked[T].duplicate() -> Hijacked[T]
  return me

### Returns the raw address of a bare value when it is reinterpreted as a pointer slot.
### :returns: The address of this value viewed as a pointer-sized slot.
### :note: For records, the receiver must be an lvalue (a named binding or field path) — the
###        compiler intercepts the call at the call site and emits the address of the caller's
###        storage directly. Calling on an rvalue (`make_rec().get_address()`) is a build
###        error. For entities, the receiver value (already a ptr) is reinterpreted.
@readonly
routine T.get_address() -> Address
  return LLVM::pointer_to_int[T, Address](LLVM::reinterpret_bits[T, Hijacked[T]](me))

### Reinterprets a raw address as `Hijacked[T]`.
### :param from: The address to wrap.
### :returns: A `Hijacked[T]` pointer wrapping the given raw address.
routine Hijacked[T](from: Address) -> Hijacked[T]
  return LLVM::int_to_pointer[Address, T](from)

### Produces an unmanaged pointer alias of `me`.
### :returns: An unmanaged pointer alias of this value.
### :note: For entities and `@llvm("ptr")` records (`Retained[T]`, `Tracked[T]`, `CPtr`, etc.)
###        the receiver's value is already a pointer and the body works as written. For
###        struct-shaped records, `me.get_address()` is intercepted at the call site to use
###        the caller's lvalue storage (see `T.get_address()`); the receiver must therefore
###        be a named lvalue (local/parameter or field chain), and `hijack()` produces a
###        pointer to the caller's storage.
@readonly
routine T.hijack() -> Hijacked[T]
  return Hijacked[T](me.get_address())

### Reads the value stored at this address. This is `*ptr` — a raw `load`, no
### `store`, no refcount bump.
###
### Mental model: the pointer addresses a slot that holds a `T`; `peek` reads
### that slot.
###
### Refcount caveat: if `T` is a refcounted record (`Bytes`, `Text`, ...) the
### returned local still runs `destroy` on scope exit and will decrement the
### shared control block. The load is a non-owning view that pretends to be
### owned — keep its lifetime shorter than the real owner, or store the record's
### underlying primitive fields directly instead of round-tripping through
### `Hijacked[Record]`.
### :returns: The value at this address (bitwise copy).
dangerous routine Hijacked[T].peek() -> T
  return LLVM::load[T](me)

### Treats this pointer's bit pattern as if it already *were* a `T`. No load,
### no dereference — `Hijacked[T]` and the entity reference share a layout
### (both `ptr`), so this is a pure reinterpretation.
###
### Mental model: the pointer doesn't *address* a `T`, the pointer *is* a `T`.
### Use when you already hold the entity's pointer and just want it typed as
### the entity (the typical case for `@llvm("ptr")` records' plumbing).
### Contrast with `peek`, which reads the `T` stored *at* the address.
### :returns: This pointer reinterpreted as `T`.
dangerous routine Hijacked[T].as_entity() -> T
needs EntityType T
  return LLVM::reinterpret_bits[Hijacked[T], T](me)

### Stores `value` at the address referenced by this pointer.
### :param value: The value to write.
dangerous routine Hijacked[T].poke(value: T)
  LLVM::store[T](me, value)
  return

### Loads the value at this pointer reinterpreted as type `U` without type-system checks.
### :returns: The value stored at this address interpreted as `U`.
dangerous routine Hijacked[T].peek_as[U]() -> U
  var as_u = me.recast_as[U]()
  return as_u.peek()

### Writes `value` at this pointer reinterpreted as type `U` without type-system checks.
### :param value: The value to write at this pointer reinterpreted as `Hijacked[U]`.
dangerous routine Hijacked[T].poke_as[U](value: U)
  var as_u = me.recast_as[U]()
  as_u.poke(value: value)
  return

### Returns this pointer reinterpreted as `Hijacked[U]`, without loading or storing.
### :returns: This pointer with its type parameter reinterpreted as `U`.
routine Hijacked[T].recast_as[U]() -> Hijacked[U]
  return LLVM::reinterpret_bits[Hijacked[T], Hijacked[U]](me)

### Returns the raw address of this pointer.
### :returns: The raw address stored in this pointer.
@readonly
routine Hijacked[T].address() -> Address
  return LLVM::pointer_to_int[Hijacked[T], Address](me)

### Steps this pointer forward by {count} elements (element-sized stride, may be negative).
### :param count: Number of elements to advance.
### :returns: This pointer advanced by `count` elements of type `T`.
routine Hijacked[T].stride(count: S64) -> Hijacked[T]
  return LLVM::element_pointer[T](ptr: me, count: count)

### Returns the value at byte offset {offset} from this pointer without moving the pointer.
### :param offset: The byte offset.
### :returns: The value stored `offset` bytes from this pointer.
dangerous routine Hijacked[T].peek_at_offset(offset: ByteSize) -> T
  return me.offset(bytes: offset).peek()

### Writes {value} at byte offset {at} from this pointer without moving the pointer.
### :param at: The byte offset.
### :param value: The value to write.
dangerous routine Hijacked[T].poke_at_offset(at: ByteSize, value: T)
  me.offset(bytes: at).poke(value: value)
  return

### Cycle-collector container hook: reports every element of this `count`-length buffer to the
### collector so container-held objects are visible to cycle collection. `cyclic_visit` is a
### universal `@overridable` no-op that only `Roamed[T]` overrides, so this walk needs no per-element
### branching — a buffer of values visits nothing, a buffer of `Roamed` handles reports each one.
### :param count: The number of live elements in the buffer.
dangerous routine Hijacked[T].cyclic_trace_buffer(count: U64)
  var i = 0u64
  while i < count
    me.peek_at_offset(offset: T.data_size() * i).cyclic_visit()
    i = i +% 1u64
  return

### Cycle-collector hook for a SPARSE (open-addressing) container's dense entries buffer, whose slots
### have holes: reports each LIVE element to the collector, skipping tombstoned/unused slots per the
### parallel `live` bitmap. This is the `cyclic_trace_buffer` counterpart for Dict/Set (whose `keys`/
### `vals`/`slots` arrays are indexed 0..`used` with per-entry liveness), so exactly the live elements
### are reported (R2 — no garbage from empty slots). `cyclic_visit` is the universal no-op that only
### `Roamed[T]` overrides, so value elements visit nothing.
### :param live: The parallel `entry_live` bitmap — one `U8` per entry, `1` = live, `0` = tombstone/unused.
### :param used: The high-water mark of the entries buffer; slots `0..used` are scanned.
dangerous routine Hijacked[T].cyclic_trace_sparse_buffer(live: Hijacked[U8], used: U64)
  var i = 0u64
  while i < used
    if live.peek_at_offset(offset: U8.data_size() * i) == 1u8
      me.peek_at_offset(offset: T.data_size() * i).cyclic_visit()
    i = i +% 1u64
  return

### Deallocates the memory at this pointer's address.
dangerous routine Hijacked[T].invalidate()
  C::rf_invalidate(me.address())
  return

### Zeroes out the pointed-to memory without deallocating it.
dangerous routine Hijacked[T].detonate()
  rf_set_bytes_at(dest: me.address(), value: 0_u8, size: T.data_size())
  return

### Returns a null `Hijacked[T]` pointer (address zero).
### :returns: A null pointer of type `Hijacked[T]`.
routine hijacked_none[T]() -> Hijacked[T]
  return Hijacked[T](0_addr)

### Constructs a {Hijacked[T]} from a raw address. Use this instead of
### `Hijacked[T](addr)` directly when T is a parent-scope generic param,
### to work around monomorphization not substituting nested CreatorExpression
### type refs.
### :param addr: The raw address to wrap.
### :returns: A `Hijacked[T]` wrapping the given raw address.
routine hijacked_from[T](addr: Address) -> Hijacked[T]
  return Hijacked[T](addr)

### Returns `true` if this pointer is null (address zero).
### :returns: `true` if this pointer holds address zero.
@readonly
routine Hijacked[T].is_none() -> Bool
  return LLVM::int_eq[Hijacked[T]](me, hijacked_none[T]())

### Returns this pointer advanced by `bytes` bytes.
### :param bytes: The byte distance to advance.
### :returns: This pointer shifted forward by the given number of bytes.
routine Hijacked[T].offset(bytes: ByteSize) -> Hijacked[T]
  var addr = LLVM::pointer_to_int[T, Address](me)
  return Hijacked[T](addr + bytes)

### Returns whether both values are equal.
### :param you: The other value to compare against.
### :returns: `true` if both pointers reference the same address.
routine Hijacked[T].eq(you: Hijacked[T]) -> Bool
  return LLVM::int_eq[Hijacked[T]](me, you)

### Compares this pointer against another by address.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
routine Hijacked[T].cmp(you: Hijacked[T]) -> ComparisonSign
  return me.address().cmp(you: you.address())

### Returns a SipHash-2-4 keyed hash of this pointer's address.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A SipHash-2-4 keyed hash of this pointer's address.
routine Hijacked[T].hash(k0: U64, k1: U64) -> U64
  return __secure_hash_u64(v: U64(me.address()), k0: k0, k1: k1)

# NOTE: All operations on Hijacked[T] are inherently unsafe
# Undefined behavior can occur if:
# - Pointer is dangling (object was deallocated)
# - Pointer is misaligned
# - Type U in peek_as[U]() doesn't match actual data
# - Writing to read-only memory
# - Data races in multi-threaded code
#
# Use ONLY when:
# - Interfacing with C/C++ FFI
# - Implementing low-level memory allocators
# - Performance-critical code with manual safety verification
# - You absolutely know what you're doing

# ============================================================================
# Display (opaque - address only, no inner value access)
# ============================================================================

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
@[readonly, override]
routine Hijacked[T].represent() -> Text
  return me.type_name()

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
@[readonly, override]
routine Hijacked[T].diagnose() -> Text
  return f"{me.type_name()}(addr: {me.address()}, none: {me.is_none()})"
