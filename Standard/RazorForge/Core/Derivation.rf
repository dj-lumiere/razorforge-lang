module Core

import BuilderQuery
import BuilderExpansion
import Collections

### The auto-derived default `represent()` for any record/entity: `TypeName(field: value, …)`. Written as a
### universal `@overridable routine T.represent()` — the compiler uses it as the represent for any
### record that doesn't provide its own (a hand-written `T.represent` or a kind-specialized
### `@override` takes precedence). Secret fields are hidden — the `openmemvarof` walk yields only the
### publicly-readable (OPEN ∪ POSTED) members. Each value renders via its own `represent`.
@overridable
routine T.represent() -> Text
needs AnyType T
  var result = me.type_name() + "("
  var first = true
  expand m in openmemvarof(T)
    if not first
      result = result + ", "
    result = result + nameof(m) + ": " + me.$nameof(m).represent()
    first = false
  result = result + ")"
  return result

### The form a value takes as a CONTAINER ELEMENT: stringy leaves are quoted (Text/Bytes in `"…"`,
### Character/Byte in `'…'`) so nested strings print delimited (`["a", "b"]` / `['a', 'b']`), while
### numbers, nested containers and records stay structural. A single generic free routine — the `when T`
### type-switch is folded at monomorphization (T is concrete there; RF has no inheritance, so `T is X` is
### exact type-identity), so each instantiation collapses to just its arm. Containers call `nested_repr`
### on every element; the top-level `represent()` stays bare.
routine nested_repr(value: T) -> Text
needs AnyType T
  when T
    is Text => return "\"" + value.represent() + "\""
    is Bytes => return "\"" + value.represent() + "\""
    is Character => return "'" + value.represent() + "'"
    is Byte => return "'" + value.represent() + "'"
    else => return value.represent()

### Variant `represent()`: TYPE-dispatch on the live arm — `TypeName(payload_repr)`, or `TypeName(none)`
### for the absent arm. The `@override needs VariantType T` gate makes the wired synthesizer pick this
### over the record default for a variant type. `expand m in branchof(T)` generates one arm clause each;
### the explicit `is None` clause covers the absent arm the payload expansion skips.
@override
routine T.represent() -> Text
needs VariantType T
  when me
    is None => return me.type_name() + "(none)"
    expand m in branchof(T)
      is $typeof(m) v => return me.type_name() + "(" + v.represent() + ")"

### Variant `diagnose()`: `Module.Variant(type_id: <arm id>, <arm diagnose>)` — TAG-dispatch via
### `branchof`; the live arm's `typeidof(m)` (its stable type id) and the payload's `diagnose()`. The absent
### `None` arm shows `(type_id: 0, none)`. (No `None`/void arms exist — `None` is the canonical empty
### branch — so no bindingless-arm form is needed.)
@override
routine T.diagnose() -> Text
needs VariantType T
  when me
    is None => return me.full_type_name() + "(type_id: 0, none)"
    expand m in branchof(T)
      is $typeof(m) v => return me.full_type_name() + "(type_id: " + typeidof(m).represent() + ", " + v.diagnose() + ")"

### Choice `represent()`: VALUE-dispatch on the S32 discriminant via `caseof`, returning the bare case
### name (`READ`). `S32(from: me)` reads the discriminant; `$valueof(c)` is each case's constant. The
### walk is exhaustive (one case always matches), so the trailing `pierce` is unreachable.
@override
routine T.represent() -> Text
needs ChoiceType T
  expand c in caseof(T)
    if S32(from: me) == $valueof(c)
      return nameof(c)
  pierce LogicBreachedError()

### Choice `diagnose()`: `Module.ChoiceName(id: <discriminant>, CaseName)`, matching the C# builder.
@override
routine T.diagnose() -> Text
needs ChoiceType T
  expand c in caseof(T)
    if S32(from: me) == $valueof(c)
      return me.full_type_name() + "(id: " + S32(from: me).represent() + ", " + nameof(c) + ")"
  pierce LogicBreachedError()

### Flags `represent()`: the ON members joined by `" and "` (`READ and WRITE`), or `<none>` if the
### bitmask is empty. A flags value is a COMBINATION, so `caseof` ACCUMULATES (no `when`): a SUBSET
### test per member `(U64(from: me) & $valueof(c)) != 0` appends its name.
@override
routine T.represent() -> Text
needs FlagsType T
  var result = ""
  var first = true
  expand c in caseof(T)
    if (U64(from: me) & $valueof(c)) != 0u64
      if first
        result = nameof(c)
      else
        result = result + " and " + nameof(c)
      first = false
  if first
    result = "<none>"
  return result

### Flags `diagnose()`: `Module.FlagsName(value: %<bits>, <members>)` — `<bits>` is LSB-first, one
### digit per declared member in declaration order ('1' if set), matching the C# builder.
@override
routine T.diagnose() -> Text
needs FlagsType T
  var result = ""
  var first = true
  var bits = "%"
  expand c in caseof(T)
    if (U64(from: me) & $valueof(c)) != 0u64
      if first
        result = nameof(c)
      else
        result = result + " and " + nameof(c)
      first = false
      bits = bits + "1"
    else
      bits = bits + "0"
  if first
    result = "<none>"
  return me.full_type_name() + "(value: " + bits + ", " + result + ")"

### Choice `all_cases()`: every declared case value, in declaration order. `caseof` yields each case;
### `$valueof(c)` is its S32 discriminant, reconstructed into a `Me` value via the reverse `Me(from: S32)`
### constructor. Replaces the C# `BuildAllCasesBody` (which left the bare case names unresolved at codegen).
@overridable
routine T.all_cases() -> List[Me]
needs ChoiceType T
  var result = List[Me]()
  expand c in caseof(T)
    result.add_last(value: Me(from: $valueof(c)))
  return result

### Flags `all_cases()`: every declared single-bit member value. `$valueof(c)` is its U64 bit, reconstructed
### via the reverse `Me(from: U64)` constructor.
@overridable
routine T.all_cases() -> List[Me]
needs FlagsType T
  var result = List[Me]()
  expand c in caseof(T)
    result.add_last(value: Me(from: $valueof(c)))
  return result

### Choice/Flags `count()` is NOT a template: it is emitted as a BUILDTIME CONSTANT (`return <N>_u64`)
### by WiredRoutinePass.BuildCountBody — the declared case/member count is known at build time, so there
### is no runtime `caseof` unroll + increment.

### Tuple `represent()`: the SPECIAL tuple format `(v0, v1, …)` — no type name, no field names, each
### element via its own `represent`. Distinct from the record `TypeName(field: value)` shape, hence the
### `is TupleType` override.
@override
routine T.represent() -> Text
needs TupleType T
  var result = "("
  var first = true
  expand m in allmemvarof(T)
    if not first
      result = result + ", "
    result = result + me.$nameof(m).represent()
    first = false
  return result + ")"

### Tuple `diagnose()`: `Module.Tuple[…](v0, v1, …)` — the qualified type name prefixed onto the same
### element walk (elements still render via `represent`, not `diagnose`, matching the C# builder).
@override
routine T.diagnose() -> Text
needs TupleType T
  var result = me.full_type_name() + "("
  var first = true
  expand m in allmemvarof(T)
    if not first
      result = result + ", "
    result = result + me.$nameof(m).represent()
    first = false
  return result + ")"

### Routine values: `represent`/`diagnose` show the SIGNATURE (the routine type's name, e.g.
### `Routine[(S32,), S32]`) — executable code has no field structure to walk. `serialize` boxes that same
### signature Text: serializing code is meaningless, but the signature is the useful view. These make a
### routine-typed member (an entity may hold one — `entity Callback { f: Routine[...] }`) serialize
### uniformly through the universal walk, no capability gate.
@override
routine T.represent() -> Text
needs RoutineType T
  return me.type_name()

@override
routine T.diagnose() -> Text
needs RoutineType T
  return me.full_type_name()

### The auto-derived default `diagnose()` for any record: `Module.TypeName(field: value, …)`. Uses the
### fully-qualified name and shows ALL fields (secret ones prefixed `[secret] ` via `visibilityof`); each
### value still renders via `represent` (never `diagnose`) to avoid exponentially verbose nested output.
@overridable
routine T.diagnose() -> Text
needs AnyType T
  var result = me.full_type_name() + "("
  var first = true
  expand m in allmemvarof(T)
    if not first
      result = result + ", "
    if visibilityof(m) is SECRET
      result = result + "[secret] "
    result = result + nameof(m) + ": " + me.$nameof(m).represent()
    first = false
  result = result + ")"
  return result

### The auto-derived default `eq()` for any record/entity/tuple: equal when every member variable is
### equal. Written as the universal `@overridable routine T.eq()`; `ne` is derived from this by the
### compiler (`return not me.eq(...)`). The buildtime `expand` field-walk replaces the hand-written C#
### builder — a zero-field type expands to no comparisons and returns `true`.
@overridable
routine T.eq(you: T) -> Bool
needs T obeys Equatable
  expand m in allmemvarof(T)
    if me.$nameof(m) != you.$nameof(m)
      return false
  return true

### The auto-derived default `cmp()` for any record/entity/tuple: lexicographic comparison in
### declaration order, returning at the first non-`SAME` member. Written as the universal
### `@overridable routine T.cmp()`; `lt`/`le`/`gt`/`ge` are derived from this by the compiler. A
### zero-field type expands to no comparisons and returns `SAME`.
@overridable
routine T.cmp(you: T) -> ComparisonSign
needs T obeys Comparable
  expand m in allmemvarof(T)
    if me.$nameof(m).cmp(you: you.$nameof(m)) isnot SAME
      return me.$nameof(m).cmp(you: you.$nameof(m))
  return SAME

### Choice `eq`/`cmp`: a choice holds EXACTLY ONE case, so equality and ordering are just a compare of
### the S32 discriminant — NOT the record field-walk above (a choice has no member variables, so
### `allmemvarof(T)` is empty and the record template would wrongly return `true`/`SAME` for every pair).
### `S32(from: me)` reinterprets the discriminant (the same reader the choice `represent` uses); the inner
### `==`/`cmp` resolve to the hand-written `S32` ops, so there is no recursion back into this derive.
@override
routine T.eq(you: T) -> Bool
needs ChoiceType T
  return S32(from: me) == S32(from: you)

@override
routine T.cmp(you: T) -> ComparisonSign
needs ChoiceType T
  return S32(from: me).cmp(you: S32(from: you))

### Flags `eq`: EXACT bitmask equality (`perms == READ` means "exactly READ, nothing else"). A flags value
### is a SET of bits, so membership/subset ("is READ on?") is the separate `in` operator, never `==`. Like
### the choice derives, this compares the reinterpreted U64 bitmask via the hand-written `U64` op — no
### field-walk, no recursion. Flags have no natural total order, so no `cmp` derive.
@override
routine T.eq(you: T) -> Bool
needs FlagsType T
  return U64(from: me) == U64(from: you)

### The auto-derived ordering helpers `lt`/`le`/`gt`/`ge` for any Comparable type, derived from `cmp`
### (`me.cmp(you)` is `ME_SMALL`/`SAME`/`ME_LARGE`). These used to be emitted by the C# DerivedOperatorPass,
### which the collector/harness codegen path lost; deriving them here routes them through the same
### everywhere-derive template mechanism as `represent`/`cmp` (registered + materialized by the collector),
### so `a < b` (-> `a.lt(b)`) resolves for Character, numerics, records, collections uniformly.
routine T.lt(you: T) -> Bool
needs T obeys Comparable
  return me.cmp(you: you) is ME_SMALL

routine T.le(you: T) -> Bool
needs T obeys Comparable
  return me.cmp(you: you) isnot ME_LARGE

routine T.gt(you: T) -> Bool
needs T obeys Comparable
  return me.cmp(you: you) is ME_LARGE

routine T.ge(you: T) -> Bool
needs T obeys Comparable
  return me.cmp(you: you) isnot ME_SMALL

### The auto-derived fast `hash()` for any record/entity/tuple: XOR-fold each member variable's fast
### hash. Seeded at `0` (the XOR identity), so a single-field type hashes to exactly that field's hash
### and a zero-field type hashes to `0` — matching the hand-written C# builder. `expand` field-walk.
@overridable
routine T.hash() -> U64
needs T obeys Hashable
  var acc = 0u64
  expand m in allmemvarof(T)
    acc = acc.bitxor(you: me.$nameof(m).hash())
  return acc

### The auto-derived keyed `hash(k0, k1)`: same XOR-fold, threading the seed keys through each member
### variable's keyed hash.
@overridable
routine T.hash(k0: U64, k1: U64) -> U64
needs T obeys Hashable
  var acc = 0u64
  expand m in allmemvarof(T)
    acc = acc.bitxor(you: me.$nameof(m).hash(k0: k0, k1: k1))
  return acc

### The auto-derived default `serialize()` for a composite record/entity: field-walk into a
### `Dict[Text, SerialValue]` arm over the publicly-readable (`openmemvarof`) members, keyed by field
### name in declaration order (`Dict` iteration is insertion-ordered, so the output is stable).
###
### `serialize` is UNIVERSAL — EVERY type has one, so the walk calls `me.field.serialize()`
### UNCONDITIONALLY (no capability gate, no buildtime prune): a scalar boxes its own SerialValue arm; an
### aggregate record/entity/variant recurses; a `choice`/`flags` or zero-field opaque @llvm leaf (and a
### routine-typed member — entities may hold one, records can't per RF-S412) boxes its `represent()` Text
### as ITS serialize.
@overridable
routine T.serialize() -> SerialValue
needs AnyType T
  var __sv = Dict[Text, SerialValue]()
  expand m in openmemvarof(T)
    discard __sv.add(key: nameof(m), value: me.$nameof(m).serialize())
  return SerialValue(steal __sv)

### The auto-derived deep `copy()` (Copyable): forwards to `store` — a bitwise copy for a pure value
### type, or the retaining store for a managed-leaf / retaining-field record. Same as the C# builder.
@overridable
routine T.duplicate() -> Me
needs T obeys Copyable
  return me.assign()

### Variant `copy()`: TAG-dispatch DEEP copy — reconstruct the live arm with a copied payload, so a
### heap arm (a collection, a managed leaf) is NOT bitwise-aliased (which would double-free). `branchof`
### emits one clause per payload arm boxing `v.duplicate()` back into the variant via the arm constructor
### `Me(from: …)`; None / borrow arms (borrow can't be a variant payload) fall to `else => return me`.
@override
routine T.duplicate() -> Me
needs VariantType T
needs T obeys Copyable
  when me
    is None => return me
    expand m in branchof(T)
      is $typeof(m) v =>
        return T(from: v.duplicate())
    else => return me

### The auto-derived `destroy()`: tear down each member (unconditionally — every type has a `destroy`,
### a no-op for a raw-pointer / scalar / borrow leaf). Records/tuples stop here (stack values); an ENTITY
### additionally frees its heap allocation via `hijack().invalidate()`, mirroring a hand-written entity
### destructor. The `allmemvarof` walk covers every owned member including `secret`.
@overridable
routine T.destroy()
needs RecordType T
  expand m in allmemvarof(T)
    me.$nameof(m).destroy()
  return

@override
routine T.destroy()
needs EntityType T
  expand m in allmemvarof(T)
    me.$nameof(m).destroy()
  danger
    me.hijack().invalidate()
  return

### Variant `destroy()`: TAG-dispatch — tear down ONLY the live arm's payload (a variant is a union,
### one arm live at a time). `branchof` generates one `is $typeof(m) v =>` clause per payload arm; the
### explicit `is None` + `else` cover the payload-less / void arms (nothing to destroy).
@override
routine T.destroy()
needs VariantType T
  when me
    is None => return
    expand m in branchof(T)
      is $typeof(m) v =>
        v.destroy()
        return
    else => return

### The auto-derived cycle-collector TRACE hook `roam_trace()`: reports this value's strong
### (`Roamed`) edges to the collector. The universal default walks every member, delegating to each
### member's own `roam_trace` — a `Roamed` field reports its controller (override in Roamed.rf),
### a plain value member is a no-op (empty walk / no edge), a bare owned sub-entity recurses so nested
### aggregates (e.g. an SF container overlay's `inner: List[T]`) are descended. Container entities with
### raw `Hijacked` element buffers OVERRIDE this to call `cyclic_trace_buffer` — a raw pointer cannot
### self-describe its length, so the container (which knows its `count`) supplies it.
@overridable
dangerous routine T.roam_trace()
needs AnyType T
  expand m in allmemvarof(T)
    me.$nameof(m).roam_trace()
  return

### Variant `roam_trace()`: descend ONLY into the live arm's payload (a variant is a union). The
### `None` / void arms own no edge.
@override
dangerous routine T.roam_trace()
needs VariantType T
  when me
    is None => return
    expand m in branchof(T)
      is $typeof(m) v =>
        v.roam_trace()
        return
    else => return

### The auto-derived cycle-collector FREE hook `roam_free()`: tears down this value's OWNED
### resources but NOT its `Roamed` edges — the collector frees the whole white cycle directly, so
### following a `Roamed` edge here would double-free a sibling reaped in the same batch. The universal
### default is a plain `destroy` (a value / plain record owns no `Roamed` edge, so full teardown is
### safe); `Roamed[T]` overrides to a no-op (Roamed.rf).
@overridable
dangerous routine T.roam_free()
needs AnyType T
  me.destroy()
  return

### Entity `roam_free()`: walk each member's `roam_free` (so a `Roamed` member is SKIPPED via
### its no-op override, while an owned member is torn down) then free this entity's own heap box.
@override
dangerous routine T.roam_free()
needs EntityType T
  expand m in allmemvarof(T)
    me.$nameof(m).roam_free()
  danger
    me.hijack().invalidate()
  return

### Variant `roam_free()`: tear down ONLY the live arm's payload, skipping its `Roamed` edges.
@override
dangerous routine T.roam_free()
needs VariantType T
  when me
    is None => return
    expand m in branchof(T)
      is $typeof(m) v =>
        v.roam_free()
        return
    else => return

### The auto-derived `assign()` (Assignable — the shallow store / alias-safe verb): a shallow `var result
### = me` (the compiler does NOT re-enter `store` on this self-copy — no recursion), then re-store each
### member IN PLACE via its OWN `assign()`. `assign` is UNIVERSAL (Assignable is conferred everywhere), so
### the walk is unconditional: a managed leaf (Text/Decimal, or a record owning one) bumps its refcount on
### the copy — a bare bitwise alias would double-free at teardown — while a pure value field's `assign` is
### the bitwise `return me`. Replaces the C# reconstruction `T(f: me.f.assign(), …)` with a mutation walk
### — no creator arg-list needed.
@overridable
routine T.assign() -> Me
needs T obeys Assignable
needs Assignable everywhere
  var result = me
  expand m in allmemvarof(T)
    result.$nameof(m) = me.$nameof(m).assign()
  return result

### Variant `assign()`: TAG-dispatch shallow store — reconstruct the live arm with a RE-STORED payload,
### so a retaining arm (managed leaf) gets its refcount bumped rather than bitwise-aliased. Mirrors the
### variant `copy()` but with the arm's shallow `.assign()` instead of the deep `.duplicate()`. None / void
### arms fall to `else => return me` (nothing to re-store). A variant used as a plain record member (e.g.
### `Maybe[S32]` in a struct) MUST resolve `.assign()` — the record's own `assign` field-walk calls it.
@override
routine T.assign() -> Me
needs VariantType T
needs T obeys Assignable
  when me
    is None => return me
    expand m in branchof(T)
      is $typeof(m) v =>
        return T(from: v.assign())
    else => return me
