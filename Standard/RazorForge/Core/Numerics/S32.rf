module Core

### A 32-bit signed integer in the range −2,147,483,648 to 2,147,483,647.
###
### `S32` is the standard 32-bit integer type in RazorForge, used for Unicode
### code points, array indices on smaller platforms, and general arithmetic.
@llvm("i32")
record S32 obeys SignedIntegral, Ordered, ConstCompatible, AtomicType, Assignable, Copyable, Splittable
  pass

# Constants for S32 limits
preset S32_MIN: S32 = -2147483648_s32
preset S32_MAX: S32 = 2147483647_s32
preset S32_ZERO: S32 = 0_s32
preset S32_ONE: S32 = 1_s32

# ============================================================================
# Creators
# ============================================================================

### Sign-extends an `S8` to `S32`.
### :param from: The `S8` value to widen.
### :returns: An `S32` with the same signed value as `from`.
routine S32(from: S8) -> S32
  return LLVM::sign_extend[S8, S32](from)

### Sign-extends an `S16` to `S32`.
### :param from: The `S16` value to widen.
### :returns: An `S32` with the same signed value as `from`.
routine S32(from: S16) -> S32
  return LLVM::sign_extend[S16, S32](from)

### Identity conversion — returns `from` unchanged.
### :param from: The `S32` value to return.
### :returns: `from` unchanged.
routine S32(from: S32) -> S32
  return from

### Converts an `S64` to `S32`, throwing if the value is outside the S32 range.
### :param from: The `S64` value to convert.
### :returns: The lower 32 bits of `from` interpreted as signed.
### :throws: {IntegerOverflowError} if `from` is not in `-2147483648..=2147483647`.
routine S32!(from: S64) -> S32
  unless S64(S32_MIN) <= from <= S64(S32_MAX)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S64, S32](from)

### Converts an `S128` to `S32`, throwing if the value is outside the S32 range.
### :param from: The `S128` value to convert.
### :returns: The lower 32 bits of `from` interpreted as signed.
### :throws: {IntegerOverflowError} if `from` is not in `-2147483648..=2147483647`.
routine S32!(from: S128) -> S32
  unless S128(S32_MIN) <= from <= S128(S32_MAX)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S128, S32](from)

### Zero-extends a `U8` to `S32` (always succeeds — `U8` max 255 fits in S32).
### :param from: The `U8` value to widen.
### :returns: An `S32` equal in value to `from`.
routine S32(from: U8) -> S32
  return LLVM::zero_extend[U8, S32](from)

### Zero-extends a `U16` to `S32` (always succeeds — `U16` max 65535 fits in S32).
### :param from: The `U16` value to widen.
### :returns: An `S32` equal in value to `from`.
routine S32(from: U16) -> S32
  return LLVM::zero_extend[U16, S32](from)

### Reinterprets a `U32` as `S32` using two's complement, throwing if the value exceeds S32_MAX.
### :param from: The `U32` value to convert.
### :returns: The same bit pattern interpreted as `S32`.
### :throws: {IntegerOverflowError} if `from > 2147483647`.
routine S32!(from: U32) -> S32
  unless from <= U32(S32_MAX)
    throw IntegerOverflowError()
  return LLVM::reinterpret_bits[U32, S32](from)

### Converts a `U64` to `S32`, throwing if the value exceeds S32_MAX.
### :param from: The `U64` value to convert.
### :returns: The lower 32 bits interpreted as a signed `S32`.
### :throws: {IntegerOverflowError} if `from > 2147483647`.
routine S32!(from: U64) -> S32
  unless from <= U64(S32_MAX)
    throw IntegerOverflowError()
  return LLVM::int_truncate[U64, S32](from)

### Converts a `U128` to `S32`, throwing if the value exceeds S32_MAX.
### :param from: The `U128` value to convert.
### :returns: The lower 32 bits interpreted as a signed `S32`.
### :throws: {IntegerOverflowError} if `from > 2147483647`.
routine S32!(from: U128) -> S32
  unless from <= U128(S32_MAX)
    throw IntegerOverflowError()
  return LLVM::int_truncate[U128, S32](from)

### Converts an `S256` to `S32`, throwing if outside −2147483648..2147483647.
### :param from: The `S256` value to convert.
### :returns: The lower 32 bits reinterpreted as an `S32`.
### :throws: {IntegerOverflowError} if `from` is outside −2147483648..2147483647.
routine S32!(from: S256) -> S32
  if not (-2147483648_s256 <= from <= 2147483647_s256)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S256, S32](from)

### Converts a `U256` to `S32`, throwing if the value exceeds 2147483647.
### :param from: The `U256` value to convert.
### :returns: The lower 32 bits reinterpreted as an `S32`.
### :throws: {IntegerOverflowError} if `from > 2147483647`.
routine S32!(from: U256) -> S32
  if from > 2147483647_u256
    throw IntegerOverflowError()
  return LLVM::int_truncate[U256, S32](from)

### Converts an `F16` to `S32` by widening to `F32` first, then truncating toward zero.
### :param from: The `F16` value to convert.
### :returns: The integer part of `from` as an `S32`.
### :throws: {IntegerOverflowError} if the integer part is outside the S32 range.
routine S32!(from: F16) -> S32
  return from.F32().S32!()

### Converts an `F32` to `S32`, truncating toward zero.
### :param from: The `F32` value to convert.
### :returns: The integer part of `from` as an `S32`.
### :throws: {IntegerOverflowError} if the value is outside the S32 range.
routine S32!(from: F32) -> S32
  if from.is_nan() or not (-2147483648.0_f32 <= from <= 2147483647.0_f32)
    throw IntegerOverflowError()
  return LLVM::float_to_signed[F32, S32](from)

### Converts an `F64` to `S32`, truncating toward zero.
### :param from: The `F64` value to convert.
### :returns: The integer part of `from` as an `S32`.
### :throws: {IntegerOverflowError} if the value is outside the S32 range.
routine S32!(from: F64) -> S32
  if from.is_nan() or not (-2147483648.0_f64 <= from <= 2147483647.0_f64)
    throw IntegerOverflowError()
  return LLVM::float_to_signed[F64, S32](from)

### Converts an `F128` to `S32` by narrowing to `F64` first, then truncating.
### :param from: The `F128` value to convert.
### :returns: The integer part of `from` as an `S32`.
### :throws: {IntegerOverflowError} if the integer part is outside the S32 range.
routine S32!(from: F128) -> S32
  return from.F64!().S32!()

### Converts a `D32` decimal to `S32` via its packed bit representation.
### :param from: The `D32` value to convert.
### :returns: The integer part of `from` as an `S32`.
### :throws: {IntegerOverflowError} if the integer part is outside the S32 range.
routine S32!(from: D32) -> S32
  return S128(from: D128(from: from)).S32!()

### Converts a `D64` decimal to `S32` via its packed bit representation.
### :param from: The `D64` value to convert.
### :returns: The integer part of `from` as an `S32`.
### :throws: {IntegerOverflowError} if the integer part is outside the S32 range.
routine S32!(from: D64) -> S32
  return S128(from: D128(from: from)).S32!()

### Converts a `D128` decimal to `S32` via its low/high 64-bit halves.
### :param from: The `D128` value to convert.
### :returns: The integer part of `from` as an `S32`.
### :throws: {IntegerOverflowError} if the integer part is outside the S32 range.
routine S32!(from: D128) -> S32
  return S128(from: from).S32!()

# ============================================================================
# Arithmetic Operations
# ============================================================================

### Returns the sum and a flag indicating whether the result overflowed.
### :param you: The right operand.
### :returns: A tuple of `(wrapped_sum, overflowed)`.
routine S32.add_with_overflow(you: S32) -> (S32, Bool)
  return LLVM::signed_add_checked[S32](me, you)

### Returns the difference and a flag indicating whether the result overflowed.
### :param you: The value to subtract.
### :returns: A tuple of `(wrapped_difference, overflowed)`.
routine S32.sub_with_overflow(you: S32) -> (S32, Bool)
  return LLVM::signed_sub_checked[S32](me, you)

### Returns the product and a flag indicating whether the result overflowed.
### :param you: The right operand.
### :returns: A tuple of `(wrapped_product, overflowed)`.
routine S32.mul_with_overflow(you: S32) -> (S32, Bool)
  return LLVM::signed_mul_checked[S32](me, you)

### Returns `me + you`, throwing on overflow.
### :param you: The right operand.
### :returns: The sum `me + you`.
### :throws: {IntegerOverflowError} if the result is outside the S32 range.
routine S32.add!(you: S32) -> S32
  var result = me.add_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me - you`, throwing on overflow.
### :param you: The value to subtract.
### :returns: The difference `me - you`.
### :throws: {IntegerOverflowError} if the result is outside the S32 range.
routine S32.sub!(you: S32) -> S32
  var result = me.sub_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me * you`, throwing on overflow.
### :param you: The right operand.
### :returns: The product `me * you`.
### :throws: {IntegerOverflowError} if the result is outside the S32 range.
routine S32.mul!(you: S32) -> S32
  var result = me.mul_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me // you` (euclidean division), throwing on errors.
### Euclidean division: the remainder is always in `[0, |you|)`, consistent with `mod!`.
### The special case `S32_MIN // -1` would overflow and throws.
### :param you: The divisor.
### :returns: The euclidean quotient `me // you`.
### :throws: {DivisionByZeroError} if `you == 0`.
### :throws: {IntegerOverflowError} if `me == S32_MIN` and `you == -1`.
routine S32.floordiv!(you: S32) -> S32
  if you == 0
    throw DivisionByZeroError()
  if me == S32_MIN and you == -1_s32
    throw IntegerOverflowError()
  var quotient = LLVM::signed_div(a: me, b: you)
  var remainder = LLVM::signed_rem(a: me, b: you)
  if remainder < 0_s32
    if you > 0_s32
      return quotient - 1_s32
    return quotient + 1_s32
  return quotient

### Returns `me % you` (euclidean modulo): the remainder is always in `[0, |you|)`.
### :param you: The divisor.
### :returns: The euclidean remainder — always non-negative.
### :throws: {DivisionByZeroError} if `you == 0`.
routine S32.mod!(you: S32) -> S32
  if you == 0
    throw DivisionByZeroError()
  var remainder = LLVM::signed_rem(a: me, b: you)
  if remainder < 0_s32
    if you > 0_s32
      return remainder + you
    return remainder - you
  return remainder

### Returns `-me` (arithmetic negation), with wrapping behavior on `S32_MIN`.
### :returns: The negated value. `-S32_MIN` wraps to `S32_MIN` (−2147483648).
routine S32.neg!() -> S32
  if me == -2147483648_s32
    throw IntegerOverflowError()
  return LLVM::sub(a: 0_s32, b: me)

# ============================================================================
# Wrapping Arithmetic (+%, -%, *%)
# ============================================================================

### Returns `(me + you)` with wrapping arithmetic (mod 2³², signed).
### :param you: The right operand.
### :returns: The sum, wrapping on overflow.
routine S32.add_wrap(you: S32) -> S32
  return LLVM::add(a: me, b: you)

### Returns `(me - you)` with wrapping arithmetic (mod 2³², signed).
### :param you: The value to subtract.
### :returns: The difference, wrapping on underflow.
routine S32.sub_wrap(you: S32) -> S32
  return LLVM::sub(a: me, b: you)

### Returns `(me * you)` with wrapping arithmetic (mod 2³², signed).
### :param you: The right operand.
### :returns: The product, wrapping on overflow.
routine S32.mul_wrap(you: S32) -> S32
  return LLVM::mul(a: me, b: you)

# ============================================================================
# Unchecked Arithmetic (+!, -!, *!, //!, %!)
# ============================================================================

### Returns `me + you` with undefined behavior on overflow.
### :param you: The right operand.
### :returns: The sum, assuming no overflow.
dangerous routine S32.add_unchecked(you: S32) -> S32
  return LLVM::signed_add_exact[S32](a: me, b: you)

### Returns `me - you` with undefined behavior on overflow.
### :param you: The value to subtract.
### :returns: The difference, assuming no overflow.
dangerous routine S32.sub_unchecked(you: S32) -> S32
  return LLVM::signed_sub_exact[S32](a: me, b: you)

### Returns `me * you` with undefined behavior on overflow.
### :param you: The right operand.
### :returns: The product, assuming no overflow.
dangerous routine S32.mul_unchecked(you: S32) -> S32
  return LLVM::signed_mul_exact[S32](a: me, b: you)

### Returns `me // you` (euclidean division) with undefined behavior if `you == 0` or overflow.
### :param you: The divisor.
### :returns: The euclidean quotient, assuming `you != 0` and no overflow.
dangerous routine S32.floordiv_unchecked(you: S32) -> S32
  var quotient = LLVM::signed_div(a: me, b: you)
  var remainder = LLVM::signed_rem(a: me, b: you)
  if remainder < 0_s32
    if you > 0_s32
      return quotient - 1_s32
    return quotient + 1_s32
  return quotient

### Returns `me % you` (euclidean modulo) with undefined behavior if `you == 0`.
### :param you: The divisor.
### :returns: The euclidean remainder, assuming `you != 0`.
dangerous routine S32.mod_unchecked(you: S32) -> S32
  var remainder = LLVM::signed_rem(a: me, b: you)
  if remainder < 0_s32
    if you > 0_s32
      return remainder + you
    return remainder - you
  return remainder

# ============================================================================
# Clamping Arithmetic (+^, -^, *^)
# ============================================================================

### Returns `me + you`, clamped to `S32_MAX` or `S32_MIN` on overflow.
### :param you: The right operand.
### :returns: The sum, or `2147483647` / `−2147483648` if it would overflow.
routine S32.add_clamp(you: S32) -> S32
  return LLVM::signed_add_sat[S32](a: me, b: you)

### Returns `me - you`, clamped to `S32_MAX` or `S32_MIN` on overflow.
### :param you: The value to subtract.
### :returns: The difference, or `2147483647` / `−2147483648` if it would overflow.
routine S32.sub_clamp(you: S32) -> S32
  return LLVM::signed_sub_sat[S32](a: me, b: you)

### Returns `me * you`, clamped to `S32_MAX` or `S32_MIN` on overflow.
### :param you: The right operand.
### :returns: The product, or `2147483647` / `−2147483648` if it would overflow.
routine S32.mul_clamp(you: S32) -> S32
  var wide = LLVM::mul(LLVM::sign_extend[S32, S64](me), LLVM::sign_extend[S32, S64](you))
  if LLVM::signed_gt(wide, 2147483647_s64)
    return S32_MAX
  if LLVM::signed_lt(wide, -2147483648_s64)
    return S32_MIN
  return LLVM::int_truncate[S64, S32](wide)

# ============================================================================
# Power Operations (**)
# ============================================================================

### Returns `me ** exp` and a flag indicating whether the result overflowed.
### :param exp: The exponent (must be non-negative).
### :returns: A tuple of `(wrapped_result, overflowed)`.
### :throws: {NumericDomainError} if `exp < 0`.
routine S32.pow_with_overflow!(exp: S32) -> (S32, Bool)
  if exp < 0
    throw NumericDomainError(description: "negative exponent: no integer result")
  var result: S32 = 1
  var base: S32 = me
  var e: U32 = U32(exp)
  var overflow = false
  while e > 0
    if (e & 1) == 1
      var mul_result = result.mul_with_overflow(base)
      result = mul_result.item0
      overflow = overflow or mul_result.item1
    e = e >> 1_u32
    if e > 0
      var square_result = base.mul_with_overflow(base)
      base = square_result.item0
      overflow = overflow or square_result.item1
  return (result, overflow)

### Returns `me ** exp`, throwing on overflow.
### :param exp: The exponent (must be non-negative).
### :returns: The result of raising `me` to the power `exp`.
### :throws: {IntegerOverflowError} if the result is outside the S32 range.
### :throws: {NumericDomainError} if `exp < 0`.
routine S32.pow!(exp: S32) -> S32
  var result = me.pow_with_overflow(exp)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me ** exp` with wrapping arithmetic.
### :param exp: The exponent (must be non-negative).
### :returns: The result modulo 2³² (signed wrap).
### :throws: {NumericDomainError} if `exp < 0`.
routine S32.pow_wrap!(exp: S32) -> S32
  if exp < 0_s32
    throw NumericDomainError(description: "negative exponent: no integer result")
  var result: S32 = 1
  var base: S32 = me
  var e: U32 = U32(exp)
  while e > 0
    if (e & 1) == 1
      result = result.mul_wrap(base)
    e = e >> 1_u32
    if e > 0
      base = base.mul_wrap(base)
  return result

### Returns `me ** exp`, clamped to `S32_MAX` or `S32_MIN` on overflow.
### :param exp: The exponent (must be non-negative).
### :returns: The result, or `2147483647` / `−2147483648` if it would overflow.
### :throws: {NumericDomainError} if `exp < 0`.
routine S32.pow_clamp!(exp: S32) -> S32
  if exp < 0
    throw NumericDomainError(description: "negative exponent: no integer result")
  var result: S32 = 1
  var base: S32 = me
  var e: U32 = U32(exp)
  while e > 0
    if (e & 1) == 1
      result = result.mul_clamp(base)
    e = e >> 1_u32
    if e > 0
      base = base.mul_clamp(base)
  return result

# ============================================================================
# Bitwise Operations
# ============================================================================

### Returns the bitwise AND of this value and `you`.
### :param you: The right operand.
### :returns: `me & you`.
routine S32.bitand(you: S32) -> S32
  return LLVM::bit_and(a: me, b: you)

### Returns the bitwise OR of this value and `you`.
### :param you: The right operand.
### :returns: `me | you`.
routine S32.bitor(you: S32) -> S32
  return LLVM::bit_or(a: me, b: you)

### Returns the bitwise XOR of this value and `you`.
### :param you: The right operand.
### :returns: `me ^ you`.
routine S32.bitxor(you: S32) -> S32
  return LLVM::bit_xor(a: me, b: you)

### Returns the bitwise complement of this value.
### :returns: `~me` — each bit flipped.
routine S32.bitnot() -> S32
  return LLVM::bit_xor[S32](a: me, b: -1)

# ============================================================================
# Shift Operations (<<, <<?>, >>, <<<, >>>)
# ============================================================================

### Left-shifts this value by `bits` positions, filling vacated bits with zero.
### :param bits: The number of bit positions to shift left.
### :returns: `me << bits`.
routine S32.ashl(bits: U32) -> S32
  return LLVM::shift_left[S32](me, bits)

### Right-shifts this value by `bits` positions, sign-filling (arithmetic shift right).
### :param bits: The number of bit positions to shift right.
### :returns: `me >> bits`, copying the sign bit into vacated positions.
routine S32.ashr(bits: U32) -> S32
  return LLVM::shift_right_signed[S32](me, bits)

### Left-shifts this value by `bits` positions (same as `ashl` for signed integers).
### :param bits: The number of bit positions to shift left.
### :returns: `me << bits`.
routine S32.lshl(bits: U32) -> S32
  return LLVM::shift_left[S32](me, bits)

### Right-shifts this value by `bits` positions, zero-filling (logical shift right).
### :param bits: The number of bit positions to shift right.
### :returns: `me >>> bits`, filling vacated bits with zero regardless of sign.
routine S32.lshr(bits: U32) -> S32
  return LLVM::shift_right_unsigned[S32](me, bits)

# ============================================================================
# Comparison Operations
# ============================================================================

### Returns `true` when both values are equal.
### :param you: The value to compare against.
### :returns: `true` if `me == you`; `false` otherwise.
routine S32.eq(you: S32) -> Bool
  return LLVM::int_eq(a: me, b: you)

### Compares this value with `you`, returning the ordering relationship.
### :param you: The value to compare against.
### :returns: `ME_SMALL` if `me < you`, `ME_LARGE` if `me > you`, `SAME` if equal.
routine S32.cmp(you: S32) -> ComparisonSign
  if LLVM::signed_lt(me, you)
    return ME_SMALL
  if LLVM::signed_gt(me, you)
    return ME_LARGE
  return SAME

# ============================================================================
# Math Operations
# ============================================================================

### Returns the absolute value of this integer.
### :returns: `-me` if `me < 0`; `me` if `me >= 0`.
### :throws: {IntegerOverflowError} when `me` is `S32_MIN` (its magnitude is not representable in S32).
routine S32.abs!() -> S32
  if me == -2147483648_s32
    throw IntegerOverflowError()
  return LLVM::int_abs[S32](me)

### Returns the smaller of this value and `you`.
### :param you: The value to compare against.
### :returns: `me` if `me <= you`; otherwise `you`.
routine S32.min(you: S32) -> S32
  return if me <= you then me else you

### Returns the larger of this value and `you`.
### :param you: The value to compare against.
### :returns: `me` if `me >= you`; otherwise `you`.
routine S32.max(you: S32) -> S32
  return if me >= you then me else you

### Returns this value clamped to the range `min_val..=max_val`.
### :param min_val: The lower bound (inclusive).
### :param max_val: The upper bound (inclusive).
### :returns: `min_val` if `me < min_val`; `max_val` if `me > max_val`; otherwise `me`.
@positional
routine S32.clamp(min_val: S32, max_val: S32) -> S32
  return me.min(max_val).max(min_val)

# ============================================================================
# Bit Manipulation
# ============================================================================

### Returns the count of set bits (popcount) in this value's 32-bit representation.
### :returns: The number of `1` bits; between 0 and 32.
routine S32.count_ones() -> S32
  return LLVM::count_ones[S32](me)

### Returns the count of clear bits in this value's 32-bit representation.
### :returns: `32` minus the popcount; between 0 and 32.
routine S32.count_zeros() -> S32
  return 32_s32 -% me.count_ones()

### Returns the number of leading zero bits, starting from the most-significant bit.
### :returns: The leading zero count; `32` if the value is zero.
routine S32.leading_zeros() -> S32
  return LLVM::leading_zeros(me)

### Returns the number of trailing zero bits, starting from the least-significant bit.
### :returns: The trailing zero count; `32` if the value is zero.
routine S32.trailing_zeros() -> S32
  return LLVM::trailing_zeros(me)

### Returns the number of leading one bits, starting from the most-significant bit.
### :returns: The leading one count; `32` if the value is `−1` (all bits set).
routine S32.leading_ones() -> S32
  return me.bitnot().leading_zeros()

### Returns the number of trailing one bits, starting from the least-significant bit.
### :returns: The trailing one count; `32` if the value is `−1` (all bits set).
routine S32.trailing_ones() -> S32
  return me.bitnot().trailing_zeros()

### Returns this value with its bits reversed (bit 31 ↔ bit 0, etc.).
### :returns: The bit-reversed `S32`.
routine S32.reverse_bits() -> S32
  return LLVM::reverse_bits[S32](me)

### Returns this value with its four bytes swapped (for endianness conversion).
### :returns: An `S32` with its bytes in reverse order.
routine S32.swap_bytes() -> S32
  return LLVM::byte_swap(me)

### Returns this value rotated left by `bits` positions.
routine S32.rotate_left(bits: U32) -> S32
  return LLVM::reinterpret_bits[U32, S32](LLVM::reinterpret_bits[S32, U32](me).rotate_left(bits: bits))

### Returns this value rotated right by `bits` positions.
routine S32.rotate_right(bits: U32) -> S32
  return LLVM::reinterpret_bits[U32, S32](LLVM::reinterpret_bits[S32, U32](me).rotate_right(bits: bits))

### Returns the raw byte representation of this value in little-endian order.
routine S32.to_bytes_le() -> Array[Byte, 4]
  return LLVM::reinterpret_bits[S32, U32](me).to_bytes_le()

### Returns the raw byte representation of this value in big-endian order.
routine S32.to_bytes_be() -> Array[Byte, 4]
  return LLVM::reinterpret_bits[S32, U32](me).to_bytes_be()

### Builds an `S32` from its little-endian raw byte representation.
common routine S32.from_bytes_le(bytes: Array[Byte, 4]) -> S32
  return LLVM::reinterpret_bits[U32, S32](U32.from_bytes_le(bytes: bytes))

### Builds an `S32` from its big-endian raw byte representation.
common routine S32.from_bytes_be(bytes: Array[Byte, 4]) -> S32
  return LLVM::reinterpret_bits[U32, S32](U32.from_bytes_be(bytes: bytes))

# ============================================================================
# Utility Methods
# ============================================================================

### Returns `true` if this value is greater than zero.
### :returns: `true` if `me > 0`.
routine S32.is_positive() -> Bool
  return me > 0_s32

### Returns `true` if this value is less than zero.
### :returns: `true` if `me < 0`.
routine S32.is_negative() -> Bool
  return me < 0_s32

### Returns `true` if this value is zero.
### :returns: `true` if `me == 0`.
routine S32.is_zero() -> Bool
  return me == 0_s32

### Returns `true` if this value is divisible by 2.
### :returns: `true` if the least-significant bit is 0.
routine S32.is_even() -> Bool
  var result = LLVM::bit_and(a: me, b: 1_s32)
  return LLVM::int_eq(a: result, b: 0_s32)

### Returns `true` if this value is not divisible by 2.
### :returns: `true` if the least-significant bit is 1.
routine S32.is_odd() -> Bool
  return not me.is_even()

### Returns the sign of this value as −1, 0, or 1.
### :returns: `1` if `me > 0`, `−1` if `me < 0`, `0` if `me == 0`.
routine S32.signum() -> S32
  return when
    me > 0_s32 => 1_s32
    me < 0_s32 => -1_s32
    else => 0_s32

### Returns `true` if this value is an exact power of two.
### Negative values always return `false`.
### :returns: `true` if `me` is 1, 2, 4, ..., 1073741824; `false` otherwise (including zero and negatives).
routine S32.is_power_of_two() -> Bool
  var is_pos = LLVM::signed_gt(me, 0_s32)
  var minus_one = LLVM::sub(a: me, b: 1_s32)
  var anded = LLVM::bit_and(a: me, b: minus_one)
  var is_zero = LLVM::int_eq(a: anded, b: 0_s32)
  return is_pos and is_zero

# ============================================================================
# Text Representation and Parsing
# ============================================================================

### Returns the human-readable text of this value.
### :returns: The value rendered as `Text`.
@override
routine S32.represent() -> Text
  if me == 0s32
    return "0"
  if me > 0s32
    return U32(me).represent()
  # Use reinterpret_bits (not U32(me)) — U32.create(S32) throws on negative inputs,
  # and we need the raw bit pattern so the two's-complement negation `0u32 -% bits`
  # yields |me| (works correctly even for S32.MIN, whose absolute value overflows S32).
  return "-" + (0u32 -% LLVM::reinterpret_bits[S32, U32](me)).represent()

### Returns a type-tagged debug rendering of this value.
### :returns: A diagnostic `Text` rendering, e.g. `Type(value)`.
@override
routine S32.diagnose() -> Text
  return "S32(" + me.represent() + ")"

### Parses a decimal string into an `S32`, accepting an optional leading `+` or `−` sign.
### :param from_text: The decimal string to parse.
### :returns: The parsed `S32` value.
### :throws: {InvalidValueError} if `from_text` is empty, sign-only, or contains non-digit characters.
routine S32!(from_text: Text) -> S32
  if from_text.count() == 0u64
    throw InvalidValueError(input: from_text, target: "S32")
  var start = 0u64
  var negative = false
  var first = from_text[0u64]
  if first == Character(0x002Du32)
    negative = true
    start = 1u64
  elseif first == Character(0x002Bu32)
    start = 1u64
  if start >= from_text.count()
    throw InvalidValueError(input: from_text, target: "S32")
  var result = 0u32
  var i = start
  while i < from_text.count()
    var ch = from_text[i]
    if ch.is_numeric()
      result = result * 10u32 + U32(ch.digit_value())
    else
      throw InvalidValueError(input: from_text, target: "S32")
    i = i + 1u64
  if negative
    if result > 2147483648u32
      throw IntegerOverflowError()
    return LLVM::reinterpret_bits[U32, S32](0u32 -% result)
  return S32(result)

# ============================================================================
# Hashing
# ============================================================================

### Returns a SipHash-2-4 keyed hash of this value.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash suitable for denial-of-service-resistant hash tables.
routine S32.hash(k0: U64, k1: U64) -> U64
  return __secure_hash_u64(v: LLVM::zero_extend[S32, U64](me), k0: k0, k1: k1)

