routine F16.erfc() -> F16
  return F16.from_bits(bits: C::rf_f16_erfc(bits: me.to_bits()))

### Gamma function.
routine F16.tgamma!() -> F16
  var rr = me.tgamma_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Gamma function with raw IEEE 754 propagation (overflow/pole -> ±inf or NaN). Wraps
### `rf_f16_tgamma`.
routine F16.tgamma_unchecked() -> F16
  return F16.from_bits(bits: C::rf_f16_tgamma(bits: me.to_bits()))

### Natural log of the absolute value of gamma(me).
routine F16.lgamma() -> F16
  return F16.from_bits(bits: C::rf_f16_lgamma(bits: me.to_bits()))

### Truncates toward zero (alias of int_truncate).
routine F16.trunc() -> F16
  return LLVM::float_truncate[F16](me)

### Fractional part me - trunc(me).
routine F16.frac() -> F16
  return me - LLVM::float_truncate[F16](me)

### Integer and fractional parts (C modf); both carry the sign of me.
routine F16.modf() -> (F16, F16)
  var ip = LLVM::float_truncate[F16](me)
  return (ip, me - ip)

### Fraction in [0.5,1) and power-of-two exponent (C frexp).
routine F16.frexp() -> (F16, S64)
  if me.is_zero() or me.is_infinite() or me.is_nan()
    return (me, 0_s64)
  var e = LLVM::add(a: C::rf_f16_ilogb(bits: me.to_bits()), b: 1_s64)
  return (F16.from_bits(bits: C::rf_f16_scalbn(bits: me.to_bits(), n: LLVM::sub(a: 0_s64, b: e))), e)

### True if the sign bit is set (C signbit).
routine F16.signbit() -> Bool
  return LLVM::int_ne(a: LLVM::bit_and(a: me.to_bits(), b: 0x8000_u16), b: 0_u16)

### True for a subnormal (denormalized, nonzero) value.
routine F16.is_subnormal() -> Bool
  var bits = me.to_bits()
  var exponent = LLVM::bit_and(a: bits, b: 0x7C00_u16)
  var mantissa = LLVM::bit_and(a: bits, b: 0x03FF_u16)
  return exponent == 0_u16 and mantissa != 0_u16

### True for a finite, normal value (nonzero and not subnormal).
routine F16.is_normal() -> Bool
  return me.is_finite() and not me.is_zero() and not me.is_subnormal()

### C fpclassify: 0 NaN, 1 infinite, 2 zero, 3 subnormal, 4 normal.
routine F16.fpclassify() -> FpClass
  if me.is_signaling()
    return SIGNALING_NAN
  if me.is_nan()
    return NAN
  if me.is_infinite()
    return INFINITE
  if me.is_zero()
    return ZERO
  if me.is_subnormal()
    return SUBNORMAL
  return NORMAL

# ============================================================================
# IEEE 754 Tier 1 — total ordering predicates
# ============================================================================

### Sign-magnitude total-order key: negatives become small, non-negatives large, so an
### unsigned `<=` reproduces the IEEE 754 totalOrder ranking (-NaN < -inf < ... < +inf < +NaN).
routine f16_order_key(bits: U16) -> U16
  if LLVM::int_ne(a: LLVM::bit_and(a: bits, b: 0x8000_u16), b: 0_u16)
    return LLVM::bit_xor(a: bits, b: 0xFFFF_u16)
  return LLVM::bit_or(a: bits, b: 0x8000_u16)

### IEEE 754 totalOrder: a total order over all values including signed zeros and NaNs
### (-NaN < -inf < negatives < -0 < +0 < positives < +inf < +NaN). Never crashes.
### :param you: The value to compare against.
### :returns: Whether `me` precedes or equals `you` in the total order.
routine F16.total_order(you: F16) -> Bool
  return f16_order_key(bits: me.to_bits()) <= f16_order_key(bits: you.to_bits())

### IEEE 754 totalOrderMag: `total_order` applied to the magnitudes (sign bit cleared).
### :param you: The value whose magnitude to compare against.
### :returns: Whether `|me|` precedes or equals `|you|` in the total order.
routine F16.total_order_mag(you: F16) -> Bool
  return LLVM::bit_and(a: me.to_bits(), b: 0x7FFF_u16) <= LLVM::bit_and(a: you.to_bits(), b: 0x7FFF_u16)

# ============================================================================
# IEEE 754 Tier 2 — stepping, exponent extraction, scaling, selection, rounding
# ============================================================================

### IEEE 754 nextUp: the least value greater than `me`. Propagating; never crashes.
### :returns: The next representable value toward +infinity.
routine F16.next_up() -> F16
  return me.nextafter(you: F16_INFINITY)

### IEEE 754 nextDown: the greatest value less than `me`. Never crashes.
### :returns: The next representable value toward -infinity.
routine F16.next_down() -> F16
  return me.nextafter(you: -F16_INFINITY)

### IEEE 754 logb: the unbiased exponent of `me` as a floating value (logb(0)=-inf,
### logb(±inf)=+inf, logb(NaN)=NaN). Propagating; never crashes.
### :returns: The radix-2 exponent of `me`.
routine F16.logb() -> F16
  if me.is_nan()
    return me
  if me.is_infinite()
    return F16_INFINITY
  if me.is_zero()
    return -F16_INFINITY
  return F16(from: C::rf_f16_ilogb(bits: me.to_bits()))

### IEEE 754 scaleB: `me * 2^n`. Checked: crashes if a finite `me` overflows to ±infinity.
### :param n: The power-of-two exponent to apply.
### :returns: `me` scaled by `2^n`.
routine F16.scaleb!(n: S64) -> F16
  var r = me.scalbn(n: n)
  if r.is_finite() or not me.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `me * 2^n` with raw IEEE 754 propagation (overflow -> ±infinity).
### :param n: The power-of-two exponent to apply.
### :returns: `me` scaled by `2^n`.
routine F16.scaleb_unchecked(n: S64) -> F16
  return me.scalbn(n: n)

### IEEE 754-2008 minNum: the smaller operand, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The minimum of `me` and `you`, ignoring NaN.
routine F16.min_num(you: F16) -> F16
  return me.fmin(you: you)

### IEEE 754-2008 maxNum: the larger operand, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The maximum of `me` and `you`, ignoring NaN.
routine F16.max_num(you: F16) -> F16
  return me.fmax(you: you)

### IEEE 754-2019 minimum: the smaller operand, propagating NaN, ordering -0 below +0.
### :param you: The value to compare against.
### :returns: The minimum of `me` and `you`, NaN if either is NaN.
routine F16.minimum(you: F16) -> F16
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  if me == you
    if me.is_zero()
      return if me.signbit() then me else you
    return me
  return if me < you then me else you

### IEEE 754-2019 maximum: the larger operand, propagating NaN, ordering +0 above -0.
### :param you: The value to compare against.
### :returns: The maximum of `me` and `you`, NaN if either is NaN.
routine F16.maximum(you: F16) -> F16
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  if me == you
    if me.is_zero()
      return if me.signbit() then you else me
    return me
  return if me > you then me else you

### IEEE 754 roundToIntegralTiesToAway: rounds to nearest integer, halves away from zero.
### :returns: `me` rounded to an integral value with ties away from zero.
routine F16.round_ties_away() -> F16
  if not me.is_finite()
    return me
  var a = me.abs()
  var t = a.trunc()
  var rounded = if a - t >= 0.5_f16 then t + 1.0_f16 else t
  return rounded.copysign(sign: me)
