  return F16.from_bits(bits: C::rf_f16_tan(bits: me.to_bits()))

### Arc sine.
routine F16.asin!() -> F16
  var rr = me.asin_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Arc sine with raw IEEE 754 propagation (`|me| > 1` -> NaN). Thin wrapper over `rf_f16_asin`.
routine F16.asin_unchecked() -> F16
  return F16.from_bits(bits: C::rf_f16_asin(bits: me.to_bits()))

