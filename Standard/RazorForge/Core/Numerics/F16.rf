### Sine (radians).
routine F16.sin() -> F16
  return F16.from_bits(bits: C::rf_f16_sin(bits: me.to_bits()))

### Cosine (radians).
routine F16.cos() -> F16
  return F16.from_bits(bits: C::rf_f16_cos(bits: me.to_bits()))

