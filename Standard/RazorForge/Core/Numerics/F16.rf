routine F16.cbrt() -> F16
  return F16.from_bits(bits: C::rf_f16_cbrt(bits: me.to_bits()))

### Hypotenuse without overflow.
routine F16.hypot!(you: F16) -> F16
  var rr = me.hypot_unchecked(you: you)
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Hypotenuse with raw IEEE 754 propagation (overflow -> +inf). Thin wrapper over `rf_f16_hypot`.
routine F16.hypot_unchecked(you: F16) -> F16
  return F16.from_bits(bits: C::rf_f16_hypot(x: me.to_bits(), y: you.to_bits()))

### Fused multiply-add me*b + c with a single rounding.
routine F16.fma!(b: F16, c: F16) -> F16
  var rr = me.fma_unchecked(b: b, c: c)
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Fused multiply-add me*b + c with raw IEEE 754 propagation. Thin wrapper over `rf_f16_fma`.
routine F16.fma_unchecked(b: F16, c: F16) -> F16
  return F16.from_bits(bits: C::rf_f16_fma(x: me.to_bits(), y: b.to_bits(), z: c.to_bits()))

