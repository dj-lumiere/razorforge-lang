routine F64.atan() -> F64
  return C::rf_f64_atan(value: me)

### Two-argument arc tangent atan2(me, x).
routine F64.atan2(x: F64) -> F64
  return C::rf_f64_atan2(y: me, x: x)

### Hyperbolic sine. Checked: crashes on overflow. Use `sinh_unchecked` for raw IEEE.
routine F64.sinh!() -> F64
  var r = me.sinh_unchecked()
  if r.is_finite()
    return r
