module Core
# Core S16 type definition - maps to LLVM i16

### A 16-bit signed integer in the range −32,768 to 32,767.
###
### `S16` is used for audio samples (PCM 16-bit), compact numeric data,
### and other values that fit in 16 bits with a sign.
@llvm("i16")
record S16 obeys SignedIntegral, Ordered, ConstCompatible, AtomicType, Assignable, Copyable, Splittable
  pass

# Constants for S16 limits
preset S16_MIN: S16 = -32768_s16
preset S16_MAX: S16 = 32767_s16
preset S16_ZERO: S16 = 0_s16
preset S16_ONE: S16 = 1_s16

# ============================================================================
# Creators
# ============================================================================

### Sign-extends an `S8` to `S16`.
### :param from: The `S8` value to widen.
### :returns: An `S16` with the same signed value as `from`.
routine S16(from: S8) -> S16
  return LLVM::sign_extend[S8, S16](from)

### Identity conversion — returns `from` unchanged.
### :param from: The `S16` value to return.
### :returns: `from` unchanged.
routine S16(from: S16) -> S16
  return from

### Converts an `S32` to `S16`, throwing if the value is outside −32768..32767.
### :param from: The `S32` value to convert.
### :returns: The lower 16 bits of `from` interpreted as signed.
### :throws: {IntegerOverflowError} if `from` is not in `-32768..=32767`.
routine S16!(from: S32) -> S16
  if not (-32768s32 <= from <= 32767s32)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S32, S16](from)

### Converts an `S64` to `S16`, throwing if the value is outside −32768..32767.
### :param from: The `S64` value to convert.
### :returns: The lower 16 bits of `from` interpreted as signed.
### :throws: {IntegerOverflowError} if `from` is not in `-32768..=32767`.
routine S16!(from: S64) -> S16
  if not (-32768s64 <= from <= 32767s64)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S64, S16](from)

### Converts an `S128` to `S16`, throwing if the value is outside −32768..32767.
### :param from: The `S128` value to convert.
### :returns: The lower 16 bits of `from` interpreted as signed.
### :throws: {IntegerOverflowError} if `from` is not in `-32768..=32767`.
routine S16!(from: S128) -> S16
  if not (-32768s128 <= from <= 32767s128)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S128, S16](from)

### Zero-extends a `U8` to `S16` (always succeeds — `U8` max 255 fits in S16).
### :param from: The `U8` value to widen.
### :returns: An `S16` equal in value to `from`.
routine S16(from: U8) -> S16
  return LLVM::zero_extend[U8, S16](from)

### Reinterprets a `U16` as `S16` using two's complement, throwing if the value exceeds 32767.
### :param from: The `U16` value to convert.
### :returns: The same bit pattern interpreted as `S16`.
### :throws: {IntegerOverflowError} if `from > 32767`.
routine S16!(from: U16) -> S16
  if from > 32767_u16
    throw IntegerOverflowError()
  return LLVM::reinterpret_bits[U16, S16](from)

### Converts a `U32` to `S16`, throwing if the value exceeds 32767.
### :param from: The `U32` value to convert.
### :returns: The lower 16 bits interpreted as a signed `S16`.
### :throws: {IntegerOverflowError} if `from > 32767`.
routine S16!(from: U32) -> S16
  if from > 32767_u32
    throw IntegerOverflowError()
  return LLVM::int_truncate[U32, S16](from)

### Converts a `U64` to `S16`, throwing if the value exceeds 32767.
### :param from: The `U64` value to convert.
### :returns: The lower 16 bits interpreted as a signed `S16`.
### :throws: {IntegerOverflowError} if `from > 32767`.
routine S16!(from: U64) -> S16
  if from > 32767_u64
    throw IntegerOverflowError()
  return LLVM::int_truncate[U64, S16](from)

### Converts a `U128` to `S16`, throwing if the value exceeds 32767.
### :param from: The `U128` value to convert.
### :returns: The lower 16 bits interpreted as a signed `S16`.
### :throws: {IntegerOverflowError} if `from > 32767`.
routine S16!(from: U128) -> S16
  if from > 32767_u128
    throw IntegerOverflowError()
  return LLVM::int_truncate[U128, S16](from)

### Converts an `S256` to `S16`, throwing if outside −32768..32767.
### :param from: The `S256` value to convert.
### :returns: The lower 16 bits reinterpreted as an `S16`.
### :throws: {IntegerOverflowError} if `from` is outside −32768..32767.
routine S16!(from: S256) -> S16
  if not (-32768_s256 <= from <= 32767_s256)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S256, S16](from)

### Converts a `U256` to `S16`, throwing if the value exceeds 32767.
### :param from: The `U256` value to convert.
### :returns: The lower 16 bits reinterpreted as an `S16`.
### :throws: {IntegerOverflowError} if `from > 32767`.
routine S16!(from: U256) -> S16
  if from > 32767_u256
    throw IntegerOverflowError()
  return LLVM::int_truncate[U256, S16](from)

### Converts an `F16` to `S16` by first converting to `S32`, then truncating.
### :param from: The `F16` value to convert.
### :returns: The integer part of `from` as an `S16`.
### :throws: {IntegerOverflowError} if the integer part is outside −32768..32767.
routine S16!(from: F16) -> S16
  return from.S32!().S16!()

### Converts an `F32` to `S16` by first converting to `S32`, then truncating.
### :param from: The `F32` value to convert.
### :returns: The integer part of `from` as an `S16`.
### :throws: {IntegerOverflowError} if the integer part is outside −32768..32767.
routine S16!(from: F32) -> S16
  return from.S32!().S16!()

### Converts an `F64` to `S16` by first converting to `S32`, then truncating.
### :param from: The `F64` value to convert.
### :returns: The integer part of `from` as an `S16`.
### :throws: {IntegerOverflowError} if the integer part is outside −32768..32767.
routine S16!(from: F64) -> S16
  return from.S32!().S16!()

### Converts an `F128` to `S16` by first converting to `S32`, then truncating.
### :param from: The `F128` value to convert.
### :returns: The integer part of `from` as an `S16`.
### :throws: {IntegerOverflowError} if the integer part is outside −32768..32767.
routine S16!(from: F128) -> S16
  return from.S32!().S16!()

### Converts a `D32` to `S16` by first converting to `S32`, then truncating.
### :param from: The `D32` value to convert.
### :returns: The integer part of `from` as an `S16`.
### :throws: {IntegerOverflowError} if the integer part is outside −32768..32767.
routine S16!(from: D32) -> S16
  return from.S32!().S16!()

### Converts a `D64` to `S16` by first converting to `S32`, then truncating.
### :param from: The `D64` value to convert.
### :returns: The integer part of `from` as an `S16`.
### :throws: {IntegerOverflowError} if the integer part is outside −32768..32767.
routine S16!(from: D64) -> S16
  return from.S32!().S16!()

### Converts a `D128` to `S16` by first converting to `S32`, then truncating.
### :param from: The `D128` value to convert.
### :returns: The integer part of `from` as an `S16`.
### :throws: {IntegerOverflowError} if the integer part is outside −32768..32767.
routine S16!(from: D128) -> S16
  return from.S32!().S16!()

# ============================================================================
# Arithmetic Operations (trapping on overflow by default)
# ============================================================================

### Returns the sum and a flag indicating whether the result overflowed.
### :param you: The right operand.
### :returns: A tuple of `(wrapped_sum, overflowed)`.
routine S16.add_with_overflow(you: S16) -> (S16, Bool)
  return LLVM::signed_add_checked[S16](me, you)

### Returns the difference and a flag indicating whether the result overflowed.
### :param you: The value to subtract.
### :returns: A tuple of `(wrapped_difference, overflowed)`.
routine S16.sub_with_overflow(you: S16) -> (S16, Bool)
  return LLVM::signed_sub_checked[S16](me, you)

### Returns the product and a flag indicating whether the result overflowed.
### :param you: The right operand.
### :returns: A tuple of `(wrapped_product, overflowed)`.
routine S16.mul_with_overflow(you: S16) -> (S16, Bool)
  return LLVM::signed_mul_checked[S16](me, you)

### Returns `me + you`, throwing on overflow.
### :param you: The right operand.
### :returns: The sum `me + you`.
### :throws: {IntegerOverflowError} if the result is outside −32768..32767.
routine S16.add!(you: S16) -> S16
  var result = me.add_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me - you`, throwing on overflow.
### :param you: The value to subtract.
### :returns: The difference `me - you`.
### :throws: {IntegerOverflowError} if the result is outside −32768..32767.
routine S16.sub!(you: S16) -> S16
  var result = me.sub_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me * you`, throwing on overflow.
### :param you: The right operand.
### :returns: The product `me * you`.
### :throws: {IntegerOverflowError} if the result is outside −32768..32767.
routine S16.mul!(you: S16) -> S16
  var result = me.mul_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me // you` (euclidean division), throwing on errors.
### Euclidean division: the remainder is always in `[0, |you|)`, consistent with `mod!`.
### The special case `S16_MIN // -1` would overflow and throws.
### :param you: The divisor.
### :returns: The euclidean quotient `me // you`.
### :throws: {DivisionByZeroError} if `you == 0`.
### :throws: {IntegerOverflowError} if `me == S16_MIN` and `you == -1`.
routine S16.floordiv!(you: S16) -> S16
  if you == 0
    throw DivisionByZeroError()
  if me == S16_MIN and you == -1_s16
    throw IntegerOverflowError()
  var quotient = LLVM::signed_div(a: me, b: you)
  var remainder = LLVM::signed_rem(a: me, b: you)
  if remainder < 0_s16
    if you > 0_s16
      return quotient - 1_s16
    return quotient + 1_s16
  return quotient

### Returns `me % you` (euclidean modulo): the remainder is always in `[0, |you|)`.
### :param you: The divisor.
### :returns: The euclidean remainder — always non-negative.
### :throws: {DivisionByZeroError} if `you == 0`.
routine S16.mod!(you: S16) -> S16
  if you == 0
    throw DivisionByZeroError()
  var remainder = LLVM::signed_rem(a: me, b: you)
  if remainder < 0_s16
    if you > 0_s16
      return remainder + you
    return remainder - you
  return remainder

### Returns `-me` (arithmetic negation), throwing on overflow.
### :returns: The negated value.
### :throws: {IntegerOverflowError} when `me` is `S16_MIN` (its negation is not representable).
routine S16.neg!() -> S16
  if me == -32768_s16
    throw IntegerOverflowError()
  return LLVM::sub(a: 0_s16, b: me)

# ============================================================================
# Wrapping Arithmetic (+%, -%, *%)
# ============================================================================

### Returns `(me + you)` with wrapping arithmetic (mod 65536, signed).
### :param you: The right operand.
### :returns: The sum, wrapping on overflow.
routine S16.add_wrap(you: S16) -> S16
  return LLVM::add(a: me, b: you)

### Returns `(me - you)` with wrapping arithmetic (mod 65536, signed).
### :param you: The value to subtract.
### :returns: The difference, wrapping on underflow.
routine S16.sub_wrap(you: S16) -> S16
  return LLVM::sub(a: me, b: you)

### Returns `(me * you)` with wrapping arithmetic (mod 65536, signed).
### :param you: The right operand.
### :returns: The product, wrapping on overflow.
routine S16.mul_wrap(you: S16) -> S16
  return LLVM::mul(a: me, b: you)

# ============================================================================
# Unchecked Arithmetic (+!, -!, *!, //!, %!)
# ============================================================================

### Returns `me + you` with undefined behavior on overflow.
### :param you: The right operand.
### :returns: The sum, assuming no overflow.
dangerous routine S16.add_unchecked(you: S16) -> S16
  return LLVM::signed_add_exact[S16](a: me, b: you)

### Returns `me - you` with undefined behavior on overflow.
### :param you: The value to subtract.
### :returns: The difference, assuming no overflow.
dangerous routine S16.sub_unchecked(you: S16) -> S16
  return LLVM::signed_sub_exact[S16](a: me, b: you)

### Returns `me * you` with undefined behavior on overflow.
### :param you: The right operand.
### :returns: The product, assuming no overflow.
dangerous routine S16.mul_unchecked(you: S16) -> S16
  return LLVM::signed_mul_exact[S16](a: me, b: you)

### Returns `me // you` (euclidean division) with undefined behavior if `you == 0` or overflow.
### :param you: The divisor.
### :returns: The euclidean quotient, assuming `you != 0` and no overflow.
dangerous routine S16.floordiv_unchecked(you: S16) -> S16
  var quotient = LLVM::signed_div(a: me, b: you)
  var remainder = LLVM::signed_rem(a: me, b: you)
  if remainder < 0_s16
    if you > 0_s16
      return quotient - 1_s16
    return quotient + 1_s16
  return quotient

### Returns `me % you` (euclidean modulo) with undefined behavior if `you == 0`.
### :param you: The divisor.
### :returns: The euclidean remainder, assuming `you != 0`.
dangerous routine S16.mod_unchecked(you: S16) -> S16
  var remainder = LLVM::signed_rem(a: me, b: you)
  if remainder < 0_s16
    if you > 0_s16
      return remainder + you
    return remainder - you
  return remainder

# ============================================================================
# Clamping Arithmetic (+^, -^, *^)
# ============================================================================

### Returns `me + you`, clamped to `S16_MAX` or `S16_MIN` on overflow.
### :param you: The right operand.
### :returns: The sum, or `32767` / `−32768` if it would overflow.
routine S16.add_clamp(you: S16) -> S16
  return LLVM::signed_add_sat[S16](a: me, b: you)

### Returns `me - you`, clamped to `S16_MAX` or `S16_MIN` on overflow.
### :param you: The value to subtract.
### :returns: The difference, or `32767` / `−32768` if it would overflow.
routine S16.sub_clamp(you: S16) -> S16
  return LLVM::signed_sub_sat[S16](a: me, b: you)

### Returns `me * you`, clamped to `S16_MAX` or `S16_MIN` on overflow.
### :param you: The right operand.
### :returns: The product, or `32767` / `−32768` if it would overflow.
routine S16.mul_clamp(you: S16) -> S16
  var wide = LLVM::mul(LLVM::sign_extend[S16, S32](me), LLVM::sign_extend[S16, S32](you))
  if LLVM::signed_gt(wide, 32767_s32)
    return S16_MAX
  if LLVM::signed_lt(wide, -32768_s32)
    return S16_MIN
  return LLVM::int_truncate[S32, S16](wide)

# ============================================================================
# Power Operations (**)
# ============================================================================

### Returns `me ** exp` and a flag indicating whether the result overflowed.
### :param exp: The exponent (must be non-negative).
### :returns: A tuple of `(wrapped_result, overflowed)`.
### :throws: {NumericDomainError} if `exp < 0`.
routine S16.pow_with_overflow!(exp: S16) -> (S16, Bool)
  if exp < 0
    throw NumericDomainError(description: "negative exponent: no integer result")
  var result: S16 = 1
  var base: S16 = me
  var e: U32 = U32(exp)
  var overflow = false
  while e > 0
    if (e & 1) == 1
      var mul_result = result.mul_with_overflow(base)
      result = mul_result.item0
      overflow = overflow or mul_result.item1
    e = e >> 1_u32
    if e > 0
      var square_result = base.mul_with_overflow(base)
      base = square_result.item0
      overflow = overflow or square_result.item1
  return (result, overflow)

### Returns `me ** exp`, throwing on overflow.
### :param exp: The exponent (must be non-negative).
### :returns: The result of raising `me` to the power `exp`.
### :throws: {IntegerOverflowError} if the result is outside −32768..32767.
### :throws: {NumericDomainError} if `exp < 0`.
routine S16.pow!(exp: S16) -> S16
  var result = me.pow_with_overflow(exp)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me ** exp` with wrapping arithmetic.
### :param exp: The exponent (must be non-negative).
### :returns: The result modulo 65536 (signed wrap).
### :throws: {NumericDomainError} if `exp < 0`.
routine S16.pow_wrap!(exp: S16) -> S16
  if exp < 0_s16
    throw NumericDomainError(description: "negative exponent: no integer result")
  var result: S16 = 1
  var base: S16 = me
  var e: U32 = U32(exp)
  while e > 0
    if (e & 1) == 1
      result = result.mul_wrap(base)
    e = e >> 1_u32
    if e > 0
      base = base.mul_wrap(base)
  return result

### Returns `me ** exp`, clamped to `S16_MAX` or `S16_MIN` on overflow.
### :param exp: The exponent (must be non-negative).
### :returns: The result, or `32767` / `−32768` if it would overflow.
### :throws: {NumericDomainError} if `exp < 0`.
routine S16.pow_clamp!(exp: S16) -> S16
  if exp < 0
    throw NumericDomainError(description: "negative exponent: no integer result")
  var result: S16 = 1
  var base: S16 = me
  var e: U32 = U32(exp)
  while e > 0
    if (e & 1) == 1
      result = result.mul_clamp(base)
    e = e >> 1_u32
    if e > 0
      base = base.mul_clamp(base)
  return result

# ============================================================================
# Bitwise Operations
# ============================================================================

### Returns the bitwise AND of this value and `you`.
### :param you: The right operand.
### :returns: `me & you`.
routine S16.bitand(you: S16) -> S16
  return LLVM::bit_and(a: me, b: you)

### Returns the bitwise OR of this value and `you`.
### :param you: The right operand.
### :returns: `me | you`.
routine S16.bitor(you: S16) -> S16
  return LLVM::bit_or(a: me, b: you)

### Returns the bitwise XOR of this value and `you`.
### :param you: The right operand.
### :returns: `me ^ you`.
routine S16.bitxor(you: S16) -> S16
  return LLVM::bit_xor(a: me, b: you)

### Returns the bitwise complement of this value.
### :returns: `~me` — each bit flipped.
routine S16.bitnot() -> S16
  return LLVM::bit_xor[S16](a: me, b: -1)

# ============================================================================
# Shift Operations (<<, <<?>, >>, <<<, >>>)
# ============================================================================

### Left-shifts this value by `bits` positions, filling vacated bits with zero.
### :param bits: The number of bit positions to shift left.
### :returns: `me << bits`.
routine S16.ashl(bits: U32) -> S16
  return LLVM::shift_left(me, S16(bits))

### Right-shifts this value by `bits` positions, sign-filling (arithmetic shift right).
### :param bits: The number of bit positions to shift right.
### :returns: `me >> bits`, copying the sign bit into vacated positions.
routine S16.ashr(bits: U32) -> S16
  return LLVM::shift_right_signed(me, S16(bits))

### Left-shifts this value by `bits` positions (same as `ashl` for signed integers).
### :param bits: The number of bit positions to shift left.
### :returns: `me << bits`.
routine S16.lshl(bits: U32) -> S16
  return LLVM::shift_left(me, S16(bits))

### Right-shifts this value by `bits` positions, zero-filling (logical shift right).
### :param bits: The number of bit positions to shift right.
### :returns: `me >>> bits`, filling vacated bits with zero regardless of sign.
routine S16.lshr(bits: U32) -> S16
  return LLVM::shift_right_unsigned(me, S16(bits))

# ============================================================================
# Comparison Operations
# ============================================================================

### Returns `true` when both values are equal.
### :param you: The value to compare against.
### :returns: `true` if `me == you`; `false` otherwise.
routine S16.eq(you: S16) -> Bool
  return LLVM::int_eq(a: me, b: you)

### Compares this value with `you`, returning the ordering relationship.
### :param you: The value to compare against.
### :returns: `ME_SMALL` if `me < you`, `ME_LARGE` if `me > you`, `SAME` if equal.
routine S16.cmp(you: S16) -> ComparisonSign
  if LLVM::signed_lt(me, you)
    return ME_SMALL
  if LLVM::signed_gt(me, you)
    return ME_LARGE
  return SAME

# ============================================================================
# Math Operations
# ============================================================================

### Returns the absolute value of this integer.
### :returns: `-me` if `me < 0`; `me` if `me >= 0`.
### :throws: {IntegerOverflowError} when `me` is `S16_MIN` (its magnitude is not representable in S16).
routine S16.abs!() -> S16
  if me == -32768_s16
    throw IntegerOverflowError()
  return LLVM::int_abs[S16](me)

### Returns the smaller of this value and `you`.
### :param you: The value to compare against.
### :returns: `me` if `me <= you`; otherwise `you`.
routine S16.min(you: S16) -> S16
  return if me <= you then me else you

### Returns the larger of this value and `you`.
### :param you: The value to compare against.
### :returns: `me` if `me >= you`; otherwise `you`.
routine S16.max(you: S16) -> S16
  return if me >= you then me else you

### Returns this value clamped to the range `min_val..=max_val`.
### :param min_val: The lower bound (inclusive).
### :param max_val: The upper bound (inclusive).
### :returns: `min_val` if `me < min_val`; `max_val` if `me > max_val`; otherwise `me`.
@positional
routine S16.clamp(min_val: S16, max_val: S16) -> S16
  return me.min(max_val).max(min_val)

# ============================================================================
# Bit Manipulation
# ============================================================================

### Returns the count of set bits (popcount) in this value's 16-bit representation.
### :returns: The number of `1` bits; between 0 and 16.
routine S16.count_ones() -> S16
  return LLVM::count_ones[S16](me)

### Returns the count of clear bits in this value's 16-bit representation.
### :returns: `16` minus the popcount; between 0 and 16.
routine S16.count_zeros() -> S16
  return 16_s16 -% me.count_ones()

### Returns the number of leading zero bits, starting from the most-significant bit.
### :returns: The leading zero count; `16` if the value is zero.
routine S16.leading_zeros() -> S16
  return LLVM::leading_zeros(me)

### Returns the number of trailing zero bits, starting from the least-significant bit.
### :returns: The trailing zero count; `16` if the value is zero.
routine S16.trailing_zeros() -> S16
  return LLVM::trailing_zeros(me)

### Returns the number of leading one bits, starting from the most-significant bit.
### :returns: The leading one count; `16` if the value is `−1` (all bits set).
routine S16.leading_ones() -> S16
  return me.bitnot().leading_zeros()

### Returns the number of trailing one bits, starting from the least-significant bit.
### :returns: The trailing one count; `16` if the value is `−1` (all bits set).
routine S16.trailing_ones() -> S16
  return me.bitnot().trailing_zeros()

### Returns this value with its bits reversed (bit 15 ↔ bit 0, etc.).
### :returns: The bit-reversed `S16`.
routine S16.reverse_bits() -> S16
  return LLVM::reverse_bits[S16](me)

### Returns this value with its two bytes swapped (for endianness conversion).
### :returns: An `S16` with the high and low bytes exchanged.
routine S16.swap_bytes() -> S16
  return LLVM::byte_swap(me)

### Returns this value rotated left by `bits` positions.
routine S16.rotate_left(bits: U32) -> S16
  return LLVM::reinterpret_bits[U16, S16](LLVM::reinterpret_bits[S16, U16](me).rotate_left(bits: bits))

### Returns this value rotated right by `bits` positions.
routine S16.rotate_right(bits: U32) -> S16
  return LLVM::reinterpret_bits[U16, S16](LLVM::reinterpret_bits[S16, U16](me).rotate_right(bits: bits))

### Returns the raw byte representation of this value in little-endian order.
routine S16.to_bytes_le() -> Array[Byte, 2]
  return LLVM::reinterpret_bits[S16, U16](me).to_bytes_le()

### Returns the raw byte representation of this value in big-endian order.
routine S16.to_bytes_be() -> Array[Byte, 2]
  return LLVM::reinterpret_bits[S16, U16](me).to_bytes_be()

### Builds an `S16` from its little-endian raw byte representation.
common routine S16.from_bytes_le(bytes: Array[Byte, 2]) -> S16
  return LLVM::reinterpret_bits[U16, S16](U16.from_bytes_le(bytes: bytes))

### Builds an `S16` from its big-endian raw byte representation.
common routine S16.from_bytes_be(bytes: Array[Byte, 2]) -> S16
  return LLVM::reinterpret_bits[U16, S16](U16.from_bytes_be(bytes: bytes))

# ============================================================================
# Utility Methods
# ============================================================================

### Returns `true` if this value is greater than zero.
### :returns: `true` if `me > 0`.
routine S16.is_positive() -> Bool
  return me > 0_s16

### Returns `true` if this value is less than zero.
### :returns: `true` if `me < 0`.
routine S16.is_negative() -> Bool
  return me < 0_s16

### Returns `true` if this value is zero.
### :returns: `true` if `me == 0`.
routine S16.is_zero() -> Bool
  return me == 0_s16

### Returns `true` if this value is divisible by 2.
### :returns: `true` if the least-significant bit is 0.
routine S16.is_even() -> Bool
  var result = LLVM::bit_and(a: me, b: 1_s16)
  return LLVM::int_eq(a: result, b: 0_s16)

### Returns `true` if this value is not divisible by 2.
### :returns: `true` if the least-significant bit is 1.
routine S16.is_odd() -> Bool
  return not me.is_even()

### Returns true if this value is an exact power of two.
### Negative values always return `false`.
### :returns: `true` if `me > 0 and (me & (me - 1)) == 0`.
routine S16.is_power_of_two() -> Bool
  return me > 0_s16 and (me & (me -% 1_s16)) == 0_s16

### Returns the sign of this value as −1, 0, or 1.
### :returns: `1` if `me > 0`, `−1` if `me < 0`, `0` if `me == 0`.
routine S16.signum() -> S16
  return when
    me > 0_s16 => 1_s16
    me < 0_s16 => -1_s16
    else => 0_s16

# ============================================================================
# Text Representation and Parsing
# ============================================================================

### Returns the human-readable text of this value.
### :returns: The value rendered as `Text`.
@override
routine S16.represent() -> Text
  if me == 0s16
    return "0"
  if me > 0s16
    return U16(me).represent()
  # Use reinterpret_bits (not U16(me)) — U16.create(S16) throws on negative inputs,
  # and we need the raw bit pattern so the two's-complement negation `0u16 -% bits`
  # yields |me| (works correctly even for S16.MIN, whose absolute value overflows S16).
  return "-" + (0u16 -% LLVM::reinterpret_bits[S16, U16](me)).represent()

### Returns a type-tagged debug rendering of this value.
### :returns: A diagnostic `Text` rendering, e.g. `Type(value)`.
@override
routine S16.diagnose() -> Text
  return "S16(" + me.represent() + ")"

### Parses a decimal string into an `S16`, accepting an optional leading `+` or `−` sign.
### :param from_text: The decimal string to parse.
### :returns: The parsed `S16` value.
### :throws: {InvalidValueError} if `from_text` is empty, sign-only, or contains non-digit characters.
routine S16!(from_text: Text) -> S16
  if from_text.count() == 0u64
    throw InvalidValueError(input: from_text, target: "S16")
  var start = 0u64
  var negative = false
  var first = from_text[0u64]
  if first == Character(0x002Du32)
    negative = true
    start = 1u64
  elseif first == Character(0x002Bu32)
    start = 1u64
  if start >= from_text.count()
    throw InvalidValueError(input: from_text, target: "S16")
  var result = 0u32
  var i = start
  while i < from_text.count()
    var ch = from_text[i]
    if ch.is_numeric()
      result = result * 10u32 + U32(ch.digit_value())
    else
      throw InvalidValueError(input: from_text, target: "S16")
    i = i + 1u64
  if negative
    if result > 32768u32
      throw IntegerOverflowError()
    return LLVM::reinterpret_bits[U16, S16](LLVM::int_truncate[U32, U16](0u32 -% result))
  return S16(result)

# ============================================================================
# Hashing
# ============================================================================

### Returns a SipHash-2-4 keyed hash of this value.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash suitable for denial-of-service-resistant hash tables.
routine S16.hash(k0: U64, k1: U64) -> U64
  return __secure_hash_u64(v: LLVM::zero_extend[S16, U64](me), k0: k0, k1: k1)
