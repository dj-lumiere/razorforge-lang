### floor(x / 10^k) by reciprocal-multiply (k in 1..40); k<=0 returns x.
routine div_pow10b(x: U256, k: S64) -> U256
  if LLVM::signed_le(a: k, b: 0_s64)
    return x
  var ku = LLVM::reinterpret_bits[S64, U64](k)
  var i0 = LLVM::reinterpret_bits[S64, U64](LLVM::mul(a: k, b: 4_s64))
  var i1 = LLVM::add(a: i0, b: 1_u64)
  var i2 = LLVM::add(a: i0, b: 2_u64)
  var i3 = LLVM::add(a: i0, b: 3_u64)
  var g0 = POW10_MAGIC[i0]
  var g1 = POW10_MAGIC[i1]
  var g2 = POW10_MAGIC[i2]
  var g3 = POW10_MAGIC[i3]
  var mm = LLVM::bit_or(a: LLVM::bit_or(a: LLVM::zero_extend[U64, U256](g0), b: LLVM::shift_left(value: LLVM::zero_extend[U64, U256](g1), bits: U256.to_width(s: 64_s64))), b: LLVM::bit_or(a: LLVM::shift_left(value: LLVM::zero_extend[U64, U256](g2), bits: U256.to_width(s: 128_s64)), b: LLVM::shift_left(value: LLVM::zero_extend[U64, U256](g3), bits: U256.to_width(s: 192_s64))))
  var prod = LLVM::mul(a: LLVM::zero_extend[U256, U512](x), b: LLVM::zero_extend[U256, U512](mm))
  var t = LLVM::int_truncate[U512, U256](LLVM::shift_right_unsigned(prod, U512.to_width(s: 256_s64)))
  var s = POW10_SHIFT[ku]
  var ad = POW10_ADD[ku]
  if LLVM::int_ne(a: ad, b: 0_u64)
    var dd = LLVM::shift_right_unsigned(LLVM::sub(a: x, b: t), U256.to_width(s: 1_s64))
    var q = LLVM::add(a: dd, b: t)
    return LLVM::shift_right_unsigned(q, U256.to_width(s: LLVM::sub(a: s, b: 1_s64)))
  return LLVM::shift_right_unsigned(t, U256.to_width(s: s))

