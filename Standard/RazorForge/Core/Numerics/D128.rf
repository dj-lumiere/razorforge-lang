    var q = LLVM::add(a: dd, b: t)
    return LLVM::shift_right_unsigned(q, U512.to_width(s: LLVM::sub(a: s, b: 1_s64)))
  return LLVM::shift_right_unsigned(t, U512.to_width(s: s))

