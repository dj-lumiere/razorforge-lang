### floor(x / 10^k) for a U128 x by reciprocal-multiply (k in 1..38; k<=0 returns x).
routine div_pow10_u128(x: U128, k: S64) -> U128
  if LLVM::signed_le(a: k, b: 0_s64)
    return x
  var ku = LLVM::reinterpret_bits[S64, U64](k)
  var i0 = LLVM::reinterpret_bits[S64, U64](LLVM::mul(a: k, b: 2_s64))
  var i1 = LLVM::add(a: i0, b: 1_u64)
  var g0 = POW10_MAGIC128[i0]
  var g1 = POW10_MAGIC128[i1]
  var mm = LLVM::bit_or(a: LLVM::zero_extend[U64, U128](g0), b: LLVM::shift_left(value: LLVM::zero_extend[U64, U128](g1), bits: U128.to_width(s: 64_s64)))
  var prod = LLVM::mul(a: LLVM::zero_extend[U128, U256](x), b: LLVM::zero_extend[U128, U256](mm))
  var t = LLVM::int_truncate[U256, U128](LLVM::shift_right_unsigned(prod, U256.to_width(s: 128_s64)))
  var s = POW10_SHIFT128[ku]
  var ad = POW10_ADD128[ku]
  if LLVM::int_ne(a: ad, b: 0_u64)
    var dd = LLVM::shift_right_unsigned(LLVM::sub(a: x, b: t), U128.to_width(s: 1_s64))
    var q = LLVM::add(a: dd, b: t)
    return LLVM::shift_right_unsigned(q, U128.to_width(s: LLVM::sub(a: s, b: 1_s64)))
  return LLVM::shift_right_unsigned(t, U128.to_width(s: s))

