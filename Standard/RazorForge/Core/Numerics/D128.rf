### floor(x / 10^k) for a U512 x by reciprocal-multiply (k in 1..76; k<=0 returns x).
routine div_pow10_u512(x: U512, k: S64) -> U512
  if LLVM::signed_le(a: k, b: 0_s64)
    return x
  var ku = LLVM::reinterpret_bits[S64, U64](k)
  var i0 = LLVM::reinterpret_bits[S64, U64](LLVM::mul(a: k, b: 8_s64))
  var i1 = LLVM::add(a: i0, b: 1_u64)
  var i2 = LLVM::add(a: i0, b: 2_u64)
  var i3 = LLVM::add(a: i0, b: 3_u64)
  var i4 = LLVM::add(a: i0, b: 4_u64)
  var i5 = LLVM::add(a: i0, b: 5_u64)
  var i6 = LLVM::add(a: i0, b: 6_u64)
  var i7 = LLVM::add(a: i0, b: 7_u64)
  var g0 = POW10_MAGIC512[i0]
  var g1 = POW10_MAGIC512[i1]
  var g2 = POW10_MAGIC512[i2]
  var g3 = POW10_MAGIC512[i3]
  var g4 = POW10_MAGIC512[i4]
  var g5 = POW10_MAGIC512[i5]
  var g6 = POW10_MAGIC512[i6]
  var g7 = POW10_MAGIC512[i7]
  var mm = LLVM::bit_or(a: LLVM::bit_or(a: LLVM::bit_or(a: LLVM::bit_or(a: LLVM::bit_or(a: LLVM::bit_or(a: LLVM::bit_or(a: LLVM::zero_extend[U64, U512](g0), b: LLVM::shift_left(value: LLVM::zero_extend[U64, U512](g1), bits: U512.to_width(s: 64_s64))), b: LLVM::shift_left(value: LLVM::zero_extend[U64, U512](g2), bits: U512.to_width(s: 128_s64))), b: LLVM::shift_left(value: LLVM::zero_extend[U64, U512](g3), bits: U512.to_width(s: 192_s64))), b: LLVM::shift_left(value: LLVM::zero_extend[U64, U512](g4), bits: U512.to_width(s: 256_s64))), b: LLVM::shift_left(value: LLVM::zero_extend[U64, U512](g5), bits: U512.to_width(s: 320_s64))), b: LLVM::shift_left(value: LLVM::zero_extend[U64, U512](g6), bits: U512.to_width(s: 384_s64))), b: LLVM::shift_left(value: LLVM::zero_extend[U64, U512](g7), bits: U512.to_width(s: 448_s64)))
  var prod = LLVM::mul(a: LLVM::zero_extend[U512, U1024](x), b: LLVM::zero_extend[U512, U1024](mm))
  var t = LLVM::int_truncate[U1024, U512](LLVM::shift_right_unsigned(prod, U1024.to_width(s: 512_s64)))
  var s = POW10_SHIFT512[ku]
  var ad = POW10_ADD512[ku]
  if LLVM::int_ne(a: ad, b: 0_u64)
