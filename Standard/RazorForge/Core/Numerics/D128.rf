module Core

import Collections

# CREDITS: the BID (Binary-Integer-Decimal) encoding, rounding, and exponent rules of
# this decimal128 engine are a port and extension of Intel's Decimal Floating-Point
# Math Library ("libbid", © Intel Corporation, BSD 3-Clause). See THIRD-PARTY-NOTICES.md.

# ============================================================================
# D128 — software IEEE 754-2008 decimal128 in BID form, done competently.
#
# Storage is a custom BINARY layout (NOT a DPD declet container): bit127=sign,
# bits126..113=biased exponent (14 bits, bias 6176), bits112..0=coefficient as a
# plain U128 binary integer (< 10^34 < 2^113). Finite values only — the layout
# does not reserve a combination field, so infinities/NaNs are not representable.
# Arithmetic, decimal formatting, and the pow10 reciprocal tables all live in this
# file — the engine is self-contained (only the wide-int primitives are imported).
# Values are built natively via from_components / from_int64 (no decNumber/DPD).
#
# decimal128 limits: Pmax=34, stored exponent q in [-6176, 6111].
# ============================================================================

### A software decimal128 value in BID binary storage.
@llvm("i128")
record D128 obeys Numeric, Ordered, Assignable, Copyable
  pass

### The decoded fields of a decimal128: value = (-1)^sign * coeff * 10^exp.
### `special`: 0 finite, 1 infinity, 2 quiet NaN, 3 signaling NaN. Specials are
### encoded with the IEEE combination prefix (11110 = Inf, 11111 = NaN), which the
### finite range never reaches (biased exp <= 12287, top 2 bits never 11).
record D128Parts
  ### Sign bit.
  sign: Bool
  ### 0 finite, 1 inf, 2 qNaN, 3 sNaN.
  special: U64
  ### Unbiased exponent (finite only).
  exp: S64
  ### Integer significand 0..10^34-1 (finite only).
  coeff: U128

### Reinterprets this value as its raw decimal128 bit pattern.
routine D128.to_bits() -> U128
  return LLVM::reinterpret_bits[D128, U128](me)

### Builds a value directly from a raw decimal128 bit pattern.
common routine D128.from_bits(bits: U128) -> D128
  return LLVM::reinterpret_bits[U128, D128](bits)

### Builds a value from its low/high 64-bit words (matching Core.D128 layout).
common routine D128.from_words(low: U64, high: U64) -> D128
  var bits = LLVM::bit_or(a: LLVM::zero_extend[U64, U128](low), b: LLVM::shift_left(value: LLVM::zero_extend[U64, U128](high), bits: U128.to_width(s: 64_s64)))
  return D128.from_bits(bits: bits)

# ---- DPD interchange (IEEE 754-2008 densely-packed-decimal) ----
# BID is native (to_bits/from_bits); these convert to/from the DPD interchange word for interop.
# decimal128: bit 127 sign | 126:122 combination | 121:110 exp continuation (12) | 109:0 eleven
# declets. Combination = 2 exponent MSBs + leading digit (8/9 special-cased); trailing 33 digits
# are eleven DPD declets via bin_to_dpd/dpd_to_bin. Same scheme validated on D32/D64 vs the
# IEEE/Speleotrove canonical encodings.

### The decimal128 value re-encoded in DPD interchange form. Never crashes.
routine D128.to_dpd() -> U128
  var p = me.decode()
  var zero128 = LLVM::zero_extend[U64, U128](0_u64)
  var one128 = LLVM::zero_extend[U64, U128](1_u64)
  var sbit = LLVM::shift_left(value: if p.sign then one128 else zero128, bits: U128.to_width(s: 127_s64))
  if LLVM::int_ne(a: p.special, b: 0_u64)
    var top5 = if LLVM::int_eq(a: p.special, b: 1_u64) then 0x1E_u64 else 0x1F_u64
    var bb = LLVM::bit_or(a: sbit, b: LLVM::shift_left(value: LLVM::zero_extend[U64, U128](top5), bits: U128.to_width(s: 122_s64)))
    if LLVM::int_eq(a: p.special, b: 3_u64)
      bb = LLVM::bit_or(a: bb, b: LLVM::shift_left(value: one128, bits: U128.to_width(s: 121_s64)))
    return bb
  var e = LLVM::add(a: LLVM::reinterpret_bits[S64, U64](p.exp), b: 6176_u64)
  var thousand = LLVM::zero_extend[U64, U128](1000_u64)
  var c = p.coeff
  var cont = zero128
  var sh = 0_s64
  var k = 0_s64
  while LLVM::signed_lt(a: k, b: 11_s64)
    var g = LLVM::int_truncate[U128, U64](LLVM::unsigned_rem(a: c, b: thousand))
    cont = LLVM::bit_or(a: cont, b: LLVM::shift_left(value: LLVM::zero_extend[U64, U128](bin_to_dpd(v: g)), bits: U128.to_width(s: sh)))
    c = LLVM::unsigned_div(a: c, b: thousand)
    sh = LLVM::add(a: sh, b: 10_s64)
    k = LLVM::add(a: k, b: 1_s64)
  var msd = LLVM::int_truncate[U128, U64](c)
  var ehi = LLVM::shift_right_unsigned(e, 12_u64)
  var elo = LLVM::bit_and(a: e, b: 0xFFF_u64)
  var combo = 0_u64
  if LLVM::unsigned_lt(a: msd, b: 8_u64)
    combo = LLVM::bit_or(a: LLVM::shift_left(value: ehi, bits: 3_u64), b: msd)
  else
    combo = LLVM::bit_or(a: 0x18_u64, b: LLVM::bit_or(a: LLVM::shift_left(value: ehi, bits: 1_u64), b: LLVM::sub(a: msd, b: 8_u64)))
  var w = LLVM::bit_or(a: sbit, b: LLVM::shift_left(value: LLVM::zero_extend[U64, U128](combo), bits: U128.to_width(s: 122_s64)))
  w = LLVM::bit_or(a: w, b: LLVM::shift_left(value: LLVM::zero_extend[U64, U128](elo), bits: U128.to_width(s: 110_s64)))
  w = LLVM::bit_or(a: w, b: cont)
  return w

### Decodes a DPD interchange word into a decimal128. Never crashes.
common routine D128.from_dpd(bits: U128) -> D128
  var zero128 = LLVM::zero_extend[U64, U128](0_u64)
  var sign = LLVM::int_ne(a: LLVM::bit_and(a: bits, b: LLVM::shift_left(value: LLVM::zero_extend[U64, U128](1_u64), bits: U128.to_width(s: 127_s64))), b: zero128)
  var combo = LLVM::int_truncate[U128, U64](LLVM::bit_and(a: LLVM::shift_right_unsigned(bits, U128.to_width(s: 122_s64)), b: LLVM::zero_extend[U64, U128](0x1F_u64)))
  if LLVM::int_eq(a: combo, b: 0x1E_u64)
    return d128_of_parts(p: D128Parts(sign: sign, special: 1_u64, exp: 0_s64, coeff: zero128))
  if LLVM::int_eq(a: combo, b: 0x1F_u64)
    var sp = 2_u64
    if LLVM::int_ne(a: LLVM::bit_and(a: LLVM::shift_right_unsigned(bits, U128.to_width(s: 121_s64)), b: LLVM::zero_extend[U64, U128](1_u64)), b: zero128)
      sp = 3_u64
    return d128_of_parts(p: D128Parts(sign: sign, special: sp, exp: 0_s64, coeff: zero128))
  var ehi = 0_u64
  var msd = 0_u64
  if LLVM::unsigned_lt(a: combo, b: 0x18_u64)
    ehi = LLVM::shift_right_unsigned(combo, 3_u64)
    msd = LLVM::bit_and(a: combo, b: 0x7_u64)
  else
    ehi = LLVM::bit_and(a: LLVM::shift_right_unsigned(combo, 1_u64), b: 0x3_u64)
    msd = LLVM::add(a: 8_u64, b: LLVM::bit_and(a: combo, b: 1_u64))
  var elo = LLVM::int_truncate[U128, U64](LLVM::bit_and(a: LLVM::shift_right_unsigned(bits, U128.to_width(s: 110_s64)), b: LLVM::zero_extend[U64, U128](0xFFF_u64)))
  var e = LLVM::bit_or(a: LLVM::shift_left(value: ehi, bits: 12_u64), b: elo)
  var exp = LLVM::sub(a: LLVM::reinterpret_bits[U64, S64](e), b: 6176_s64)
  var thousand = LLVM::zero_extend[U64, U128](1000_u64)
  var coeff = LLVM::zero_extend[U64, U128](msd)
  var k = 10_s64
  while LLVM::signed_ge(a: k, b: 0_s64)
    var declet = LLVM::int_truncate[U128, U64](LLVM::bit_and(a: LLVM::shift_right_unsigned(bits, U128.to_width(s: LLVM::mul(a: 10_s64, b: k))), b: LLVM::zero_extend[U64, U128](0x3FF_u64)))
    coeff = LLVM::add(a: LLVM::mul(a: coeff, b: thousand), b: LLVM::zero_extend[U64, U128](dpd_to_bin(d: declet)))
    k = LLVM::sub(a: k, b: 1_s64)
  return d128_of_parts(p: D128Parts(sign: sign, special: 0_u64, exp: exp, coeff: coeff))

### BINARY decode — sign / specials (combination prefix) / 14-bit biased exponent /
### 113-bit coefficient.
routine D128.decode() -> D128Parts
  var bits = me.to_bits()
  # bit127 = sign.
  var sign = LLVM::int_ne[U128](a: LLVM::bit_and[U128](a: bits, b: LLVM::shift_left[U128](value: 1, bits: U128.to_width(s: 127_s64))), b: 0)
  # Combination prefix = top 5 bits (126..122): 11110 (0x1E) = Inf, 11111 (0x1F) = NaN.
  var top5 = LLVM::int_truncate[U128, U64](LLVM::bit_and(a: LLVM::shift_right_unsigned(bits, U128.to_width(s: 122_s64)), b: LLVM::zero_extend[U64, U128](0x1F_u64)))
  if LLVM::int_eq(a: top5, b: 0x1E_u64)
    return D128Parts(sign: sign, special: 1_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U128](0_u64))
  if LLVM::int_eq(a: top5, b: 0x1F_u64)
    # NaN: bit121 is the signaling flag (1 = sNaN -> special 3, else qNaN -> 2).
    var sp = 2_u64
    if LLVM::int_ne[U128](a: LLVM::bit_and[U128](a: LLVM::shift_right_unsigned[U128](bits, U128.to_width(s: 121_s64)), b: LLVM::zero_extend[U64, U128](1_u64)), b: 0)
      sp = 3_u64
    return D128Parts(sign: sign, special: sp, exp: 0_s64, coeff: LLVM::zero_extend[U64, U128](0_u64))
  # Finite: bits 126..113 = 14-bit biased exponent; bits 112..0 = 113-bit coefficient.
  var biased = LLVM::int_truncate[U128, U64](LLVM::bit_and(a: LLVM::shift_right_unsigned(bits, U128.to_width(s: 113_s64)), b: LLVM::zero_extend[U64, U128](0x3FFF_u64)))
  var coeff = LLVM::bit_and[U128](a: bits, b: LLVM::sub[U128](a: LLVM::shift_left[U128](value: 1, bits: U128.to_width(s: 113_s64)), b: 1))
  # Unbias by 6176 to recover the true base-10 exponent.
  return D128Parts(sign: sign, special: 0_u64, exp: LLVM::sub(a: LLVM::reinterpret_bits[U64, S64](biased), b: 6176_s64), coeff: coeff)

### BINARY encode — pack sign / specials / exponent / coefficient.
routine d128_of_parts(p: D128Parts) -> D128
  # Sign goes to bit127.
  var sbit = LLVM::shift_left(value: LLVM::zero_extend[U64, U128](if p.sign then 1_u64 else 0_u64), bits: U128.to_width(s: 127_s64))
  if LLVM::int_ne(a: p.special, b: 0_u64)
    # Combination prefix 0x1E (Inf) or 0x1F (NaN) into bits 126..122; bit121 set for sNaN.
    var top5 = if LLVM::int_eq(a: p.special, b: 1_u64) then 0x1E_u64 else 0x1F_u64
    var b = LLVM::bit_or(a: sbit, b: LLVM::shift_left(value: LLVM::zero_extend[U64, U128](top5), bits: U128.to_width(s: 122_s64)))
    if LLVM::int_eq(a: p.special, b: 3_u64)
      b = LLVM::bit_or[U128](a: b, b: LLVM::shift_left[U128](value: 1, bits: U128.to_width(s: 121_s64)))
    return D128.from_bits(bits: b)
  # Finite: rebias the exponent (+6176), mask to 14 bits at bits 126..113, OR in the coefficient.
  var biased = LLVM::add(a: LLVM::reinterpret_bits[S64, U64](p.exp), b: 6176_u64)
  var ebits = LLVM::shift_left(value: LLVM::zero_extend[U64, U128](LLVM::bit_and(a: biased, b: 0x3FFF_u64)), bits: U128.to_width(s: 113_s64))
  return D128.from_bits(bits: LLVM::bit_or(a: LLVM::bit_or(a: sbit, b: ebits), b: p.coeff))

### Infinity with the given sign.
common routine D128.infinity(sign: Bool) -> D128
  return d128_of_parts(p: D128Parts(sign: sign, special: 1_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U128](0_u64)))

### A quiet NaN.
common routine D128.quiet_nan() -> D128
  return d128_of_parts(p: D128Parts(sign: false, special: 2_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U128](0_u64)))

### Returns a signaling NaN (interop/testing; never produced by arithmetic).
common routine D128.signaling_nan() -> D128
  return d128_of_parts(p: D128Parts(sign: false, special: 3_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U128](0_u64)))

### True when finite (neither inf nor NaN).
routine D128.is_finite() -> Bool
  return LLVM::int_eq(a: me.decode().special, b: 0_u64)

### True when infinite.
routine D128.is_infinite() -> Bool
  return LLVM::int_eq(a: me.decode().special, b: 1_u64)

### True when NaN (quiet or signaling).
routine D128.is_nan() -> Bool
  return LLVM::unsigned_ge(a: me.decode().special, b: 2_u64)

### True when this is a SIGNALING NaN (special field == 3).
routine D128.is_signaling() -> Bool
  return LLVM::int_eq(a: me.decode().special, b: 3_u64)

### True when this is a finite zero (±0).
routine D128.is_zero() -> Bool
  var p = me.decode()
  return LLVM::int_eq(a: p.special, b: 0_u64) and LLVM::int_eq(a: p.coeff, b: LLVM::zero_extend[U64, U128](0_u64))

### Builds a finite D128 from a signed coefficient and a base-10 exponent:
### value = (-1)^sign * coeff * 10^exp. The native constructor — no decNumber/DPD.
common routine D128.from_components(sign: Bool, coeff: U128, exp: S64) -> D128
  return d128_of_parts(p: D128Parts(sign: sign, special: 0_u64, exp: exp, coeff: coeff))

### Builds a D128 from a 64-bit signed integer (exponent 0).
common routine D128.from_int64(value: S64) -> D128
  var neg = LLVM::signed_lt(a: value, b: 0_s64)
  var mag = if neg then LLVM::sub(a: 0_s64, b: value) else value
  return D128.from_components(sign: neg, coeff: LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](mag)), exp: 0_s64)

### Truncating integer magnitude (toward zero) of a finite decimal as a U128. Throws when
### the integer part overflows U128. The coefficient carries <= 34 digits, so a positive
### exponent past 38 always overflows and a negative exponent past -38 truncates to zero.
routine d128_int_magnitude!(coeff: U128, exp: S64) -> U128
  if LLVM::int_eq[U128](a: coeff, b: 0)
    return 0_u128
  if LLVM::signed_ge(a: exp, b: 0_s64)
    if LLVM::signed_ge(a: exp, b: 39_s64)
      throw NumericOverflowError(description: "decimal magnitude exceeds a 128-bit integer")
    var prod = LLVM::mul(a: LLVM::zero_extend[U128, U256](coeff), b: pow10_tbl(k: exp))
    if LLVM::int_ne[U256](a: LLVM::shift_right_unsigned[U256](value: prod, bits: U256.to_width(s: 128_s64)), b: 0)
      throw NumericOverflowError(description: "decimal magnitude exceeds a 128-bit integer")
    return LLVM::int_truncate[U256, U128](prod)
  var d = LLVM::sub(a: 0_s64, b: exp)
  if LLVM::signed_ge(a: d, b: 39_s64)
    return 0_u128
  return div_pow10_u128(x: coeff, k: d)

### Truncates toward zero to an unsigned 128-bit integer. Throws on a non-finite value, a
### negative value, or an integer part beyond U128.
routine U128!(from: D128) -> U128
  var p = from.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64)
    throw NumericDomainError(description: "non-finite decimal is not an integer")
  if p.sign and LLVM::int_ne[U128](a: p.coeff, b: 0)
    throw NumericOverflowError(description: "negative decimal to unsigned integer")
  return d128_int_magnitude(coeff: p.coeff, exp: p.exp)

### Truncates toward zero to a signed 128-bit integer. Throws on a non-finite value or an
### integer part outside [-2^127, 2^127-1].
routine S128!(from: D128) -> S128
  var p = from.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64)
    throw NumericDomainError(description: "non-finite decimal is not an integer")
  var mag = d128_int_magnitude(coeff: p.coeff, exp: p.exp)
  var lim = LLVM::shift_left[U128](value: 1, bits: U128.to_width(s: 127_s64))
  if p.sign
    if LLVM::unsigned_gt(a: mag, b: lim)
      throw NumericOverflowError(description: "decimal out of range for target integer")
    if LLVM::int_eq(a: mag, b: lim)
      return LLVM::reinterpret_bits[U128, S128](lim)
    return LLVM::sub(a: 0_s128, b: LLVM::reinterpret_bits[U128, S128](mag))
  if LLVM::unsigned_ge(a: mag, b: lim)
    throw NumericOverflowError(description: "decimal out of range for target integer")
  return LLVM::reinterpret_bits[U128, S128](mag)

### Truncating integer magnitude (toward zero) of a finite decimal as a U256. Throws when
### the integer part overflows U256. Coefficient carries <= 34 digits so exp >= 78 always
### overflows; negative exp past -38 truncates to zero (no 34-digit value survives /10^39).
routine d128_int_magnitude_u256!(coeff: U128, exp: S64) -> U256
  if LLVM::int_eq[U128](a: coeff, b: 0)
    return 0_u256
  if LLVM::signed_ge(a: exp, b: 0_s64)
    if LLVM::signed_ge(a: exp, b: 78_s64)
      throw NumericOverflowError(description: "decimal magnitude exceeds a 256-bit integer")
    var prod = LLVM::mul(a: LLVM::zero_extend[U128, U512](coeff), b: LLVM::zero_extend[U256, U512](pow10_tbl(k: exp)))
    if LLVM::int_ne[U512](a: LLVM::shift_right_unsigned[U512](value: prod, bits: U512.to_width(s: 256_s64)), b: 0)
      throw NumericOverflowError(description: "decimal magnitude exceeds a 256-bit integer")
    return LLVM::int_truncate[U512, U256](prod)
  var d = LLVM::sub(a: 0_s64, b: exp)
  if LLVM::signed_ge(a: d, b: 39_s64)
    return 0_u256
  return LLVM::zero_extend[U128, U256](div_pow10_u128(x: coeff, k: d))

### Truncates toward zero to an unsigned 256-bit integer. Throws on a non-finite value, a
### negative value, or an integer part beyond U256.
routine U256!(from: D128) -> U256
  var p = from.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64)
    throw NumericDomainError(description: "non-finite decimal is not an integer")
  if p.sign and LLVM::int_ne[U128](a: p.coeff, b: 0)
    throw NumericOverflowError(description: "negative decimal to unsigned integer")
  return d128_int_magnitude_u256(coeff: p.coeff, exp: p.exp)

### Truncates toward zero to a signed 256-bit integer. Throws on a non-finite value or an
### integer part outside [-2^255, 2^255-1].
routine S256!(from: D128) -> S256
  var p = from.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64)
    throw NumericDomainError(description: "non-finite decimal is not an integer")
  var mag = d128_int_magnitude_u256(coeff: p.coeff, exp: p.exp)
  var lim = LLVM::shift_left[U256](value: 1, bits: U256.to_width(s: 255_s64))
  if p.sign
    if LLVM::unsigned_gt(a: mag, b: lim)
      throw NumericOverflowError(description: "decimal out of range for target integer")
    if LLVM::int_eq(a: mag, b: lim)
      return LLVM::reinterpret_bits[U256, S256](lim)
    return LLVM::sub(a: 0_s256, b: LLVM::reinterpret_bits[U256, S256](mag))
  if LLVM::unsigned_ge(a: mag, b: lim)
    throw NumericOverflowError(description: "decimal out of range for target integer")
  return LLVM::reinterpret_bits[U256, S256](mag)

# ============================================================================
# Arithmetic core (formerly DecMathB) — U256 working width, clz digit count,
# reciprocal pow10 reduction.
# ============================================================================
### 10^k as a U256 (k small). Multiplies are cheap — only DIVISIONS were the
### naive-BID cost, so a pow10 multiply loop is fine.
routine pow10b(k: S64) -> U256
  return pow10_tbl(k: k)

### Number of decimal digits in `c` (0 has 1 digit). Divides by 10^18 chunks so a
### 34..72-digit coefficient costs ~4 wide divisions instead of ~72, then finishes
### the last <=18 digits in native U64 division.
routine digits10b(c: U256) -> S64
  if LLVM::int_eq[U256](a: c, b: 0)
    return 1_s64
  # clz-based: digits ≈ ((nbits * 1233) >> 12) + 1, one ±1 compare vs pow10_tbl.
  # No wide multiply — leading_zeros is one instruction, the compare one U256 cmp.
  var nbits = LLVM::sub(a: 256_s64, b: LLVM::int_truncate[U256, S64](LLVM::leading_zeros(c)))
  var d = LLVM::add(a: LLVM::signed_div(a: LLVM::mul(a: nbits, b: 1233_s64), b: 4096_s64), b: 1_s64)
  if LLVM::signed_ge(a: d, b: 1_s64) and LLVM::unsigned_lt(a: c, b: pow10_tbl(k: LLVM::sub(a: d, b: 1_s64)))
    return LLVM::sub(a: d, b: 1_s64)
  if LLVM::signed_le(a: d, b: 76_s64) and LLVM::unsigned_ge(a: c, b: pow10_tbl(k: d))
    return LLVM::add(a: d, b: 1_s64)
  return d

### Widens a U128 coefficient to the U256 working width.
routine cwb(c: U128) -> U256
  return LLVM::zero_extend[U128, U256](c)

### Number of decimal digits in a U128 value (0 has 1 digit), via 10^18 chunks.
routine digits10_u128(c: U128) -> S64
  if LLVM::int_eq(a: c, b: 0_u128)
    return 1_s64
  # clz-based digit count (see digits10b). pow10 at U128 = truncated pow10_tbl.
  var nbits = LLVM::sub(a: 128_s64, b: LLVM::int_truncate[U128, S64](LLVM::leading_zeros(c)))
  var d = LLVM::add(a: LLVM::signed_div(a: LLVM::mul(a: nbits, b: 1233_s64), b: 4096_s64), b: 1_s64)
  if LLVM::signed_ge(a: d, b: 1_s64) and LLVM::unsigned_lt(a: c, b: LLVM::int_truncate[U256, U128](pow10_tbl(k: LLVM::sub(a: d, b: 1_s64))))
    return LLVM::sub(a: d, b: 1_s64)
  if LLVM::signed_le(a: d, b: 38_s64) and LLVM::unsigned_ge(a: c, b: LLVM::int_truncate[U256, U128](pow10_tbl(k: d)))
    return LLVM::add(a: d, b: 1_s64)
  return d

### Rounds a wide working value to <=34 significant digits (round-half-even) and
### applies the preferred exponent `pref`, returning a finalized finite D128Parts.
routine decfinB(sign: Bool, coeff: U256, exp: S64, pref: S64) -> D128Parts
  var ten = LLVM::zero_extend[U64, U256](10_u64)
  var two = LLVM::zero_extend[U64, U256](2_u64)
  var one = LLVM::zero_extend[U64, U256](1_u64)
  if LLVM::int_eq[U256](a: coeff, b: 0)
    var ez = pref
    if LLVM::signed_lt(a: ez, b: -6176_s64)
      ez = -6176_s64
    if LLVM::signed_gt(a: ez, b: 6111_s64)
      ez = 6111_s64
    return D128Parts(sign: sign, special: 0_u64, exp: ez, coeff: LLVM::zero_extend[U64, U128](0_u64))
  var c = coeff
  var e = exp
  var nd = digits10b(c: c)
  if LLVM::signed_gt(a: nd, b: 34_s64)
    var drop = LLVM::sub(a: nd, b: 34_s64)
    var div = pow10b(k: drop)
    var q = div_pow10b(x: c, k: drop)
    var r = LLVM::sub(a: c, b: LLVM::mul(a: q, b: div))
    var twice = LLVM::mul(a: r, b: two)
    if LLVM::unsigned_gt(a: twice, b: div)
      q = LLVM::add(a: q, b: one)
    elseif LLVM::int_eq[U256](a: twice, b: div) and LLVM::int_ne[U256](a: LLVM::bit_and[U256](a: q, b: one), b: 0)
      q = LLVM::add(a: q, b: one)
    c = q
    e = LLVM::add(a: e, b: drop)
    # Rounding can only carry 34 digits up to 35 (e.g. 9…9 -> 10…0), i.e. c >= 10^34.
    # One U256 compare instead of a second full digits10b clz+compare pass.
    if LLVM::unsigned_ge(a: c, b: pow10_tbl(k: 34_s64))
      c = div_pow10b(x: c, k: 1_s64)
      e = LLVM::add(a: e, b: 1_s64)
  # c is now <= 34 digits, so it fits U128. Do strip / pad / digit-count in U128
  # (mulhi via U256, ~half the U256 path's U512) instead of widening every op.
  var cu = LLVM::int_truncate[U256, U128](c)
  var ten128 = 10_u128
  # Strip trailing zeros toward `pref`, batched: binary-search the largest tz (capped at
  # both `pref-e` and 34) with cu divisible by 10^tz, then strip all tz at once. cu is
  # divisible by 10^k iff (cu // 10^k) * 10^k == cu.
  var room = LLVM::sub(a: pref, b: e)
  if LLVM::signed_gt(a: room, b: 0_s64) and LLVM::int_ne(a: cu, b: 0_u128)
    var cap = if LLVM::signed_lt(a: room, b: 34_s64) then room else 34_s64
    # Decimal trailing zeros tz <= binary trailing zeros (each factor 10 carries a
    # factor 2). cttz is one hardware instruction; capping the search at it means the
    # probe loop's div_pow10/mul never fire for candidates > t2 — odd coeffs (t2=0,
    # ~half of cases) strip with zero wide multiplies.
    var t2 = LLVM::int_truncate[U128, S64](LLVM::trailing_zeros(cu))
    if LLVM::signed_lt(a: t2, b: cap)
      cap = t2
    var tz = 0_s64
    if LLVM::signed_gt(a: cap, b: 0_s64)
      # Fast path for exact-round results (a/a = 1.0…0, terminating quotients): if 10^cap
      # divides cu outright, tz = cap in ONE wide check instead of log2(cap) probes. This
      # is the common case for division, the strip's dominant cost.
      var ctop = div_pow10_u128(x: cu, k: cap)
      if LLVM::int_eq(a: cu, b: LLVM::mul(a: ctop, b: LLVM::int_truncate[U256, U128](pow10_tbl(k: cap))))
        tz = cap
      else
        var hi = LLVM::sub(a: cap, b: 1_s64)
        var probe = 32_s64
        while LLVM::signed_ge(a: probe, b: 1_s64)
          var cand = LLVM::add(a: tz, b: probe)
          if LLVM::signed_le(a: cand, b: hi)
            var c10 = div_pow10_u128(x: cu, k: cand)
            if LLVM::int_eq(a: cu, b: LLVM::mul(a: c10, b: LLVM::int_truncate[U256, U128](pow10_tbl(k: cand))))
              tz = cand
          probe = LLVM::signed_div(a: probe, b: 2_s64)
    if LLVM::signed_gt(a: tz, b: 0_s64)
      cu = div_pow10_u128(x: cu, k: tz)
      e = LLVM::add(a: e, b: tz)
  # Pad toward `pref` while cu stays under 34 digits. "digits < 34" is exactly
  # "cu < 10^33" — one U128 compare per step instead of a digits10_u128 clz pass.
  var ten33 = LLVM::int_truncate[U256, U128](pow10_tbl(k: 33_s64))
  while LLVM::signed_gt(a: e, b: pref) and LLVM::unsigned_lt(a: cu, b: ten33)
    cu = LLVM::mul(a: cu, b: ten128)
    e = LLVM::sub(a: e, b: 1_s64)
  # IEEE decimal128 range clamp. The integer-significand exponent q must lie in
  # [qmin, qmax] = [Emin-(p-1), Emax-(p-1)] = [-6176, 6111] (p=34, Emax=6144, Emin=-6143).
  # Above qmax: pad the coefficient with zeros to pull q down (the canonical max-q cohort);
  # if it won't fit in 34 digits the magnitude exceeds Nmax -> overflow to infinity.
  if LLVM::signed_gt(a: e, b: 6111_s64)
    var spread = LLVM::sub(a: e, b: 6111_s64)
    var fits = false
    if LLVM::signed_le(a: spread, b: 33_s64)
      var lim = LLVM::int_truncate[U256, U128](pow10_tbl(k: LLVM::sub(a: 34_s64, b: spread)))
      if LLVM::unsigned_lt(a: cu, b: lim)
        fits = true
    if not fits
      return D128Parts(sign: sign, special: 1_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U128](0_u64))
    cu = LLVM::int_truncate[U256, U128](LLVM::mul(a: LLVM::zero_extend[U128, U256](cu), b: pow10b(k: spread)))
    e = 6111_s64
  # Below qmin: round the coefficient right (round-half-even) to land q at qmin. The
  # coefficient shrinks below 10^33 (gradual underflow / subnormal); if it rounds to 0
  # the result is a signed zero.
  if LLVM::signed_lt(a: e, b: -6176_s64)
    var drop = LLVM::sub(a: -6176_s64, b: e)
    if LLVM::signed_ge(a: drop, b: 35_s64)
      cu = 0_u128
    else
      var divp = pow10b(k: drop)
      var cw = LLVM::zero_extend[U128, U256](cu)
      var q = div_pow10b(x: cw, k: drop)
      var r = LLVM::sub(a: cw, b: LLVM::mul(a: q, b: divp))
      var twice = LLVM::mul(a: r, b: two)
      if LLVM::unsigned_gt(a: twice, b: divp)
        q = LLVM::add(a: q, b: one)
      elseif LLVM::int_eq[U256](a: twice, b: divp) and LLVM::int_ne[U256](a: LLVM::bit_and[U256](a: q, b: one), b: 0)
        q = LLVM::add(a: q, b: one)
      cu = LLVM::int_truncate[U256, U128](q)
    e = -6176_s64
  return D128Parts(sign: sign, special: 0_u64, exp: e, coeff: cu)

# ============================================================================
# Special-value (inf / NaN) handling for arithmetic
# ============================================================================

### Decoded parts for a quiet NaN / a signed infinity / a finite zero. Width-neutral
### (coeff fits U128) so decimal32/64/128 all share the special-arithmetic rules below.
routine nan_parts() -> D128Parts
  return D128Parts(sign: false, special: 2_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U128](0_u64))

### Decoded parts for a signed infinity (special=1, zero coefficient).
routine inf_parts(sign: Bool) -> D128Parts
  return D128Parts(sign: sign, special: 1_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U128](0_u64))

### Decoded parts for a signed finite zero (special=0, zero coefficient).
routine zero_parts(sign: Bool) -> D128Parts
  return D128Parts(sign: sign, special: 0_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U128](0_u64))

### True if either operand is NaN (special >= 2).
routine has_nan(pa: D128Parts, pb: D128Parts) -> Bool
  return LLVM::unsigned_ge(a: pa.special, b: 2_u64) or LLVM::unsigned_ge(a: pb.special, b: 2_u64)

### add/sub special rule: NaN propagates; inf + inf(same sign) = inf; inf + -inf = NaN.
routine add_special_parts(pa: D128Parts, pb: D128Parts) -> D128Parts
  if has_nan(pa: pa, pb: pb)
    return nan_parts()
  if LLVM::int_eq(a: pa.special, b: 1_u64) and LLVM::int_eq(a: pb.special, b: 1_u64)
    if pa.sign == pb.sign
      return inf_parts(sign: pa.sign)
    return nan_parts()
  if LLVM::int_eq(a: pa.special, b: 1_u64)
    return inf_parts(sign: pa.sign)
  return inf_parts(sign: pb.sign)

### mul special rule: NaN propagates; inf * 0 = NaN; else inf (sign = xor).
routine mul_special_parts(pa: D128Parts, pb: D128Parts) -> D128Parts
  if has_nan(pa: pa, pb: pb)
    return nan_parts()
  var azero = LLVM::int_eq[U64](a: pa.special, b: 0_u64) and LLVM::int_eq[U128](a: pa.coeff, b: 0)
  var bzero = LLVM::int_eq[U64](a: pb.special, b: 0_u64) and LLVM::int_eq[U128](a: pb.coeff, b: 0)
  if azero or bzero
    return nan_parts()
  return inf_parts(sign: pa.sign != pb.sign)

### div special rule: NaN propagates; inf/inf = NaN; inf/finite = inf; finite/inf = 0.
routine div_special_parts(pa: D128Parts, pb: D128Parts) -> D128Parts
  if has_nan(pa: pa, pb: pb)
    return nan_parts()
  var sign = pa.sign != pb.sign
  if LLVM::int_eq(a: pa.special, b: 1_u64)
    if LLVM::int_eq(a: pb.special, b: 1_u64)
      return nan_parts()
    return inf_parts(sign: sign)
  return zero_parts(sign: sign)

# ============================================================================
# Multiply
# ============================================================================

### Decimal multiply: coeff product, exponents add, preferred exponent = Ea+Eb.
routine d128_mul(a: D128, b: D128) -> D128
  var pa = a.decode()
  var pb = b.decode()
  if LLVM::int_ne(a: pa.special, b: 0_u64) or LLVM::int_ne(a: pb.special, b: 0_u64)
    return d128_of_parts(p: mul_special_parts(pa: pa, pb: pb))
  var sign = pa.sign != pb.sign
  var prod = LLVM::mul(a: cwb(c: pa.coeff), b: cwb(c: pb.coeff))
  var p = decfinB(sign: sign, coeff: prod, exp: LLVM::add(a: pa.exp, b: pb.exp), pref: LLVM::add(a: pa.exp, b: pb.exp))
  return d128_of_parts(p: p)

# ============================================================================
# Add / subtract (alignment guard tightened 80 -> 40 to fit U256)
# ============================================================================

### Decimal add following decNumber: align to the smaller exponent (capped at 40
### guard digits, beyond which the lesser operand folds to a sticky unit), combine
### by sign, preferred exponent = min(Ea, Eb).
routine d128_add(a: D128, b: D128) -> D128
  var pa = a.decode()
  var pb = b.decode()
  if LLVM::int_ne(a: pa.special, b: 0_u64) or LLVM::int_ne(a: pb.special, b: 0_u64)
    return d128_of_parts(p: add_special_parts(pa: pa, pb: pb))
  var eh = pa.exp
  var ch = cwb(c: pa.coeff)
  var sh = pa.sign
  var el = pb.exp
  var cl = cwb(c: pb.coeff)
  var sl = pb.sign
  if LLVM::signed_lt(a: pa.exp, b: pb.exp)
    eh = pb.exp
    ch = cwb(c: pb.coeff)
    sh = pb.sign
    el = pa.exp
    cl = cwb(c: pa.coeff)
    sl = pa.sign
  var pref = el
  var shift = LLVM::sub(a: eh, b: el)
  var ew = el
  if LLVM::signed_le(a: shift, b: 40_s64)
    ch = LLVM::mul(a: ch, b: pow10b(k: shift))
  else
    ch = LLVM::mul(a: ch, b: pow10b(k: 40_s64))
    ew = LLVM::sub(a: eh, b: 40_s64)
    # keep the low operand's in-window digits (down to ew); sticky only below.
    var drop = LLVM::sub(a: shift, b: 40_s64)
    if LLVM::signed_ge(a: drop, b: 34_s64)
      cl = if LLVM::int_ne[U256](a: cl, b: 0) then LLVM::zero_extend[U64, U256](1_u64) else LLVM::zero_extend[U64, U256](0_u64)
    else
      var qcl = div_pow10b(x: cl, k: drop)
      var remcl = LLVM::sub(a: cl, b: LLVM::mul(a: qcl, b: pow10b(k: drop)))
      cl = if LLVM::int_ne[U256](a: remcl, b: 0) then LLVM::bit_or[U256](a: qcl, b: LLVM::zero_extend[U64, U256](1_u64)) else qcl
  var rc = LLVM::zero_extend[U64, U256](0_u64)
  var rsign = sh
  if sh == sl
    rc = LLVM::add(a: ch, b: cl)
  elseif LLVM::unsigned_ge(a: ch, b: cl)
    rc = LLVM::sub(a: ch, b: cl)
  else
    rc = LLVM::sub(a: cl, b: ch)
    rsign = sl
  if LLVM::int_eq[U256](a: rc, b: 0)
    # IEEE 754: a zero SUM keeps the common sign when both operands share it
    # ((-0)+(-0) = -0); exact cancellation of opposite signs gives +0 (roundTiesToEven).
    rsign = if sh == sl then sh else false
  return d128_of_parts(p: decfinB(sign: rsign, coeff: rc, exp: ew, pref: pref))

### Decimal subtract: a - b = a + (-b).
routine d128_sub(a: D128, b: D128) -> D128
  return d128_add(a: a, b: d128_neg(a: b))

### Arithmetic negation (flip the sign bit).
routine d128_neg(a: D128) -> D128
  return D128.from_bits(bits: LLVM::bit_xor[U128](a: a.to_bits(), b: LLVM::shift_left[U128](value: 1, bits: U128.to_width(s: 127_s64))))

# ============================================================================
# Divide (scale numerator to ~38 quotient digits, divide, sticky, round)
# ============================================================================

### Decimal divide following decNumber: scale the numerator until the quotient
### carries ~38 digits (single hoisted pow10 multiply, not a per-iteration digit
### count), divide, fold a nonzero remainder into a sticky low bit, then round to
### 34 digits. Preferred exponent = Ea - Eb.
routine d128_div(a: D128, b: D128) -> D128
  var pa = a.decode()
  var pb = b.decode()
  if LLVM::int_ne(a: pa.special, b: 0_u64) or LLVM::int_ne(a: pb.special, b: 0_u64)
    return d128_of_parts(p: div_special_parts(pa: pa, pb: pb))
  var sign = pa.sign != pb.sign
  var azero = LLVM::int_eq[U128](a: pa.coeff, b: 0)
  var bzero = LLVM::int_eq[U128](a: pb.coeff, b: 0)
  # x/0 = inf (x != 0); 0/0 = NaN.
  if bzero
    if azero
      return D128.quiet_nan()
    return D128.infinity(sign: sign)
  var pref = LLVM::sub(a: pa.exp, b: pb.exp)
  if azero
    return d128_of_parts(p: decfinB(sign: sign, coeff: LLVM::zero_extend[U64, U256](0_u64), exp: pref, pref: pref))
  var num = cwb(c: pa.coeff)
  var den = cwb(c: pb.coeff)
  # +35: quotient lands at 35-36 digits = 34 result + 1 round digit; the sticky bit
  # (set below from a nonzero remainder) carries everything beneath, so 1 guard digit
  # suffices for correct round-half-even. Smaller num => narrower divide + less to strip
  # in decfin than the old +38 (which computed ~3 needless extra quotient digits).
  var target = LLVM::add(a: digits10b(c: den), b: 36_s64)
  var shift = LLVM::sub(a: target, b: digits10b(c: num))
  if LLVM::signed_lt(a: shift, b: 0_s64)
    shift = 0_s64
  num = LLVM::mul(a: num, b: pow10b(k: shift))
  # register-resident U256/U128 divide (unrolled Knuth, no Array memory traffic),
  # returns quotient + remainder-sticky in one pass.
  var q = udiv256_by_u128_sticky(num: num, den: den)
  var exp = LLVM::sub(a: LLVM::sub(a: pa.exp, b: pb.exp), b: shift)
  return d128_of_parts(p: decfinB(sign: sign, coeff: q, exp: exp, pref: pref))

# ============================================================================
# Wired operators
# ============================================================================

# Checked arithmetic crashes with a specific cause on a non-finite result (mirrors F64/Decimal):
# ±inf -> NumericOverflowError, NaN -> NumericDomainError, x/0 -> DivisionByZeroError. `@crash_only`
# keeps the callers non-failable. Use the `*_unchecked` operators for raw IEEE 754 propagation.

### Returns `me + you`. Checked: crashes if the result is non-finite. Use `add_unchecked` for raw
### IEEE.
routine D128.add!(you: D128) -> D128
  var r = d128_add(a: me, b: you)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `me - you`. Checked: crashes if the result is non-finite. Use `sub_unchecked` for raw
### IEEE.
routine D128.sub!(you: D128) -> D128
  var r = d128_sub(a: me, b: you)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `me * you`. Checked: crashes if the result is non-finite. Use `mul_unchecked` for raw
### IEEE.
routine D128.mul!(you: D128) -> D128
  var r = d128_mul(a: me, b: you)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `me / you`. Checked: `x/0` -> DivisionByZeroError, `0/0` -> domain, overflow ->
### overflow.
### Use `truediv_unchecked` for raw IEEE 754 (`x/0` -> ±inf, `0/0` -> NaN).
routine D128.truediv!(you: D128) -> D128
  var r = d128_div(a: me, b: you)
  if r.is_finite()
    return r
  if you.is_zero() and not me.is_zero()
    throw DivisionByZeroError()
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `me + you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine D128.add_unchecked(you: D128) -> D128
  return d128_add(a: me, b: you)

### Returns `me - you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine D128.sub_unchecked(you: D128) -> D128
  return d128_sub(a: me, b: you)

### Returns `me * you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine D128.mul_unchecked(you: D128) -> D128
  return d128_mul(a: me, b: you)

### Returns `me / you` with raw IEEE 754 propagation (`x/0` -> ±infinity, `0/0` -> NaN). No crash.
routine D128.truediv_unchecked(you: D128) -> D128
  return d128_div(a: me, b: you)

### Decimal value equality. NaN is never equal to anything (including itself);
### infinities are equal only with the same sign; finite values compare by value
### (so different cohorts of the same number — e.g. 1.0 and 1.00 — are equal).
routine D128.eq(you: D128) -> Bool
  if me.is_nan() or you.is_nan()
    return false
  if me.is_infinite() or you.is_infinite()
    var pa = me.decode()
    var pb = you.decode()
    return LLVM::int_eq(a: pa.special, b: pb.special) and pa.sign == pb.sign
  return LLVM::int_eq[U128](a: d128_sub(a: me, b: you).decode().coeff, b: 0)

### Three-way decimal comparison under IEEE ordered semantics. NaN is unordered and
### maps to `SAME` (matching the F128 engine convention). Compares finite values by the
### sign of `me - you`; handles infinities explicitly.
routine D128.cmp(you: D128) -> ComparisonSign
  if me.is_nan() or you.is_nan()
    return SAME
  if me.is_infinite() or you.is_infinite()
    var pa = me.decode()
    var pb = you.decode()
    if LLVM::int_eq(a: pa.special, b: pb.special) and pa.sign == pb.sign
      return SAME
    if LLVM::int_eq(a: pa.special, b: 1_u64)
      return if pa.sign then ME_SMALL else ME_LARGE
    return if pb.sign then ME_LARGE else ME_SMALL
  var d = d128_sub(a: me, b: you).decode()
  if LLVM::int_eq[U128](a: d.coeff, b: 0)
    return SAME
  return if d.sign then ME_SMALL else ME_LARGE

### Returns `me` raised to the `you` power. Delegates to the transcendental `pow`;
### follows IEEE semantics (overflow/domain errors yield inf/NaN, never throw), so the
### wired `pow!` is crashable and satisfies `Exponentiable`.
routine D128.pow!(you: D128) -> D128
  var r = me.pow_unchecked(you: you)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

# ============================================================================
# Decimal formatting (decNumber decToString rules) — operates on the binary
# coefficient directly, so no DPD round-trip is needed.
# ============================================================================

### A run of `n` ASCII zeros.
routine dec_zeros(n: S64) -> Text
  var s = ""
  var i = 0_s64
  while LLVM::signed_lt(a: i, b: n)
    s = s + "0"
    i = LLVM::add(a: i, b: 1_s64)
  return s

### The coefficient digits for decimal powers `hi` down to `lo` (inclusive), MSD first.
routine dec_digit_range(c: U128, hi: S64, lo: S64) -> Text
  var s = ""
  var i = hi
  while LLVM::signed_ge(a: i, b: lo)
    var p = LLVM::int_truncate[U256, U128](pow10_tbl(k: i))
    var d = LLVM::int_truncate[U128, U64](LLVM::unsigned_rem(a: LLVM::unsigned_div(a: c, b: p), b: LLVM::zero_extend[U64, U128](10_u64)))
    s = s + f"{d}"
    i = LLVM::sub(a: i, b: 1_s64)
  return s

### Decimal text of decoded parts (decNumber decToString: plain when exp<=0 and the
### adjusted exponent >= -6, else scientific with an explicit-sign exponent).
routine d128_represent(p: D128Parts) -> Text
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return if p.sign then "-inf" else "inf"
  if LLVM::int_eq(a: p.special, b: 3_u64)
    return "sNaN"
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return "NaN"
  var nd = digits10_u128(c: p.coeff)
  var adj = LLVM::add(a: p.exp, b: LLVM::sub(a: nd, b: 1_s64))
  var body = ""
  if LLVM::signed_le(a: p.exp, b: 0_s64) and LLVM::signed_ge(a: adj, b: -6_s64)
    var point = LLVM::add(a: nd, b: p.exp)
    if LLVM::int_eq(a: LLVM::reinterpret_bits[S64, U64](p.exp), b: 0_u64)
      body = dec_digit_range(c: p.coeff, hi: LLVM::sub(a: nd, b: 1_s64), lo: 0_s64)
    elseif LLVM::signed_le(a: point, b: 0_s64)
      body = "0." + dec_zeros(n: LLVM::sub(a: 0_s64, b: point)) + dec_digit_range(c: p.coeff, hi: LLVM::sub(a: nd, b: 1_s64), lo: 0_s64)
    else
      body = dec_digit_range(c: p.coeff, hi: LLVM::sub(a: nd, b: 1_s64), lo: LLVM::sub(a: nd, b: point)) + "." + dec_digit_range(c: p.coeff, hi: LLVM::sub(a: LLVM::sub(a: nd, b: point), b: 1_s64), lo: 0_s64)
  else
    var mant = dec_digit_range(c: p.coeff, hi: LLVM::sub(a: nd, b: 1_s64), lo: LLVM::sub(a: nd, b: 1_s64))
    if LLVM::signed_gt(a: nd, b: 1_s64)
      mant = mant + "." + dec_digit_range(c: p.coeff, hi: LLVM::sub(a: nd, b: 2_s64), lo: 0_s64)
    var mag = if LLVM::signed_lt(a: adj, b: 0_s64) then LLVM::sub(a: 0_s64, b: adj) else adj
    var es = if LLVM::signed_lt(a: adj, b: 0_s64) then "-" else "+"
    body = mant + "E" + es + f"{mag}"
  return if p.sign then "-" + body else body

### Returns the decimal text of this value.
@override
routine D128.represent() -> Text
  return d128_represent(p: me.decode())

### Returns a diagnostic representation tagged with the type name.
@override
routine D128.diagnose() -> Text
  return "D128(" + me.represent() + ")"

