# The construction/conversion web, presets, byte/hash views, and the decimal-text
# parser. The storage layout, arithmetic, comparison, libm, and formatting are the
# software BID engine above (the `@llvm("i128") record D128 obeys Numeric, Ordered`).
# Pure RF, no FFI.
# ============================================================================

# ============================================================================
# Constants
# ============================================================================

preset D128_ZERO: D128 = 0.0_d128
preset D128_ONE: D128 = 1.0_d128
# IEEE 754 decimal128: 34 significant digits, emax = 6144.
preset D128_MAX: D128 = 9.999999999999999999999999999999999e6144_d128
preset D128_MIN: D128 = -9.999999999999999999999999999999999e6144_d128
preset D128_MIN_POSITIVE: D128 = 1e-6143_d128
preset D128_EPSILON: D128 = 1e-33_d128

# ============================================================================
# Creators — integers (exact, then engine rounds to <= 34 digits)
# ============================================================================

### Converts a signed integer into decimal128.
routine D128(from: S8) -> D128
  return D128.from_int64(value: S64(from))

### Converts a signed 16-bit integer into decimal128.
routine D128(from: S16) -> D128
  return D128.from_int64(value: S64(from))

### Converts a signed 32-bit integer into decimal128.
routine D128(from: S32) -> D128
  return D128.from_int64(value: S64(from))

### Converts a signed 64-bit integer into decimal128.
routine D128(from: S64) -> D128
  return D128.from_int64(value: from)

### Converts a signed 128-bit integer into decimal128 (exact: <= 34 digits fit the coefficient).
routine D128(from: S128) -> D128
  var neg = LLVM::signed_lt(a: from, b: 0_s128)
  var mag = if neg then LLVM::reinterpret_bits[S128, U128](LLVM::sub(a: 0_s128, b: from)) else LLVM::reinterpret_bits[S128, U128](from)
  return D128.from_components(sign: neg, coeff: mag, exp: 0_s64)

### Converts a signed 256-bit integer into decimal128 (rounds half-even when > 34 digits).
routine D128(from: S256) -> D128
  # The 256-bit magnitude can exceed 34 digits, so round it (half-even) via decfinB
  # rather than D128.from_components (which assumes a <=34-digit U128 coefficient).
  var neg = LLVM::signed_lt(a: from, b: 0_s256)
  var mag = if neg then LLVM::reinterpret_bits[S256, U256](LLVM::sub(a: 0_s256, b: from)) else LLVM::reinterpret_bits[S256, U256](from)
  return d128_of_parts(p: decfinB(sign: neg, coeff: mag, exp: 0_s64, pref: 0_s64))

### Converts an unsigned integer into decimal128.
routine D128(from: U8) -> D128
  return D128.from_components(sign: false, coeff: U128(from), exp: 0_s64)

### Converts an unsigned 16-bit integer into decimal128.
routine D128(from: U16) -> D128
  return D128.from_components(sign: false, coeff: U128(from), exp: 0_s64)

### Converts an unsigned 32-bit integer into decimal128.
routine D128(from: U32) -> D128
  return D128.from_components(sign: false, coeff: U128(from), exp: 0_s64)

### Converts an unsigned 64-bit integer into decimal128.
routine D128(from: U64) -> D128
  return D128.from_components(sign: false, coeff: U128(from), exp: 0_s64)

### Converts an unsigned 128-bit integer into decimal128 (exact: <= 34 digits fit the coefficient).
routine D128(from: U128) -> D128
  return D128.from_components(sign: false, coeff: from, exp: 0_s64)

### Converts an unsigned 256-bit integer into decimal128 (rounds half-even when > 34 digits).
routine D128(from: U256) -> D128
  # >34-digit magnitude rounds (half-even) via decfinB, same as the S256 path.
  return d128_of_parts(p: decfinB(sign: false, coeff: from, exp: 0_s64, pref: 0_s64))

# ============================================================================
# Creators — binary floats (route through the matched-width engine F256)
# ============================================================================

### Converts a binary float to decimal128 (correctly rounded via F256 -> D128).
routine D128(from: F16) -> D128
  return D128(from: from.F32())

### Converts an F32 to decimal128 (widen to F64 -> F128 -> F256, correctly rounded).
routine D128(from: F32) -> D128
  return D128(from: from.F64())

### Converts an F64 to decimal128 (widen to F128 -> F256, correctly rounded).
routine D128(from: F64) -> D128
  return f256_to_d128(x: F256(from: F128(from: from)))

### Converts an F128 to decimal128 (widen to F256, correctly rounded).
routine D128(from: F128) -> D128
  return f256_to_d128(x: F256(from: from))

# ============================================================================
# Creators — decimal <-> decimal (widen narrow parts to D128Parts)
# ============================================================================

### Widens a decimal32 to decimal128 (exact; no rounding needed).
routine D128(from: D32) -> D128
  return d128_of_parts(p: d32parts_to_d128(p: from.decode()))

### Widens a decimal64 to decimal128 (exact; no rounding needed).
routine D128(from: D64) -> D128
  return d128_of_parts(p: d64parts_to_d128(p: from.decode()))

### Identity conversion (decimal128 -> decimal128).
routine D128(from: D128) -> D128
  return from

# ============================================================================
# Text parsing — pure-RF decimal scanner feeding the engine from_components
# (which rounds RNE to 34 digits and clamps the exponent). No FFI.
# ============================================================================

### Parses a decimal literal into a `D128` (the shared scanner for all decimal widths;
### D64/D32 narrow the result). Accepts an optional sign, an integer/fraction mantissa, an
### optional `e`/`E` exponent, and the special values `inf`/`infinity`/`nan` (case-insensitive).
### :throws: {InvalidValueError} if the text is not a valid decimal literal.
### Scans decimal text into raw parts (sign, special, coeff, exp10) WITHOUT rounding to
### 34 digits — the shared front end for both `D128` and `F128`/`F64` parsing. Keeping the
### full coefficient (up to 38 digits in the U128) lets the binary parsers round once,
### correctly, instead of double-rounding through decimal128.
### :throws: {InvalidValueError} on malformed input.
routine scan_decimal_parts!(from_text: Text) -> D128Parts
  var len = from_text.count()
  if len == 0u64
    throw InvalidValueError(input: from_text, target: "decimal number")
  var i = 0u64
  var neg = false
  var first = from_text[0u64]
  if first == Character(0x002Bu32) or first == Character(0x002Du32)
    neg = first == Character(0x002Du32)
    i = 1u64
    if i >= len
      throw InvalidValueError(input: from_text, target: "decimal number")
  # special values
  var rest = len - i
  if rest == 3u64 or rest == 8u64
    var c0 = from_text[i].to_lowercase()
    var c1 = from_text[i + 1u64].to_lowercase()
    var c2 = from_text[i + 2u64].to_lowercase()
    if rest == 3u64 and c0 == Character(0x006Eu32) and c1 == Character(0x0061u32) and c2 == Character(0x006Eu32)
      return D128Parts(sign: neg, special: 2_u64, exp: 0_s64, coeff: 0_u128)
    if c0 == Character(0x0069u32) and c1 == Character(0x006Eu32) and c2 == Character(0x0066u32)
      if rest == 3u64
        return D128Parts(sign: neg, special: 1_u64, exp: 0_s64, coeff: 0_u128)
      var c3 = from_text[i + 3u64].to_lowercase()
      var c4 = from_text[i + 4u64].to_lowercase()
      var c5 = from_text[i + 5u64].to_lowercase()
      var c6 = from_text[i + 6u64].to_lowercase()
      var c7 = from_text[i + 7u64].to_lowercase()
      if c3 == Character(0x0069u32) and c4 == Character(0x006Eu32) and c5 == Character(0x0069u32) and c6 == Character(0x0074u32) and c7 == Character(0x0079u32)
        return D128Parts(sign: neg, special: 1_u64, exp: 0_s64, coeff: 0_u128)
    # NOT a special value: a 3- or 8-char numeric like "0.5" / "100" / "12345678" must fall
    # through to the numeric scan below — do NOT throw here (that was a latent bug).
  # numeric: accumulate coefficient and base-10 exponent
  var coeff = 0_u128
  var exp10 = 0_s64
  var seen_dot = false
  var has_digit = false
  while i < len
    var ch = from_text[i]
    if ch.is_numeric()
      coeff = LLVM::add(a: LLVM::mul(a: coeff, b: 10_u128), b: LLVM::zero_extend[U32, U128](LLVM::reinterpret_bits[S32, U32](ch.digit_value())))
      if seen_dot
        exp10 = LLVM::sub(a: exp10, b: 1_s64)
      has_digit = true
    elseif ch == Character(0x002Eu32)
      if seen_dot
        throw InvalidValueError(input: from_text, target: "decimal number")
      seen_dot = true
    elseif ch == Character(0x0065u32) or ch == Character(0x0045u32)
      if not has_digit
        throw InvalidValueError(input: from_text, target: "decimal number")
      i = i + 1u64
      var esign = false
      if i < len and (from_text[i] == Character(0x002Bu32) or from_text[i] == Character(0x002Du32))
        esign = from_text[i] == Character(0x002Du32)
        i = i + 1u64
      var eval = 0_s64
      var has_edigit = false
      while i < len
        var ec = from_text[i]
        if not ec.is_numeric()
          throw InvalidValueError(input: from_text, target: "decimal number")
        eval = LLVM::add(a: LLVM::mul(a: eval, b: 10_s64), b: S64(ec.digit_value()))
        has_edigit = true
        i = i + 1u64
      if not has_edigit
        throw InvalidValueError(input: from_text, target: "decimal number")
      exp10 = LLVM::add(a: exp10, b: if esign then LLVM::sub(a: 0_s64, b: eval) else eval)
      break
    else
      throw InvalidValueError(input: from_text, target: "decimal number")
    i = i + 1u64
  if not has_digit
    throw InvalidValueError(input: from_text, target: "decimal number")
  return D128Parts(sign: neg, special: 0_u64, exp: exp10, coeff: coeff)

### Parses decimal text into a `D128` (rounds the scanned coefficient to 34 digits).
### :throws: {InvalidValueError} on malformed input.
routine parse_decimal_d128!(from_text: Text) -> D128
  var p = scan_decimal_parts(from_text: from_text)
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return D128.infinity(sign: p.sign)
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return D128.quiet_nan()
  return D128.from_components(sign: p.sign, coeff: p.coeff, exp: p.exp)

### Parses a decimal literal into a `D128`.
### :throws: {InvalidValueError} if the text is not a valid decimal literal.
routine D128!(from_text: Text) -> D128
  return parse_decimal_d128(from_text: from_text)

# ============================================================================
# Hashing
# ============================================================================

# ============================================================================
# Byte Representation
# ============================================================================

### Returns the raw bytes of this value in little-endian order.
routine D128.to_bytes_le() -> Array[Byte, 16]
  var raw = me.to_bits()
  var result = Array[Byte, 16]()
  var i = 0_u64
  while LLVM::unsigned_lt(a: i, b: 16_u64)
    var b = LLVM::int_truncate[U128, U8](LLVM::shift_right_unsigned(raw, LLVM::zero_extend[U64, U128](LLVM::mul(a: i, b: 8_u64))))
    result = LLVM::set_byte_at(array: result, index: i, value: b)
    i = LLVM::add(a: i, b: 1_u64)
  return result

### Returns the raw bytes of this value in big-endian order.
routine D128.to_bytes_be() -> Array[Byte, 16]
  var raw = me.to_bits()
  var result = Array[Byte, 16]()
  var i = 0_u64
  while LLVM::unsigned_lt(a: i, b: 16_u64)
    var b = LLVM::int_truncate[U128, U8](LLVM::shift_right_unsigned(raw, LLVM::zero_extend[U64, U128](LLVM::mul(a: LLVM::sub(a: 15_u64, b: i), b: 8_u64))))
    result = LLVM::set_byte_at(array: result, index: i, value: b)
    i = LLVM::add(a: i, b: 1_u64)
  return result
