### 10^k as a U256 by table lookup (k in 0..76).
routine pow10_tbl(k: S64) -> U256
  var i0 = LLVM::reinterpret_bits[S64, U64](LLVM::mul(a: k, b: 4_s64))
  var i1 = LLVM::add(a: i0, b: 1_u64)
  var i2 = LLVM::add(a: i0, b: 2_u64)
  var i3 = LLVM::add(a: i0, b: 3_u64)
  var g0 = POW10_VAL[i0]
  var g1 = POW10_VAL[i1]
  var g2 = POW10_VAL[i2]
  var g3 = POW10_VAL[i3]
  return LLVM::bit_or(a: LLVM::bit_or(a: LLVM::zero_extend[U64, U256](g0), b: LLVM::shift_left(value: LLVM::zero_extend[U64, U256](g1), bits: U256.to_width(s: 64_s64))), b: LLVM::bit_or(a: LLVM::shift_left(value: LLVM::zero_extend[U64, U256](g2), bits: U256.to_width(s: 128_s64)), b: LLVM::shift_left(value: LLVM::zero_extend[U64, U256](g3), bits: U256.to_width(s: 192_s64))))

