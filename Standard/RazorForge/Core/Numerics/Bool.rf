module Core

### The boolean type, representing a single `true` or `false` value.
###
### `Bool` is the result type of all comparison and logical operations in
### RazorForge. It maps to LLVM `i1` and occupies a single bit in registers,
### though it is stored as a byte in memory.
@llvm("i1")
record Bool obeys Equatable, ConstCompatible, Assignable, Copyable, Splittable
  pass

### Returns `true` when both values are equal.
### :param you: The value to compare against.
### :returns: `true` if `me == you`; `false` otherwise.
routine Bool.eq(you: Bool) -> Bool
  return LLVM::int_eq(me, you)

# ============================================================================
# Type Conversions
# ============================================================================

### Converts this boolean to an `S32` integer.
### :returns: `1` if `me` is `true`; `0` if `me` is `false`.
routine S32(from: Bool) -> S32
  if from
    return 1_s32
  return 0_s32

### Converts this boolean to a `U8` byte.
### :returns: `1u8` if `me` is `true`; `0u8` if `me` is `false`.
routine U8(from: Bool) -> U8
  if from
    return U8(1)
  return U8(0)

# ============================================================================
# Diagnostics and Hashing
# ============================================================================

### Returns a type-tagged debug rendering of this value.
### :returns: A diagnostic `Text` rendering, e.g. `Type(value)`.
@override
routine Bool.diagnose() -> Text
  if me
    return "Bool(true)"
  return "Bool(false)"

### Returns the human-readable text of this value.
### :returns: The value rendered as `Text`.
@override
routine Bool.represent() -> Text
  if me
    return "true"
  return "false"

# ============================================================================
# Hashing
# ============================================================================

### Returns a SipHash-2-4 keyed hash of this value.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash suitable for denial-of-service-resistant hash tables.
routine Bool.hash(k0: U64, k1: U64) -> U64
  return __secure_hash_u64(v: LLVM::zero_extend[Bool, U64](me), k0: k0, k1: k1)

