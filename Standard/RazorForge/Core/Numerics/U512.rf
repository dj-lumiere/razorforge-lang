module Core

import Collections

# ============================================================================
# U512 — raw 512-bit unsigned integer, a wide intermediate for the software float
# / decimal kernels (e.g. decimal256 products and division numerators). Pure
# integer; division uses the base-2⁶⁴ Knuth-D kernel, not inline `udiv i512`.
# ============================================================================

@llvm("i512")
secret record U512 obeys FloorDivisible, Assignable, Copyable
  pass

### Assemble 8 U64 limbs (little-endian) into a U512.
@inline
routine asm512(q0: U64, q1: U64, q2: U64, q3: U64, q4: U64, q5: U64, q6: U64, q7: U64) -> U512
  var r = LLVM::zero_extend[U64, U512](q0)
  r = LLVM::bit_or(a: r, b: LLVM::shift_left(value: LLVM::zero_extend[U64, U512](q1), bits: U512.to_width(s: 64_s64)))
  r = LLVM::bit_or(a: r, b: LLVM::shift_left(value: LLVM::zero_extend[U64, U512](q2), bits: U512.to_width(s: 128_s64)))
  r = LLVM::bit_or(a: r, b: LLVM::shift_left(value: LLVM::zero_extend[U64, U512](q3), bits: U512.to_width(s: 192_s64)))
  r = LLVM::bit_or(a: r, b: LLVM::shift_left(value: LLVM::zero_extend[U64, U512](q4), bits: U512.to_width(s: 256_s64)))
  r = LLVM::bit_or(a: r, b: LLVM::shift_left(value: LLVM::zero_extend[U64, U512](q5), bits: U512.to_width(s: 320_s64)))
  r = LLVM::bit_or(a: r, b: LLVM::shift_left(value: LLVM::zero_extend[U64, U512](q6), bits: U512.to_width(s: 384_s64)))
  r = LLVM::bit_or(a: r, b: LLVM::shift_left(value: LLVM::zero_extend[U64, U512](q7), bits: U512.to_width(s: 448_s64)))
  return r

### nth U64 limb of a U512.
@inline
routine limb512(x: U512, i: S64) -> U64
  return LLVM::int_truncate[U512, U64](LLVM::shift_right_unsigned(x, U512.to_width(s: LLVM::mul(a: i, b: 64_s64))))

### Quotient of num // den (den fits U256) with the round-sticky in bit 0. The n=1 case
### (single-limb divisor — e.g. dividing by 2/5/10) is register-resident 8-limb long
### division; larger divisors fall back to the generic Knuth kernel.
routine udiv512_by_u256_sticky(num: U512, den: U512) -> U512
  if LLVM::int_eq(a: LLVM::shift_right_unsigned(den, U512.to_width(s: 64_s64)), b: LLVM::zero_extend[U64, U512](0_u64))
    var d0 = LLVM::int_truncate[U512, U64](den)
    # single-limb divisor: normalized long division via multiply-only div2by1 (no hardware divide).
    var s1 = LLVM::reinterpret_bits[U64, S64](LLVM::leading_zeros(d0))
    var s1u = LLVM::reinterpret_bits[S64, U64](s1)
    var s1i = LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: 64_s64, b: s1))
    var p1 = LLVM::signed_gt(a: s1, b: 0_s64)
    var dn1 = LLVM::shift_left(value: d0, bits: s1u)
    var vr1 = reciprocal_word(dn1)
    var l0 = limb512(x: num, i: 0_s64)
    var l1 = limb512(x: num, i: 1_s64)
    var l2 = limb512(x: num, i: 2_s64)
    var l3 = limb512(x: num, i: 3_s64)
    var l4 = limb512(x: num, i: 4_s64)
    var l5 = limb512(x: num, i: 5_s64)
    var l6 = limb512(x: num, i: 6_s64)
    var l7 = limb512(x: num, i: 7_s64)
    var na7 = LLVM::bit_or(a: LLVM::shift_left(value: l7, bits: s1u), b: if p1 then LLVM::shift_right_unsigned(l6, s1i) else 0_u64)
    var na6 = LLVM::bit_or(a: LLVM::shift_left(value: l6, bits: s1u), b: if p1 then LLVM::shift_right_unsigned(l5, s1i) else 0_u64)
    var na5 = LLVM::bit_or(a: LLVM::shift_left(value: l5, bits: s1u), b: if p1 then LLVM::shift_right_unsigned(l4, s1i) else 0_u64)
    var na4 = LLVM::bit_or(a: LLVM::shift_left(value: l4, bits: s1u), b: if p1 then LLVM::shift_right_unsigned(l3, s1i) else 0_u64)
    var na3 = LLVM::bit_or(a: LLVM::shift_left(value: l3, bits: s1u), b: if p1 then LLVM::shift_right_unsigned(l2, s1i) else 0_u64)
    var na2 = LLVM::bit_or(a: LLVM::shift_left(value: l2, bits: s1u), b: if p1 then LLVM::shift_right_unsigned(l1, s1i) else 0_u64)
    var na1 = LLVM::bit_or(a: LLVM::shift_left(value: l1, bits: s1u), b: if p1 then LLVM::shift_right_unsigned(l0, s1i) else 0_u64)
    var na0 = LLVM::shift_left(value: l0, bits: s1u)
    var r0 = if p1 then LLVM::shift_right_unsigned(l7, s1i) else 0_u64
    var dr7 = div2by1(u1: r0, u0: na7, d: dn1, v: vr1)
    var dr6 = div2by1(u1: dr7.r, u0: na6, d: dn1, v: vr1)
    var dr5 = div2by1(u1: dr6.r, u0: na5, d: dn1, v: vr1)
    var dr4 = div2by1(u1: dr5.r, u0: na4, d: dn1, v: vr1)
    var dr3 = div2by1(u1: dr4.r, u0: na3, d: dn1, v: vr1)
    var dr2 = div2by1(u1: dr3.r, u0: na2, d: dn1, v: vr1)
    var dr1 = div2by1(u1: dr2.r, u0: na1, d: dn1, v: vr1)
    var dr0 = div2by1(u1: dr1.r, u0: na0, d: dn1, v: vr1)
    var q = asm512(q0: dr0.q, q1: dr1.q, q2: dr2.q, q3: dr3.q, q4: dr4.q, q5: dr5.q, q6: dr6.q, q7: dr7.q)
    if LLVM::int_ne(a: dr0.r, b: 0_u64)
      q = LLVM::bit_or(a: q, b: LLVM::zero_extend[U64, U512](1_u64))
    return q
  return udiv512_sticky(num: num, den: den)

### Returns me // you via the generic base-2⁶⁴ Knuth-D kernel (`knuth_divide[8]`,
### hardware `DIV r64` per step) instead of the slow inline-expanded `udiv i512`.
routine U512.floordiv(you: U512) -> U512
  var av = me
  var bv = you
  var rem = Array[U64, 8]()
  danger
    var q = knuth_divide[8](
      a: LLVM::reinterpret_bits[Hijacked[U512], Hijacked[Array[U64, 8]]](av.hijack()),
      b: LLVM::reinterpret_bits[Hijacked[U512], Hijacked[Array[U64, 8]]](bv.hijack()),
      rem: rem.hijack())
    return LLVM::reinterpret_bits[Hijacked[Array[U64, 8]], Hijacked[U512]](q.hijack()).peek()

### Quotient of `num // den` with the round-sticky baked into bit 0 (set iff the
### division left a nonzero remainder). One Knuth-D call — no separate %/mul-back.
routine udiv512_sticky(num: U512, den: U512) -> U512
  var av = num
  var bv = den
  var rem = Array[U64, 8]()
  danger
    var qa = knuth_divide[8](
      a: LLVM::reinterpret_bits[Hijacked[U512], Hijacked[Array[U64, 8]]](av.hijack()),
      b: LLVM::reinterpret_bits[Hijacked[U512], Hijacked[Array[U64, 8]]](bv.hijack()),
      rem: rem.hijack())
    var q = LLVM::reinterpret_bits[Hijacked[Array[U64, 8]], Hijacked[U512]](qa.hijack()).peek()
    var r = LLVM::reinterpret_bits[Hijacked[Array[U64, 8]], Hijacked[U512]](rem.hijack()).peek()
    if LLVM::int_ne[U512](a: r, b: 0)
      return LLVM::bit_or(a: q, b: LLVM::zero_extend[U64, U512](1_u64))
    return q

### Returns me % you (remainder from the same Knuth-D kernel).
routine U512.mod(you: U512) -> U512
  var av = me
  var bv = you
  var rem = Array[U64, 8]()
  danger
    var q = knuth_divide[8](
      a: LLVM::reinterpret_bits[Hijacked[U512], Hijacked[Array[U64, 8]]](av.hijack()),
      b: LLVM::reinterpret_bits[Hijacked[U512], Hijacked[Array[U64, 8]]](bv.hijack()),
      rem: rem.hijack())
    return LLVM::reinterpret_bits[Hijacked[Array[U64, 8]], Hijacked[U512]](rem.hijack()).peek()

### Diagnostic name (raw wide intermediate; not decimal-formatted).
@override
routine U512.represent() -> Text
  return wide_dec[U512](me)

### Diagnostic representation tagged with the type name.
@override
routine U512.diagnose() -> Text
  return "U512"
