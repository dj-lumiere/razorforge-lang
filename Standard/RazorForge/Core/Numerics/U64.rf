module Core

### A 64-bit unsigned integer in the range 0 to 18,446,744,073,709,551,615.
### `U64` is the default word-sized counter and index type in RazorForge.
@llvm("i64")
record U64 obeys UnsignedIntegral, Ordered, ConstCompatible, AtomicType, Assignable, Copyable, Splittable
  pass

# Constants for U64 limits
preset U64_MIN: U64 = 0u64
preset U64_MAX: U64 = 18_446_744_073_709_551_615_u64
preset U64_ZERO: U64 = 0u64
preset U64_ONE: U64 = 1_u64

# ============================================================================
# Creators
# ============================================================================

### Converts a signed 8-bit integer to `U64`.
### :param from: The source value.
### :returns: The `U64` representation of `from`.
### :throws: {IntegerOverflowError} if `from` is negative.
routine U64!(from: S8) -> U64
  if from < 0_s8
    throw IntegerOverflowError()
  return LLVM::sign_extend[S8, U64](from)

### Converts a signed 16-bit integer to `U64`.
### :param from: The source value.
### :returns: The `U64` representation of `from`.
### :throws: {IntegerOverflowError} if `from` is negative.
routine U64!(from: S16) -> U64
  if from < 0_s16
    throw IntegerOverflowError()
  return LLVM::sign_extend[S16, U64](from)

### Converts a signed 32-bit integer to `U64`.
### :param from: The source value.
### :returns: The `U64` representation of `from`.
### :throws: {IntegerOverflowError} if `from` is negative.
routine U64!(from: S32) -> U64
  if from < 0_s32
    throw IntegerOverflowError()
  return LLVM::sign_extend[S32, U64](from)

### Converts a signed 64-bit integer to `U64`.
### :param from: The source value.
### :returns: The `U64` representation of `from`.
### :throws: {IntegerOverflowError} if `from` is negative.
routine U64!(from: S64) -> U64
  if from < 0_s64
    throw IntegerOverflowError()
  return LLVM::reinterpret_bits[S64, U64](from)

### Converts a signed 128-bit integer to `U64`.
### :param from: The source value.
### :returns: The `U64` representation of `from`.
### :throws: {IntegerOverflowError} if `from` is outside the `U64` range.
routine U64!(from: S128) -> U64
  if not (0_s128 <= from <= 18446744073709551615_s128)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S128, U64](from)

### Zero-extends an unsigned 8-bit integer to `U64`.
### :param from: The source value.
### :returns: The `U64` representation of `from`.
routine U64(from: U8) -> U64
  return LLVM::zero_extend[U8, U64](from)

### Zero-extends an unsigned 16-bit integer to `U64`.
### :param from: The source value.
### :returns: The `U64` representation of `from`.
routine U64(from: U16) -> U64
  return LLVM::zero_extend[U16, U64](from)

### Zero-extends an unsigned 32-bit integer to `U64`.
### :param from: The source value.
### :returns: The `U64` representation of `from`.
routine U64(from: U32) -> U64
  return LLVM::zero_extend[U32, U64](from)

### Returns `from` unchanged (identity conversion).
### :param from: The source value.
### :returns: `from`.
routine U64(from: U64) -> U64
  return from

### Truncates an unsigned 128-bit integer to `U64`.
### :param from: The source value.
### :returns: The lower 64 bits of `from`.
### :throws: {IntegerOverflowError} if `from` exceeds `U64_MAX`.
routine U64!(from: U128) -> U64
  if from > 18446744073709551615_u128
    throw IntegerOverflowError()
  return LLVM::int_truncate[U128, U64](from)

### Converts an `S256` to `U64`, throwing if the value is negative or exceeds U64_MAX.
### :param from: The `S256` value to convert.
### :returns: The lower 64 bits of `from`.
### :throws: {IntegerOverflowError} if `from` is outside 0..18446744073709551615.
routine U64!(from: S256) -> U64
  if not (0_s256 <= from <= 18446744073709551615_s256)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S256, U64](from)

### Converts a `U256` to `U64`, throwing if the value exceeds U64_MAX.
### :param from: The `U256` value to convert.
### :returns: The lower 64 bits of `from`.
### :throws: {IntegerOverflowError} if `from > 18446744073709551615`.
routine U64!(from: U256) -> U64
  if from > 18446744073709551615_u256
    throw IntegerOverflowError()
  return LLVM::int_truncate[U256, U64](from)

### Truncates a 16-bit float to `U64` by first widening to `F32`.
### :param from: The source float value.
### :returns: The truncated `U64` representation.
routine U64!(from: F16) -> U64
  return from.F32().U64!()

### Truncates a 32-bit float to `U64`, rounding toward zero.
### :param from: The source float value.
### :returns: The truncated `U64` representation.
routine U64!(from: F32) -> U64
  if from.is_nan() or not (0.0_f32 <= from <= 18446744073709551615.0_f32)
    throw IntegerOverflowError()
  return LLVM::float_to_unsigned[F32, U64](from)

### Truncates a 64-bit float to `U64`, rounding toward zero.
### :param from: The source float value.
### :returns: The truncated `U64` representation.
routine U64!(from: F64) -> U64
  if from.is_nan() or not (0.0_f64 <= from <= 18446744073709551615.0_f64)
    throw IntegerOverflowError()
  return LLVM::float_to_unsigned[F64, U64](from)

### Truncates a 128-bit float to `U64` by narrowing to `F64` first.
### :param from: The source float value.
### :returns: The truncated `U64` representation.
routine U64!(from: F128) -> U64
  return from.F64!().U64!()

### Converts a 32-bit decimal float to `U64` via `S64`.
### :param from: The source decimal float value.
### :returns: The truncated `U64` representation.
routine U64!(from: D32) -> U64
  return from.S64!().U64!()

### Converts a 64-bit decimal float to `U64` via `S64`.
### :param from: The source decimal float value.
### :returns: The truncated `U64` representation.
routine U64!(from: D64) -> U64
  return from.S64!().U64!()

### Converts a 128-bit decimal float to `U64` via `S64`.
### :param from: The source decimal float value.
### :returns: The truncated `U64` representation.
routine U64!(from: D128) -> U64
  return from.S64!().U64!()

# ============================================================================
# Arithmetic Operations (trapping on overflow by default)
# ============================================================================

### Returns the sum of this value and `you`, and a flag indicating whether the result wrapped.
### :param you: The right operand.
### :returns: A tuple of `(sum, overflow_flag)`.
routine U64.add_with_overflow(you: U64) -> (U64, Bool)
  return LLVM::unsigned_add_checked[U64](me, you)

### Returns the difference `me - you`, and a flag indicating whether the result wrapped.
### :param you: The value to subtract.
### :returns: A tuple of `(difference, overflow_flag)`.
routine U64.sub_with_overflow(you: U64) -> (U64, Bool)
  return LLVM::unsigned_sub_checked[U64](me, you)

### Returns the product of this value and `you`, and a flag indicating whether the result wrapped.
### :param you: The right operand.
### :returns: A tuple of `(product, overflow_flag)`.
routine U64.mul_with_overflow(you: U64) -> (U64, Bool)
  return LLVM::unsigned_mul_checked[U64](me, you)

### Returns `me + you`, throwing on overflow.
### :param you: The right operand.
### :returns: The sum.
### :throws: {IntegerOverflowError} if the result exceeds `U64_MAX`.
routine U64.add!(you: U64) -> U64
  var result = me.add_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me - you`, throwing on underflow.
### :param you: The value to subtract.
### :returns: The difference.
### :throws: {IntegerOverflowError} if the result would go below zero.
routine U64.sub!(you: U64) -> U64
  var result = me.sub_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me * you`, throwing on overflow.
### :param you: The right operand.
### :returns: The product.
### :throws: {IntegerOverflowError} if the result exceeds `U64_MAX`.
routine U64.mul!(you: U64) -> U64
  var result = me.mul_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me // you` (floor division), throwing if `you` is zero.
### :param you: The divisor.
### :returns: The quotient, rounding toward zero.
### :throws: {DivisionByZeroError} if `you == 0`.
routine U64.floordiv!(you: U64) -> U64
  if you == 0
    throw DivisionByZeroError()
  return LLVM::unsigned_div(a: me, b: you)

### Returns `me % you`, throwing if `you` is zero.
### :param you: The divisor.
### :returns: The remainder.
### :throws: {DivisionByZeroError} if `you == 0`.
routine U64.mod!(you: U64) -> U64
  if you == 0
    throw DivisionByZeroError()
  return LLVM::unsigned_rem(a: me, b: you)

# ============================================================================
# Wrapping Arithmetic (+%, -%, *%)
# ============================================================================

### Returns `(me + you) mod 2⁶⁴` without overflow check.
### :param you: The right operand.
### :returns: The wrapped sum.
routine U64.add_wrap(you: U64) -> U64
  return LLVM::add(a: me, b: you)

### Returns `(me - you) mod 2⁶⁴` without underflow check.
### :param you: The value to subtract.
### :returns: The wrapped difference.
routine U64.sub_wrap(you: U64) -> U64
  return LLVM::sub(a: me, b: you)

### Returns `(me * you) mod 2⁶⁴` without overflow check.
### :param you: The right operand.
### :returns: The wrapped product.
routine U64.mul_wrap(you: U64) -> U64
  return LLVM::mul(a: me, b: you)

# ============================================================================
# Unchecked Arithmetic (+!, -!, *!, //!, %!)
# ============================================================================

### Returns `me + you` with undefined behavior on overflow.
### :param you: The right operand.
### :returns: The sum.
dangerous routine U64.add_unchecked(you: U64) -> U64
  return LLVM::unsigned_add_exact[U64](a: me, b: you)

### Returns `me - you` with undefined behavior on underflow.
### :param you: The value to subtract.
### :returns: The difference.
dangerous routine U64.sub_unchecked(you: U64) -> U64
  return LLVM::unsigned_sub_exact[U64](a: me, b: you)

### Returns `me * you` with undefined behavior on overflow.
### :param you: The right operand.
### :returns: The product.
dangerous routine U64.mul_unchecked(you: U64) -> U64
  return LLVM::unsigned_mul_exact[U64](a: me, b: you)

### Returns `me // you` with undefined behavior if `you` is zero.
### :param you: The divisor.
### :returns: The quotient.
dangerous routine U64.floordiv_unchecked(you: U64) -> U64
  return LLVM::unsigned_div(a: me, b: you)

### Returns `me % you` with undefined behavior if `you` is zero.
### :param you: The divisor.
### :returns: The remainder.
dangerous routine U64.mod_unchecked(you: U64) -> U64
  return LLVM::unsigned_rem(a: me, b: you)

# ============================================================================
# Clamping Arithmetic (+^, -^, *^)
# ============================================================================

### Returns `me + you`, clamped to `U64_MAX` on overflow.
### :param you: The right operand.
### :returns: The sum, or `U64_MAX` if it would overflow.
routine U64.add_clamp(you: U64) -> U64
  return LLVM::unsigned_add_sat[U64](a: me, b: you)

### Returns `me - you`, clamped to `U64_MIN` on underflow.
### :param you: The value to subtract.
### :returns: The difference, or `0` if it would underflow.
routine U64.sub_clamp(you: U64) -> U64
  return LLVM::unsigned_sub_sat[U64](a: me, b: you)

### Returns `me * you`, clamped to `U64_MAX` on overflow.
### :param you: The right operand.
### :returns: The product, or `U64_MAX` if it would overflow.
routine U64.mul_clamp(you: U64) -> U64
  var wide = LLVM::mul(LLVM::zero_extend[U64, U128](me), LLVM::zero_extend[U64, U128](you))
  if LLVM::unsigned_gt(wide, 18446744073709551615_u128)
    return U64_MAX
  return LLVM::int_truncate[U128, U64](wide)

# ============================================================================
# Power Operations (**)
# ============================================================================

### Returns `me ** exp` and an overflow flag.
### Uses repeated squaring. `0 ** 0 == 1` (the empty product).
### :param exp: The exponent.
### :returns: A tuple of `(result, overflow_flag)`.
routine U64.pow_with_overflow(exp: U64) -> (U64, Bool)
  var result: U64 = 1
  var base: U64 = me
  var e: U32 = U32(exp)
  var overflow = false
  while e > 0
    if (e & 1) == 1
      var mul_result = result.mul_with_overflow(base)
      result = mul_result.item0
      overflow = overflow or mul_result.item1
    e = e >> 1_u32
    if e > 0
      var square_result = base.mul_with_overflow(base)
      base = square_result.item0
      overflow = overflow or square_result.item1
  return (result, overflow)

### Returns `me ** exp`, throwing on overflow.
### :param exp: The exponent.
### :returns: The result.
### :throws: {IntegerOverflowError} if the result exceeds `U64_MAX`.
routine U64.pow!(exp: U64) -> U64
  var result = me.pow_with_overflow(exp)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me ** exp` with wrapping arithmetic.
### :param exp: The exponent.
### :returns: The result modulo 2⁶⁴.
routine U64.pow_wrap(exp: U64) -> U64
  var result: U64 = 1
  var base: U64 = me
  var e: U32 = U32(exp)
  while e > 0
    if (e & 1) == 1
      result = result.mul_wrap(base)
    e = e >> 1_u32
    if e > 0
      base = base.mul_wrap(base)
  return result

### Returns `me ** exp` clamped to `U64_MAX` on overflow.
### :param exp: The exponent.
### :returns: The clamped result.
routine U64.pow_clamp(exp: U64) -> U64
  var result: U64 = 1
  var base: U64 = me
  var e: U32 = U32(exp)
  while e > 0
    if (e & 1) == 1
      result = result.mul_clamp(base)
    base = base.mul_clamp(base)
    e = e >> 1_u32
  return result

# ============================================================================
# Bitwise Operations
# ============================================================================

### Returns `me & you` (bitwise AND).
### :param you: The right operand.
### :returns: The bitwise intersection.
routine U64.bitand(you: U64) -> U64
  return LLVM::bit_and(a: me, b: you)

### Returns `me | you` (bitwise OR).
### :param you: The right operand.
### :returns: The bitwise union.
routine U64.bitor(you: U64) -> U64
  return LLVM::bit_or(a: me, b: you)

### Returns `me ^ you` (bitwise XOR).
### :param you: The right operand.
### :returns: The bitwise exclusive-or.
routine U64.bitxor(you: U64) -> U64
  return LLVM::bit_xor(a: me, b: you)

### Returns `~me` (bitwise NOT).
### :returns: The bitwise complement.
routine U64.bitnot() -> U64
  return LLVM::bit_xor(a: me, b: U64_MAX)

# ============================================================================
# Shift Operations (<<, <<?>, >>, <<<, >>>)
# For unsigned types, arithmetic and logical shifts behave identically
# ============================================================================

### Returns `me << bits` (arithmetic left shift).
### :param bits: The number of bit positions to shift.
### :returns: The shifted value.
routine U64.ashl(bits: U32) -> U64
  return LLVM::shift_left(me, U64(bits))

### Returns `me >> bits` (arithmetic right shift, zero-filling for unsigned).
### :param bits: The number of bit positions to shift.
### :returns: The shifted value.
routine U64.ashr(bits: U32) -> U64
  return LLVM::shift_right_unsigned(me, U64(bits))

### Returns `me << bits` (logical left shift).
### :param bits: The number of bit positions to shift.
### :returns: The shifted value.
routine U64.lshl(bits: U32) -> U64
  return LLVM::shift_left(me, U64(bits))

### Returns `me >> bits` (logical right shift, zero-filling).
### :param bits: The number of bit positions to shift.
### :returns: The shifted value.
routine U64.lshr(bits: U32) -> U64
  return LLVM::shift_right_unsigned(me, U64(bits))

# ============================================================================
# Comparison Operations
# ============================================================================

### Returns true if both values are equal.
### :param you: The value to compare against.
### :returns: `true` if `me == you`.
routine U64.eq(you: U64) -> Bool
  return LLVM::int_eq(a: me, b: you)

### Returns the ordering relationship between this value and `you`.
### :param you: The value to compare against.
### :returns: `ME_SMALL` if `me < you`, `ME_LARGE` if `me > you`, `SAME` if equal.
routine U64.cmp(you: U64) -> ComparisonSign
  if LLVM::unsigned_lt(me, you)
    return ME_SMALL
  if LLVM::unsigned_gt(me, you)
    return ME_LARGE
  return SAME

# ============================================================================
# Math Operations
# ============================================================================

### Returns the smaller of this value and `you`.
### :param you: The value to compare.
### :returns: `me` if `me <= you`; otherwise `you`.
routine U64.min(you: U64) -> U64
  return if me <= you then me else you

### Returns the larger of this value and `you`.
### :param you: The value to compare.
### :returns: `me` if `me >= you`; otherwise `you`.
routine U64.max(you: U64) -> U64
  return if me >= you then me else you

### Returns this value clamped to the inclusive range `[min_val, max_val]`.
### :param min_val: The lower bound of the allowed range.
### :param max_val: The upper bound of the allowed range.
### :returns: `min_val` if `me < min_val`; `max_val` if `me > max_val`; `me` otherwise.
@positional
routine U64.clamp(min_val: U64, max_val: U64) -> U64
  return me.min(max_val).max(min_val)

# ============================================================================
# Bit Manipulation
# ============================================================================

### Returns the number of bits set to one (popcount).
### :returns: The count of set bits in the 64-bit representation.
routine U64.count_ones() -> U64
  return LLVM::count_ones[U64](me)

### Returns the number of bits set to zero.
### :returns: `64` minus the popcount.
routine U64.count_zeros() -> U64
  return 64_u64 -% me.count_ones()

### Returns the number of consecutive zero bits before the highest set bit.
### :returns: The leading zero count; `64` if the value is zero.
routine U64.leading_zeros() -> U64
  return LLVM::leading_zeros(me)

### Returns the number of consecutive zero bits starting from the least significant bit.
### :returns: The trailing zero count; `64` if the value is zero.
routine U64.trailing_zeros() -> U64
  return LLVM::trailing_zeros(me)

### Returns the number of consecutive one bits before the highest clear bit.
### :returns: The leading one count.
routine U64.leading_ones() -> U64
  return me.bitnot().leading_zeros()

### Returns the number of consecutive one bits starting from the least significant bit.
### :returns: The trailing one count.
routine U64.trailing_ones() -> U64
  return me.bitnot().trailing_zeros()

### Returns this value with the bit order reversed.
### :returns: The bit-reversed value.
routine U64.reverse_bits() -> U64
  return LLVM::reverse_bits[U64](me)

### Returns this value with the byte order reversed (big/little endian swap).
### :returns: The byte-swapped value.
routine U64.swap_bytes() -> U64
  return LLVM::byte_swap(me)

### Returns true if this value is an exact power of two.
### :returns: `true` if `me != 0 and (me & (me - 1)) == 0`.
routine U64.is_power_of_two() -> Bool
  return me != 0u64 and (me & (me -% 1_u64)) == 0u64

### Returns this value rotated left by `bits` positions.
### :param bits: The number of bit positions to rotate.
### :returns: The rotated value.
routine U64.rotate_left(bits: U32) -> U64
  var n = bits % 64_u32
  if n == 0_u32
    return me
  var left = LLVM::shift_left(me, U64(n))
  var right = LLVM::shift_right_unsigned(me, U64(64_u32 -% n))
  return LLVM::bit_or(a: left, b: right)

### Returns this value rotated right by `bits` positions.
### :param bits: The number of bit positions to rotate.
### :returns: The rotated value.
routine U64.rotate_right(bits: U32) -> U64
  var n = bits % 64_u32
  if n == 0_u32
    return me
  var right = LLVM::shift_right_unsigned(me, U64(n))
  var left = LLVM::shift_left(me, U64(64_u32 -% n))
  return LLVM::bit_or(a: right, b: left)

### Returns the raw byte representation of this value in little-endian order.
routine U64.to_bytes_le() -> Array[Byte, 8]
  var result = Array[Byte, 8]()
  var i = 0_u64
  while i < 8_u64
    var b = LLVM::int_truncate[U64, U8](LLVM::shift_right_unsigned(me, i * 8_u64))
    result = LLVM::set_byte_at(array: result, index: i, value: b)
    i = i + 1_u64
  return result

### Returns the raw byte representation of this value in big-endian order.
routine U64.to_bytes_be() -> Array[Byte, 8]
  return me.swap_bytes().to_bytes_le()

### Builds a `U64` from its little-endian raw byte representation.
common routine U64.from_bytes_le(bytes: Array[Byte, 8]) -> U64
  var result = 0_u64
  var i = 0_u64
  while i < 8_u64
    var part = LLVM::shift_left(LLVM::zero_extend[U8, U64](LLVM::byte_at(array: bytes, index: i)), i * 8_u64)
    result = LLVM::bit_or(a: result, b: part)
    i = i + 1_u64
  return result

### Builds a `U64` from its big-endian raw byte representation.
common routine U64.from_bytes_be(bytes: Array[Byte, 8]) -> U64
  return U64.from_bytes_le(bytes: bytes).swap_bytes()

# ============================================================================
# Utility Methods
# ============================================================================

### Returns true if this value is zero.
### :returns: `true` when `me == 0`.
routine U64.is_zero() -> Bool
  return me == 0u64

### Returns true if this value is even.
### :returns: `true` when the least significant bit is clear.
routine U64.is_even() -> Bool
  var result = LLVM::bit_and(a: me, b: 1_u64)
  return LLVM::int_eq(a: result, b: 0u64)

### Returns true if this value is odd.
### :returns: `true` when the least significant bit is set.
routine U64.is_odd() -> Bool
  return not me.is_even()

# ============================================================================
# Text Representation and Parsing
# ============================================================================

### Returns the human-readable text of this value.
### :returns: The value rendered as `Text`.
@override
routine U64.represent() -> Text
  if me == 0u64
    return "0"
  var digits = List[Character]()
  var remaining = me
  while remaining > 0u64
    var digit = U8(LLVM::unsigned_rem(a: remaining, b: 10u64))
    remaining = LLVM::unsigned_div(a: remaining, b: 10u64)
    digits.add_first(Character(0x0030u32 + U32(digit)))
  return Text(from_list: steal digits)

### Returns a type-tagged debug rendering of this value.
### :returns: A diagnostic `Text` rendering, e.g. `Type(value)`.
@override
routine U64.diagnose() -> Text
  return "U64(" + me.represent() + ")"

### Parses a decimal text representation of a `U64`.
### :param from_text: A non-empty string of ASCII decimal digits.
### :returns: The parsed `U64` value.
### :throws: {InvalidValueError} if the text is empty or contains non-digit characters.
routine U64!(from_text: Text) -> U64
  if from_text.count() == 0u64
    throw InvalidValueError(input: from_text, target: "U64")
  var result = 0u64
  var i = 0u64
  while i < from_text.count()
    var ch = from_text[i]
    if ch.is_numeric()
      result = result * 10u64 + U64(ch.digit_value())
    else
      throw InvalidValueError(input: from_text, target: "U64")
    i = i + 1u64
  return result

# ============================================================================
# Hashing
# ============================================================================

### Returns a SipHash-2-4 keyed hash of this value.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: The 64-bit keyed hash.
routine U64.hash(k0: U64, k1: U64) -> U64
  return __secure_hash_u64(v: me, k0: k0, k1: k1)

