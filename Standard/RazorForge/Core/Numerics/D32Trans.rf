module Core

# ============================================================================
# D32Trans — decimal32 (Pmax=7) transcendentals + libm surface via F64 (double,
# ~15.9 decimal digits >> 7). A D32 value widened to F64, run through the
# platform libm double routine, and rounded back to 7 digits is correctly
# rounded (double error lands near digit ~16, far below 7).
#
# The dec<->bin conversions are HAND-ROLLED on our tabled-BID parts (binary-coefficient
# encoding). Transcendentals use F64 methods where present and external("C") libm bindings
# (incl. erf/tgamma) otherwise.
# ============================================================================

# Transcendentals delegate to F64's libm methods (Standard F64.rf, bound to the
# rf_f64_* runtime passthroughs). The dec<->f64 conversions below are hand-rolled on our BID parts.

# ============================================================================
# Hand-rolled radix conversions (our BID parts <-> F64). value = coeff * 10^exp.
# ============================================================================

### 10^e as an F64 via binary exponentiation of 10.0 (D32 exp range fits double).
routine f64_pow10(e: S64) -> F64
  var neg = LLVM::signed_lt(a: e, b: 0_s64)
  var n = if neg then LLVM::sub(a: 0_s64, b: e) else e
  var result = 1.0_f64
  var base = 10.0_f64
  while LLVM::signed_gt(a: n, b: 0_s64)
    if LLVM::int_ne(a: LLVM::bit_and(a: n, b: 1_s64), b: 0_s64)
      result = LLVM::float_mul[F64](a: result, b: base)
    base = LLVM::float_mul[F64](a: base, b: base)
    n = LLVM::shift_right_unsigned[S64](n, 1_u32)
  if neg
    return LLVM::float_div[F64](a: 1.0_f64, b: result)
  return result

### True if the F64 sign bit is set (handles -0).
routine f64_signbit(v: F64) -> Bool
  return LLVM::int_ne(a: LLVM::bit_and(a: v.to_bits(), b: 0x8000000000000000_u64), b: 0_u64)

### dec -> bin: D32 value as an F64. The idiomatic conversion `someD32.F64()`.
routine F64(from: D32) -> F64
  var p = from.decode()
  if LLVM::int_eq(a: p.special, b: 1_u64)
    var ib = if p.sign then 0xFFF0000000000000_u64 else 0x7FF0000000000000_u64
    return F64.from_bits(bits: ib)
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return F64.from_bits(bits: 0x7FF8000000000000_u64)
  # value = coeff (exact, <=7 digits) * 10^exp; widen coeff to F64 then scale, apply sign
  var cf = p.coeff.F64()
  var v = LLVM::float_mul[F64](a: cf, b: f64_pow10(e: p.exp))
  if p.sign
    return LLVM::float_neg[F64](v)
  return v

### bin -> dec: F64 value as a D32 (`someF64.D32()`), via the pure-RF D128 path. The old
### hand-rolled version used libm `log10`/`round` to find the decimal exponent; routing
### through D128 (`f256_to_d128`, which derives the exponent from the binary `ilogb` — no
### libm) keeps it FFI-free, and the 34-digit intermediate correctly rounds to D32's 7.
routine D32(from: F64) -> D32
  return D32(from: D128(from: from))

# ============================================================================
# Transcendentals — F64 methods where present, external libm otherwise.
# ============================================================================

### e^me via hardware libm (F64). Crashes on a non-finite result.
### :returns: The exponential of `me`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D32.exp!() -> D32
  var r = me.exp_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### e^me via libm double, raw IEEE: may return ±inf or NaN. Never crashes.
### :returns: The exponential of `me`, possibly non-finite.
routine D32.exp_unchecked() -> D32
  return me.F64().exp_unchecked().D32()

