module Core
# Core S8 type definition - maps to LLVM i8

### An 8-bit signed integer in the range −128 to 127.
###
### `S8` is the smallest signed integer type in RazorForge, used for compact
### signed data such as audio samples (where the range fits) and C interop.
@llvm("i8")
record S8 obeys SignedIntegral, Ordered, ConstCompatible, AtomicType, Assignable, Copyable, Splittable
  pass

# Constants for S8 limits
preset S8_MIN: S8 = -128_s8
preset S8_MAX: S8 = 127_s8
preset S8_ZERO: S8 = 0_s8
preset S8_ONE: S8 = 1_s8

# ============================================================================
# Creators
# ============================================================================

### Identity conversion — returns `from` unchanged.
### :param from: The `S8` value to return.
### :returns: `from` unchanged.
routine S8(from: S8) -> S8
  return from

### Converts an `S16` to `S8`, throwing if the value is outside −128..127.
### :param from: The `S16` value to convert.
### :returns: The lower 8 bits of `from` interpreted as signed.
### :throws: {IntegerOverflowError} if `from` is not in `-128..=127`.
routine S8!(from: S16) -> S8
  if not (-128s16 <= from <= 127s16)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S16, S8](from)

### Converts an `S32` to `S8`, throwing if the value is outside −128..127.
### :param from: The `S32` value to convert.
### :returns: The lower 8 bits of `from` interpreted as signed.
### :throws: {IntegerOverflowError} if `from` is not in `-128..=127`.
routine S8!(from: S32) -> S8
  if not (-128s32 <= from <= 127s32)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S32, S8](from)

### Converts an `S64` to `S8`, throwing if the value is outside −128..127.
### :param from: The `S64` value to convert.
### :returns: The lower 8 bits of `from` interpreted as signed.
### :throws: {IntegerOverflowError} if `from` is not in `-128..=127`.
routine S8!(from: S64) -> S8
  if not (-128s64 <= from <= 127s64)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S64, S8](from)

### Converts an `S128` to `S8`, throwing if the value is outside −128..127.
### :param from: The `S128` value to convert.
### :returns: The lower 8 bits of `from` interpreted as signed.
### :throws: {IntegerOverflowError} if `from` is not in `-128..=127`.
routine S8!(from: S128) -> S8
  if not (-128s128 <= from <= 127s128)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S128, S8](from)

### Reinterprets a `U8` as `S8` using two's complement, throwing if the value exceeds 127.
### :param from: The `U8` value to convert.
### :returns: The same bit pattern interpreted as `S8`.
### :throws: {IntegerOverflowError} if `from > 127`.
routine S8!(from: U8) -> S8
  if from > 127_u8
    throw IntegerOverflowError()
  return LLVM::reinterpret_bits[U8, S8](from)

### Converts a `U16` to `S8`, throwing if the value exceeds 127.
### :param from: The `U16` value to convert.
### :returns: The lower 8 bits interpreted as a signed `S8`.
### :throws: {IntegerOverflowError} if `from > 127`.
routine S8!(from: U16) -> S8
  if from > 127_u16
    throw IntegerOverflowError()
  return LLVM::int_truncate[U16, S8](from)

### Converts a `U32` to `S8`, throwing if the value exceeds 127.
### :param from: The `U32` value to convert.
### :returns: The lower 8 bits interpreted as a signed `S8`.
### :throws: {IntegerOverflowError} if `from > 127`.
routine S8!(from: U32) -> S8
  if from > 127_u32
    throw IntegerOverflowError()
  return LLVM::int_truncate[U32, S8](from)

### Converts a `U64` to `S8`, throwing if the value exceeds 127.
### :param from: The `U64` value to convert.
### :returns: The lower 8 bits interpreted as a signed `S8`.
### :throws: {IntegerOverflowError} if `from > 127`.
routine S8!(from: U64) -> S8
  if from > 127_u64
    throw IntegerOverflowError()
  return LLVM::int_truncate[U64, S8](from)

### Converts a `U128` to `S8`, throwing if the value exceeds 127.
### :param from: The `U128` value to convert.
### :returns: The lower 8 bits interpreted as a signed `S8`.
### :throws: {IntegerOverflowError} if `from > 127`.
routine S8!(from: U128) -> S8
  if from > 127_u128
    throw IntegerOverflowError()
  return LLVM::int_truncate[U128, S8](from)

### Converts an `S256` to `S8`, throwing if outside −128..127.
### :param from: The `S256` value to convert.
### :returns: The lower 8 bits reinterpreted as an `S8`.
### :throws: {IntegerOverflowError} if `from` is outside −128..127.
routine S8!(from: S256) -> S8
  if not (-128_s256 <= from <= 127_s256)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S256, S8](from)

### Converts a `U256` to `S8`, throwing if the value exceeds 127.
### :param from: The `U256` value to convert.
### :returns: The lower 8 bits reinterpreted as an `S8`.
### :throws: {IntegerOverflowError} if `from > 127`.
routine S8!(from: U256) -> S8
  if from > 127_u256
    throw IntegerOverflowError()
  return LLVM::int_truncate[U256, S8](from)

### Converts an `F16` to `S8` by first converting to `S32`, then truncating.
### :param from: The `F16` value to convert.
### :returns: The integer part of `from` as an `S8`.
### :throws: {IntegerOverflowError} if the integer part is outside −128..127.
routine S8!(from: F16) -> S8
  return from.S32!().S8!()

### Converts an `F32` to `S8` by first converting to `S32`, then truncating.
### :param from: The `F32` value to convert.
### :returns: The integer part of `from` as an `S8`.
### :throws: {IntegerOverflowError} if the integer part is outside −128..127.
routine S8!(from: F32) -> S8
  return from.S32!().S8!()

### Converts an `F64` to `S8` by first converting to `S32`, then truncating.
### :param from: The `F64` value to convert.
### :returns: The integer part of `from` as an `S8`.
### :throws: {IntegerOverflowError} if the integer part is outside −128..127.
routine S8!(from: F64) -> S8
  return from.S32!().S8!()

### Converts an `F128` to `S8` by first converting to `S32`, then truncating.
### :param from: The `F128` value to convert.
### :returns: The integer part of `from` as an `S8`.
### :throws: {IntegerOverflowError} if the integer part is outside −128..127.
routine S8!(from: F128) -> S8
  return from.S32!().S8!()

### Converts a `D32` to `S8` by first converting to `S32`, then truncating.
### :param from: The `D32` value to convert.
### :returns: The integer part of `from` as an `S8`.
### :throws: {IntegerOverflowError} if the integer part is outside −128..127.
routine S8!(from: D32) -> S8
  return from.S32!().S8!()

### Converts a `D64` to `S8` by first converting to `S32`, then truncating.
### :param from: The `D64` value to convert.
### :returns: The integer part of `from` as an `S8`.
### :throws: {IntegerOverflowError} if the integer part is outside −128..127.
routine S8!(from: D64) -> S8
  return from.S32!().S8!()

### Converts a `D128` to `S8` by first converting to `S32`, then truncating.
### :param from: The `D128` value to convert.
### :returns: The integer part of `from` as an `S8`.
### :throws: {IntegerOverflowError} if the integer part is outside −128..127.
routine S8!(from: D128) -> S8
  return from.S32!().S8!()

# ============================================================================
# Arithmetic Operations (trapping on overflow by default)
# ============================================================================

### Returns the sum and a flag indicating whether the result overflowed.
### :param you: The right operand.
### :returns: A tuple of `(wrapped_sum, overflowed)`.
routine S8.add_with_overflow(you: S8) -> (S8, Bool)
  return LLVM::signed_add_checked[S8](me, you)

### Returns the difference and a flag indicating whether the result overflowed.
### :param you: The value to subtract.
### :returns: A tuple of `(wrapped_difference, overflowed)`.
routine S8.sub_with_overflow(you: S8) -> (S8, Bool)
  return LLVM::signed_sub_checked[S8](me, you)

### Returns the product and a flag indicating whether the result overflowed.
### :param you: The right operand.
### :returns: A tuple of `(wrapped_product, overflowed)`.
routine S8.mul_with_overflow(you: S8) -> (S8, Bool)
  return LLVM::signed_mul_checked[S8](me, you)

### Returns `me + you`, throwing on overflow.
### :param you: The right operand.
### :returns: The sum `me + you`.
### :throws: {IntegerOverflowError} if the result is outside −128..127.
routine S8.add!(you: S8) -> S8
  var result = me.add_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me - you`, throwing on overflow.
### :param you: The value to subtract.
### :returns: The difference `me - you`.
### :throws: {IntegerOverflowError} if the result is outside −128..127.
routine S8.sub!(you: S8) -> S8
  var result = me.sub_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me * you`, throwing on overflow.
### :param you: The right operand.
### :returns: The product `me * you`.
### :throws: {IntegerOverflowError} if the result is outside −128..127.
routine S8.mul!(you: S8) -> S8
  var result = me.mul_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me // you` (euclidean division), throwing on errors.
### Euclidean division: the remainder is always in `[0, |you|)`, consistent with `mod!`.
### The special case `S8_MIN // -1` would overflow (result would be 128) and throws.
### :param you: The divisor.
### :returns: The euclidean quotient `me // you`.
### :throws: {DivisionByZeroError} if `you == 0`.
### :throws: {IntegerOverflowError} if `me == S8_MIN` and `you == -1`.
routine S8.floordiv!(you: S8) -> S8
  if you == 0
    throw DivisionByZeroError()
  if me == S8_MIN and you == -1_s8
    throw IntegerOverflowError()
  var quotient = LLVM::signed_div(a: me, b: you)
  var remainder = LLVM::signed_rem(a: me, b: you)
  if remainder < 0_s8
    if you > 0_s8
      return quotient - 1_s8
    return quotient + 1_s8
  return quotient

### Returns `me % you` (euclidean modulo): the remainder is always in `[0, |you|)`.
### :param you: The divisor.
### :returns: The euclidean remainder — always non-negative.
### :throws: {DivisionByZeroError} if `you == 0`.
routine S8.mod!(you: S8) -> S8
  if you == 0
    throw DivisionByZeroError()
  var remainder = LLVM::signed_rem(a: me, b: you)
  if remainder < 0_s8
    if you > 0_s8
      return remainder + you
    return remainder - you
  return remainder

### Returns `-me` (arithmetic negation), with wrapping behavior on `S8_MIN`.
### :returns: The negated value. `-S8_MIN` wraps to `S8_MIN` (−128).
routine S8.neg!() -> S8
  if me == -128_s8
    throw IntegerOverflowError()
  return LLVM::sub(a: 0_s8, b: me)

# ============================================================================
# Wrapping Arithmetic (+%, -%, *%)
# ============================================================================

### Returns `(me + you)` with wrapping arithmetic (mod 256, signed).
### :param you: The right operand.
### :returns: The sum, wrapping on overflow.
routine S8.add_wrap(you: S8) -> S8
  return LLVM::add(a: me, b: you)

### Returns `(me - you)` with wrapping arithmetic (mod 256, signed).
### :param you: The value to subtract.
### :returns: The difference, wrapping on underflow.
routine S8.sub_wrap(you: S8) -> S8
  return LLVM::sub(a: me, b: you)

### Returns `(me * you)` with wrapping arithmetic (mod 256, signed).
### :param you: The right operand.
### :returns: The product, wrapping on overflow.
routine S8.mul_wrap(you: S8) -> S8
  return LLVM::mul(a: me, b: you)

# ============================================================================
# Unchecked Arithmetic (+!, -!, *!, //!, %!)
# ============================================================================

### Returns `me + you` with undefined behavior on overflow.
### :param you: The right operand.
### :returns: The sum, assuming no overflow.
dangerous routine S8.add_unchecked(you: S8) -> S8
  return LLVM::signed_add_exact[S8](a: me, b: you)

### Returns `me - you` with undefined behavior on overflow.
### :param you: The value to subtract.
### :returns: The difference, assuming no overflow.
dangerous routine S8.sub_unchecked(you: S8) -> S8
  return LLVM::signed_sub_exact[S8](a: me, b: you)

### Returns `me * you` with undefined behavior on overflow.
### :param you: The right operand.
### :returns: The product, assuming no overflow.
dangerous routine S8.mul_unchecked(you: S8) -> S8
  return LLVM::signed_mul_exact[S8](a: me, b: you)

### Returns `me // you` (euclidean division) with undefined behavior if `you == 0` or overflow.
### :param you: The divisor.
### :returns: The euclidean quotient, assuming `you != 0` and no overflow.
dangerous routine S8.floordiv_unchecked(you: S8) -> S8
  var quotient = LLVM::signed_div(a: me, b: you)
  var remainder = LLVM::signed_rem(a: me, b: you)
  if remainder < 0_s8
    if you > 0_s8
      return quotient - 1_s8
    return quotient + 1_s8
  return quotient

### Returns `me % you` (euclidean modulo) with undefined behavior if `you == 0`.
### :param you: The divisor.
### :returns: The euclidean remainder, assuming `you != 0`.
dangerous routine S8.mod_unchecked(you: S8) -> S8
  var remainder = LLVM::signed_rem(a: me, b: you)
  if remainder < 0_s8
    if you > 0_s8
      return remainder + you
    return remainder - you
  return remainder

# ============================================================================
# Clamping Arithmetic (+^, -^, *^)
# ============================================================================

### Returns `me + you`, clamped to `S8_MAX` or `S8_MIN` on overflow.
### :param you: The right operand.
### :returns: The sum, or `127` / `−128` if it would overflow.
routine S8.add_clamp(you: S8) -> S8
  return LLVM::signed_add_sat[S8](a: me, b: you)

### Returns `me - you`, clamped to `S8_MAX` or `S8_MIN` on overflow.
### :param you: The value to subtract.
### :returns: The difference, or `127` / `−128` if it would overflow.
routine S8.sub_clamp(you: S8) -> S8
  return LLVM::signed_sub_sat[S8](a: me, b: you)

### Returns `me * you`, clamped to `S8_MAX` or `S8_MIN` on overflow.
### :param you: The right operand.
### :returns: The product, or `127` / `−128` if it would overflow.
routine S8.mul_clamp(you: S8) -> S8
  var wide = LLVM::mul(LLVM::sign_extend[S8, S16](me), LLVM::sign_extend[S8, S16](you))
  if LLVM::signed_gt(wide, 127_s16)
    return S8_MAX
  if LLVM::signed_lt(wide, -128_s16)
    return S8_MIN
  return LLVM::int_truncate[S16, S8](wide)

# ============================================================================
# Power Operations (**)
# ============================================================================

### Returns `me ** exp` and a flag indicating whether the result overflowed.
### :param exp: The exponent (must be non-negative).
### :returns: A tuple of `(wrapped_result, overflowed)`.
### :throws: {NumericDomainError} if `exp < 0`.
routine S8.pow_with_overflow!(exp: S8) -> (S8, Bool)
  if exp < 0
    throw NumericDomainError(description: "negative exponent: no integer result")
  var result: S8 = 1
  var base: S8 = me
  var e: U32 = U32(exp)
  var overflow = false
  while e > 0
    if (e & 1) == 1
      var mul_result = result.mul_with_overflow(base)
      result = mul_result.item0
      overflow = overflow or mul_result.item1
    e = e >> 1_u32
    if e > 0
      var square_result = base.mul_with_overflow(base)
      base = square_result.item0
      overflow = overflow or square_result.item1
  return (result, overflow)

### Returns `me ** exp`, throwing on overflow.
### :param exp: The exponent (must be non-negative).
### :returns: The result of raising `me` to the power `exp`.
### :throws: {IntegerOverflowError} if the result is outside −128..127.
### :throws: {NumericDomainError} if `exp < 0`.
routine S8.pow!(exp: S8) -> S8
  var result = me.pow_with_overflow(exp)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me ** exp` with wrapping arithmetic.
### :param exp: The exponent (must be non-negative).
### :returns: The result modulo 256 (signed wrap).
### :throws: {NumericDomainError} if `exp < 0`.
routine S8.pow_wrap!(exp: S8) -> S8
  if exp < 0_s8
    throw NumericDomainError(description: "negative exponent: no integer result")
  var result: S8 = 1
  var base: S8 = me
  var e: U32 = U32(exp)
  while e > 0
    if (e & 1) == 1
      result = result.mul_wrap(base)
    e = e >> 1_u32
    if e > 0
      base = base.mul_wrap(base)
  return result

### Returns `me ** exp`, clamped to `S8_MAX` or `S8_MIN` on overflow.
### :param exp: The exponent (must be non-negative).
### :returns: The result, or `127` / `−128` if it would overflow.
### :throws: {NumericDomainError} if `exp < 0`.
routine S8.pow_clamp!(exp: S8) -> S8
  if exp < 0
    throw NumericDomainError(description: "negative exponent: no integer result")
  var result: S8 = 1
  var base: S8 = me
  var e: U32 = U32(exp)
  while e > 0
    if (e & 1) == 1
      result = result.mul_clamp(base)
    e = e >> 1_u32
    if e > 0
      base = base.mul_clamp(base)
  return result

# ============================================================================
# Bitwise Operations
# ============================================================================

### Returns the bitwise AND of this value and `you`.
### :param you: The right operand.
### :returns: `me & you`.
routine S8.bitand(you: S8) -> S8
  return LLVM::bit_and(a: me, b: you)

### Returns the bitwise OR of this value and `you`.
### :param you: The right operand.
### :returns: `me | you`.
routine S8.bitor(you: S8) -> S8
  return LLVM::bit_or(a: me, b: you)

### Returns the bitwise XOR of this value and `you`.
### :param you: The right operand.
### :returns: `me ^ you`.
routine S8.bitxor(you: S8) -> S8
  return LLVM::bit_xor(a: me, b: you)

### Returns the bitwise complement of this value.
### :returns: `~me` — each bit flipped.
routine S8.bitnot() -> S8
  return LLVM::bit_xor[S8](a: me, b: -1)

# ============================================================================
# Shift Operations (<<, >>, <<<, >>>)
# ============================================================================

### Left-shifts this value by `bits` positions, filling vacated bits with zero.
### :param bits: The number of bit positions to shift left.
### :returns: `me << bits`.
routine S8.ashl(bits: U32) -> S8
  return LLVM::shift_left(me, S8(bits))

### Right-shifts this value by `bits` positions, sign-filling (arithmetic shift right).
### :param bits: The number of bit positions to shift right.
### :returns: `me >> bits`, copying the sign bit into vacated positions.
routine S8.ashr(bits: U32) -> S8
  return LLVM::shift_right_signed(me, S8(bits))

### Left-shifts this value by `bits` positions (same as `ashl` for signed integers).
### :param bits: The number of bit positions to shift left.
### :returns: `me << bits`.
routine S8.lshl(bits: U32) -> S8
  return LLVM::shift_left(me, S8(bits))

### Right-shifts this value by `bits` positions, zero-filling (logical shift right).
### :param bits: The number of bit positions to shift right.
### :returns: `me >>> bits`, filling vacated bits with zero regardless of sign.
routine S8.lshr(bits: U32) -> S8
  return LLVM::shift_right_unsigned(me, S8(bits))

# ============================================================================
# Comparison Operations
# ============================================================================

### Returns `true` when both values are equal.
### :param you: The value to compare against.
### :returns: `true` if `me == you`; `false` otherwise.
routine S8.eq(you: S8) -> Bool
  return LLVM::int_eq(a: me, b: you)

### Compares this value with `you`, returning the ordering relationship.
### :param you: The value to compare against.
### :returns: `ME_SMALL` if `me < you`, `ME_LARGE` if `me > you`, `SAME` if equal.
routine S8.cmp(you: S8) -> ComparisonSign
  if LLVM::signed_lt(me, you)
    return ME_SMALL
  if LLVM::signed_gt(me, you)
    return ME_LARGE
  return SAME

# ============================================================================
# Math Operations
# ============================================================================

### Returns the absolute value of this integer.
### :returns: `-me` if `me < 0`; `me` if `me >= 0`.
### :throws: {IntegerOverflowError} when `me` is `S8_MIN` (its magnitude is not representable in S8).
routine S8.abs!() -> S8
  if me == -128_s8
    throw IntegerOverflowError()
  return LLVM::int_abs[S8](me)

### Returns the smaller of this value and `you`.
### :param you: The value to compare against.
### :returns: `me` if `me <= you`; otherwise `you`.
routine S8.min(you: S8) -> S8
  return if me <= you then me else you

### Returns the larger of this value and `you`.
### :param you: The value to compare against.
### :returns: `me` if `me >= you`; otherwise `you`.
routine S8.max(you: S8) -> S8
  return if me >= you then me else you

### Returns this value clamped to the range `min_val..=max_val`.
### :param min_val: The lower bound (inclusive).
### :param max_val: The upper bound (inclusive).
### :returns: `min_val` if `me < min_val`; `max_val` if `me > max_val`; otherwise `me`.
@positional
routine S8.clamp(min_val: S8, max_val: S8) -> S8
  return me.min(max_val).max(min_val)

# ============================================================================
# Bit Manipulation
# ============================================================================

### Returns the count of set bits (popcount) in this value's 8-bit representation.
### :returns: The number of `1` bits; between 0 and 8.
routine S8.count_ones() -> S8
  return LLVM::count_ones[S8](me)

### Returns the count of clear bits in this value's 8-bit representation.
### :returns: `8` minus the popcount; between 0 and 8.
routine S8.count_zeros() -> S8
  return 8_s8 -% me.count_ones()

### Returns the number of leading zero bits, starting from the most-significant bit.
### :returns: The leading zero count; `8` if the value is zero.
routine S8.leading_zeros() -> S8
  return LLVM::leading_zeros(me)

### Returns the number of trailing zero bits, starting from the least-significant bit.
### :returns: The trailing zero count; `8` if the value is zero.
routine S8.trailing_zeros() -> S8
  return LLVM::trailing_zeros(me)

### Returns the number of leading one bits, starting from the most-significant bit.
### :returns: The leading one count; `8` if the value is `−1` (all bits set).
routine S8.leading_ones() -> S8
  return me.bitnot().leading_zeros()

### Returns the number of trailing one bits, starting from the least-significant bit.
### :returns: The trailing one count; `8` if the value is `−1` (all bits set).
routine S8.trailing_ones() -> S8
  return me.bitnot().trailing_zeros()

### Returns this value with its bits reversed (bit 7 ↔ bit 0, etc.).
### :returns: The bit-reversed `S8`.
routine S8.reverse_bits() -> S8
  return LLVM::reverse_bits[S8](me)

### Returns this value with its single byte unchanged (8-bit byte swap is identity).
### Provided for API uniformity with the wider integer types.
### :returns: `me`.
routine S8.swap_bytes() -> S8
  return me

### Returns this value rotated left by `bits` positions.
routine S8.rotate_left(bits: U32) -> S8
  return LLVM::reinterpret_bits[U8, S8](LLVM::reinterpret_bits[S8, U8](me).rotate_left(bits: bits))

### Returns this value rotated right by `bits` positions.
routine S8.rotate_right(bits: U32) -> S8
  return LLVM::reinterpret_bits[U8, S8](LLVM::reinterpret_bits[S8, U8](me).rotate_right(bits: bits))

### Returns the raw byte representation of this value in little-endian order.
routine S8.to_bytes_le() -> Array[Byte, 1]
  return LLVM::reinterpret_bits[S8, U8](me).to_bytes_le()

### Returns the raw byte representation of this value in big-endian order.
routine S8.to_bytes_be() -> Array[Byte, 1]
  return me.to_bytes_le()

### Builds an `S8` from its little-endian raw byte representation.
common routine S8.from_bytes_le(bytes: Array[Byte, 1]) -> S8
  return LLVM::reinterpret_bits[U8, S8](U8.from_bytes_le(bytes: bytes))

### Builds an `S8` from its big-endian raw byte representation.
common routine S8.from_bytes_be(bytes: Array[Byte, 1]) -> S8
  return S8.from_bytes_le(bytes: bytes)

# ============================================================================
# Utility Methods
# ============================================================================

### Returns `true` if this value is greater than zero.
### :returns: `true` if `me > 0`.
routine S8.is_positive() -> Bool
  return me > 0_s8

### Returns `true` if this value is less than zero.
### :returns: `true` if `me < 0`.
routine S8.is_negative() -> Bool
  return me < 0_s8

### Returns `true` if this value is zero.
### :returns: `true` if `me == 0`.
routine S8.is_zero() -> Bool
  return me == 0_s8

### Returns `true` if this value is divisible by 2.
### :returns: `true` if the least-significant bit is 0.
routine S8.is_even() -> Bool
  var result = LLVM::bit_and(a: me, b: 1_s8)
  return LLVM::int_eq(a: result, b: 0_s8)

### Returns `true` if this value is not divisible by 2.
### :returns: `true` if the least-significant bit is 1.
routine S8.is_odd() -> Bool
  return not me.is_even()

### Returns true if this value is an exact power of two.
### Negative values always return `false`.
### :returns: `true` if `me > 0 and (me & (me - 1)) == 0`.
routine S8.is_power_of_two() -> Bool
  return me > 0_s8 and (me & (me -% 1_s8)) == 0_s8

### Returns the sign of this value as −1, 0, or 1.
### :returns: `1` if `me > 0`, `−1` if `me < 0`, `0` if `me == 0`.
routine S8.signum() -> S8
  return when
    me > 0_s8 => 1_s8
    me < 0_s8 => -1_s8
    else => 0_s8

# ============================================================================
# Text Representation and Parsing
# ============================================================================

### Returns the human-readable text of this value.
### :returns: The value rendered as `Text`.
@override
routine S8.represent() -> Text
  if me == 0s8
    return "0"
  if me > 0s8
    return U8(me).represent()
  # Use reinterpret_bits (not U8(me)) — U8.create(S8) throws on negative inputs,
  # and we need the raw bit pattern so the two's-complement negation `0u8 -% bits`
  # yields |me| (works correctly even for S8.MIN, whose absolute value overflows S8).
  return "-" + (0u8 -% LLVM::reinterpret_bits[S8, U8](me)).represent()

### Returns a type-tagged debug rendering of this value.
### :returns: A diagnostic `Text` rendering, e.g. `Type(value)`.
@override
routine S8.diagnose() -> Text
  return "S8(" + me.represent() + ")"

### Parses a decimal string into an `S8`, accepting an optional leading `+` or `−` sign.
### :param from_text: The decimal string to parse.
### :returns: The parsed `S8` value.
### :throws: {InvalidValueError} if `from_text` is empty, sign-only, or contains non-digit characters.
routine S8!(from_text: Text) -> S8
  if from_text.count() == 0u64
    throw InvalidValueError(input: from_text, target: "S8")
  var start = 0u64
  var negative = false
  var first = from_text[0u64]
  if first == Character(0x002Du32)
    negative = true
    start = 1u64
  elseif first == Character(0x002Bu32)
    start = 1u64
  if start >= from_text.count()
    throw InvalidValueError(input: from_text, target: "S8")
  var result = 0u32
  var i = start
  while i < from_text.count()
    var ch = from_text[i]
    if ch.is_numeric()
      result = result * 10u32 + U32(ch.digit_value())
    else
      throw InvalidValueError(input: from_text, target: "S8")
    i = i + 1u64
  if negative
    if result > 128u32
      throw IntegerOverflowError()
    return LLVM::reinterpret_bits[U8, S8](LLVM::int_truncate[U32, U8](0u32 -% result))
  return S8(result)

# ============================================================================
# Hashing
# ============================================================================

### Returns a SipHash-2-4 keyed hash of this value.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash suitable for denial-of-service-resistant hash tables.
routine S8.hash(k0: U64, k1: U64) -> U64
  return __secure_hash_u64(v: LLVM::zero_extend[S8, U64](me), k0: k0, k1: k1)
