module Core

### An 8-bit unsigned integer in the range 0 to 255.
###
### `U8` is the standard byte-sized unsigned integer type in RazorForge, used
### for raw byte manipulation, character codes, and compact numeric data.
@llvm("i8")
record U8 obeys UnsignedIntegral, Ordered, ConstCompatible, AtomicType, Assignable, Copyable, Splittable
  pass

# Constants for U8 limits
preset U8_MIN: U8 = 0_u8
preset U8_MAX: U8 = 255_u8
preset U8_ZERO: U8 = 0_u8
preset U8_ONE: U8 = 1_u8

# ============================================================================
# Checked Creators (crash on overflow)
# ============================================================================

### Converts a signed 8-bit integer to `U8`, throwing if the value is negative.
### :param from: The `S8` value to convert.
### :returns: A `U8` with the same bit pattern as `from`.
### :throws: {IntegerOverflowError} if `from < 0`.
routine U8!(from: S8) -> U8
  if from < 0_s8
    throw IntegerOverflowError()
  return LLVM::reinterpret_bits[S8, U8](from)

### Converts an `S16` to `U8`, throwing if the value is outside 0..255.
### :param from: The `S16` value to convert.
### :returns: The `U8` representation of `from`.
### :throws: {IntegerOverflowError} if `from` is not in `0..=255`.
routine U8!(from: S16) -> U8
  if not (0_s16 <= from <= 255_s16)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S16, U8](from)

### Converts an `S32` to `U8`, throwing if the value is outside 0..255.
### :param from: The `S32` value to convert.
### :returns: The `U8` representation of `from`.
### :throws: {IntegerOverflowError} if `from` is not in `0..=255`.
routine U8!(from: S32) -> U8
  if not (0_s32 <= from <= 255_s32)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S32, U8](from)

### Converts an `S64` to `U8`, throwing if the value is outside 0..255.
### :param from: The `S64` value to convert.
### :returns: The `U8` representation of `from`.
### :throws: {IntegerOverflowError} if `from` is not in `0..=255`.
routine U8!(from: S64) -> U8
  if not (0_s64 <= from <= 255_s64)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S64, U8](from)

### Converts an `S128` to `U8`, throwing if the value is outside 0..255.
### :param from: The `S128` value to convert.
### :returns: The `U8` representation of `from`.
### :throws: {IntegerOverflowError} if `from` is not in `0..=255`.
routine U8!(from: S128) -> U8
  if not (0_s128 <= from <= 255_s128)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S128, U8](from)

### Identity conversion — returns `from` unchanged.
### :param from: The `U8` value to return.
### :returns: `from` unchanged.
routine U8(from: U8) -> U8
  return from

### Converts a `U16` to `U8`, throwing if the value exceeds 255.
### :param from: The `U16` value to convert.
### :returns: The lower 8 bits of `from`.
### :throws: {IntegerOverflowError} if `from > 255`.
routine U8!(from: U16) -> U8
  if from > 255_u16
    throw IntegerOverflowError()
  return LLVM::int_truncate[U16, U8](from)

### Converts a `U32` to `U8`, throwing if the value exceeds 255.
### :param from: The `U32` value to convert.
### :returns: The lower 8 bits of `from`.
### :throws: {IntegerOverflowError} if `from > 255`.
routine U8!(from: U32) -> U8
  if from > 255_u32
    throw IntegerOverflowError()
  return LLVM::int_truncate[U32, U8](from)

### Converts a `U64` to `U8`, throwing if the value exceeds 255.
### :param from: The `U64` value to convert.
### :returns: The lower 8 bits of `from`.
### :throws: {IntegerOverflowError} if `from > 255`.
routine U8!(from: U64) -> U8
  if from > 255_u64
    throw IntegerOverflowError()
  return LLVM::int_truncate[U64, U8](from)

### Converts a `U128` to `U8`, throwing if the value exceeds 255.
### :param from: The `U128` value to convert.
### :returns: The lower 8 bits of `from`.
### :throws: {IntegerOverflowError} if `from > 255`.
routine U8!(from: U128) -> U8
  if from > 255_u128
    throw IntegerOverflowError()
  return LLVM::int_truncate[U128, U8](from)

### Converts an `S256` to `U8`, throwing if the value is negative or exceeds 255.
### :param from: The `S256` value to convert.
### :returns: The lower 8 bits of `from`.
### :throws: {IntegerOverflowError} if `from` is outside 0..255.
routine U8!(from: S256) -> U8
  if not (0_s256 <= from <= 255_s256)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S256, U8](from)

### Converts a `U256` to `U8`, throwing if the value exceeds 255.
### :param from: The `U256` value to convert.
### :returns: The lower 8 bits of `from`.
### :throws: {IntegerOverflowError} if `from > 255`.
routine U8!(from: U256) -> U8
  if from > 255_u256
    throw IntegerOverflowError()
  return LLVM::int_truncate[U256, U8](from)

### Converts an `F16` to `U8` by first converting to `U32`, then truncating.
### :param from: The `F16` value to convert.
### :returns: The integer part of `from` as a `U8`.
### :throws: {IntegerOverflowError} if the integer part exceeds 255.
routine U8!(from: F16) -> U8
  return from.U32!().U8!()

### Converts an `F32` to `U8` by first converting to `U32`, then truncating.
### :param from: The `F32` value to convert.
### :returns: The integer part of `from` as a `U8`.
### :throws: {IntegerOverflowError} if the integer part exceeds 255.
routine U8!(from: F32) -> U8
  return from.U32!().U8!()

### Converts an `F64` to `U8` by first converting to `U32`, then truncating.
### :param from: The `F64` value to convert.
### :returns: The integer part of `from` as a `U8`.
### :throws: {IntegerOverflowError} if the integer part exceeds 255.
routine U8!(from: F64) -> U8
  return from.U32!().U8!()

### Converts an `F128` to `U8` by first converting to `U32`, then truncating.
### :param from: The `F128` value to convert.
### :returns: The integer part of `from` as a `U8`.
### :throws: {IntegerOverflowError} if the integer part exceeds 255.
routine U8!(from: F128) -> U8
  return from.U32!().U8!()

### Converts a `D32` to `U8` by first converting to `U32`, then truncating.
### :param from: The `D32` value to convert.
### :returns: The integer part of `from` as a `U8`.
### :throws: {IntegerOverflowError} if the integer part exceeds 255.
routine U8!(from: D32) -> U8
  return from.U32!().U8!()

### Converts a `D64` to `U8` by first converting to `U32`, then truncating.
### :param from: The `D64` value to convert.
### :returns: The integer part of `from` as a `U8`.
### :throws: {IntegerOverflowError} if the integer part exceeds 255.
routine U8!(from: D64) -> U8
  return from.U32!().U8!()

### Converts a `D128` to `U8` by first converting to `U32`, then truncating.
### :param from: The `D128` value to convert.
### :returns: The integer part of `from` as a `U8`.
### :throws: {IntegerOverflowError} if the integer part exceeds 255.
routine U8!(from: D128) -> U8
  return from.U32!().U8!()

# ============================================================================
# Arithmetic Operations (trapping on overflow by default)
# ============================================================================

### Returns the sum and a flag indicating whether the result wrapped around.
### :param you: The right operand.
### :returns: A tuple of `(wrapped_sum, overflowed)`.
routine U8.add_with_overflow(you: U8) -> (U8, Bool)
  return LLVM::unsigned_add_checked[U8](me, you)

### Returns the difference and a flag indicating whether the result wrapped around.
### :param you: The value to subtract.
### :returns: A tuple of `(wrapped_difference, overflowed)`.
routine U8.sub_with_overflow(you: U8) -> (U8, Bool)
  return LLVM::unsigned_sub_checked[U8](me, you)

### Returns the product and a flag indicating whether the result wrapped around.
### :param you: The right operand.
### :returns: A tuple of `(wrapped_product, overflowed)`.
routine U8.mul_with_overflow(you: U8) -> (U8, Bool)
  return LLVM::unsigned_mul_checked[U8](me, you)

### Returns `me + you`, throwing on overflow.
### :param you: The right operand.
### :returns: The sum `me + you`.
### :throws: {IntegerOverflowError} if the result exceeds `U8_MAX`.
routine U8.add!(you: U8) -> U8
  var result = me.add_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me - you`, throwing on underflow.
### :param you: The value to subtract.
### :returns: The difference `me - you`.
### :throws: {IntegerOverflowError} if the result is less than `U8_MIN` (0).
routine U8.sub!(you: U8) -> U8
  var result = me.sub_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me * you`, throwing on overflow.
### :param you: The right operand.
### :returns: The product `me * you`.
### :throws: {IntegerOverflowError} if the result exceeds `U8_MAX`.
routine U8.mul!(you: U8) -> U8
  var result = me.mul_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me // you` (integer division), throwing if `you` is zero.
### :param you: The divisor.
### :returns: The quotient `me // you`.
### :throws: {DivisionByZeroError} if `you == 0`.
routine U8.floordiv!(you: U8) -> U8
  if you == 0
    throw DivisionByZeroError()
  return LLVM::unsigned_div(a: me, b: you)

### Returns `me % you` (integer remainder).
### :param you: The divisor.
### :returns: The remainder `me % you`. Behavior is undefined if `you == 0`.
routine U8.mod!(you: U8) -> U8
  if you == 0_u8
    throw DivisionByZeroError()
  return LLVM::unsigned_rem(a: me, b: you)

# ============================================================================
# Wrapping Arithmetic (+%, -%, *%)
# ============================================================================

### Returns `(me + you) mod 256` without overflow check.
### :param you: The right operand.
### :returns: The sum modulo 256.
routine U8.add_wrap(you: U8) -> U8
  return LLVM::add(a: me, b: you)

### Returns `(me - you) mod 256` without underflow check.
### :param you: The value to subtract.
### :returns: The difference modulo 256.
routine U8.sub_wrap(you: U8) -> U8
  return LLVM::sub(a: me, b: you)

### Returns `(me * you) mod 256` without overflow check.
### :param you: The right operand.
### :returns: The product modulo 256.
routine U8.mul_wrap(you: U8) -> U8
  return LLVM::mul(a: me, b: you)

# ============================================================================
# Unchecked Arithmetic (+!, -!, *!, //!, %!)
# ============================================================================

### Returns `me + you` with undefined behavior on overflow.
### :param you: The right operand.
### :returns: The sum, assuming no overflow.
dangerous routine U8.add_unchecked(you: U8) -> U8
  return LLVM::unsigned_add_exact[U8](a: me, b: you)

### Returns `me - you` with undefined behavior on underflow.
### :param you: The value to subtract.
### :returns: The difference, assuming no underflow.
dangerous routine U8.sub_unchecked(you: U8) -> U8
  return LLVM::unsigned_sub_exact[U8](a: me, b: you)

### Returns `me * you` with undefined behavior on overflow.
### :param you: The right operand.
### :returns: The product, assuming no overflow.
dangerous routine U8.mul_unchecked(you: U8) -> U8
  return LLVM::unsigned_mul_exact[U8](a: me, b: you)

### Returns `me // you` with undefined behavior if `you == 0`.
### :param you: The divisor.
### :returns: The quotient, assuming `you != 0`.
dangerous routine U8.floordiv_unchecked(you: U8) -> U8
  return LLVM::unsigned_div(a: me, b: you)

### Returns `me % you` with undefined behavior if `you == 0`.
### :param you: The divisor.
### :returns: The remainder, assuming `you != 0`.
dangerous routine U8.mod_unchecked(you: U8) -> U8
  return LLVM::unsigned_rem(a: me, b: you)

# ============================================================================
# Clamping Arithmetic (+^, -^, *^)
# ============================================================================

### Returns `me + you`, clamped to `U8_MAX` on overflow.
### :param you: The right operand.
### :returns: The sum, or `255` if it would exceed `U8_MAX`.
routine U8.add_clamp(you: U8) -> U8
  return LLVM::unsigned_add_sat[U8](a: me, b: you)

### Returns `me - you`, clamped to `U8_MIN` on underflow.
### :param you: The value to subtract.
### :returns: The difference, or `0` if it would go below `U8_MIN`.
routine U8.sub_clamp(you: U8) -> U8
  return LLVM::unsigned_sub_sat[U8](a: me, b: you)

### Returns `me * you`, clamped to `U8_MAX` on overflow.
### :param you: The right operand.
### :returns: The product, or `255` if it would exceed `U8_MAX`.
routine U8.mul_clamp(you: U8) -> U8
  var wide = LLVM::mul(LLVM::zero_extend[U8, U16](me), LLVM::zero_extend[U8, U16](you))
  if LLVM::unsigned_gt(wide, 255_u16)
    return U8_MAX
  return LLVM::int_truncate[U16, U8](wide)

# ============================================================================
# Power Operations (**)
# ============================================================================

### Returns `me ** exp` and a flag indicating whether the result wrapped around.
### :param exp: The exponent.
### :returns: A tuple of `(wrapped_result, overflowed)`.
routine U8.pow_with_overflow(exp: U8) -> (U8, Bool)
  var result: U8 = 1
  var base: U8 = me
  var e: U32 = U32(exp)
  var overflow = false
  while e > 0
    if (e & 1) == 1
      var mul_result = result.mul_with_overflow(base)
      result = mul_result.item0
      overflow = overflow or mul_result.item1
    e = e >> 1_u32
    if e > 0
      var square_result = base.mul_with_overflow(base)
      base = square_result.item0
      overflow = overflow or square_result.item1
  return (result, overflow)

### Returns `me ** exp`, throwing on overflow.
### :param exp: The exponent.
### :returns: The result of raising `me` to the power `exp`.
### :throws: {IntegerOverflowError} if the result exceeds `U8_MAX`.
routine U8.pow!(exp: U8) -> U8
  var result = me.pow_with_overflow(exp)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me ** exp` with wrapping arithmetic (mod 256).
### :param exp: The exponent.
### :returns: The result modulo 256.
routine U8.pow_wrap(exp: U8) -> U8
  var result: U8 = 1
  var base: U8 = me
  var e: U32 = U32(exp)
  while e > 0
    if (e & 1) == 1
      result = result.mul_wrap(base)
    e = e >> 1_u32
    if e > 0
      base = base.mul_wrap(base)
  return result

### Returns `me ** exp`, clamped to `U8_MAX` on overflow.
### :param exp: The exponent.
### :returns: The result, or `255` if it would overflow.
routine U8.pow_clamp(exp: U8) -> U8
  var result: U8 = 1
  var base: U8 = me
  var e: U32 = U32(exp)
  while e > 0
    if (e & 1) == 1
      result = result.mul_clamp(base)
    base = base.mul_clamp(base)
    e = e >> 1_u32
  return result

# ============================================================================
# Bitwise Operations
# ============================================================================

### Returns the bitwise AND of this value and `you`.
### :param you: The right operand.
### :returns: `me & you`.
routine U8.bitand(you: U8) -> U8
  return LLVM::bit_and(a: me, b: you)

### Returns the bitwise OR of this value and `you`.
### :param you: The right operand.
### :returns: `me | you`.
routine U8.bitor(you: U8) -> U8
  return LLVM::bit_or(a: me, b: you)

### Returns the bitwise XOR of this value and `you`.
### :param you: The right operand.
### :returns: `me ^ you`.
routine U8.bitxor(you: U8) -> U8
  return LLVM::bit_xor(a: me, b: you)

### Returns the bitwise complement of this value.
### :returns: `~me` — each bit flipped.
routine U8.bitnot() -> U8
  return LLVM::bit_xor(a: me, b: U8_MAX)

# ============================================================================
# Shift Operations (<<, <<?>, >>, <<<, >>>)
# For unsigned types, arithmetic and logical shifts behave identically
# ============================================================================

### Left-shifts this value by `bits` positions, filling vacated bits with zero.
### :param bits: The number of bit positions to shift left.
### :returns: `me << bits`.
routine U8.ashl(bits: U32) -> U8
  return LLVM::shift_left(me, U8(bits))

### Right-shifts this value by `bits` positions, filling vacated bits with zero.
### :param bits: The number of bit positions to shift right.
### :returns: `me >> bits` (logical, zero-filling).
routine U8.ashr(bits: U32) -> U8
  return LLVM::shift_right_unsigned(me, U8(bits))

### Left-shifts this value by `bits` positions (logical shift, same as `ashl` for unsigned).
### :param bits: The number of bit positions to shift left.
### :returns: `me << bits`.
routine U8.lshl(bits: U32) -> U8
  return LLVM::shift_left(me, U8(bits))

### Right-shifts this value by `bits` positions (logical shift, same as `ashr` for unsigned).
### :param bits: The number of bit positions to shift right.
### :returns: `me >> bits` (zero-filling).
routine U8.lshr(bits: U32) -> U8
  return LLVM::shift_right_unsigned(me, U8(bits))

# ============================================================================
# Comparison Operations
# ============================================================================

### Returns `true` when both values are equal.
### :param you: The value to compare against.
### :returns: `true` if `me == you`; `false` otherwise.
routine U8.eq(you: U8) -> Bool
  return LLVM::int_eq(a: me, b: you)

### Compares this value with `you`, returning the ordering relationship.
### :param you: The value to compare against.
### :returns: `ME_SMALL` if `me < you`, `ME_LARGE` if `me > you`, `SAME` if equal.
routine U8.cmp(you: U8) -> ComparisonSign
  if LLVM::unsigned_lt(me, you)
    return ME_SMALL
  if LLVM::unsigned_gt(me, you)
    return ME_LARGE
  return SAME

# ============================================================================
# Math Operations
# ============================================================================

### Returns the smaller of this value and `you`.
### :param you: The value to compare against.
### :returns: `me` if `me <= you`; otherwise `you`.
routine U8.min(you: U8) -> U8
  return if me <= you then me else you

### Returns the larger of this value and `you`.
### :param you: The value to compare against.
### :returns: `me` if `me >= you`; otherwise `you`.
routine U8.max(you: U8) -> U8
  return if me >= you then me else you

### Returns this value clamped to the range `min_val..=max_val`.
### :param min_val: The lower bound (inclusive).
### :param max_val: The upper bound (inclusive).
### :returns: `min_val` if `me < min_val`; `max_val` if `me > max_val`; otherwise `me`.
@positional
routine U8.clamp(min_val: U8, max_val: U8) -> U8
  return me.min(max_val).max(min_val)

# ============================================================================
# Bit Manipulation
# ============================================================================

### Returns the count of set bits (popcount) in this value's 8-bit representation.
### :returns: The number of `1` bits; between 0 and 8.
routine U8.count_ones() -> U8
  return LLVM::count_ones[U8](me)

### Returns the count of clear bits in this value's 8-bit representation.
### :returns: `8` minus the popcount; between 0 and 8.
routine U8.count_zeros() -> U8
  return 8_u8 -% me.count_ones()

### Returns the number of leading zero bits, starting from the most-significant bit.
### :returns: The leading zero count; `8` if the value is zero.
routine U8.leading_zeros() -> U8
  return LLVM::leading_zeros(me)

### Returns the number of trailing zero bits, starting from the least-significant bit.
### :returns: The trailing zero count; `8` if the value is zero.
routine U8.trailing_zeros() -> U8
  return LLVM::trailing_zeros(me)

### Returns the number of leading one bits, starting from the most-significant bit.
### :returns: The leading one count; `8` if the value is `255`.
routine U8.leading_ones() -> U8
  return me.bitnot().leading_zeros()

### Returns the number of trailing one bits, starting from the least-significant bit.
### :returns: The trailing one count; `8` if the value is `255`.
routine U8.trailing_ones() -> U8
  return me.bitnot().trailing_zeros()

### Returns this value with its bits reversed (bit 7 ↔ bit 0, etc.).
### :returns: The bit-reversed `U8`.
routine U8.reverse_bits() -> U8
  return LLVM::reverse_bits[U8](me)

### Reverses the byte order. A single-byte value is its own byte-swap, so this returns `me`
### unchanged — provided for parity with the wider unsigned types and `S8.swap_bytes`.
### :returns: `me`.
routine U8.swap_bytes() -> U8
  return me

### Returns `true` if this value is an exact power of two.
### :returns: `true` if `me` is 1, 2, 4, 8, ..., 128; `false` otherwise (including zero).
routine U8.is_power_of_two() -> Bool
  return me != 0_u8 and (me & (me - 1_u8)) == 0_u8

### Returns this value rotated left by `bits` positions.
routine U8.rotate_left(bits: U32) -> U8
  var n = bits % 8_u32
  if n == 0_u32
    return me
  return LLVM::bit_or(a: LLVM::shift_left(me, U8(n)), b: LLVM::shift_right_unsigned(me, U8(8_u32 -% n)))

### Returns this value rotated right by `bits` positions.
routine U8.rotate_right(bits: U32) -> U8
  var n = bits % 8_u32
  if n == 0_u32
    return me
  return LLVM::bit_or(a: LLVM::shift_right_unsigned(me, U8(n)), b: LLVM::shift_left(me, U8(8_u32 -% n)))

### Returns the raw byte representation of this value in little-endian order.
routine U8.to_bytes_le() -> Array[Byte, 1]
  var result = Array[Byte, 1]()
  result = LLVM::set_byte_at(array: result, index: 0_u64, value: me)
  return result

### Returns the raw byte representation of this value in big-endian order.
routine U8.to_bytes_be() -> Array[Byte, 1]
  return me.to_bytes_le()

### Builds a `U8` from its little-endian raw byte representation.
common routine U8.from_bytes_le(bytes: Array[Byte, 1]) -> U8
  return LLVM::byte_at(array: bytes, index: 0_u64)

### Builds a `U8` from its big-endian raw byte representation.
common routine U8.from_bytes_be(bytes: Array[Byte, 1]) -> U8
  return U8.from_bytes_le(bytes: bytes)

# ============================================================================
# Type Conversions (creator syntax)
# ============================================================================

### Reinterprets the 8-bit pattern of `from` as a signed `S8` (two's complement).
### :param from: The `U8` value to reinterpret.
### :returns: The `S8` with the same bit pattern.
routine S8(from: U8) -> S8
  return LLVM::reinterpret_bits[U8, S8](from)

### Zero-extends `from` to a 16-bit `U16`.
### :param from: The `U8` value to widen.
### :returns: A `U16` equal in value to `from`.
routine U16(from: U8) -> U16
  return LLVM::zero_extend[U8, U16](from)

### Zero-extends `from` to a 32-bit `U32`.
### :param from: The `U8` value to widen.
### :returns: A `U32` equal in value to `from`.
routine U32(from: U8) -> U32
  return LLVM::zero_extend[U8, U32](from)

### Zero-extends `from` to a 64-bit `U64`.
### :param from: The `U8` value to widen.
### :returns: A `U64` equal in value to `from`.
routine U64(from: U8) -> U64
  return LLVM::zero_extend[U8, U64](from)

### Zero-extends `from` to a 128-bit `U128`.
### :param from: The `U8` value to widen.
### :returns: A `U128` equal in value to `from`.
routine U128(from: U8) -> U128
  return LLVM::zero_extend[U8, U128](from)

### Converts `from` to the nearest representable `F32`.
### :param from: The `U8` value to convert.
### :returns: An `F32` with the same numeric value as `from`.
routine F32(from: U8) -> F32
  return LLVM::unsigned_to_float[U8, F32](from)

### Converts `from` to the nearest representable `F64`.
### :param from: The `U8` value to convert.
### :returns: An `F64` with the same numeric value as `from`.
routine F64(from: U8) -> F64
  return LLVM::unsigned_to_float[U8, F64](from)

### Returns `false` if `from` is `0`; `true` for any other value.
### :param from: The `U8` value to convert.
### :returns: `true` if `from != 0`.
routine Bool(from: U8) -> Bool
  return LLVM::int_ne(a: from, b: 0_u8)

# ============================================================================
# Utility Methods
# ============================================================================

### Returns `true` if this value is zero.
### :returns: `true` if `me == 0`.
routine U8.is_zero() -> Bool
  return me == 0_u8

### Returns `true` if this value is divisible by 2.
### :returns: `true` if the least-significant bit is 0.
routine U8.is_even() -> Bool
  var result = LLVM::bit_and(a: me, b: 1_u8)
  return LLVM::int_eq(a: result, b: 0_u8)

### Returns `true` if this value is not divisible by 2.
### :returns: `true` if the least-significant bit is 1.
routine U8.is_odd() -> Bool
  return not me.is_even()

# ============================================================================
# Text Representation and Parsing
# ============================================================================

### Returns the human-readable text of this value.
### :returns: The value rendered as `Text`.
@override
routine U8.represent() -> Text
  return U32(me).represent()

### Returns a type-tagged debug rendering of this value.
### :returns: A diagnostic `Text` rendering, e.g. `Type(value)`.
@override
routine U8.diagnose() -> Text
  return "U8(" + me.represent() + ")"

### Parses a decimal string into a `U8`.
### :param from_text: The decimal string to parse (no sign, no prefix).
### :returns: The parsed `U8` value.
### :throws: {InvalidValueError} if `from_text` is empty or contains non-digit characters.
routine U8!(from_text: Text) -> U8
  if from_text.count() == 0u64
    throw InvalidValueError(input: from_text, target: "U8")
  var result = 0u32
  var i = 0u64
  while i < from_text.count()
    var ch = from_text[i]
    if ch.is_numeric()
      result = result * 10u32 + U32(ch.digit_value())
    else
      throw InvalidValueError(input: from_text, target: "U8")
    i = i + 1u64
  return U8(result)

# ============================================================================
# Hashing
# ============================================================================

### Returns a SipHash-2-4 keyed hash of this value.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash suitable for denial-of-service-resistant hash tables.
routine U8.hash(k0: U64, k1: U64) -> U64
  return __secure_hash_u64(v: LLVM::zero_extend[U8, U64](me), k0: k0, k1: k1)

