### Tangent (radians).
routine F32.tan() -> F32
  return C::rf_f32_tan(value: me)

### Arc sine.
routine F32.asin!() -> F32
  var rr = me.asin_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Arc sine with raw IEEE 754 propagation (`|me| > 1` -> NaN). Thin wrapper over `rf_f32_asin`.
routine F32.asin_unchecked() -> F32
  return C::rf_f32_asin(value: me)

### Arc cosine.
routine F32.acos!() -> F32
  var rr = me.acos_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Arc cosine with raw IEEE 754 propagation (`|me| > 1` -> NaN). Thin wrapper over `rf_f32_acos`.
routine F32.acos_unchecked() -> F32
  return C::rf_f32_acos(value: me)

### Arc tangent.
routine F32.atan() -> F32
  return C::rf_f32_atan(value: me)

### Two-argument arc tangent atan2(me, x).
routine F32.atan2(x: F32) -> F32
  return C::rf_f32_atan2(y: me, x: x)

### Hyperbolic sine.
routine F32.sinh!() -> F32
  var rr = me.sinh_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Hyperbolic sine with raw IEEE 754 propagation (overflow -> ±inf). Wraps `rf_f32_sinh`.
routine F32.sinh_unchecked() -> F32
  return C::rf_f32_sinh(value: me)

