module Core

import Collections
# Core F32 type definition - maps to LLVM float

### Represents a 32-bit IEEE 754 binary floating-point value.
### `F32` is the standard single-precision float: compact, fast, and suitable
### for graphics, simulation, and general-purpose numeric code where 24 bits of
### significand precision are acceptable.
@llvm("float")
record F32 obeys Numeric, Ordered, Assignable, Copyable, Splittable
  pass

# IEEE 754 single precision constants
preset F32_EPSILON: F32 = 1.1920929e-7_f32
preset F32_MIN: F32 = -3.4028235e+38_f32
preset F32_MAX: F32 = 3.4028235e+38_f32
preset F32_MIN_POSITIVE: F32 = 1.1754944e-38_f32
preset F32_ZERO: F32 = 0.0_f32
preset F32_ONE: F32 = 1.0_f32
preset F32_INFINITY: F32 = inf_f32
preset F32_NAN: F32 = nan_f32

# Mathematical constants
preset F32_PI: F32 = 3.1415927_f32
preset F32_E: F32 = 2.7182817_f32
preset F32_SQRT_2: F32 = 1.4142135_f32
preset F32_LN_2: F32 = 0.6931472_f32
preset F32_LN_10: F32 = 2.3025851_f32

### Converts an `S8` into single-precision floating-point form.
### :param from: The signed 8-bit integer to convert.
### :returns: The corresponding `F32` value.
@inline
routine F32(from: S8) -> F32
  return LLVM::signed_to_float[S8, F32](from)

### Converts an `S16` into single-precision floating-point form.
### :param from: The signed 16-bit integer to convert.
### :returns: The corresponding `F32` value.
@inline
routine F32(from: S16) -> F32
  return LLVM::signed_to_float[S16, F32](from)

### Converts an `S32` into single-precision floating-point form.
### :param from: The signed 32-bit integer to convert.
### :returns: The closest representable `F32` value.
@inline
routine F32(from: S32) -> F32
  return LLVM::signed_to_float[S32, F32](from)

### Converts an `S64` into single-precision floating-point form.
### Precision may be rounded when the integer cannot be represented exactly.
### :param from: The signed 64-bit integer to convert.
### :returns: The closest representable `F32` value.
@inline
routine F32(from: S64) -> F32
  return LLVM::signed_to_float[S64, F32](from)

### Converts an `S128` into single-precision floating-point form.
### :param from: The signed 128-bit integer to convert.
### :returns: The closest representable `F32` value under the target rounding rules.
@inline
routine F32(from: S128) -> F32
  return LLVM::signed_to_float[S128, F32](from)

### Converts a `U8` into single-precision floating-point form.
### :param from: The unsigned 8-bit integer to convert.
### :returns: The corresponding `F32` value.
@inline
routine F32(from: U8) -> F32
  return LLVM::unsigned_to_float[U8, F32](from)

### Converts a `U16` into single-precision floating-point form.
### :param from: The unsigned 16-bit integer to convert.
### :returns: The corresponding `F32` value.
@inline
routine F32(from: U16) -> F32
  return LLVM::unsigned_to_float[U16, F32](from)

### Converts a `U32` into single-precision floating-point form.
### :param from: The unsigned 32-bit integer to convert.
### :returns: The closest representable `F32` value.
@inline
routine F32(from: U32) -> F32
  return LLVM::unsigned_to_float[U32, F32](from)

### Converts a `U64` into single-precision floating-point form.
### :param from: The unsigned 64-bit integer to convert.
### :returns: The closest representable `F32` value.
@inline
routine F32(from: U64) -> F32
  return LLVM::unsigned_to_float[U64, F32](from)

### Converts a `U128` into single-precision floating-point form. Failable: throws when the
### value exceeds the F32 range (overflow to +inf) — handle with `F32!`/`when`/`try_`.
### :param from: The unsigned 128-bit integer to convert.
### :returns: The closest representable `F32` value (finite).
### :throws: {NumericOverflowError} if the value is out of the F32 range.
routine F32!(from: U128) -> F32
  return LLVM::unsigned_to_float[U128, F32](from).finite()

### Converts an `S256` to `F32`. Failable: throws if the value exceeds the F32 range.
### :param from: The signed 256-bit integer to convert.
### :returns: The closest representable `F32` value (finite).
### :throws: {NumericOverflowError} if the value is out of the F32 range.
routine F32!(from: S256) -> F32
  return LLVM::signed_to_float[S256, F32](from).finite()

### Converts a `U256` to `F32`. Failable: throws if the value exceeds the F32 range.
### :param from: The unsigned 256-bit integer to convert.
### :returns: The closest representable `F32` value (finite).
### :throws: {NumericOverflowError} if the value is out of the F32 range.
routine F32!(from: U256) -> F32
  return LLVM::unsigned_to_float[U256, F32](from).finite()

### Widens a half-precision float to single precision.
### :param from: The `F16` value to widen.
### :returns: An `F32` carrying the same numeric value when representable.
@inline
routine F32(from: F16) -> F32
  return LLVM::float_extend[F16, F32](from)

### Returns an existing `F32` unchanged.
### :param from: The single-precision value to forward.
### :returns: `from`.
@inline
routine F32(from: F32) -> F32
  return from

### Narrows a double-precision float to single precision.
### :param from: The `F64` value to convert.
### :returns: The nearest representable `F32` value.
@inline
routine F32(from: F64) -> F32
  return LLVM::float_narrow[F64, F32](from)

### (`F32(from: F128)` is provided by the quadruple-precision engine — `F128.rf` — which owns
### the bit-surgery narrowing; a forwarding stub here would recurse into itself.)

### Converts a decimal32 value to single-precision binary floating point.
### :param from: The decimal floating-point input value.
### :returns: The closest representable `F32` value.
routine F32(from: D32) -> F32
  return F32(from: F64(from))

### Converts a decimal64 value to single-precision binary floating point.
### :param from: The decimal floating-point input value.
### :returns: The closest representable `F32` value.
routine F32(from: D64) -> F32
  return F32(from: F64(from))

### Converts a decimal128 value to single-precision binary floating point.
### :param from: The decimal floating-point input value.
### :returns: The closest representable `F32` value.
routine F32(from: D128) -> F32
  return F32(from: F64(from))

# ============================================================================
# Arithmetic Operations (IEEE 754 semantics)
# ============================================================================

# Checked arithmetic crashes with a specific cause on a non-finite result (mirrors F64/Decimal):
# ±inf -> NumericOverflowError, NaN -> NumericDomainError, x/0 -> DivisionByZeroError. `@crash_only`
# keeps the callers non-failable. Use the `*_unchecked` operators for raw IEEE 754 propagation.

### Returns `me + you`. Checked: crashes if the IEEE result is non-finite. Use `add_unchecked` for
### raw IEEE.
### :param you: The addend.
### :returns: The single-precision sum (always finite).
routine F32.add!(you: F32) -> F32
  var r = LLVM::float_add[F32](a: me, b: you)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `me - you`. Checked: crashes if the IEEE result is non-finite. Use `sub_unchecked` for
### raw IEEE.
### :param you: The value to subtract.
### :returns: The single-precision difference (always finite).
routine F32.sub!(you: F32) -> F32
  var r = LLVM::float_sub[F32](a: me, b: you)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `me * you`. Checked: crashes if the IEEE result is non-finite. Use `mul_unchecked` for
### raw IEEE.
### :param you: The multiplier.
### :returns: The single-precision product (always finite).
routine F32.mul!(you: F32) -> F32
  var r = LLVM::float_mul[F32](a: me, b: you)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `me / you`. Checked: `x/0` -> DivisionByZeroError, `0/0` -> domain, overflow ->
### overflow.
### Use `truediv_unchecked` for raw IEEE 754, or `(a / b).finite()` for recoverable handling.
### :param you: The divisor.
### :returns: The single-precision quotient (always finite).
routine F32.truediv!(you: F32) -> F32
  var r = LLVM::float_div[F32](a: me, b: you)
  if r.is_finite()
    return r
  if you.is_zero() and not me.is_zero()
    throw DivisionByZeroError()
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `me` if it is finite; throws if it is ±infinity or NaN. The opt-in
### finiteness assertion for IEEE arithmetic, e.g. `var x = (a * b + c).finite()`.
### :returns: `me`, when finite.
### :throws: {NumericOverflowError} if `me` is ±infinity or NaN.
routine F32.finite!() -> F32
  if not me.is_finite()
    throw NumericOverflowError(description: f"F32 value is non-finite: {me}")
  return me

### Returns the negated value.
### :returns: The resulting `F32` value.
routine F32.neg() -> F32
  return LLVM::float_neg[F32](me)

# Unchecked variants — raw IEEE 754 propagation (the float analog of integer `+%`/`+^`). Plain
# (NOT `dangerous`): inf/NaN are valid IEEE values, the `_unchecked` spelling is the marker.

### Returns `me / you` with raw IEEE 754 semantics: `x/0` -> ±infinity, `0/0` -> NaN. No crash.
routine F32.truediv_unchecked(you: F32) -> F32
  return LLVM::float_div[F32](a: me, b: you)

### Returns `me + you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine F32.add_unchecked(you: F32) -> F32
  return LLVM::float_add[F32](a: me, b: you)

### Returns `me - you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine F32.sub_unchecked(you: F32) -> F32
  return LLVM::float_sub[F32](a: me, b: you)

### Returns `me * you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine F32.mul_unchecked(you: F32) -> F32
  return LLVM::float_mul[F32](a: me, b: you)

# ============================================================================
# Comparison Operations (ordered - false if NaN)
# ============================================================================

### Returns whether both values are equal.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
routine F32.eq(you: F32) -> Bool
  return LLVM::float_eq[F32](a: me, b: you)

### Compares this value with the other value.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
routine F32.cmp(you: F32) -> ComparisonSign
  if LLVM::float_lt[F32](a: me, b: you)
    return ME_SMALL
  if LLVM::float_gt[F32](a: me, b: you)
    return ME_LARGE
  return SAME

# ============================================================================
# Math Operations using intrinsics
# ============================================================================

### Returns the square root of this value in single precision.
### :returns: The intrinsic square-root result for `me`.
routine F32.sqrt!() -> F32
  var rr = me.sqrt_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Square root with raw IEEE 754 propagation (`sqrt(<0)` -> NaN). Thin wrapper over LLVM `sqrt`.
routine F32.sqrt_unchecked() -> F32
  return LLVM::sqrt[F32](me)

### Returns the absolute value.
### :returns: The resulting `F32` value.
routine F32.abs() -> F32
  return LLVM::float_abs[F32](me)

### Rounds this value toward negative infinity.
### :returns: The greatest integral-valued `F32` not larger than `me`.
routine F32.floor() -> F32
  return LLVM::floor[F32](me)

### Rounds this value toward positive infinity.
### :returns: The smallest integral-valued `F32` not smaller than `me`.
routine F32.ceil() -> F32
  return LLVM::ceil[F32](me)

### Rounds this value to the nearest integral-valued `F32`.
### :returns: The rounded result in single precision.
routine F32.round() -> F32
  return LLVM::round[F32](me)

### Discards the fractional part of this value toward zero.
### :returns: The truncated result in single precision.
routine F32.int_truncate() -> F32
  return LLVM::float_truncate[F32](me)

### Returns the sine of this value, interpreting it as radians.
### :returns: The single-precision sine result.
routine F32.sin() -> F32
  return LLVM::sin[F32](me)

### Returns the cosine of this value, interpreting it as radians.
### :returns: The single-precision cosine result.
routine F32.cos() -> F32
  return LLVM::cos[F32](me)

### Returns `e` raised to this value.
### :returns: The single-precision exponential result.
routine F32.exp!() -> F32
  var rr = me.exp_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Natural exponential with raw IEEE 754 propagation (overflow -> +inf). Wraps LLVM `exp`.
routine F32.exp_unchecked() -> F32
  return LLVM::exp[F32](me)

### Returns the natural logarithm of this value.
### :returns: The single-precision natural-log result.
routine F32.log!() -> F32
  var rr = me.log_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Natural log, raw IEEE (`log(0)` -> -inf, `log(<0)` -> NaN). Thin wrapper over LLVM `log`.
routine F32.log_unchecked() -> F32
  return LLVM::log[F32](me)

### Returns the base-10 logarithm of this value.
### :returns: The single-precision common-log result.
routine F32.log10!() -> F32
  var rr = me.log10_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Base-10 logarithm with raw IEEE 754 propagation. Thin wrapper over LLVM `log10`.
routine F32.log10_unchecked() -> F32
  return LLVM::log10[F32](me)

### `me` raised to `exp` with raw IEEE 754 propagation (inf/NaN on overflow/domain). Wraps LLVM
### `pow`.
routine F32.pow_unchecked(exp: F32) -> F32
  return LLVM::pow[F32](me, exp)

### Raises this value to `exp` (IEEE semantics: overflow/domain errors yield inf/NaN).
### :param exp: The exponent applied to `me`.
### :returns: `me` raised to `exp` in single precision.
routine F32.pow!(exp: F32) -> F32
  var rr = me.pow_unchecked(exp: exp)
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns this value with its sign bit replaced by the sign of `sign`.
### :param sign: The value supplying the sign bit.
### :returns: A value with the magnitude of `me` and the sign of `sign`.
routine F32.copysign(sign: F32) -> F32
  return LLVM::copysign[F32](me, sign)

# ============================================================================
# Utility Methods
# ============================================================================

### Returns the smaller of this value and `you`.
### :param you: The value to compare against.
### :returns: The lower of the two values under the ordered comparison rules.
routine F32.min(you: F32) -> F32
  return if me <= you then me else you

### Returns the larger of this value and `you`.
### :param you: The value to compare against.
### :returns: The greater of the two values under the ordered comparison rules.
routine F32.max(you: F32) -> F32
  return if me >= you then me else you

### Restricts this value to the closed interval `[min_val, max_val]`.
### :param min_val: The lower bound to enforce.
### :param max_val: The upper bound to enforce.
### :returns: `me` if already in range, otherwise the nearest bound.
@positional
routine F32.clamp(min_val: F32, max_val: F32) -> F32
  return me.min(max_val).max(min_val)

### Returns `true` if this value is strictly positive (greater than zero).
### :returns: `true` if `me > 0.0`.
routine F32.is_positive() -> Bool
  return me > 0.0_f32

### Returns `true` if this value is strictly negative (less than zero).
### :returns: `true` if `me < 0.0`.
routine F32.is_negative() -> Bool
  return me < 0.0_f32

### Returns `true` if this value compares equal to zero.
### :returns: `true` if `me == 0.0`.
routine F32.is_zero() -> Bool
  return me == 0.0_f32

### Returns `true` when this value encodes an IEEE 754 NaN.
### :returns: Whether the bit pattern represents a not-a-number payload.
routine F32.is_nan() -> Bool
  var bits = me.to_bits()
  var exponent = LLVM::bit_and(a: bits, b: 0x7F800000_u32)
  var mantissa = LLVM::bit_and(a: bits, b: 0x007FFFFF_u32)
  return exponent == 0x7F800000_u32 and mantissa != 0_u32

### True when this is a SIGNALING NaN (quiet bit clear). Arithmetic only makes quiet NaN.
routine F32.is_signaling() -> Bool
  return me.is_nan() and LLVM::bit_and(a: me.to_bits(), b: 0x00400000_u32) == 0_u32

### Returns `true` when this value encodes positive or negative infinity.
### :returns: Whether the bit pattern represents an infinity.
routine F32.is_infinite() -> Bool
  var bits = me.to_bits()
  var exponent = LLVM::bit_and(a: bits, b: 0x7F800000_u32)
  var mantissa = LLVM::bit_and(a: bits, b: 0x007FFFFF_u32)
  return exponent == 0x7F800000_u32 and mantissa == 0_u32

### Returns `true` when this value is neither NaN nor infinity.
### :returns: Whether the value is finite.
routine F32.is_finite() -> Bool
  return not me.is_nan() and not me.is_infinite()

### Returns the sign of this value as `-1.0`, `0.0`, or `1.0`.
### :returns: A unit-sign value describing the sign of `me`.
routine F32.signum() -> F32
  return when
    me > 0.0_f32 => 1.0_f32
    me < 0.0_f32 => -1.0_f32
    else => 0.0_f32

# ============================================================================
# Type Conversions
# ============================================================================

### Reinterprets this float as its raw IEEE 754 bit pattern.
### :returns: The underlying `U32` encoding of this value.
routine F32.to_bits() -> U32
  return LLVM::reinterpret_bits[F32, U32](me)

### Reinterprets a raw IEEE 754 bit pattern as an `F32`.
### :param bits: The exact single-precision encoding to decode.
### :returns: The `F32` value with that bit pattern.
common routine F32.from_bits(bits: U32) -> F32
  return LLVM::reinterpret_bits[U32, F32](bits)

### Returns a signaling NaN (interop/testing; never produced by arithmetic).
common routine F32.signaling_nan() -> F32
  return F32.from_bits(bits: 0x7F800001_u32)

# ============================================================================
# Text Representation and Parsing
# ============================================================================

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
@override
routine F32.represent() -> Text
  if me.is_signaling()
    return "snan"
  var cstr_result = C::rf_format_F32(me)
  return Text(from: CStr(from_ptr: cstr_result))

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
@override
routine F32.diagnose() -> Text
  var cstr_result = C::rf_format_F32(me)
  return "F32(" + Text(from: CStr(from_ptr: cstr_result)) + ")"

### Implements the wired routine behavior for this value.
### :param from_text: The `from_text` value.
### :returns: The resulting `F32` value.
### :throws: May throw {InvalidValueError}.
routine F32!(from_text: Text) -> F32
  var len = from_text.count()
  if len == 0u64
    throw InvalidValueError(input: from_text, target: "F32")
  var i = 0u64
  var first = from_text[0u64]
  if first == Character(0x002Bu32) or first == Character(0x002Du32)
    i = 1u64
    if i >= len
      throw InvalidValueError(input: from_text, target: "F32")
  var special = false
  var rest = len - i
  if rest >= 3u64
    var c0 = from_text[i].to_lowercase()
    var c1 = from_text[i + 1u64].to_lowercase()
    var c2 = from_text[i + 2u64].to_lowercase()
    if rest == 3u64 and c0 == Character(0x006Eu32) and c1 == Character(0x0061u32) and c2 == Character(0x006Eu32)
      special = true
    if rest == 3u64 and c0 == Character(0x0069u32) and c1 == Character(0x006Eu32) and c2 == Character(0x0066u32)
      special = true
    if not special and rest == 8u64 and c0 == Character(0x0069u32) and c1 == Character(0x006Eu32) and c2 == Character(0x0066u32)
      var c3 = from_text[i + 3u64].to_lowercase()
      var c4 = from_text[i + 4u64].to_lowercase()
      var c5 = from_text[i + 5u64].to_lowercase()
      var c6 = from_text[i + 6u64].to_lowercase()
      var c7 = from_text[i + 7u64].to_lowercase()
      if c3 == Character(0x0069u32) and c4 == Character(0x006Eu32) and c5 == Character(0x0069u32) and c6 == Character(0x0074u32) and c7 == Character(0x0079u32)
        special = true
  if not special
    var has_digit = false
    var has_dot = false
    var has_exp = false
    while i < len
      var ch = from_text[i]
      if ch.is_numeric()
        has_digit = true
      elseif ch == Character(0x002Eu32)
        if has_dot or has_exp
          throw InvalidValueError(input: from_text, target: "F32")
        has_dot = true
      elseif ch == Character(0x0065u32) or ch == Character(0x0045u32)
        if has_exp or not has_digit
          throw InvalidValueError(input: from_text, target: "F32")
        has_exp = true
        has_digit = false
        if i + 1u64 < len
          var next_ch = from_text[i + 1u64]
          if next_ch == Character(0x002Bu32) or next_ch == Character(0x002Du32)
            i = i + 1u64
      else
        throw InvalidValueError(input: from_text, target: "F32")
      i = i + 1u64
    if not has_digit
      throw InvalidValueError(input: from_text, target: "F32")
  var cstr_val = CStr(from: from_text)
  return C::rf_parse_F32(cstr_val)

# ============================================================================
# Hashing
# ============================================================================

# ============================================================================
# Byte Representation
# ============================================================================

### Returns the raw bytes of this value in little-endian order.
### :returns: The resulting `Array[Byte, 4]` value.
routine F32.to_bytes_le() -> Array[Byte, 4]
  var raw = LLVM::reinterpret_bits[F32, U32](me)
  var result = Array[Byte, 4]()
  result = LLVM::set_byte_at(array: result, index: 0u64, value: LLVM::int_truncate[U32, U8](raw))
  result = LLVM::set_byte_at(array: result, index: 1_u64, value: LLVM::int_truncate[U32, U8](LLVM::shift_right_unsigned(raw, 8_u32)))
  result = LLVM::set_byte_at(array: result, index: 2_u64, value: LLVM::int_truncate[U32, U8](LLVM::shift_right_unsigned(raw, 16_u32)))
  result = LLVM::set_byte_at(array: result, index: 3_u64, value: LLVM::int_truncate[U32, U8](LLVM::shift_right_unsigned(raw, 24_u32)))
  return result

### Returns the raw bytes of this value in big-endian order.
### :returns: The resulting `Array[Byte, 4]` value.
routine F32.to_bytes_be() -> Array[Byte, 4]
  var raw = LLVM::byte_swap(LLVM::reinterpret_bits[F32, U32](me))
  var result = Array[Byte, 4]()
  result = LLVM::set_byte_at(array: result, index: 0u64, value: LLVM::int_truncate[U32, U8](raw))
  result = LLVM::set_byte_at(array: result, index: 1_u64, value: LLVM::int_truncate[U32, U8](LLVM::shift_right_unsigned(raw, 8_u32)))
  result = LLVM::set_byte_at(array: result, index: 2_u64, value: LLVM::int_truncate[U32, U8](LLVM::shift_right_unsigned(raw, 16_u32)))
  result = LLVM::set_byte_at(array: result, index: 3_u64, value: LLVM::int_truncate[U32, U8](LLVM::shift_right_unsigned(raw, 24_u32)))
  return result

### Returns a keyed hash of this value using SipHash-2-4.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: The resulting `U64` value.
routine F32.hash(k0: U64, k1: U64) -> U64
  return __secure_hash_u64(v: LLVM::zero_extend[U32, U64](LLVM::reinterpret_bits[F32, U32](me)), k0: k0, k1: k1)

