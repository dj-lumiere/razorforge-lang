### Hypotenuse sqrt(me^2 + you^2) without overflow.
routine F32.hypot!(you: F32) -> F32
  var rr = me.hypot_unchecked(you: you)
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Hypotenuse with raw IEEE 754 propagation (overflow -> +inf). Thin wrapper over `rf_f32_hypot`.
routine F32.hypot_unchecked(you: F32) -> F32
  return C::rf_f32_hypot(x: me, y: you)

### Fused multiply-add me*b + c with a single rounding.
routine F32.fma!(b: F32, c: F32) -> F32
  var rr = me.fma_unchecked(b: b, c: c)
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Fused multiply-add me*b + c with raw IEEE 754 propagation. Thin wrapper over `rf_f32_fma`.
routine F32.fma_unchecked(b: F32, c: F32) -> F32
  return C::rf_f32_fma(x: me, y: b, z: c)

### Floating-point remainder of me/you (C fmod).
routine F32.fmod(you: F32) -> F32
  return C::rf_f32_fmod(x: me, y: you)

### IEEE remainder of me/you (C remainder).
routine F32.remainder(you: F32) -> F32
  return C::rf_f32_remainder(x: me, y: you)

### Positive difference max(me - you, 0) (C fdim).
routine F32.fdim(you: F32) -> F32
  return C::rf_f32_fdim(x: me, y: you)

### Larger of me and you (C fmax).
routine F32.fmax(you: F32) -> F32
  return C::rf_f32_fmax(x: me, y: you)

### Smaller of me and you (C fmin).
routine F32.fmin(you: F32) -> F32
  return C::rf_f32_fmin(x: me, y: you)

### sin(pi*me).
routine F32.sinpi() -> F32
  return C::rf_f32_sinpi(value: me)

### cos(pi*me).
routine F32.cospi() -> F32
  return C::rf_f32_cospi(value: me)

### tan(pi*me).
routine F32.tanpi() -> F32
  return C::rf_f32_tanpi(value: me)

### Next representable value after me toward you.
routine F32.nextafter(you: F32) -> F32
  return C::rf_f32_nextafter(x: me, y: you)

### me * 2^n (C scalbn).
routine F32.scalbn(n: S64) -> F32
  return C::rf_f32_scalbn(value: me, n: n)

### Alias of scalbn (C ldexp).
routine F32.ldexp(n: S64) -> F32
  return C::rf_f32_scalbn(value: me, n: n)

### Rounds to nearest integer in the current rounding mode (C rint).
routine F32.rint() -> F32
  return C::rf_f32_rint(value: me)

### Error function.
routine F32.erf() -> F32
  return C::rf_f32_erf(value: me)

### Complementary error function.
routine F32.erfc() -> F32
  return C::rf_f32_erfc(value: me)

### Gamma function.
routine F32.tgamma!() -> F32
  var rr = me.tgamma_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Gamma function with raw IEEE 754 propagation (overflow/pole -> ±inf or NaN). Wraps
### `rf_f32_tgamma`.
routine F32.tgamma_unchecked() -> F32
  return C::rf_f32_tgamma(value: me)

### Natural log of |gamma(me)|.
routine F32.lgamma() -> F32
  return C::rf_f32_lgamma(value: me)

### Truncates toward zero (C trunc; alias of int_truncate).
routine F32.trunc() -> F32
  return LLVM::float_truncate[F32](me)

### Fractional part me - trunc(me).
routine F32.frac() -> F32
  return me - LLVM::float_truncate[F32](me)

### Integer and fractional parts (C modf); both carry me's sign.
routine F32.modf() -> (F32, F32)
  var ip = LLVM::float_truncate[F32](me)
  return (ip, me - ip)

### Fraction in [0.5,1) and power-of-two exponent (C frexp).
routine F32.frexp() -> (F32, S64)
  if me.is_zero() or me.is_infinite() or me.is_nan()
    return (me, 0_s64)
  var e = LLVM::add(a: C::rf_f32_ilogb(value: me), b: 1_s64)
  return (C::rf_f32_scalbn(value: me, n: LLVM::sub(a: 0_s64, b: e)), e)

### True if the sign bit is set (C signbit).
routine F32.signbit() -> Bool
  return LLVM::int_ne(a: LLVM::bit_and(a: me.to_bits(), b: 0x80000000_u32), b: 0_u32)

### True for a subnormal (denormalized, nonzero) value.
routine F32.is_subnormal() -> Bool
  var bits = me.to_bits()
  var exponent = LLVM::bit_and(a: bits, b: 0x7F800000_u32)
  var mantissa = LLVM::bit_and(a: bits, b: 0x007FFFFF_u32)
  return exponent == 0_u32 and mantissa != 0_u32

### True for a finite, normal value (nonzero and not subnormal).
routine F32.is_normal() -> Bool
  return me.is_finite() and not me.is_zero() and not me.is_subnormal()

### C fpclassify: 0 NaN, 1 infinite, 2 zero, 3 subnormal, 4 normal.
routine F32.fpclassify() -> FpClass
  if me.is_signaling()
    return SIGNALING_NAN
  if me.is_nan()
    return NAN
  if me.is_infinite()
    return INFINITE
  if me.is_zero()
    return ZERO
  if me.is_subnormal()
    return SUBNORMAL
  return NORMAL

# ============================================================================
# IEEE 754 Tier 1 — total ordering predicates
# ============================================================================

### Sign-magnitude total-order key: negatives become small, non-negatives large, so an
### unsigned `<=` reproduces the IEEE 754 totalOrder ranking (-NaN < -inf < ... < +inf < +NaN).
routine f32_order_key(bits: U32) -> U32
  if LLVM::int_ne(a: LLVM::bit_and(a: bits, b: 0x80000000_u32), b: 0_u32)
    return LLVM::bit_xor(a: bits, b: 0xFFFFFFFF_u32)
  return LLVM::bit_or(a: bits, b: 0x80000000_u32)

### IEEE 754 totalOrder: a total order over all values including signed zeros and NaNs
### (-NaN < -inf < negatives < -0 < +0 < positives < +inf < +NaN). Never crashes.
### :param you: The value to compare against.
### :returns: Whether `me` precedes or equals `you` in the total order.
routine F32.total_order(you: F32) -> Bool
  return f32_order_key(bits: me.to_bits()) <= f32_order_key(bits: you.to_bits())

### IEEE 754 totalOrderMag: `total_order` applied to the magnitudes (sign bit cleared).
### :param you: The value whose magnitude to compare against.
### :returns: Whether `|me|` precedes or equals `|you|` in the total order.
routine F32.total_order_mag(you: F32) -> Bool
  return LLVM::bit_and(a: me.to_bits(), b: 0x7FFFFFFF_u32) <= LLVM::bit_and(a: you.to_bits(), b: 0x7FFFFFFF_u32)

# ============================================================================
# IEEE 754 Tier 2 — stepping, exponent extraction, scaling, selection, rounding
# ============================================================================

### IEEE 754 nextUp: the least value greater than `me`. Propagating; never crashes.
### :returns: The next representable value toward +infinity.
routine F32.next_up() -> F32
  return me.nextafter(you: F32_INFINITY)

### IEEE 754 nextDown: the greatest value less than `me`. Never crashes.
### :returns: The next representable value toward -infinity.
routine F32.next_down() -> F32
  return me.nextafter(you: -F32_INFINITY)

### IEEE 754 logb: the unbiased exponent of `me` as a floating value (logb(0)=-inf,
### logb(±inf)=+inf, logb(NaN)=NaN). Propagating; never crashes.
### :returns: The radix-2 exponent of `me`.
routine F32.logb() -> F32
  if me.is_nan()
    return me
  if me.is_infinite()
    return F32_INFINITY
  if me.is_zero()
    return -F32_INFINITY
  return F32(from: C::rf_f32_ilogb(value: me))

### IEEE 754 scaleB: `me * 2^n`. Checked: crashes if a finite `me` overflows to ±infinity.
### :param n: The power-of-two exponent to apply.
### :returns: `me` scaled by `2^n`.
routine F32.scaleb!(n: S64) -> F32
  var r = me.scalbn(n: n)
  if r.is_finite() or not me.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `me * 2^n` with raw IEEE 754 propagation (overflow -> ±infinity).
### :param n: The power-of-two exponent to apply.
### :returns: `me` scaled by `2^n`.
routine F32.scaleb_unchecked(n: S64) -> F32
  return me.scalbn(n: n)

### IEEE 754-2008 minNum: the smaller operand, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The minimum of `me` and `you`, ignoring NaN.
routine F32.min_num(you: F32) -> F32
  return me.fmin(you: you)

### IEEE 754-2008 maxNum: the larger operand, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The maximum of `me` and `you`, ignoring NaN.
routine F32.max_num(you: F32) -> F32
  return me.fmax(you: you)

### IEEE 754-2019 minimum: the smaller operand, propagating NaN, ordering -0 below +0.
### :param you: The value to compare against.
### :returns: The minimum of `me` and `you`, NaN if either is NaN.
routine F32.minimum(you: F32) -> F32
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  if me == you
    if me.is_zero()
      return if me.signbit() then me else you
    return me
  return if me < you then me else you

### IEEE 754-2019 maximum: the larger operand, propagating NaN, ordering +0 above -0.
### :param you: The value to compare against.
### :returns: The maximum of `me` and `you`, NaN if either is NaN.
routine F32.maximum(you: F32) -> F32
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  if me == you
    if me.is_zero()
      return if me.signbit() then you else me
    return me
  return if me > you then me else you

### IEEE 754 roundToIntegralTiesToAway: rounds to nearest integer, halves away from zero.
### :returns: `me` rounded to an integral value with ties away from zero.
routine F32.round_ties_away() -> F32
  if not me.is_finite()
    return me
  var a = me.abs()
  var t = a.trunc()
  var rounded = if a - t >= 0.5_f32 then t + 1.0_f32 else t
  return rounded.copysign(sign: me)
