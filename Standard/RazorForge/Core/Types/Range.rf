module Core

### Represents the `Range` record.
### `Range[T]` describes a lazily iterated arithmetic progression between two bounds.
### :typeparam T: The type argument bound to `T`.
record Range[AnyType T] obeys Iterable[T] needs T obeys Comparable, Addable, Subtractable
  ### Stores the first value in the progression.
  start: T
  ### Stores the terminating bound.
  end: T
  ### Stores the step applied between successive values.
  step: T
  ### Stores whether the terminating bound is included.
  inclusive: Bool  # true for 'to', false for 'til'

### Creates an inclusive range from `start` to `end` using a step of `1`.
### :param start: The inclusive starting position.
### :param end: The terminating bound.
### :returns: The resulting `Range[T]` value.
routine Range[T](start: T, end: T) -> Range[T]
  return Range[T](start: start, end: end, step: 1, inclusive: true)

### Creates a range from `start` to `end` using a step of `1`.
### :param start: The inclusive starting position.
### :param end: The terminating bound.
### :param inclusive: `true` to include `end`; `false` to stop before it.
### :returns: The resulting `Range[T]` value.
routine Range[T](start: T, end: T, inclusive: Bool) -> Range[T]
  return Range[T](start: start, end: end, step: 1, inclusive: inclusive)

### Creates a range from `start` to `end` with an explicit `step`.
### :param start: The inclusive starting position.
### :param end: The terminating bound.
### :param step: The step applied between yielded values.
### :param inclusive: `true` to include `end`; `false` to stop before it.
### :returns: The resulting `Range[T]` value.
routine Range[T](start: T, end: T, step: T, inclusive: Bool) -> Range[T]
  return Range[T](start: start, end: end, step: step, inclusive: inclusive)

### Returns true if this value is ascending.
### Ascending ranges move from smaller values to larger ones.
### :returns: The resulting `Bool` value.
@readonly
routine Range[T].is_ascending() -> Bool
  return me.start <= me.end

### Returns the step component.
### This is the increment used for each successive value.
### :returns: The resulting `T` value.
@readonly
routine Range[T].get_step() -> T
  return me.step

### Returns true if this value is empty.
### Emptiness depends on the bound ordering and whether the end is inclusive.
### :returns: The resulting `Bool` value.
@readonly
routine Range[T].is_empty() -> Bool
  if me.inclusive and me.is_ascending()
    return me.start > me.end
  if me.inclusive and not me.is_ascending()
    return me.start < me.end
  return me.start == me.end

# ============================================================================
# Iterable protocol support
# ============================================================================

### Represents the `RangeEmittable` entity.
### `RangeEmittable[T]` holds the mutable iteration state for a `Range[T]`.
### :typeparam T: The type argument bound to `T`.
entity RangeEmittable[AnyType T] needs T obeys Comparable, Addable, Subtractable
  ### Stores the next value to yield.
  current: T
  ### Stores the terminating bound.
  end: T
  ### Stores the step size between yielded values.
  step: T
  ### Stores whether iteration is moving upward.
  ascending: Bool
  ### Stores whether the terminating bound may be yielded.
  inclusive: Bool
  ### Stores whether iteration has already completed.
  done: Bool

### Creates an iterator for this value.
### The emitter starts at `me.start`.
### :returns: The resulting `RangeEmittable[T]` value.
@readonly
routine Range[T].iter() -> RangeEmittable[T]
  return RangeEmittable[T](
    current: me.start,
    end: me.end,
    step: me.step,
    ascending: me.is_ascending(),
    inclusive: me.inclusive,
    done: me.is_empty()
  )

### Returns the next value from this iterator.
### Each successful call yields the current value and advances by `step`.
### :returns: The resulting `T` value.
### :absent: Returns absent when the requested value is unavailable.
routine RangeEmittable[T].emit!() -> T
  if me.done
    absent

  var _result = me.current

  if me.ascending
    me.current = me.current + me.step
    if me.inclusive
      if me.current > me.end
        me.done = true
    else
      if me.current >= me.end
        me.done = true
  else
    me.current = me.current - me.step
    if me.inclusive
      if me.current < me.end
        me.done = true
    else
      if me.current <= me.end
        me.done = true

  return _result
