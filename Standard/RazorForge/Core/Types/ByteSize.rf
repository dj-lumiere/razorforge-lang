module Core

# ============================================================================
# Constants
# ============================================================================

preset BYTES_PER_KIB: U64 = 1_024_u64
preset BYTES_PER_MIB: U64 = 1_048_576_u64
preset BYTES_PER_GIB: U64 = 1_073_741_824_u64
preset BYTES_PER_TIB: U64 = 1_099_511_627_776_u64
preset BYTES_PER_PIB: U64 = 1_125_899_906_842_624_u64

preset BYTES_PER_KB: U64 = 1_000u64
preset BYTES_PER_MB: U64 = 1_000_000u64
preset BYTES_PER_GB: U64 = 1_000_000_000u64
preset BYTES_PER_TB: U64 = 1_000_000_000_000u64
preset BYTES_PER_PB: U64 = 1_000_000_000_000_000u64

# ============================================================================
# Record definition
# ============================================================================

### Represents a size or displacement measured in bytes.
### `ByteSize` is the standard memory-size type for allocation, alignment, buffer math, and address offsets.
### It supports both binary units such as KiB/MiB and decimal units such as KB/MB.
### :see: {Address}, {Memory-Types}
@llvm("i64")
record ByteSize obeys Ordered, Addable, Subtractable, FloorDivisible, Scalable, ScalarFloorDivisible, Assignable, Copyable
  pass

# ============================================================================
# Creators
# ============================================================================

### Creates a `ByteSize` from a raw byte count.
### :param bytes: The number of bytes.
### :returns: The resulting `ByteSize` value.
routine ByteSize(bytes: U64) -> ByteSize
  return LLVM::reinterpret_bits[U64, ByteSize](bytes)

### Returns a decimal terabyte size.
### :param n: The number of terabytes.
### :returns: The resulting `ByteSize` value.
common routine ByteSize.terabytes(n: U64) -> ByteSize
  return LLVM::reinterpret_bits[U64, ByteSize](n *% BYTES_PER_TB)

### Returns a binary tebibyte size.
### :param n: The number of tebibytes.
### :returns: The resulting `ByteSize` value.
common routine ByteSize.tebibytes(n: U64) -> ByteSize
  return LLVM::reinterpret_bits[U64, ByteSize](n *% BYTES_PER_TIB)

### Returns a decimal petabyte size.
### :param n: The number of petabytes.
### :returns: The resulting `ByteSize` value.
common routine ByteSize.petabytes(n: U64) -> ByteSize
  return LLVM::reinterpret_bits[U64, ByteSize](n *% BYTES_PER_PB)

### Returns a binary pebibyte size.
### :param n: The number of pebibytes.
### :returns: The resulting `ByteSize` value.
common routine ByteSize.pebibytes(n: U64) -> ByteSize
  return LLVM::reinterpret_bits[U64, ByteSize](n *% BYTES_PER_PIB)

# ============================================================================
# Size accessors
# ============================================================================

### Returns the raw byte count represented by this value.
### :returns: The resulting `U64` value.
@readonly
routine ByteSize.byte_size() -> U64
  return LLVM::reinterpret_bits[ByteSize, U64](me)

### Returns the size represented by this value in bits.
### :returns: The resulting `U64` value.
@readonly
routine ByteSize.bit_size() -> U64
  return LLVM::reinterpret_bits[ByteSize, U64](me) * 8_u64

# ============================================================================
# Binary unit conversions (powers of 1024)
# ============================================================================

### Returns this size expressed in kibibytes.
### The conversion uses powers of 1024.
### :returns: The resulting `F64` value.
@readonly
routine ByteSize.kib_size() -> F64
  return F64(LLVM::reinterpret_bits[ByteSize, U64](me)) / 1024.0

### Returns this size expressed in mebibytes.
### The conversion uses powers of 1024.
### :returns: The resulting `F64` value.
@readonly
routine ByteSize.mib_size() -> F64
  return F64(LLVM::reinterpret_bits[ByteSize, U64](me)) / 1048576.0

### Returns this size expressed in gibibytes.
### The conversion uses powers of 1024.
### :returns: The resulting `F64` value.
@readonly
routine ByteSize.gib_size() -> F64
  return F64(LLVM::reinterpret_bits[ByteSize, U64](me)) / 1073741824.0

# ============================================================================
# Decimal unit conversions (powers of 1000)
# ============================================================================

### Returns this size expressed in kilobytes.
### The conversion uses powers of 1000.
### :returns: The resulting `F64` value.
@readonly
routine ByteSize.kb_size() -> F64
  return F64(LLVM::reinterpret_bits[ByteSize, U64](me)) / 1000.0

### Returns this size expressed in megabytes.
### The conversion uses powers of 1000.
### :returns: The resulting `F64` value.
@readonly
routine ByteSize.mb_size() -> F64
  return F64(LLVM::reinterpret_bits[ByteSize, U64](me)) / 1000000.0

### Returns this size expressed in gigabytes.
### The conversion uses powers of 1000.
### :returns: The resulting `F64` value.
@readonly
routine ByteSize.gb_size() -> F64
  return F64(LLVM::reinterpret_bits[ByteSize, U64](me)) / 1000000000.0

# ============================================================================
# Arithmetic operators
# ============================================================================

### Returns `me + you`, adding the two byte sizes.
### :param you: The addend.
### :returns: The combined `ByteSize`.
@readonly
routine ByteSize.add(you: ByteSize) -> ByteSize
  return LLVM::reinterpret_bits[U64, ByteSize](LLVM::reinterpret_bits[ByteSize, U64](me) + LLVM::reinterpret_bits[ByteSize, U64](you))

### Returns `me - you`, subtracting `you` from this size.
### :param you: The size to subtract.
### :returns: The resulting `ByteSize`.
@readonly
routine ByteSize.sub(you: ByteSize) -> ByteSize
  return LLVM::reinterpret_bits[U64, ByteSize](LLVM::reinterpret_bits[ByteSize, U64](me) - LLVM::reinterpret_bits[ByteSize, U64](you))

### Returns this size multiplied by an integral factor.
### :param factor: The scale factor to apply.
### :returns: The resulting `ByteSize` value.
@readonly
routine ByteSize.mul(factor: U64) -> ByteSize
  return LLVM::reinterpret_bits[U64, ByteSize](LLVM::reinterpret_bits[ByteSize, U64](me) *% factor)

### Returns how many times `you` fits into this size.
### :param you: The size divisor.
### :returns: The resulting `U64` value.
@readonly
routine ByteSize.floordiv(you: ByteSize) -> U64
  return LLVM::reinterpret_bits[ByteSize, U64](me) // LLVM::reinterpret_bits[ByteSize, U64](you)

### Returns this byte size divided by an integral factor.
### :param divisor: The divisor to apply.
### :returns: The resulting `ByteSize` value.
@readonly
routine ByteSize.div_by(divisor: U64) -> ByteSize
  return LLVM::reinterpret_bits[U64, ByteSize](LLVM::reinterpret_bits[ByteSize, U64](me) // divisor)

### Returns the remainder after dividing this size by `you`.
### :param you: The divisor size.
### :returns: The remaining `ByteSize`.
@readonly
routine ByteSize.mod(you: ByteSize) -> ByteSize
  return LLVM::reinterpret_bits[U64, ByteSize](LLVM::reinterpret_bits[ByteSize, U64](me) % LLVM::reinterpret_bits[ByteSize, U64](you))

# ============================================================================
# Comparison operators
# ============================================================================

### Returns whether both values are equal.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
@readonly
routine ByteSize.eq(you: ByteSize) -> Bool
  return LLVM::reinterpret_bits[ByteSize, U64](me) == LLVM::reinterpret_bits[ByteSize, U64](you)

### Compares this value with the other value.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
@readonly
routine ByteSize.cmp(you: ByteSize) -> ComparisonSign
  var lhs = LLVM::reinterpret_bits[ByteSize, U64](me)
  var rhs = LLVM::reinterpret_bits[ByteSize, U64](you)
  if lhs < rhs
    return ME_SMALL
  if lhs > rhs
    return ME_LARGE
  return SAME

# ============================================================================
# Display
# ============================================================================

### Returns the display form of this byte size.
### Breaks the raw byte count into binary unit components (PiB, TiB, GiB, MiB,
### KiB, B) and concatenates the non-zero parts, matching the component-wise
### style of `Duration.represent`.
### :returns: The resulting `Text` value.
@override
routine ByteSize.represent() -> Text
  var raw = LLVM::reinterpret_bits[ByteSize, U64](me)
  if raw == 0u64
    return "0B"

  var parts = ""
  var sep = ""

  var pib = raw // BYTES_PER_PIB
  var rem = raw % BYTES_PER_PIB
  if pib != 0u64
    parts = f"{parts}{sep}{pib}PiB"
    sep = " "

  var tib = rem // BYTES_PER_TIB
  rem = rem % BYTES_PER_TIB
  if tib != 0u64
    parts = f"{parts}{sep}{tib}TiB"
    sep = " "

  var gib = rem // BYTES_PER_GIB
  rem = rem % BYTES_PER_GIB
  if gib != 0u64
    parts = f"{parts}{sep}{gib}GiB"
    sep = " "

  var mib = rem // BYTES_PER_MIB
  rem = rem % BYTES_PER_MIB
  if mib != 0u64
    parts = f"{parts}{sep}{mib}MiB"
    sep = " "

  var kib = rem // BYTES_PER_KIB
  rem = rem % BYTES_PER_KIB
  if kib != 0u64
    parts = f"{parts}{sep}{kib}KiB"
    sep = " "

  if rem != 0u64
    parts = f"{parts}{sep}{rem}B"

  return parts

### Returns the diagnostic form of this byte size.
### :returns: The resulting `Text` value.
@override
routine ByteSize.diagnose() -> Text
  return "ByteSize(" + LLVM::reinterpret_bits[ByteSize, U64](me).represent() + ")"

# ============================================================================
# Hashing
# ============================================================================

### Returns a SipHash-2-4 keyed hash of this byte size.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash suitable for denial-of-service-resistant hash tables.
routine ByteSize.hash(k0: U64, k1: U64) -> U64
  return __secure_hash_u64(v: LLVM::reinterpret_bits[ByteSize, U64](me), k0: k0, k1: k1)

