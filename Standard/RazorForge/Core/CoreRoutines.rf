module Core

### A zero-initialized value of type `T` — every field/element set to zero (a null pointer for raw
### pointer fields). The buildtime footprint primitive behind the SoA collections: `SplitList`/
### `SplitArray` start from `blank[T]()` and fill their columns. Sound only when `T obeys Splittable`
### (a trivially-destructible footprint), so a zeroed instance owns nothing that needs teardown.
### :returns: A `T` with every byte zero.
common routine T.blank() -> T
needs AnyType T
  return LLVM::zeroed[T]()

### A freshly heap-allocated `T` entity whose whole footprint is zeroed — the reference-type analog of
### `blank[T]()`. Sizes the allocation from the entity's STRUCT footprint (not the 8-byte reference), so it
### is the construction primitive behind SoA ENTITY collections (a growable `SplitList`): the columns land
### null (`hijacked_none`) and scalar counts land zero, giving a valid empty container with no per-field
### `$create` args. `dangerous` because it BYPASSES the memberwise `create`: sound only when the element
### type's zero state is a valid empty instance (every field defaults to null/zero, no invariant to establish).
### :returns: A newly allocated, zero-initialized `T` entity.
@innate
dangerous routine hollow[T]() -> T

### Executes `stop`.
### :throws: May throw {UserTerminationError}.
@crash_only
routine stop!()
  throw UserTerminationError()

### Performs the `verify` operation on this value.
### :param expr: The `expr` value.
### :throws: May throw {VerificationFailedError}.
@crash_only
routine verify!(expr: Bool)
  throw VerificationFailedError()

### Executes `breach`.
### :throws: May throw {LogicBreachedError}.
@crash_only
routine breach!()
  throw LogicBreachedError()

### The quotient and remainder of a single Möller-Granlund 2-by-1 word division.
record WordQuoRem
  q: U64
  r: U64

### The Möller-Granlund reciprocal of a NORMALIZED 64-bit divisor `d` (its MSB MUST be set):
### `v = floor((2¹²⁸ − 1) / d) − 2⁶⁴`, the precomputed constant that turns each 2-by-1 division
### into multiplies (see `div2by1`). This is intx's `reciprocal_2by1` — the only divide is one
### native 64/64 seed: intx's 256-entry seed table `t[i] = 0x7fd00 / (i + 256)` indexed by `d >> 55`
### is exactly `0x7fd00 / (d >> 55)` (523520 == 0x7fd00), so a single `unsigned_div` (ARM `UDIV` /
### x86 `DIV` / wasm `div_u`, one instruction everywhere) replaces the table. The v1..v4 Newton
### refinement is the intx sequence verbatim; all arithmetic is wrapping U64 as in the reference.
### :returns: the reciprocal `v` feeding `div2by1`.
routine reciprocal_word(d: U64) -> U64
  var d9 = LLVM::shift_right_unsigned(d, 55_u64)
  var v0 = LLVM::unsigned_div(a: 523520_u64, b: d9)
  var d40 = LLVM::add(a: LLVM::shift_right_unsigned(d, 24_u64), b: 1_u64)
  var t1 = LLVM::shift_right_unsigned(LLVM::mul(a: LLVM::mul(a: v0, b: v0), b: d40), 40_u64)
  var v1 = LLVM::sub(a: LLVM::sub(a: LLVM::shift_left(v0, 11_u64), b: t1), b: 1_u64)
  var inner = LLVM::sub(a: 1152921504606846976_u64, b: LLVM::mul(a: v1, b: d40))
  var t2 = LLVM::shift_right_unsigned(LLVM::mul(a: v1, b: inner), 47_u64)
  var v2 = LLVM::add(a: LLVM::shift_left(v1, 13_u64), b: t2)
  var d0 = LLVM::bit_and(a: d, b: 1_u64)
  var d63 = LLVM::add(a: LLVM::shift_right_unsigned(d, 1_u64), b: d0)
  var mask = LLVM::sub(a: 0_u64, b: d0)
  var e = LLVM::sub(a: LLVM::bit_and(a: LLVM::shift_right_unsigned(v2, 1_u64), b: mask), b: LLVM::mul(a: v2, b: d63))
  var v2e = LLVM::mul(a: LLVM::zero_extend[U64, U128](v2), b: LLVM::zero_extend[U64, U128](e))
  var v3 = LLVM::add(a: LLVM::shift_right_unsigned(LLVM::int_truncate[U128, U64](LLVM::shift_right_unsigned(v2e, 64_u128)), 1_u64), b: LLVM::shift_left(v2, 31_u64))
  var v3d = LLVM::add(a: LLVM::mul(a: LLVM::zero_extend[U64, U128](v3), b: LLVM::zero_extend[U64, U128](d)), b: LLVM::zero_extend[U64, U128](d))
  var v4 = LLVM::sub(a: LLVM::sub(a: v3, b: LLVM::int_truncate[U128, U64](LLVM::shift_right_unsigned(v3d, 64_u128))), b: d)
  return v4

### Möller-Granlund 2-by-1 division: `(u1:u0) / d` for a NORMALIZED `d` (MSB set) with `u1 < d`,
### using the reciprocal `v = reciprocal_word(d)`. Multiply-only — this is what `rf_udivrem_128_64`
### used to do with a hardware 128/64 divide, now portable to every target (no `divq`, no ARM
### `__udivti3`). intx's `udivrem_2by1` verbatim; wrapping U64/U128 arithmetic as in the reference.
### :returns: the quotient `q` and remainder `r` of `(u1:u0) / d`.
routine div2by1(u1: U64, u0: U64, d: U64, v: U64) -> WordQuoRem
  var u = LLVM::bit_or(a: LLVM::shift_left(LLVM::zero_extend[U64, U128](u1), 64_u128), b: LLVM::zero_extend[U64, U128](u0))
  var qfull = LLVM::add(a: LLVM::mul(a: LLVM::zero_extend[U64, U128](v), b: LLVM::zero_extend[U64, U128](u1)), b: u)
  var q0 = LLVM::int_truncate[U128, U64](qfull)
  var q1 = LLVM::add(a: LLVM::int_truncate[U128, U64](LLVM::shift_right_unsigned(qfull, 64_u128)), b: 1_u64)
  var r = LLVM::sub(a: u0, b: LLVM::mul(a: q1, b: d))
  if LLVM::unsigned_gt(a: r, b: q0)
    q1 = LLVM::sub(a: q1, b: 1_u64)
    r = LLVM::add(a: r, b: d)
  if LLVM::unsigned_ge(a: r, b: d)
    q1 = LLVM::add(a: q1, b: 1_u64)
    r = LLVM::sub(a: r, b: d)
  return WordQuoRem(q: q1, r: r)

routine knuth_divide[N](
  a: Hijacked[Array[U64, N]],
  b: Hijacked[Array[U64, N]],
  rem: Hijacked[Array[U64, N]]
) -> Array[U64, N]
needs U64 N
  var nl = LLVM::reinterpret_bits[U64, S64](N)
  var q = Array[U64, N]()
  danger
    var qp = q.hijack()

    # significant limb count of the divisor (highest non-zero limb + 1)
    var n = nl
    while LLVM::signed_gt(a: n, b: 1_s64) and LLVM::int_eq(a: LLVM::load_element_ref[Array[U64, N], U64](b, LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: n, b: 1_s64))), b: 0_u64)
      n = LLVM::sub(a: n, b: 1_s64)

    # ---- Single-limb divisor: normalized long division via multiply-only div2by1 ----
    # Normalize d0 so its MSB is set (div2by1's precondition); shift the dividend limbs on
    # the fly by the same amount, then denormalize the final remainder by shifting it back.
    if LLVM::signed_le(a: n, b: 1_s64)
      var d0 = LLVM::load_element_ref[Array[U64, N], U64](b, 0_u64)
      var sh1 = LLVM::reinterpret_bits[U64, S64](LLVM::leading_zeros(d0))
      var sh1u = LLVM::reinterpret_bits[S64, U64](sh1)
      var sh1inv = LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: 64_s64, b: sh1))
      var pos1 = LLVM::signed_gt(a: sh1, b: 0_s64)
      var dn = LLVM::shift_left(d0, sh1u)
      var vrec1 = reciprocal_word(dn)
      # initial normalized remainder = the bits shifted out past the top limb (< dn, so u1 < d holds)
      var r = if pos1 then LLVM::shift_right_unsigned(LLVM::load_element_ref[Array[U64, N], U64](a, LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: nl, b: 1_s64))), sh1inv) else 0_u64
      var i = LLVM::sub(a: nl, b: 1_s64)
      while LLVM::signed_ge(a: i, b: 0_s64)
        var ahi = LLVM::shift_left(LLVM::load_element_ref[Array[U64, N], U64](a, LLVM::reinterpret_bits[S64, U64](i)), sh1u)
        var alo = if LLVM::signed_gt(a: i, b: 0_s64) and pos1 then LLVM::shift_right_unsigned(LLVM::load_element_ref[Array[U64, N], U64](a, LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: i, b: 1_s64))), sh1inv) else 0_u64
        var dr = div2by1(u1: r, u0: LLVM::bit_or(a: ahi, b: alo), d: dn, v: vrec1)
        LLVM::store_element_ref[Array[U64, N], U64](qp, LLVM::reinterpret_bits[S64, U64](i), dr.q)
        r = dr.r
        i = LLVM::sub(a: i, b: 1_s64)
      LLVM::store_element_ref[Array[U64, N], U64](rem, 0_u64, LLVM::shift_right_unsigned(r, sh1u))
      var z = 1_s64
      while LLVM::signed_lt(a: z, b: nl)
        LLVM::store_element_ref[Array[U64, N], U64](rem, LLVM::reinterpret_bits[S64, U64](z), 0_u64)
        z = LLVM::add(a: z, b: 1_s64)
      return q

    # significant limb count of the dividend
    var mlen = nl
    while LLVM::signed_gt(a: mlen, b: 1_s64) and LLVM::int_eq(a: LLVM::load_element_ref[Array[U64, N], U64](a, LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: mlen, b: 1_s64))), b: 0_u64)
      mlen = LLVM::sub(a: mlen, b: 1_s64)

    # Dividend shorter than divisor → quotient 0, remainder = dividend.
    if LLVM::signed_lt(a: mlen, b: n)
      var z2 = 0_s64
      while LLVM::signed_lt(a: z2, b: nl)
        LLVM::store_element_ref[Array[U64, N], U64](rem, LLVM::reinterpret_bits[S64, U64](z2), LLVM::load_element_ref[Array[U64, N], U64](a, LLVM::reinterpret_bits[S64, U64](z2)))
        z2 = LLVM::add(a: z2, b: 1_s64)
      return q
    var m = LLVM::sub(a: mlen, b: n)

    # ---- D1: normalize so the divisor's top limb has its MSB set ----
    var vtop = LLVM::load_element_ref[Array[U64, N], U64](b, LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: n, b: 1_s64)))
    var s = 0_s64
    while LLVM::int_eq(a: LLVM::bit_and(a: vtop, b: LLVM::shift_left(1_u64, 63_u64)), b: 0_u64)
      vtop = LLVM::shift_left(vtop, 1_u64)
      s = LLVM::add(a: s, b: 1_s64)
    var su = LLVM::reinterpret_bits[S64, U64](s)
    var su_inv = LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: 64_s64, b: s))

    # vn = b << s  (n limbs)
    var vn = Array[U64, N]()
    var vnp = vn.hijack()
    var vi = LLVM::sub(a: n, b: 1_s64)
    while LLVM::signed_ge(a: vi, b: 0_s64)
      var hi = LLVM::shift_left(LLVM::load_element_ref[Array[U64, N], U64](b, LLVM::reinterpret_bits[S64, U64](vi)), su)
      var lo = if LLVM::signed_gt(a: vi, b: 0_s64) and LLVM::signed_gt(a: s, b: 0_s64) then LLVM::shift_right_unsigned(LLVM::load_element_ref[Array[U64, N], U64](b, LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: vi, b: 1_s64))), su_inv) else 0_u64
      LLVM::store_element_ref[Array[U64, N], U64](vnp, LLVM::reinterpret_bits[S64, U64](vi), LLVM::bit_or(a: hi, b: lo))
      vi = LLVM::sub(a: vi, b: 1_s64)

    # un = a << s  (mlen+1 limbs; the top limb lives in `un_hi`)
    var un = Array[U64, N]()
    var unp = un.hijack()
    var un_hi = if LLVM::signed_gt(a: s, b: 0_s64) then LLVM::shift_right_unsigned(LLVM::load_element_ref[Array[U64, N], U64](a, LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: mlen, b: 1_s64))), su_inv) else 0_u64
    var ui = LLVM::sub(a: mlen, b: 1_s64)
    while LLVM::signed_ge(a: ui, b: 0_s64)
      var uhi = LLVM::shift_left(LLVM::load_element_ref[Array[U64, N], U64](a, LLVM::reinterpret_bits[S64, U64](ui)), su)
      var ulo = if LLVM::signed_gt(a: ui, b: 0_s64) and LLVM::signed_gt(a: s, b: 0_s64) then LLVM::shift_right_unsigned(LLVM::load_element_ref[Array[U64, N], U64](a, LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: ui, b: 1_s64))), su_inv) else 0_u64
      LLVM::store_element_ref[Array[U64, N], U64](unp, LLVM::reinterpret_bits[S64, U64](ui), LLVM::bit_or(a: uhi, b: ulo))
      ui = LLVM::sub(a: ui, b: 1_s64)

    var vn1 = LLVM::load_element_ref[Array[U64, N], U64](vnp, LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: n, b: 1_s64)))
    var vn2 = LLVM::load_element_ref[Array[U64, N], U64](vnp, LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: n, b: 2_s64)))
    # vn1 is the normalized top divisor limb (MSB set by D1), invariant across the whole
    # quotient-digit loop, so its Möller-Granlund reciprocal is computed exactly once here.
    var vrec = reciprocal_word(vn1)

    # ---- D2..D7: main loop over quotient limbs, high to low ----
    var j = m
    while LLVM::signed_ge(a: j, b: 0_s64)
      # un_get(j+n) is in un_hi when j+n == mlen, else in the un array
      var un_jn = if LLVM::int_eq(a: LLVM::add(a: j, b: n), b: mlen) then un_hi else LLVM::load_element_ref[Array[U64, N], U64](unp, LLVM::reinterpret_bits[S64, U64](LLVM::add(a: j, b: n)))
      var un_jn1 = LLVM::load_element_ref[Array[U64, N], U64](unp, LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: LLVM::add(a: j, b: n), b: 1_s64)))

      # D3: estimate qhat, rhat from the top two dividend limbs / top divisor limb
      var qhat = 0_u64
      var rhat = 0_u64
      if LLVM::int_eq(a: un_jn, b: vn1)
        qhat = U64_MAX
        rhat = LLVM::add(a: un_jn1, b: vn1)
      else
        var dr = div2by1(u1: un_jn, u0: un_jn1, d: vn1, v: vrec)
        qhat = dr.q
        rhat = dr.r
      # correct qhat: while qhat*vn2 > (rhat:un[j+n-2]) and rhat fits 64 bits
      var un_jn2 = LLVM::load_element_ref[Array[U64, N], U64](unp, LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: LLVM::add(a: j, b: n), b: 2_s64)))
      var keep = true
      while keep
        var lhs = LLVM::mul(a: LLVM::zero_extend[U64, U128](qhat), b: LLVM::zero_extend[U64, U128](vn2))
        var rhs = LLVM::bit_or(a: LLVM::shift_left(LLVM::zero_extend[U64, U128](rhat), 64_u128), b: LLVM::zero_extend[U64, U128](un_jn2))
        if LLVM::unsigned_gt(a: lhs, b: rhs)
          qhat = LLVM::sub(a: qhat, b: 1_u64)
          var rnew = LLVM::add(a: rhat, b: vn1)
          if LLVM::unsigned_lt(a: rnew, b: rhat)
            keep = false
          else
            rhat = rnew
        else
          keep = false

      # D4: multiply qhat*vn and subtract from un[j..j+n] (signed S128 borrow `k`)
      var k = LLVM::zero_extend[U64, S128](0_u64)
      var ii = 0_s64
      while LLVM::signed_lt(a: ii, b: n)
        var p = LLVM::mul(a: LLVM::zero_extend[U64, U128](qhat), b: LLVM::zero_extend[U64, U128](LLVM::load_element_ref[Array[U64, N], U64](vnp, LLVM::reinterpret_bits[S64, U64](ii))))
        var plo = LLVM::int_truncate[U128, U64](p)
        var phi = LLVM::int_truncate[U128, U64](LLVM::shift_right_unsigned(p, 64_u128))
        var idx = LLVM::add(a: ii, b: j)
        var cur = if LLVM::int_eq(a: idx, b: mlen) then un_hi else LLVM::load_element_ref[Array[U64, N], U64](unp, LLVM::reinterpret_bits[S64, U64](idx))
        var t = LLVM::sub(a: LLVM::sub(a: LLVM::zero_extend[U64, S128](cur), b: k), b: LLVM::zero_extend[U64, S128](plo))
        var tlo = LLVM::int_truncate[S128, U64](t)
        if LLVM::int_eq(a: idx, b: mlen)
          un_hi = tlo
        else
          LLVM::store_element_ref[Array[U64, N], U64](unp, LLVM::reinterpret_bits[S64, U64](idx), tlo)
        # k = phi - arithmetic_shift_right(t, 64)
        k = LLVM::sub(a: LLVM::zero_extend[U64, S128](phi), b: LLVM::shift_right_signed(t, 64_s128))
        ii = LLVM::add(a: ii, b: 1_s64)
      # final top limb: un[j+n] -= k
      var topidx = LLVM::add(a: j, b: n)
      var curtop = if LLVM::int_eq(a: topidx, b: mlen) then un_hi else LLVM::load_element_ref[Array[U64, N], U64](unp, LLVM::reinterpret_bits[S64, U64](topidx))
      var ttop = LLVM::sub(a: LLVM::zero_extend[U64, S128](curtop), b: k)
      var ttoplo = LLVM::int_truncate[S128, U64](ttop)
      if LLVM::int_eq(a: topidx, b: mlen)
        un_hi = ttoplo
      else
        LLVM::store_element_ref[Array[U64, N], U64](unp, LLVM::reinterpret_bits[S64, U64](topidx), ttoplo)

      LLVM::store_element_ref[Array[U64, N], U64](qp, LLVM::reinterpret_bits[S64, U64](j), qhat)

      # D5/D6: if the subtraction went negative, qhat was 1 too big — add the divisor back
      if LLVM::signed_lt(a: ttop, b: LLVM::zero_extend[U64, S128](0_u64))
        LLVM::store_element_ref[Array[U64, N], U64](qp, LLVM::reinterpret_bits[S64, U64](j), LLVM::sub(a: qhat, b: 1_u64))
        var carry = 0_u64
        var ai = 0_s64
        while LLVM::signed_lt(a: ai, b: n)
          var aidx = LLVM::add(a: ai, b: j)
          var acur = if LLVM::int_eq(a: aidx, b: mlen) then un_hi else LLVM::load_element_ref[Array[U64, N], U64](unp, LLVM::reinterpret_bits[S64, U64](aidx))
          var sum = LLVM::add(a: LLVM::add(a: LLVM::zero_extend[U64, U128](acur), b: LLVM::zero_extend[U64, U128](LLVM::load_element_ref[Array[U64, N], U64](vnp, LLVM::reinterpret_bits[S64, U64](ai)))), b: LLVM::zero_extend[U64, U128](carry))
          if LLVM::int_eq(a: aidx, b: mlen)
            un_hi = LLVM::int_truncate[U128, U64](sum)
          else
            LLVM::store_element_ref[Array[U64, N], U64](unp, LLVM::reinterpret_bits[S64, U64](aidx), LLVM::int_truncate[U128, U64](sum))
          carry = LLVM::int_truncate[U128, U64](LLVM::shift_right_unsigned(sum, 64_u128))
          ai = LLVM::add(a: ai, b: 1_s64)
        un_hi = LLVM::add(a: un_hi, b: carry)
      j = LLVM::sub(a: j, b: 1_s64)

    # ---- D8: denormalize the remainder (un >> s), low n limbs ----
    var ri = 0_s64
    while LLVM::signed_lt(a: ri, b: n)
      var rlo = LLVM::shift_right_unsigned(LLVM::load_element_ref[Array[U64, N], U64](unp, LLVM::reinterpret_bits[S64, U64](ri)), su)
      var rhi = if LLVM::signed_gt(a: s, b: 0_s64) then LLVM::shift_left(LLVM::load_element_ref[Array[U64, N], U64](unp, LLVM::reinterpret_bits[S64, U64](LLVM::add(a: ri, b: 1_s64))), su_inv) else 0_u64
      LLVM::store_element_ref[Array[U64, N], U64](rem, LLVM::reinterpret_bits[S64, U64](ri), LLVM::bit_or(a: rlo, b: rhi))
      ri = LLVM::add(a: ri, b: 1_s64)
    var rz = n
    while LLVM::signed_lt(a: rz, b: nl)
      LLVM::store_element_ref[Array[U64, N], U64](rem, LLVM::reinterpret_bits[S64, U64](rz), 0_u64)
      rz = LLVM::add(a: rz, b: 1_s64)
  return q
