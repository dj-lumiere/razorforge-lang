module IterTools

### Represents a lazy adapter that pairs elements from two sources into tuples.
### Iteration stops as soon as either source is exhausted.
### :typeparam T: The element type of the first source sequence.
### :typeparam U: The element type of the second source sequence.
### :typeparam S1: The concrete first source iterable type (referenced, not owned).
### :typeparam S2: The concrete second source iterable type (referenced, not owned).
entity ZipIterable[AnyType T, AnyType U, AnyType S1, AnyType S2] obeys Iterable[Tuple[T, U]]
needs S1 obeys Iterable[T]
needs S2 obeys Iterable[U]
relates ZipEmittable[T, U, S1/Iter, S2/Iter] as Iter
  ### Stores the first source iterable (referenced, not owned).
  secret first: Hijacked[S1]
  ### Stores the second source iterable (referenced, not owned).
  secret second: Hijacked[S2]

### Returns the stateful iterator that produces paired tuples lazily.
### :returns: The resulting `ZipEmittable[T, U, S1/Iter, S2/Iter]` value.
@readonly
routine ZipIterable[T, U, S1, S2].iter() -> ZipEmittable[T, U, S1/Iter, S2/Iter]
  danger
    return ZipEmittable[T, U, S1/Iter, S2/Iter](first: me.first.as_entity().iter(), second: me.second.as_entity().iter())

### Iterates over two source sequences simultaneously, pairing one element from each.
### Iteration ends when either source is exhausted.
### :typeparam T: The element type of the first source.
### :typeparam U: The element type of the second source.
### :typeparam SE1: The concrete first source iterator type (referenced, not owned).
### :typeparam SE2: The concrete second source iterator type (referenced, not owned).
entity ZipEmittable[AnyType T, AnyType U, AnyType SE1, AnyType SE2] obeys Emittable[Tuple[T, U]]
needs SE1 obeys Emittable[T]
needs SE2 obeys Emittable[U]
  ### Stores the iterator for the first source (referenced, not owned).
  secret first: Hijacked[SE1]
  ### Stores the iterator for the second source (referenced, not owned).
  secret second: Hijacked[SE2]

### Returns the next paired tuple from both source iterators.
### Propagates absence as soon as either source is exhausted.
### :returns: The resulting `Tuple[T, U]` value.
routine ZipEmittable[T, U, SE1, SE2].emit!() -> Tuple[T, U]
  danger
    var a = me.first.as_entity().emit()
    var b = me.second.as_entity().emit()
    return (a, b)

### Returns a lazy adapter that pairs each element of `a` with an element of `b`.
### Stops when either source is exhausted.
### `zip` is a symmetric n-ary combinator, so `zip(a, b)` reads as a peer combination
### rather than a method call on one operand.
### :param a: The first source iterable to zip.
### :param b: The second source iterable to zip.
### :returns: The resulting `ZipIterable[T, U, S1, S2]` value.
routine zip[T, U, S1, S2](a: Accessing[S1], b: Accessing[S2]) -> ZipIterable[T, U, S1, S2]
needs S1 obeys Iterable[T]
needs S2 obeys Iterable[U]
  danger
    return ZipIterable[T, U, S1, S2](first: a.hijack(), second: b.hijack())

### Represents a lazy adapter that pairs elements from three sources into triples.
### Iteration stops as soon as any source is exhausted.
### :typeparam T: The element type of the first source sequence.
### :typeparam U: The element type of the second source sequence.
### :typeparam V: The element type of the third source sequence.
### :typeparam S1: The concrete first source iterable type (referenced, not owned).
### :typeparam S2: The concrete second source iterable type (referenced, not owned).
### :typeparam S3: The concrete third source iterable type (referenced, not owned).
entity Zip3Iterable[AnyType T, AnyType U, AnyType V, AnyType S1, AnyType S2, AnyType S3] obeys Iterable[Tuple[T, U, V]]
needs S1 obeys Iterable[T]
needs S2 obeys Iterable[U]
needs S3 obeys Iterable[V]
relates Zip3Emittable[T, U, V, S1/Iter, S2/Iter, S3/Iter] as Iter
  ### Stores the first source iterable (referenced, not owned).
  secret first: Hijacked[S1]
  ### Stores the second source iterable (referenced, not owned).
  secret second: Hijacked[S2]
  ### Stores the third source iterable (referenced, not owned).
  secret third: Hijacked[S3]

### Returns the stateful iterator that produces paired triples lazily.
### :returns: The resulting `Zip3Emittable[T, U, V, S1/Iter, S2/Iter, S3/Iter]` value.
@readonly
routine Zip3Iterable[T, U, V, S1, S2, S3].iter() -> Zip3Emittable[T, U, V, S1/Iter, S2/Iter, S3/Iter]
  danger
    return Zip3Emittable[T, U, V, S1/Iter, S2/Iter, S3/Iter](first: me.first.as_entity().iter(), second: me.second.as_entity().iter(), third: me.third.as_entity().iter())

### Iterates over three source sequences simultaneously, pairing one element from each.
### Iteration ends when any source is exhausted.
### :typeparam T: The element type of the first source.
### :typeparam U: The element type of the second source.
### :typeparam V: The element type of the third source.
### :typeparam SE1: The concrete first source iterator type (referenced, not owned).
### :typeparam SE2: The concrete second source iterator type (referenced, not owned).
### :typeparam SE3: The concrete third source iterator type (referenced, not owned).
entity Zip3Emittable[AnyType T, AnyType U, AnyType V, AnyType SE1, AnyType SE2, AnyType SE3] obeys Emittable[Tuple[T, U, V]]
needs SE1 obeys Emittable[T]
needs SE2 obeys Emittable[U]
needs SE3 obeys Emittable[V]
  ### Stores the iterator for the first source (referenced, not owned).
  secret first: Hijacked[SE1]
  ### Stores the iterator for the second source (referenced, not owned).
  secret second: Hijacked[SE2]
  ### Stores the iterator for the third source (referenced, not owned).
  secret third: Hijacked[SE3]

### Returns the next paired triple from all three source iterators.
### Propagates absence as soon as any source is exhausted.
### :returns: The resulting `Tuple[T, U, V]` value.
routine Zip3Emittable[T, U, V, SE1, SE2, SE3].emit!() -> Tuple[T, U, V]
  danger
    var a = me.first.as_entity().emit()
    var b = me.second.as_entity().emit()
    var c = me.third.as_entity().emit()
    return (a, b, c)

### Returns a lazy adapter that pairs each element of `a`, `b`, and `c` into a triple.
### Stops when the shortest of the three sources is exhausted.
### :param a: The first source iterable to zip.
### :param b: The second source iterable to zip.
### :param c: The third source iterable to zip.
### :returns: The resulting `Zip3Iterable[T, U, V, S1, S2, S3]` value.
routine zip[T, U, V, S1, S2, S3](a: Accessing[S1], b: Accessing[S2], c: Accessing[S3]) -> Zip3Iterable[T, U, V, S1, S2, S3]
needs S1 obeys Iterable[T]
needs S2 obeys Iterable[U]
needs S3 obeys Iterable[V]
  danger
    return Zip3Iterable[T, U, V, S1, S2, S3](first: a.hijack(), second: b.hijack(), third: c.hijack())

### Represents a lazy adapter that pairs elements from four sources into quadruples.
### Iteration stops as soon as any source is exhausted.
### :typeparam T: The element type of the first source sequence.
### :typeparam U: The element type of the second source sequence.
### :typeparam V: The element type of the third source sequence.
### :typeparam W: The element type of the fourth source sequence.
### :typeparam S1: The concrete first source iterable type (referenced, not owned).
### :typeparam S2: The concrete second source iterable type (referenced, not owned).
### :typeparam S3: The concrete third source iterable type (referenced, not owned).
### :typeparam S4: The concrete fourth source iterable type (referenced, not owned).
entity Zip4Iterable[AnyType T, AnyType U, AnyType V, AnyType W, AnyType S1, AnyType S2, AnyType S3, AnyType S4] obeys Iterable[Tuple[T, U, V, W]]
needs S1 obeys Iterable[T]
needs S2 obeys Iterable[U]
needs S3 obeys Iterable[V]
needs S4 obeys Iterable[W]
relates Zip4Emittable[T, U, V, W, S1/Iter, S2/Iter, S3/Iter, S4/Iter] as Iter
  ### Stores the first source iterable (referenced, not owned).
  secret first: Hijacked[S1]
  ### Stores the second source iterable (referenced, not owned).
  secret second: Hijacked[S2]
  ### Stores the third source iterable (referenced, not owned).
  secret third: Hijacked[S3]
  ### Stores the fourth source iterable (referenced, not owned).
  secret fourth: Hijacked[S4]

### Returns the stateful iterator that produces paired quadruples lazily.
### :returns: The resulting `Zip4Emittable[...]` value.
@readonly
routine Zip4Iterable[T, U, V, W, S1, S2, S3, S4].iter() -> Zip4Emittable[T, U, V, W, S1/Iter, S2/Iter, S3/Iter, S4/Iter]
  danger
    return Zip4Emittable[T, U, V, W, S1/Iter, S2/Iter, S3/Iter, S4/Iter](first: me.first.as_entity().iter(), second: me.second.as_entity().iter(), third: me.third.as_entity().iter(), fourth: me.fourth.as_entity().iter())

### Iterates over four source sequences simultaneously, pairing one element from each.
### Iteration ends when any source is exhausted.
### :typeparam T: The element type of the first source.
### :typeparam U: The element type of the second source.
### :typeparam V: The element type of the third source.
### :typeparam W: The element type of the fourth source.
### :typeparam SE1: The concrete first source iterator type (referenced, not owned).
### :typeparam SE2: The concrete second source iterator type (referenced, not owned).
### :typeparam SE3: The concrete third source iterator type (referenced, not owned).
### :typeparam SE4: The concrete fourth source iterator type (referenced, not owned).
entity Zip4Emittable[AnyType T, AnyType U, AnyType V, AnyType W, AnyType SE1, AnyType SE2, AnyType SE3, AnyType SE4] obeys Emittable[Tuple[T, U, V, W]]
needs SE1 obeys Emittable[T]
needs SE2 obeys Emittable[U]
needs SE3 obeys Emittable[V]
needs SE4 obeys Emittable[W]
  ### Stores the iterator for the first source (referenced, not owned).
  secret first: Hijacked[SE1]
  ### Stores the iterator for the second source (referenced, not owned).
  secret second: Hijacked[SE2]
  ### Stores the iterator for the third source (referenced, not owned).
  secret third: Hijacked[SE3]
  ### Stores the iterator for the fourth source (referenced, not owned).
  secret fourth: Hijacked[SE4]

### Returns the next paired quadruple from all four source iterators.
### Propagates absence as soon as any source is exhausted.
### :returns: The resulting `Tuple[T, U, V, W]` value.
routine Zip4Emittable[T, U, V, W, SE1, SE2, SE3, SE4].emit!() -> Tuple[T, U, V, W]
  danger
    var a = me.first.as_entity().emit()
    var b = me.second.as_entity().emit()
    var c = me.third.as_entity().emit()
    var d = me.fourth.as_entity().emit()
    return (a, b, c, d)

### Returns a lazy adapter that pairs each element of `a`, `b`, `c`, and `d` into a quadruple.
### Stops when the shortest of the four sources is exhausted.
### :param a: The first source iterable to zip.
### :param b: The second source iterable to zip.
### :param c: The third source iterable to zip.
### :param d: The fourth source iterable to zip.
### :returns: The resulting `Zip4Iterable[T, U, V, W, S1, S2, S3, S4]` value.
routine zip[T, U, V, W, S1, S2, S3, S4](a: Accessing[S1], b: Accessing[S2], c: Accessing[S3], d: Accessing[S4]) -> Zip4Iterable[T, U, V, W, S1, S2, S3, S4]
needs S1 obeys Iterable[T]
needs S2 obeys Iterable[U]
needs S3 obeys Iterable[V]
needs S4 obeys Iterable[W]
  danger
    return Zip4Iterable[T, U, V, W, S1, S2, S3, S4](first: a.hijack(), second: b.hijack(), third: c.hijack(), fourth: d.hijack())
