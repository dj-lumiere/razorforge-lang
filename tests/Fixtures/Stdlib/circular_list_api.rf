module Tests/Stdlib/CircularListApi
import IO/Console
import Collections

routine start()
  var dq = CircularList[S64]()
  show(f"new size: {dq.count()}")
  show(f"is_empty: {dq.is_empty()}")

  dq.add_last(value: 10)
  dq.add_last(value: 20)
  dq.add_first(value: 0)
  show(f"after add_last 10/20 + add_first 0, size: {dq.count()}")

  # peek
  show(f"first: {dq.first()}")
  show(f"last: {dq.last()}")

  # iteration in order
  each x in dq
    show(f"  iter: {x}")

  # remove_first
  discard dq.remove_first()
  show(f"first after remove_first: {dq.first()}")
  show(f"size: {dq.count()}")

  show("DONE")
  return
