module Tests/Stdlib/GuardedApi
import IO/Console

# Atomic Arc/Weak lifecycle: Guarded[T, P] (strong) + Witnessed[T, P] (weak) over one
# GuardController[T, P]. The access discipline P is explicit at creation (`share[ReadOnly]()`).
# Cloning is the explicit verb `.share()` / `.watch()` (these wrappers are not implicitly
# copyable); dropping is automatic at scope exit. The entity is destroyed when the last strong
# handle drops; the controller outlives it until the last weak handle drops too.

entity Node
  secret id: S64

@override
dangerous routine Node.destroy()
  show(f"destroying node {me.id}")
  return

routine start()
  var a = Guarded[Node, ReadOnly](from: Node(id: 7))
  show(f"strong: {a.strong_count()}")

  var b = a.share()
  show(f"strong: {a.strong_count()}")

  var w = a.observe()
  show(f"weak: {a.weak_count()}")
  show(f"alive: {w.is_alive()}")

  # Exclusive discipline carries a real lock in the controller (an atomic flag).
  var ex = Guarded[Node, Exclusive](from: Node(id: 9))
  show(f"ex strong: {ex.strong_count()}")
  return