module Tests/Stdlib/UsingBlockApi
import IO/Console

# `using` invokes enter on entry and exit on every exit path (normal end, early
# return, throw/absent propagation, break). Side-effecting hooks print markers
# so the snapshot proves the order.

entity Resource obeys Enterable
  tag: S64

routine Resource.create(tag: S32) -> Resource
  show(f"  create({tag})")
  return Resource(tag: S64(tag))

@override
dangerous routine Resource.destroy()
  show(f"  destroy({me.tag})")
  return

routine Resource.enter() -> Resource
  show(f"  enter({me.tag})")
  return me

routine Resource.exit()
  show(f"  exit({me.tag})")
  return

routine Resource.touch()
  show(f"  touch({me.tag})")
  return

routine normal_exit()
  show(" normal: before using")
  using Resource(tag: 1) as r
    r.touch()
  show(" normal: after using")
  return

routine early_return(condition: Bool)
  show(f" early: before using (cond={condition})")
  using Resource(tag: 2) as r
    r.touch()
    if condition
      show("  about to early-return")
      return
    r.touch()
  show(" early: after using (unreached when cond=true)")
  return

routine start()
  show("--- normal_exit ---")
  normal_exit()
  show("--- early_return(false) ---")
  early_return(condition: false)
  show("--- early_return(true) ---")
  early_return(condition: true)
  show("DONE")
  return
