module Tests/Stdlib/LifecycleReassignApi
import IO/Console

# Verifies that reassigning a plain (non-lateinit) entity var destroys the old value
# at the reassignment point. Regression lock: the old entity used to leak — its
# destroy never fired; only the final value was torn down at scope exit.

entity Tracer
  tag: S64

routine Tracer.create(tag: S32) -> Tracer
  show(f"  create({tag})")
  return Tracer(tag: S64(tag))

@override
dangerous routine Tracer.destroy()
  show(f"  destroy({me.tag})")
  return

routine start()
  var r = Tracer(tag: 1s32)
  show("before reassign")
  r = Tracer(tag: 2s32)
  show("after reassign")
  r = Tracer(tag: 3s32)
  show("after second reassign")
  return
  # destroy(3) fires at scope exit