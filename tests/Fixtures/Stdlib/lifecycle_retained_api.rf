module Tests/Stdlib/LifecycleRetainedApi
import IO/Console

# Verifies Retained refcount: destroy fires only when the last strong handle drops.
entity Tracer
  tag: S64

routine Tracer.create(tag: S32) -> Tracer
  show(f"  create({tag})")
  return Tracer(tag: S64(tag))

@override
dangerous routine Tracer.destroy()
  show(f"  destroy({me.tag})")
  return

routine inner()
  show(" inner enter")
  var t = Tracer(tag: 99s32)
  var r1 = Retained(from: steal t)
  show(f" after retain, strong={r1.strong_count()}")

  var r2 = r1.share()
  show(f" after r2 = r1.retain(), strong={r1.strong_count()}")

  # When inner() returns, r1 and r2 both go out of scope — refcount goes 2->1->0,
  # then destroy fires.
  return

routine start()
  show("--- inner() ---")
  inner()
  show("--- after inner (destroy should have happened) ---")
  show("DONE")
  return
