module Tests/Stdlib/CoroMemberApi

# v0.2.0 member-routine cancellation instrumentation. A may-suspend METHOD (Worker.do_work,
# which yields) owns an entity `b`; when the coroutine is abandoned while parked inside the
# method, the method's frame must tear `b` down. This exercises that 5b-2 instruments member
# routines, not just free routines (a may-suspend method owning resources would otherwise leak).

import IO/Console

entity Box
  value: S64

@override
dangerous routine Box.destroy()
  show(value: "Box destroyed")
  me.hijack().invalidate()
  return

entity Worker
  id: S64

routine Worker.do_work()
  var b = Box(value: 5)
  C::rf_coro_yield()
  return

routine coro_body(ud: CPtr)
  var w = Worker(id: 1)
  w.do_work()
  return

routine start()
  danger
    var co = C::rf_coro_create(entry: coro_body, userdata: cptr_none(), stack_size: 0)
    discard C::rf_coro_resume(coro: co)
    C::rf_coro_abandon(coro: co)
  show(value: "done")
  return
