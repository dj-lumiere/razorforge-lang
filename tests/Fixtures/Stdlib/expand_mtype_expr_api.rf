module Tests/Stdlib/ExpandMtypeExprApi
import IO/Console
import BuilderExpansion

# Exercises `$typeof(m)` in EXPRESSION position: inside an `expand m in allmemvarof(T)` loop, the buildtime
# member type splices into a typewise receiver for a static/universal method — here `$typeof(m).data_size()`
# (a `@innate` BuilderQuery constant). Each field's type folds to its concrete byte size at
# monomorphization (S64 -> 8, F32 -> 4, Bool -> 1, U16 -> 2).

record Mixed
  a: S64
  b: F32
  c: Bool
  d: U16

routine field_sizes[T]() -> Text
  var out = ""
  expand m in allmemvarof(T)
    if orderof(m) > 0u64
      out = out + ", "
    out = out + nameof(m) + "=" + $typeof(m).data_size().represent()
  return out

routine start()
  show(field_sizes[Mixed]())
  show("DONE")
  return
