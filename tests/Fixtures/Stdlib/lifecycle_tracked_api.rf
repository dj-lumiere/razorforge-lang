module Tests/Stdlib/LifecycleTrackedApi
import IO/Console

# Tracked is a weak handle. After all strong handles drop, the entity is destroyed
# but the controller stays alive while weak handles remain. Tracked.recover should
# return absent once strong=0.
entity Tracer
  tag: S64

routine Tracer.create(tag: S32) -> Tracer
  show(f"  create({me.tag})")
  return Tracer(tag: S64(tag))

@override
dangerous routine Tracer.destroy()
  show(f"  destroy({me.tag})")
  return

routine make_weak() -> Tracked[Tracer]
  show(" make_weak: create strong")
  var t = Tracer(tag: 7s32)
  var r = Retained(from: steal t)
  show(f"  strong={r.strong_count()}")
  var w = r.observe()
  show(f"  weak={r.weak_count()}, is_alive={w.is_alive()}")
  return w
  # r drops at function exit -> strong=0, entity destroyed; w returned still alive

routine start()
  var w = make_weak()
  show(f"after make_weak: is_alive={w.is_alive()}")

  # recover should now fail (strong is 0)
  when w.try_hold()
    is None => show("  recover -> absent (expected)")
    else r  => show("  recover -> got strong (unexpected!)")

  show("DONE")
  return
