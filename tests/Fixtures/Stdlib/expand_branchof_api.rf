module Tests/Stdlib/ExpandBranchofApi
import IO/Console
import BuilderExpansion

# Exercises `expand m in branchof(T)` — the variant-arm sibling of caseof. Inside a buildtime `when` over
# a `VariantType T`, the arm template `is $typeof(m) v => …` is unrolled once per payload arm at
# monomorphization: $typeof(m) folds to the concrete arm type, nameof(m) to its name, and `v` binds the
# payload. The explicit `is None =>` clause covers the absent arm the payload expansion skips. This is
# the same branchof machinery stdlib DeriveText uses for variant represent/diagnose, here in user code.

variant Value
  S32
  Text
  None

routine describe[T](val: T) -> Text
needs VariantType T
  when val
    is None => return "none"
    expand m in branchof(T)
      is $typeof(m) v => return nameof(m) + ":" + v.represent()

routine start()
  var a: Value = 7_s32
  var b: Value = "hi"
  var c: Value = none
  show(describe[Value](val: a))
  show(describe[Value](val: b))
  show(describe[Value](val: c))
  show("DONE")
  return
