<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Tests are never packed or shipped; this assembly stays out of every publish. -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- This is the test project (the compiler project sets this false). -->
    <SonarQubeTestProject>true</SonarQubeTestProject>
    <!-- Workstation GC for the test host. StdlibApiTests spawns ~150 sequential `buildandrun`
         children (each compiling the full stdlib + opt -O2/-O3); under default Server GC the host's
         per-core heap reservation stacks onto that peak and the OS OOM-kills processes across the
         tree during long runs (test host aborts; "exit=143, no output" child kills). Workstation GC
         keeps the host footprint small. The children get the same via env vars in StdlibApiTests. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RazorForge.csproj"/>
  </ItemGroup>

  <!-- Test/tooling packages live ONLY here so they never reach the compiler publish. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0"/>
    <PackageReference Include="xunit" Version="2.6.6"/>
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6"/>
  </ItemGroup>

  <!-- StdlibApiTests spawns `RazorForge.dll buildandrun` from this project's output
       directory (AppContext.BaseDirectory), and F128EncoderTests P/Invokes razorforge_runtime
       directly. ProjectReference copies RazorForge.dll but NOT the compiler's Content items, so
       mirror the Standard copy here; the native-runtime DLLs are staged by the build-time target
       below. -->
  <ItemGroup>
    <Content Include="..\Standard\**\*" LinkBase="Standard" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

  <!-- Stage the native runtime DLLs at BUILD TIME, not via an evaluation-time Content glob.
       On a clean build, ..\native\build\bin does not exist yet when this project is EVALUATED
       (it is produced by RazorForge's native build, which races this project under parallel
       `dotnet build`), so an evaluation-time `<Content Include="...**" Condition="Exists(...)">`
       captures nothing and the razorforge_runtime P/Invoke fails with DllNotFoundException
       (0x8007007E) — the flaky Windows CI failure. Resolving the files when this target RUNS,
       after the ProjectReference (RazorForge, which builds the native runtime) has completed,
       is reliable on both clean and incremental builds. -->
  <Target Name="StageNativeRuntimeDlls" AfterTargets="Build">
    <ItemGroup>
      <_NativeRuntimeDll Include="..\native\build\bin\**\*.*"/>
      <_NativeRuntimeDll Include="..\native\build\lib\**\*.*"/>
    </ItemGroup>
    <Copy SourceFiles="@(_NativeRuntimeDll)"
          DestinationFiles="@(_NativeRuntimeDll->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_NativeRuntimeDll)' != ''"/>
  </Target>

</Project>
